(do
(set 空白 " \n\t\r\u3000")
(set 换行符 "\n")
(set 全角映射 (dict
"（" "(" "）" ")" "｛" "{" "｝" "}"
"［" "[" "］" "]" "＝" "=" "＞" ">"
"＜" "<" "＋" "+" "－" "-" "＊" "*"
"／" "/" "％" "%" "＾" "^" "，" ","
"；" ";" "：" ":" "！" "!" "　" " "
"０" "0" "１" "1" "２" "2" "３" "3"
"４" "4" "５" "5" "６" "6" "７" "7"
"８" "8" "９" "9"
))
(set 字符串开始 "\"'")
(set 字符串结束 (dict "\"" "\"" "'" "'"))
(set 前缀运算符 (list "-" "!"))
(set 运算符映射 (dict
  "+" "加" "-" "减" "*" "乘" "/" "除" "%" "余" "^" "幂"
  ">" "大于" "<" "小于" ">=" "大于等于" "<=" "小于等于"
  "=" "等于" "!=" "不等于" "==" "等于" "!" "非"
))
(fn 取当前 (tokens)
(if (eq (list_len tokens) 0) (return 假))
(return (get tokens 0)))
(fn 匹配 (tokens 期望类型 期望值)
(do
(set tok (取当前 tokens))
(if (not (is_list tok)) (return 假))
(set ttype (get tok 0))
(set tval (get tok 1))
(if (and (str_equals ttype 期望类型) (or (not (is_string 期望值)) (str_equals tval 期望值)))
(return 真)
(return 假))))
(fn 消耗 (tokens 期望类型 期望值)
(do
(set tok (取当前 tokens))
(if (not (is_list tok)) (div 1 0))
(set ttype (get tok 0))
(set tval (get tok 1))
(if (and (str_equals ttype 期望类型) (or (not (is_string 期望值)) (str_equals tval 期望值)))
(if (eq (list_len tokens) 1) (return (list)) (return (slice tokens 1)))
(div 1 0))))
(fn 映射运算符 (op)
(if (dict_contains 运算符映射 op) (return (get_key 运算符映射 op)) (return op)))
(fn 获取优先级 (op)
(if (str_equals op ".") (return 80))
(if (or (str_equals op "!") (str_equals op "非")) (return 70))
(if (or (str_equals op "*") (str_equals op "/") (str_equals op "%")) (return 60))
(if (or (str_equals op "+") (str_equals op "-")) (return 50))
(if (or (str_equals op ">") (str_equals op "<") (str_equals op ">=") (str_equals op "<=")) (return 40))
(if (or (str_equals op "=") (str_equals op "!=") (str_equals op "==")) (return 30))
(if (str_equals op "且") (return 20))
(if (str_equals op "或") (return 10))
(return 0))
(fn 词法分析 (source)
(do
(set len (length source))
(set chars (str_to_list source))
(set tokens (list))
(set i 0)
(loop (lt i len)
(do
(set c (get chars i))
(if (str_equals c 换行符) (do (set i (add i 1)) (continue)))
(if (gt (find 空白 c) -1) (do (set i (add i 1)) (continue)))
(if (or (str_equals c "/") (str_equals c "#"))
(do
(set is_comment 假)
(if (str_equals c "#") (set is_comment 真))
(if (and (not is_comment) (lt (add i 1) len))
(do
(set nxt (get chars (add i 1)))
(if (or (str_equals nxt "/") (str_equals nxt "／"))
(set is_comment 真))))
    (if is_comment
      (do
        (loop 真
          (if (not (lt i len)) (break))
          (if (str_equals (get chars i) 换行符) (break))
          (set i (add i 1)))
        (continue)))))
(if (gt (find 字符串开始 c) -1)
(do
(set quote c)
(set end_quote (if (dict_contains 字符串结束 c) (get_key 字符串结束 c) c))
(set start i)
(set i (add i 1))
(loop 真
(if (not (lt i len)) (break))
(if (str_equals (get chars i) end_quote) (break))
(if (str_equals (get chars i) "\\") (set i (add i 1)))
(set i (add i 1)))
(if (lt i len) (set i (add i 1)))
(set val (substring source start (sub i start)))
(set tokens (list_concat tokens (list (list "字符串" val))))
(continue)))
(set mapped (if (dict_contains 全角映射 c) (get_key 全角映射 c) c))
(if (or (str_equals mapped "(") (str_equals mapped ")")
(or (str_equals mapped "{") (str_equals mapped "}")
(or (str_equals mapped "[") (str_equals mapped "]")
(or (str_equals mapped ",") (str_equals mapped ";")
(or (str_equals mapped ":") (str_equals mapped "."))))))
(do
(set tokens (list_concat tokens (list (list "符号" mapped))))
(set i (add i 1))
(continue)))
(if (or (str_equals mapped "=") (str_equals mapped ">")
(or (str_equals mapped "<") (str_equals mapped "+")
(or (str_equals mapped "-") (str_equals mapped "*")
(or (str_equals mapped "/") (str_equals mapped "%")
(or (str_equals mapped "^") (str_equals mapped "!"))))))
(do
(if (lt (add i 1) len)
(do
(set next_c (get chars (add i 1)))
(set next_mapped (if (dict_contains 全角映射 next_c) (get_key 全角映射 next_c) next_c))
(if (and (str_equals mapped ">") (str_equals next_mapped "="))
(do (set tokens (list_concat tokens (list (list "运算符" ">=")))) (set i (add i 2)) (continue)))
(if (and (str_equals mapped "<") (str_equals next_mapped "="))
(do (set tokens (list_concat tokens (list (list "运算符" "<=")))) (set i (add i 2)) (continue)))
(if (and (str_equals mapped "!") (str_equals next_mapped "="))
(do (set tokens (list_concat tokens (list (list "运算符" "!=")))) (set i (add i 2)) (continue)))
(if (and (str_equals mapped "=") (str_equals next_mapped "="))
(do (set tokens (list_concat tokens (list (list "运算符" "==")))) (set i (add i 2)) (continue)))))
(set tokens (list_concat tokens (list (list "运算符" mapped))))
(set i (add i 1))
(continue)))
(set is_digit 假)
(if (gt (find "0123456789" mapped) -1) (set is_digit 真))
(if is_digit
(do
(set start i)
(set i (add i 1))
(set is_float 假)
(loop (lt i len)
(do
(set ch (get chars i))
(set ch_mapped (if (dict_contains 全角映射 ch) (get_key 全角映射 ch) ch))
(if (gt (find "0123456789" ch_mapped) -1) (do (set i (add i 1)) (continue)))
(if (and (str_equals ch_mapped ".") (not is_float))
(do (set is_float 真) (set i (add i 1)) (continue)))
(break)))
(set val (substring source start (sub i start)))
(set converted "")
(set j 0)
(loop (lt j (length val))
(do
(set ch (substring val j 1))
(set m (if (dict_contains 全角映射 ch) (get_key 全角映射 ch) ch))
(set converted (concat converted m))
(set j (add j 1))))
(set tokens (list_concat tokens (list (list "数字" converted))))
(continue)))
(set start i)
(loop (lt i len)
(do
(set ch (get chars i))
(set is_break 假)
(if (gt (find 空白 ch) -1) (set is_break 真))
(if (gt (find "(){}[],;:." ch) -1) (set is_break 真))
(if (gt (find " \n\t\r\u3000" ch) -1) (set is_break 真))
(if is_break (break))
(set i (add i 1))))
(if (gt i start)
(do
(set val (substring source start (sub i start)))
(set tokens (list_concat tokens (list (list "标识符" val))))))))
(return tokens)))
(fn 解析主表达式 (tokens)
(do
(set tok (取当前 tokens))
(if (not (is_list tok)) (div 1 0))
(set ttype (get tok 0))
(set tval (get tok 1))
(if (str_equals ttype "数字") (return (list tval (slice tokens 1))))
(if (str_equals ttype "字符串") (return (list tval (slice tokens 1))))
(if (and (str_equals ttype "符号") (str_equals tval "("))
(do
(set rest (slice tokens 1))
(set result (解析表达式 rest 0))
(set node (get result 0))
(set rest2 (get result 1))
(set rest2 (消耗 rest2 "符号" ")"))
(return (list node rest2))))
(if (and (str_equals ttype "符号") (str_equals tval "["))
(do
(set rest (slice tokens 1))
(set elems (list))
(loop 真
(if (匹配 rest "符号" "]")
(do (set rest (消耗 rest "符号" "]")) (break)))
(if (匹配 rest "符号" "，")
(do (set rest (消耗 rest "符号" ",")) (continue)))
(set r (解析表达式 rest 0))
(set elems (list_concat elems (list (get r 0))))
(set rest (get r 1)))
(set node (list_concat (list "列表") elems))
(return (list node rest))))
(if (and (str_equals ttype "符号") (str_equals tval ".")) (div 1 0))
(if (str_equals ttype "标识符")
(do
(set rest (slice tokens 1))
(if (匹配 rest "符号" "(")
(do
(set rest (消耗 rest "符号" "("))
(set args (list))
(loop 真
(if (匹配 rest "符号" ")")
(do (set rest (消耗 rest "符号" ")")) (break)))
(if (匹配 rest "符号" ",")
(do (set rest (消耗 rest "符号" ",")) (continue)))
(set r (解析表达式 rest 0))
(set args (list_concat args (list (get r 0))))
(set rest (get r 1)))
(set node (list_concat (list tval) args))
(return (list node rest))))
(if (匹配 rest "符号" ".")
(do
(set rest (消耗 rest "符号" "."))
(set r (解析主表达式 rest))
(set rhs (get r 0))
(set rest (get r 1))
(if (is_string rhs) (return (list (concat tval "." rhs) rest)))
(div 1 0)))
(return (list tval rest))))
(if (and (str_equals ttype "符号") (str_equals tval "{"))
(do
(set rest (slice tokens 1))
(set stmts (list))
(loop 真
(if (匹配 rest "符号" "}")
(do (set rest (消耗 rest "符号" "}")) (break)))
(if (匹配 rest "符号" ";")
(do (set rest (消耗 rest "符号" ";")) (continue)))
(set r (解析语句 rest))
(set stmts (list_concat stmts (list (get r 0))))
(set rest (get r 1)))
(set node (if (eq (list_len stmts) 1) (get stmts 0) (list_concat (list "do") stmts)))
(return (list node rest))))
(if (str_equals ttype "运算符")
(return (list tval (slice tokens 1))))
(div 1 0)))
(fn 解析表达式 (tokens 最小优先级)
(do
(set tok (取当前 tokens))
(if (not (is_list tok)) (div 1 0))
(set ttype (get tok 0))
(set tval (get tok 1))
(if (and (str_equals ttype "运算符") (or (gt (find "!" tval) -1) (str_equals tval "-")))
(do
(set rest (slice tokens 1))
(set r (解析表达式 rest 70))
(set mapped (映射运算符 tval))
(set node (list mapped (get r 0)))
(set rest (get r 1))
(return (list node rest))))
(set result (解析主表达式 tokens))
(set left (get result 0))
(set rest (get result 1))
(loop 真
(do
(set tok2 (取当前 rest))
(if (not (is_list tok2)) (break))
(set ttype2 (get tok2 0))
(set tval2 (get tok2 1))
(set is_op 假)
(if (str_equals ttype2 "运算符") (set is_op 真))
(if (and (str_equals ttype2 "标识符") (or (str_equals tval2 "且") (or (str_equals tval2 "或") (str_equals tval2 "非"))))
(set is_op 真))
(if (not is_op) (break))
(set prec (获取优先级 tval2))
(if (lt prec 最小优先级) (break))
(set rest (slice rest 1))
(if (str_equals tval2 "=")
(do
(set r (解析表达式 rest prec))
(set left (list "set" left (get r 0)))
(set rest (get r 1))
(continue)))
(set r (解析表达式 rest (add prec 1)))
(set right (get r 0))
(set rest (get r 1))
(set mapped_op (映射运算符 tval2))
(set left (list mapped_op left right))))
(return (list left rest))))
(fn 解析语句 (tokens)
(do
(set tok (取当前 tokens))
(if (not (is_list tok)) (return (list 假 (list))))
(set ttype (get tok 0))
(set tval (get tok 1))
(if (and (str_equals ttype "标识符") (str_equals tval "若"))
(do
(set rest (slice tokens 1))
(set cond_r (解析表达式 rest 0))
(set cond (get cond_r 0))
(set rest (get cond_r 1))
(set then_r (解析主表达式 rest))
(set then_body (get then_r 0))
(set rest (get then_r 1))
(set else_body 假)
(if (匹配 rest "标识符" "再若")
(do
(set rest (消耗 rest "标识符" "再若"))
(set elif_r (解析表达式 rest 0))
(set elif_cond (get elif_r 0))
(set rest (get elif_r 1))
(set elif_body_r (解析主表达式 rest))
(set elif_body (get elif_body_r 0))
(set rest (get elif_body_r 1))
(set else_body (list "if" elif_cond elif_body))
(if (匹配 rest "标识符" "否则")
(do
(set rest (消耗 rest "标识符" "否则"))
(set el_r (解析主表达式 rest))
(set el_body (get el_r 0))
(set rest (get el_r 1))
(set else_body (list_concat else_body (list el_body))))))
(if (匹配 rest "标识符" "否则")
 (do
  (set rest (消耗 rest "标识符" "否则"))
  (if (匹配 rest "标识符" "若")
   (do
    (set r (解析语句 rest))
    (set else_body (get r 0))
    (set rest (get r 1)))
   (do
    (set else_r (解析主表达式 rest))
    (set else_body (get else_r 0))
    (set rest (get else_r 1)))))))
(set node (list "if" cond then_body))
(if (is_list else_body) (set node (list_concat node (list else_body))))
(return (list node rest))))
(if (and (str_equals ttype "标识符") (str_equals tval "循环"))
(do
(set rest (slice tokens 1))
(set cond_r (解析表达式 rest 0))
(set cond (get cond_r 0))
(set rest (get cond_r 1))
(set body_r (解析主表达式 rest))
(set body (get body_r 0))
(set rest (get body_r 1))
(return (list (list "loop" cond body) rest))))
(if (and (str_equals ttype "标识符") (str_equals tval "设"))
(do
(set rest (slice tokens 1))
(set name_tok (取当前 rest))
(if (not (is_list name_tok)) (div 1 0))
(set name (get name_tok 1))
(set rest (slice rest 1))
(if (匹配 rest "运算符" "=") (set rest (消耗 rest "运算符" "=")))
(set val_r (解析表达式 rest 0))
(set val (get val_r 0))
(return (list (list "set" name val) (get val_r 1)))))
(if (and (str_equals ttype "标识符") (str_equals tval "定义"))
(do
(set rest (slice tokens 1))
(set name_tok (取当前 rest))
(if (not (is_list name_tok)) (div 1 0))
(set name (get name_tok 1))
(set rest (slice rest 1))
(set rest (消耗 rest "符号" "("))
(set params (list))
(loop 真
(if (匹配 rest "符号" ")")
(do (set rest (消耗 rest "符号" ")")) (break)))
(if (匹配 rest "符号" ",")
(do (set rest (消耗 rest "符号" ",")) (continue)))
(set p_tok (取当前 rest))
(if (not (is_list p_tok)) (div 1 0))
(set params (list_concat params (list (get p_tok 1))))
(set rest (slice rest 1)))
(set body_r (解析主表达式 rest))
(set body (get body_r 0))
(set rest (get body_r 1))
(return (list (list "fn" name params body) rest))))
(if (and (str_equals ttype "标识符") (str_equals tval "函数"))
(do
(set rest (slice tokens 1))
(set rest (消耗 rest "符号" "("))
(set params (list))
(loop 真
(if (匹配 rest "符号" ")")
(do (set rest (消耗 rest "符号" ")")) (break)))
(if (匹配 rest "符号" ",")
(do (set rest (消耗 rest "符号" ",")) (continue)))
(set p_tok (取当前 rest))
(if (not (is_list p_tok)) (div 1 0))
(set params (list_concat params (list (get p_tok 1))))
(set rest (slice rest 1)))
(set body_r (解析主表达式 rest))
(set body (get body_r 0))
(set rest (get body_r 1))
(return (list (list "lambda" params body) rest))))
(if (and (str_equals ttype "标识符") (str_equals tval "尝试"))
(do
(set rest (slice tokens 1))
(set try_r (解析主表达式 rest))
(set try_body (get try_r 0))
(set rest (get try_r 1))
(set catch_var 假)
(set catch_body 假)
(set has_catch 假)
(if (匹配 rest "标识符" "捕获")
(do
(set rest (消耗 rest "标识符" "捕获"))
(if (匹配 rest "符号" "(")
(do
(set rest (消耗 rest "符号" "("))
(set cv (取当前 rest))
(if (is_list cv) (do (set catch_var (get cv 1)) (set rest (slice rest 1))))
(set rest (消耗 rest "符号" ")"))))
(set ch_r (解析主表达式 rest))
(set catch_body (get ch_r 0))
(set rest (get ch_r 1))
(set has_catch 真)))
(set node (list "try" try_body))
(if has_catch (set node (list_concat node (list (list "catch" catch_var catch_body)))))
(return (list node rest))))
(if (and (str_equals ttype "标识符") (str_equals tval "返回"))
(do
(set rest (slice tokens 1))
(set val_r (解析表达式 rest 0))
(return (list (list "return" (get val_r 0)) (get val_r 1)))))
(if (and (str_equals ttype "标识符") (str_equals tval "跳出"))
(do
(set rest (slice tokens 1))
(if (匹配 rest "符号" ";") (set rest (消耗 rest "符号" ";")))
(return (list (list "break") rest))))
(if (and (str_equals ttype "标识符") (str_equals tval "继续"))
(do
(set rest (slice tokens 1))
(if (匹配 rest "符号" ";") (set rest (消耗 rest "符号" ";")))
(return (list (list "continue") rest))))
(if (and (str_equals ttype "标识符") (str_equals tval "导出"))
(do
(set rest (slice tokens 1))
(set names (list))
(loop 真
(set ntok (取当前 rest))
(if (not (is_list ntok)) (break))
(if (not (str_equals (get ntok 0) "标识符")) (break))
(set names (list_concat names (list (get ntok 1))))
(set rest (slice rest 1)))
(return (list (list_concat (list "export") names) rest))))
(return (解析表达式 tokens 0))))
(fn 解析 (source)
(do
(set tokens (词法分析 source))
(set asts (list))
(loop (gt (list_len tokens) 0)
(do
(set r (解析语句 tokens))
(set node (get r 0))
(if (is_list node)
(set asts (list_concat asts (list node)))
(do (set asts (list_concat asts (list node))) (break)))
(set tokens (get r 1))))
(if (eq (list_len asts) 0) (return 假))
(if (eq (list_len asts) 1) (return (get asts 0)))
(return (list_concat (list "do") asts))))
(export 词法分析 解析))
