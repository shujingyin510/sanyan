// 编译顶层 AST → 完整 LLVM IR 模块
// 流程：预扫描函数名 → 生成模块头 → 编译 AST → 拼接运行时/函数定义 → 包装为 main
定义 编译顶层 (ast) {
    设 reg = 0
    设 comp_env = 新字典()
    设 函数库列表 = 新列表()
    设 函数参数表 = 新字典()
    设 全局变量表 = 新字典()
    设 全局变量计数 = 0
    // 预扫描: 注册所有函数名 + 提取模块级设变量
    若 (是列表(ast)) {
        设 alen = 列表取长(ast)
        设 ai = 0
        循环 (小于(ai, alen)) {
            设 stmt = 取(ast, ai)
            若 (是列表(stmt)) {
                设 op = 取(stmt, 0)
                若 (字符串相等(op, "fn") 或 字符串相等(op, "定义") 或 字符串相等(op, "define")) {
                    设 fn_name = 取(stmt, 1)
                    设 plist = 取(stmt, 2)
                    // 排除 llvmgen 内部函数：不注册到函数参数表
                    若 (等于(取长(查键(排除字典, fn_name)), 0)) {
                        设 ascii = 注册函数名(fn_name)
                        存变量(函数参数表, ascii, 列表取长(plist))
                    }
                }
                若 (字符串相等(op, "设") 或 字符串相等(op, "設") 或 字符串相等(op, "set")) {
                    设 var_name = 取(stmt, 1)
                    设 gv_ascii = 连接("_gv", 全局变量计数)
                    存变量(全局变量表, var_name, gv_ascii)
                    全局变量计数 = 加(全局变量计数, 1)
                }
            }
            ai = 加(ai, 1)
        }
    }
    设 s = 生成模块头()
    // 生成模块级 @global 变量声明
    设 全局键列表 = 字典键列表(全局变量表)
    设 gki = 0; 设 gkc = 列表取长(全局键列表)
    循环 (小于(gki, gkc)) {
        设 gv_name = 取(全局键列表, gki)
        设 gv_ascii = 查键(全局变量表, gv_name)
        s = 连接(s, "@", gv_ascii, " = global i8* null", 换行)
        gki = 加(gki, 1)
    }
    s = 连接(s, 换行)
    设 r = 编译(comp_env, ast, reg)
    // 生成字符串常量定义
    s = 连接(s, 生成字符串常量定义())
    s = 连接(s, 换行)
    // 生成运行时函数定义（rt_print_int, rt_print_str 等）
    s = 连接(s, 生成运行时IR())
    s = 连接(s, 生成_桩函数())
    // 拼接用户函数定义
    设 fn_count = 列表取长(函数库列表)
    设 fi = 0
    循环 (小于(fi, fn_count)) {
        设 fn_ir = 取(函数库列表, fi)
        s = 连接(s, fn_ir)
        fi = 加(fi, 1)
    }
    s = 连接(s, 换行)
    // 把所有顶层代码包装为 __init 函数（解决顶层设语句的全局变量问题）
    s = 连接(s, "define void @__init() {"); s = 连接(s, 换行)
    s = 连接(s, "entry:"); s = 连接(s, 换行)
    s = 连接(s, 取(r, 0))
    s = 连接(s, "  ret void"); s = 连接(s, 换行)
    s = 连接(s, "}"); s = 连接(s, 换行)
    s = 连接(s, 换行)
    s = 连接(s, "define i8* @main() {"); s = 连接(s, 换行)
    s = 连接(s, "entry:"); s = 连接(s, 换行)
    s = 连接(s, "  call void @__init()"); s = 连接(s, 换行)
    s = 连接(s, 生成模块尾())
    返回(s)
}

导出 编译顶层
