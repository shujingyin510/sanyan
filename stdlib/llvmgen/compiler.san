// 主编译函数：递归将 AST 节点编译为 LLVM IR
// 参数：_c_ce=编译环境, ast=AST节点, reg=当前寄存器号
// 返回：列表(IR文本, 结果寄存器, 新寄存器号)
定义 编译 (_c_ce, ast, reg) {
    若 (是列表(ast)) {
        设 _c_op = 取(ast, 0)
        设 _c_args = 切片(ast, 1)

    若 (字符串相等(_c_op, "设") 或 字符串相等(_c_op, "set")) {
        设 _c_name = 列表取(_c_args, 0)
        设 _c_arg_val = 列表取(_c_args, 1)
        设 _c_val_r = 编译(_c_ce, _c_arg_val, reg)
        设 _c_s = 列表取(_c_val_r, 0)
        设 _c_val_reg = 列表取(_c_val_r, 1)
        reg = 列表取(_c_val_r, 2)
        // 检查是否为模块级全局变量
        设 _c_gv = 查键(全局变量表, _c_name)
        若 (大于(取长(_c_gv), 0)) {
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** @", _c_gv, 换行)
            返回(列表(_c_s, _c_val_reg, reg))
        }
        设 _c_existing = 查键(_c_ce, _c_name)
        若 (等于(取长(_c_existing), 0)) {
            设 _c_r = 新寄存器(reg); 设 _c_a = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", _c_a, " = alloca i8*", 换行)
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** ", _c_a, 换行)
            存变量(_c_ce, _c_name, _c_a)
        } 否则 {
            设 _c_a = _c_existing
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** ", _c_a, 换行)
        }
        返回(列表(_c_s, _c_val_reg, reg))
    }

    若 (字符串相等(_c_op, "新寄存器ID")) {
        设 _c_r = 新寄存器(reg); 设 rx = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_s = 连接("  ", rx, " = call i8* @_next_reg_str()", 换行)
        返回(列表(_c_s, rx, reg))
    }

    若 (字符串相等(_c_op, "新标签ID")) {
        设 _c_r = 新寄存器(reg); 设 rx = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_s = 连接("  ", rx, " = call i8* @_next_reg_str()", 换行)
        返回(列表(_c_s, rx, reg))
    }

    若 (字符串相等(_c_op, "加") 或 字符串相等(_c_op, "add")) {
        设 _c_l_val = 列表取(_c_args, 0)
        设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = add i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
         返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "减") 或 字符串相等(_c_op, "sub")) {
        设 _c_arg_count = 列表取长(_c_args)
        若 (等于(_c_arg_count, 1)) {
            设 _c_v_val = 列表取(_c_args, 0)
            设 _c_v_r = 编译(_c_ce, _c_v_val, reg)
            设 _c_s = 列表取(_c_v_r, 0); 设 vv = 列表取(_c_v_r, 1); reg = 列表取(_c_v_r, 2)
            设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", vv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_raw = 连接("%", ub_val)
            设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", res, " = sub i64 0, ", _c_raw, 换行)
            设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
            返回(列表(_c_s, _c_bv, reg))
        }
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_arg_count = 列表取长(_c_args)
        若 (等于(_c_arg_count, 1)) {
            // Unary negation: -x → sub 0, x
            设 _c_v_val = 列表取(_c_args, 0)
            设 _c_v_r = 编译(_c_ce, _c_v_val, reg)
            设 _c_s = 列表取(_c_v_r, 0); 设 vv = 列表取(_c_v_r, 1); reg = 列表取(_c_v_r, 2)
            设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", vv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_raw = 连接("%", ub_val)
            设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", res, " = sub i64 0, ", _c_raw, 换行)
            设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
            返回(列表(_c_s, _c_bv, reg))
        }
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = sub i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "乘") 或 字符串相等(_c_op, "mul")) {
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = mul i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "除") 或 字符串相等(_c_op, "div")) {
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = sdiv i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "小于") 或 字符串相等(_c_op, "lt")) {
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 cmp = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_r = 新寄存器(reg); 设 result = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", cmp, " = icmp slt i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        _c_s = 连接(_c_s, "  ", result, " = zext i1 ", cmp, " to i64", 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", result, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "大于") 或 字符串相等(_c_op, "gt")) {
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 cmp = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_r = 新寄存器(reg); 设 result = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", cmp, " = icmp sgt i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        _c_s = 连接(_c_s, "  ", result, " = zext i1 ", cmp, " to i64", 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", result, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "等于") 或 字符串相等(_c_op, "eq")) {
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
