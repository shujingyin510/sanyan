// 生成运行时函数的 LLVM IR 定义
// 包含：打印、字符串操作、列表操作、字典操作、类型检查等
定义 生成运行时IR () {
    // 返回所有运行时函数的 LLVM IR 定义
    设 ir = ""

    // ── rt_print_str ──
    ir = 连接(ir, "define void @rt_print_str(i8* %str) {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %_pi = ptrtoint i8* %str to i64", 换行)
    ir = 连接(ir, "  %_is_tagged = and i64 %_pi, 1", 换行)
    ir = 连接(ir, "  %_check = icmp eq i64 %_is_tagged, 0", 换行)
    ir = 连接(ir, "  br i1 %_check, label %obj, label %scan", 换行)
    ir = 连接(ir, "obj:", 换行)
    ir = 连接(ir, "  %_tp = bitcast i8* %str to i32*", 换行)
    ir = 连接(ir, "  %_type = load i32, i32* %_tp", 换行)
    ir = 连接(ir, "  %_is_str = icmp eq i32 %_type, 1", 换行)
    ir = 连接(ir, "  br i1 %_is_str, label %str_obj, label %scan", 换行)
    ir = 连接(ir, "str_obj:", 换行)
    ir = 连接(ir, "  %_lp = getelementptr i8, i8* %str, i32 4", 换行)
    ir = 连接(ir, "  %_li = bitcast i8* %_lp to i32*", 换行)
    ir = 连接(ir, "  %_len = load i32, i32* %_li", 换行)
    ir = 连接(ir, "  %_dp = getelementptr i8, i8* %str, i32 8", 换行)
    ir = 连接(ir, "  call void @san_sys_write(i32 1, i8* %_dp, i32 %_len)", 换行)
    ir = 连接(ir, "  ret void", 换行)
    ir = 连接(ir, "scan:", 换行)
    ir = 连接(ir, "  %_si = phi i32 [ 0, %entry ], [ 0, %obj ], [ %_ni, %scan ]", 换行)
    ir = 连接(ir, "  %_sp = getelementptr inbounds i8, i8* %str, i32 %_si", 换行)
    ir = 连接(ir, "  %_sc = load i8, i8* %_sp", 换行)
    ir = 连接(ir, "  %_sd = icmp eq i8 %_sc, 0", 换行)
    ir = 连接(ir, "  %_ni = add i32 %_si, 1", 换行)
    ir = 连接(ir, "  br i1 %_sd, label %write, label %scan", 换行)
    ir = 连接(ir, "write:", 换行)
    ir = 连接(ir, "  call void @san_sys_write(i32 1, i8* %str, i32 %_si)", 换行)
    ir = 连接(ir, "  ret void", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // ── rt_print_int ──
    ir = 连接(ir, "define void @rt_print_int(i64 %tagged) {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %raw = ashr i64 %tagged, 1", 换行)
    ir = 连接(ir, "  %is_neg = icmp slt i64 %raw, 0", 换行)
    ir = 连接(ir, "  %abs = sub i64 0, %raw", 换行)
    ir = 连接(ir, "  %val = select i1 %is_neg, i64 %abs, i64 %raw", 换行)
    ir = 连接(ir, "  br i1 %is_neg, label %put_sign, label %build", 换行)
    ir = 连接(ir, "put_sign:", 换行)
    ir = 连接(ir, "  %sp = getelementptr inbounds [22 x i8], [22 x i8]* @_rt_buf, i64 0, i32 0", 换行)
    ir = 连接(ir, "  store i8 45, i8* %sp", 换行)
    ir = 连接(ir, "  br label %build", 换行)
    ir = 连接(ir, "build:", 换行)
    ir = 连接(ir, "  %off = phi i32 [ 1, %put_sign ], [ 0, %entry ]", 换行)
    ir = 连接(ir, "  br label %loop", 换行)
    ir = 连接(ir, "loop:", 换行)
    ir = 连接(ir, "  %i = phi i32 [ %off, %build ], [ %ni, %loop ]", 换行)
    ir = 连接(ir, "  %v = phi i64 [ %val, %build ], [ %nv, %loop ]", 换行)
    ir = 连接(ir, "  %p = getelementptr inbounds [22 x i8], [22 x i8]* @_rt_buf, i64 0, i32 %i", 换行)
    ir = 连接(ir, "  %d = urem i64 %v, 10", 换行)
    ir = 连接(ir, "  %ch64 = add i64 %d, 48", 换行)
    ir = 连接(ir, "  %ch = trunc i64 %ch64 to i8", 换行)
    ir = 连接(ir, "  store i8 %ch, i8* %p", 换行)
    ir = 连接(ir, "  %nv = udiv i64 %v, 10", 换行)
    ir = 连接(ir, "  %ni = add i32 %i, 1", 换行)
    ir = 连接(ir, "  %ld = icmp eq i64 %nv, 0", 换行)
    ir = 连接(ir, "  br i1 %ld, label %exit, label %loop", 换行)
    ir = 连接(ir, "exit:", 换行)
    ir = 连接(ir, "  %ei = phi i32 [ %ni, %loop ]", 换行)
    ir = 连接(ir, "  %nl = getelementptr inbounds [22 x i8], [22 x i8]* @_rt_buf, i64 0, i32 %ei", 换行)
    ir = 连接(ir, "  store i8 10, i8* %nl", 换行)
    ir = 连接(ir, "  %re = sub i32 %ei, 1", 换行)
    ir = 连接(ir, "  br label %rev_loop", 换行)
    ir = 连接(ir, "rev_loop:", 换行)
    ir = 连接(ir, "  %l = phi i32 [ %off, %exit ], [ %nl2, %rev_swap ]", 换行)
    ir = 连接(ir, "  %r = phi i32 [ %re, %exit ], [ %nr2, %rev_swap ]", 换行)
    ir = 连接(ir, "  %rd = icmp sge i32 %l, %r", 换行)
    ir = 连接(ir, "  br i1 %rd, label %done, label %rev_swap", 换行)
    ir = 连接(ir, "rev_swap:", 换行)
    ir = 连接(ir, "  %lp = getelementptr inbounds [22 x i8], [22 x i8]* @_rt_buf, i64 0, i32 %l", 换行)
    ir = 连接(ir, "  %rp = getelementptr inbounds [22 x i8], [22 x i8]* @_rt_buf, i64 0, i32 %r", 换行)
    ir = 连接(ir, "  %lc = load i8, i8* %lp", 换行)
    ir = 连接(ir, "  %rc = load i8, i8* %rp", 换行)
    ir = 连接(ir, "  store i8 %rc, i8* %lp", 换行)
    ir = 连接(ir, "  store i8 %lc, i8* %rp", 换行)
    ir = 连接(ir, "  %nl2 = add i32 %l, 1", 换行)
    ir = 连接(ir, "  %nr2 = sub i32 %r, 1", 换行)
    ir = 连接(ir, "  br label %rev_loop", 换行)
    ir = 连接(ir, "done:", 换行)
    ir = 连接(ir, "  %tl = add i32 %ei, 1", 换行)
    ir = 连接(ir, "  %startp = getelementptr inbounds [22 x i8], [22 x i8]* @_rt_buf, i64 0, i32 %off", 换行)
    ir = 连接(ir, "  call void @san_sys_write(i32 1, i8* %startp, i32 %tl)", 换行)
    ir = 连接(ir, "  ret void", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    ir = 连接(ir, 生成_字符串操作())
    ir = 连接(ir, 生成_列表操作())
    ir = 连接(ir, 生成_字典操作())

    返回(ir)
}

// 生成字符串操作的 LLVM IR 定义（拼接、长度、子串、查找、比较等）
定义 生成_字符串操作 () {
    设 ir = ""

    // rt_str_new: 创建字符串对象 (data: i8*, len: i32) → i8* (堆对象)
    // 布局: [type:i32=1][len:i32][data:i8[len+1]]
    ir = 连接(ir, "define i8* @rt_str_new(i8* %data, i32 %len) {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %_sz = add i32 %len, 9", 换行)
    ir = 连接(ir, "  %_m = call i8* @_rt_malloc(i32 %_sz)", 换行)
    ir = 连接(ir, "  %_tp = bitcast i8* %_m to i32*", 换行)
    ir = 连接(ir, "  store i32 1, i32* %_tp", 换行)
    ir = 连接(ir, "  %_lp = getelementptr i8, i8* %_m, i32 4", 换行)
    ir = 连接(ir, "  %_li = bitcast i8* %_lp to i32*", 换行)
    ir = 连接(ir, "  store i32 %len, i32* %_li", 换行)
    ir = 连接(ir, "  %_dp = getelementptr i8, i8* %_m, i32 8", 换行)
    // memcpy
    ir = 连接(ir, "  %_cp = icmp sgt i32 %len, 0", 换行)
    ir = 连接(ir, "  br i1 %_cp, label %copy, label %done", 换行)
    ir = 连接(ir, "copy:", 换行)
    ir = 连接(ir, "  %_i = phi i32 [ 0, %entry ], [ %_ni, %copy ]", 换行)
    ir = 连接(ir, "  %_sp = getelementptr inbounds i8, i8* %data, i32 %_i", 换行)
    ir = 连接(ir, "  %_sc = load i8, i8* %_sp", 换行)
    ir = 连接(ir, "  %_dp2 = getelementptr inbounds i8, i8* %_dp, i32 %_i", 换行)
    ir = 连接(ir, "  store i8 %_sc, i8* %_dp2", 换行)
    ir = 连接(ir, "  %_ni = add i32 %_i, 1", 换行)
    ir = 连接(ir, "  %_cd = icmp slt i32 %_ni, %len", 换行)
    ir = 连接(ir, "  br i1 %_cd, label %copy, label %done", 换行)
    ir = 连接(ir, "done:", 换行)
    ir = 连接(ir, "  %_np = getelementptr inbounds i8, i8* %_dp, i32 %len", 换行)
    ir = 连接(ir, "  store i8 0, i8* %_np", 换行)
    ir = 连接(ir, "  ret i8* %_m", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_str_concat: 拼接两个字符串对象 → 新字符串
    ir = 连接(ir, "define i8* @rt_str_concat(i8* %a, i8* %b) {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %_lap = getelementptr i8, i8* %a, i32 4", 换行)
    ir = 连接(ir, "  %_lai = bitcast i8* %_lap to i32*", 换行)
    ir = 连接(ir, "  %_la = load i32, i32* %_lai", 换行)
    ir = 连接(ir, "  %_lbp = getelementptr i8, i8* %b, i32 4", 换行)
    ir = 连接(ir, "  %_lbi = bitcast i8* %_lbp to i32*", 换行)
    ir = 连接(ir, "  %_lb = load i32, i32* %_lbi", 换行)
    ir = 连接(ir, "  %_tl = add i32 %_la, %_lb", 换行)
    ir = 连接(ir, "  %_sz = add i32 %_tl, 9", 换行)
    ir = 连接(ir, "  %_m = call i8* @_rt_malloc(i32 %_sz)", 换行)
    ir = 连接(ir, "  %_tp = bitcast i8* %_m to i32*", 换行)
    ir = 连接(ir, "  store i32 1, i32* %_tp", 换行)
    ir = 连接(ir, "  %_lp = getelementptr i8, i8* %_m, i32 4", 换行)
    ir = 连接(ir, "  %_li = bitcast i8* %_lp to i32*", 换行)
    ir = 连接(ir, "  store i32 %_tl, i32* %_li", 换行)
    ir = 连接(ir, "  %_dp = getelementptr i8, i8* %_m, i32 8", 换行)
    ir = 连接(ir, "  %_ad = getelementptr i8, i8* %a, i32 8", 换行)
    ir = 连接(ir, "  %_bd = getelementptr i8, i8* %b, i32 8", 换行)
    // copy a
    ir = 连接(ir, "  %_ca = icmp sgt i32 %_la, 0", 换行)
    ir = 连接(ir, "  br i1 %_ca, label %copy_a, label %copy_b_start", 换行)
    ir = 连接(ir, "copy_a:", 换行)
    ir = 连接(ir, "  %_ai = phi i32 [ 0, %entry ], [ %_ani, %copy_a ]", 换行)
    ir = 连接(ir, "  %_asp = getelementptr i8, i8* %_ad, i32 %_ai", 换行)
    ir = 连接(ir, "  %_asc = load i8, i8* %_asp", 换行)
    ir = 连接(ir, "  %_adp = getelementptr i8, i8* %_dp, i32 %_ai", 换行)
    ir = 连接(ir, "  store i8 %_asc, i8* %_adp", 换行)
    ir = 连接(ir, "  %_ani = add i32 %_ai, 1", 换行)
    ir = 连接(ir, "  %_acd = icmp slt i32 %_ani, %_la", 换行)
    ir = 连接(ir, "  br i1 %_acd, label %copy_a, label %copy_b_start", 换行)
    ir = 连接(ir, "copy_b_start:", 换行)
    ir = 连接(ir, "  %_cbc = icmp sgt i32 %_lb, 0", 换行)
    ir = 连接(ir, "  br i1 %_cbc, label %copy_b, label %done", 换行)
    ir = 连接(ir, "copy_b:", 换行)
    ir = 连接(ir, "  %_bi = phi i32 [ 0, %copy_b_start ], [ %_bni, %copy_b ]", 换行)
    ir = 连接(ir, "  %_bsp = getelementptr i8, i8* %_bd, i32 %_bi", 换行)
    ir = 连接(ir, "  %_bsc = load i8, i8* %_bsp", 换行)
    ir = 连接(ir, "  %_boff = add i32 %_bi, %_la", 换行)
    ir = 连接(ir, "  %_bdp = getelementptr i8, i8* %_dp, i32 %_boff", 换行)
    ir = 连接(ir, "  store i8 %_bsc, i8* %_bdp", 换行)
    ir = 连接(ir, "  %_bni = add i32 %_bi, 1", 换行)
    ir = 连接(ir, "  %_bcd = icmp slt i32 %_bni, %_lb", 换行)
    ir = 连接(ir, "  br i1 %_bcd, label %copy_b, label %done", 换行)
    ir = 连接(ir, "done:", 换行)
    ir = 连接(ir, "  %_np = getelementptr inbounds i8, i8* %_dp, i32 %_tl", 换行)
    ir = 连接(ir, "  store i8 0, i8* %_np", 换行)
    ir = 连接(ir, "  ret i8* %_m", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_str_len: 返回字符串长度
    ir = 连接(ir, "define i32 @rt_str_len(i8* %s) {", 换行)
    ir = 连接(ir, "  %_lp = getelementptr i8, i8* %s, i32 4", 换行)
    ir = 连接(ir, "  %_li = bitcast i8* %_lp to i32*", 换行)
    ir = 连接(ir, "  %_l = load i32, i32* %_li", 换行)
    ir = 连接(ir, "  ret i32 %_l", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_str_as_cstr: 提取字符串原始数据指针(用于C函数)
    ir = 连接(ir, "define i8* @rt_str_as_cstr(i8* %s) {", 换行)
    ir = 连接(ir, "  %_dp = getelementptr i8, i8* %s, i32 8", 换行)
    ir = 连接(ir, "  ret i8* %_dp", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    返回(ir)
}

// 生成列表操作的 LLVM IR 定义（创建、追加、取值、长度、切片等）
定义 生成_列表操作 () {
    设 ir = ""

    // rt_list_new: alloc header(16 bytes) + 4 initial item slots(32 bytes) = 48 bytes
    ir = 连接(ir, "define i8* @rt_list_new() {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %_m = call i8* @_rt_malloc(i32 48)", 换行)
    ir = 连接(ir, "  %_tp = bitcast i8* %_m to i32*", 换行)
    ir = 连接(ir, "  store i32 2, i32* %_tp", 换行)
    ir = 连接(ir, "  %_lp = getelementptr i8, i8* %_m, i32 4", 换行)
    ir = 连接(ir, "  %_li = bitcast i8* %_lp to i32*", 换行)
    ir = 连接(ir, "  store i32 0, i32* %_li", 换行)
    ir = 连接(ir, "  %_cp = getelementptr i8, i8* %_m, i32 8", 换行)
    ir = 连接(ir, "  %_ci = bitcast i8* %_cp to i32*", 换行)
    ir = 连接(ir, "  store i32 4, i32* %_ci", 换行)
    ir = 连接(ir, "  ret i8* %_m", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_list_push_item → 返回可能更新的列表指针
    ir = 连接(ir, "define i8* @rt_list_push_item(i8* %lst, i8* %item) {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %_lp = getelementptr i8, i8* %lst, i32 4", 换行)
    ir = 连接(ir, "  %_li = bitcast i8* %_lp to i32*", 换行)
    ir = 连接(ir, "  %_len = load i32, i32* %_li", 换行)
    ir = 连接(ir, "  %_cp = getelementptr i8, i8* %lst, i32 8", 换行)
    ir = 连接(ir, "  %_ci = bitcast i8* %_cp to i32*", 换行)
    ir = 连接(ir, "  %_cap = load i32, i32* %_ci", 换行)
    ir = 连接(ir, "  %_full = icmp sge i32 %_len, %_cap", 换行)
    ir = 连接(ir, "  br i1 %_full, label %grow, label %append", 换行)
    ir = 连接(ir, "grow:", 换行)
    ir = 连接(ir, "  %_ncap = mul i32 %_cap, 2", 换行)
    ir = 连接(ir, "  %_nbytes = mul i32 %_ncap, 8", 换行)
    ir = 连接(ir, "  %_ntotal = add i32 %_nbytes, 16", 换行)
    ir = 连接(ir, "  %_new = call i8* @_rt_malloc(i32 %_ntotal)", 换行)
    ir = 连接(ir, "  %_ntp = bitcast i8* %_new to i32*", 换行)
    ir = 连接(ir, "  store i32 2, i32* %_ntp", 换行)
    ir = 连接(ir, "  %_nlp = getelementptr i8, i8* %_new, i32 4", 换行)
    ir = 连接(ir, "  %_nli = bitcast i8* %_nlp to i32*", 换行)
    ir = 连接(ir, "  store i32 %_len, i32* %_nli", 换行)
    ir = 连接(ir, "  %_ncp = getelementptr i8, i8* %_new, i32 8", 换行)
    ir = 连接(ir, "  %_nci = bitcast i8* %_ncp to i32*", 换行)
    ir = 连接(ir, "  store i32 %_ncap, i32* %_nci", 换行)
    ir = 连接(ir, "  %_od = icmp sgt i32 %_len, 0", 换行)
    ir = 连接(ir, "  br i1 %_od, label %copy, label %set_ret", 换行)
    ir = 连接(ir, "copy:", 换行)
    ir = 连接(ir, "  %_ci2 = phi i32 [ 0, %grow ], [ %_cni, %copy ]", 换行)
    ir = 连接(ir, "  %_osp = getelementptr i8, i8* %lst, i32 16", 换行)
    ir = 连接(ir, "  %_ospp = bitcast i8* %_osp to i8**", 换行)
    ir = 连接(ir, "  %_ospi = getelementptr i8*, i8** %_ospp, i32 %_ci2", 换行)
    ir = 连接(ir, "  %_ov = load i8*, i8** %_ospi", 换行)
    ir = 连接(ir, "  %_ndp = getelementptr i8, i8* %_new, i32 16", 换行)
    ir = 连接(ir, "  %_ndpp = bitcast i8* %_ndp to i8**", 换行)
    ir = 连接(ir, "  %_ndpi = getelementptr i8*, i8** %_ndpp, i32 %_ci2", 换行)
    ir = 连接(ir, "  store i8* %_ov, i8** %_ndpi", 换行)
    ir = 连接(ir, "  %_cni = add i32 %_ci2, 1", 换行)
    ir = 连接(ir, "  %_cd = icmp slt i32 %_cni, %_len", 换行)
    ir = 连接(ir, "  br i1 %_cd, label %copy, label %free_old", 换行)
    ir = 连接(ir, "free_old:", 换行)
    ir = 连接(ir, "  call void @_rt_free(i8* %lst)", 换行)
    ir = 连接(ir, "  br label %append_new", 换行)
    ir = 连接(ir, "set_ret:", 换行)
    ir = 连接(ir, "  br label %append_new", 换行)
    ir = 连接(ir, "append_new:", 换行)
    ir = 连接(ir, "  %_al = phi i8* [ %_new, %free_old ], [ %_new, %set_ret ]", 换行)
    ir = 连接(ir, "  %_alp = getelementptr i8, i8* %_al, i32 16", 换行)
    ir = 连接(ir, "  %_alpp = bitcast i8* %_alp to i8**", 换行)
    ir = 连接(ir, "  %_alpi = getelementptr i8*, i8** %_alpp, i32 %_len", 换行)
    ir = 连接(ir, "  store i8* %item, i8** %_alpi", 换行)
    ir = 连接(ir, "  %_nlen2 = add i32 %_len, 1", 换行)
    ir = 连接(ir, "  %_alpp2 = getelementptr i8, i8* %_al, i32 4", 换行)
    ir = 连接(ir, "  %_alpi2 = bitcast i8* %_alpp2 to i32*", 换行)
    ir = 连接(ir, "  store i32 %_nlen2, i32* %_alpi2", 换行)
    ir = 连接(ir, "  ret i8* %_al", 换行)
    ir = 连接(ir, "append:", 换行)
    ir = 连接(ir, "  %_ip = getelementptr i8, i8* %lst, i32 16", 换行)
    ir = 连接(ir, "  %_ipp = bitcast i8* %_ip to i8**", 换行)
    ir = 连接(ir, "  %_ipi = getelementptr i8*, i8** %_ipp, i32 %_len", 换行)
    ir = 连接(ir, "  store i8* %item, i8** %_ipi", 换行)
    ir = 连接(ir, "  %_nlen = add i32 %_len, 1", 换行)
    ir = 连接(ir, "  store i32 %_nlen, i32* %_li", 换行)
    ir = 连接(ir, "  ret i8* %lst", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_list_get(list, index)
    ir = 连接(ir, "define i8* @rt_list_get(i8* %lst, i32 %idx) {", 换行)
    ir = 连接(ir, "  %_ip = getelementptr i8, i8* %lst, i32 16", 换行)
    ir = 连接(ir, "  %_ipp = bitcast i8* %_ip to i8**", 换行)
    ir = 连接(ir, "  %_ipi = getelementptr i8*, i8** %_ipp, i32 %idx", 换行)
    ir = 连接(ir, "  %_v = load i8*, i8** %_ipi", 换行)
    ir = 连接(ir, "  ret i8* %_v", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_list_len(list)
    ir = 连接(ir, "define i32 @rt_list_len(i8* %lst) {", 换行)
    ir = 连接(ir, "  %_lp = getelementptr i8, i8* %lst, i32 4", 换行)
    ir = 连接(ir, "  %_li = bitcast i8* %_lp to i32*", 换行)
    ir = 连接(ir, "  %_v = load i32, i32* %_li", 换行)
    ir = 连接(ir, "  ret i32 %_v", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    返回(ir)
}

// 生成字典操作的 LLVM IR 定义（创建、设值、取值、包含、键列表等）
定义 生成_字典操作 () {
    设 ir = ""

    // _rt_str_eq: null-safe, 长度感知, 比较data字段(offset 8)
    ir = 连接(ir, "define i32 @_rt_str_eq(i8* %a, i8* %b) {", 换行)
    ir = 连接(ir, "  %_ns_a = icmp eq i8* %a, null", 换行)
    ir = 连接(ir, "  %_ns_b = icmp eq i8* %b, null", 换行)
    ir = 连接(ir, "  %_ns_or = or i1 %_ns_a, %_ns_b", 换行)
    ir = 连接(ir, "  br i1 %_ns_or, label %_ns_null, label %_ns_ok", 换行)
    ir = 连接(ir, "_ns_null:", 换行)
    ir = 连接(ir, "  %_ns_and = and i1 %_ns_a, %_ns_b", 换行)
    ir = 连接(ir, "  br i1 %_ns_and, label %_ns_ret1, label %_ns_ret0", 换行)
    ir = 连接(ir, "_ns_ret1:", 换行)
    ir = 连接(ir, "  ret i32 1", 换行)
    ir = 连接(ir, "_ns_ret0:", 换行)
    ir = 连接(ir, "  ret i32 0", 换行)
    ir = 连接(ir, "_ns_ok:", 换行)
    ir = 连接(ir, "  %_ns_la = getelementptr i8, i8* %a, i32 4", 换行)
    ir = 连接(ir, "  %_ns_lai = bitcast i8* %_ns_la to i32*", 换行)
    ir = 连接(ir, "  %_ns_lav = load i32, i32* %_ns_lai", 换行)
    ir = 连接(ir, "  %_ns_lb = getelementptr i8, i8* %b, i32 4", 换行)
    ir = 连接(ir, "  %_ns_lbi = bitcast i8* %_ns_lb to i32*", 换行)
    ir = 连接(ir, "  %_ns_lbv = load i32, i32* %_ns_lbi", 换行)
    ir = 连接(ir, "  %_ns_leq = icmp eq i32 %_ns_lav, %_ns_lbv", 换行)
    ir = 连接(ir, "  br i1 %_ns_leq, label %_ns_cmp, label %_ns_ret0b", 换行)
    ir = 连接(ir, "_ns_ret0b:", 换行)
    ir = 连接(ir, "  ret i32 0", 换行)
    ir = 连接(ir, "_ns_cmp:", 换行)
    ir = 连接(ir, "  %_ns_da = getelementptr i8, i8* %a, i32 8", 换行)
    ir = 连接(ir, "  %_ns_db = getelementptr i8, i8* %b, i32 8", 换行)
    ir = 连接(ir, "  br label %_ns_loop", 换行)
    ir = 连接(ir, "_ns_loop:", 换行)
    ir = 连接(ir, "  %_ns_i = phi i32 [ 0, %_ns_cmp ], [ %_ns_in, %_ns_next ]", 换行)
    ir = 连接(ir, "  %_ns_pa = getelementptr i8, i8* %_ns_da, i32 %_ns_i", 换行)
    ir = 连接(ir, "  %_ns_pb = getelementptr i8, i8* %_ns_db, i32 %_ns_i", 换行)
    ir = 连接(ir, "  %_ns_ca = load i8, i8* %_ns_pa", 换行)
    ir = 连接(ir, "  %_ns_cb = load i8, i8* %_ns_pb", 换行)
    ir = 连接(ir, "  %_ns_ne = icmp ne i8 %_ns_ca, %_ns_cb", 换行)
    ir = 连接(ir, "  br i1 %_ns_ne, label %_ns_neq, label %_ns_chk", 换行)
    ir = 连接(ir, "_ns_chk:", 换行)
    ir = 连接(ir, "  %_ns_z = icmp eq i8 %_ns_ca, 0", 换行)
    ir = 连接(ir, "  br i1 %_ns_z, label %_ns_eq, label %_ns_next", 换行)
    ir = 连接(ir, "_ns_next:", 换行)
    ir = 连接(ir, "  %_ns_in = add i32 %_ns_i, 1", 换行)
    ir = 连接(ir, "  %_ns_lt = icmp slt i32 %_ns_in, %_ns_lav", 换行)
    ir = 连接(ir, "  br i1 %_ns_lt, label %_ns_loop, label %_ns_eq", 换行)
    ir = 连接(ir, "_ns_eq:", 换行)
    ir = 连接(ir, "  ret i32 1", 换行)
    ir = 连接(ir, "_ns_neq:", 换行)
    ir = 连接(ir, "  ret i32 0", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_str_find: 查找字符/子串位置，未找到返回-1
    ir = 连接(ir, "define i32 @rt_str_find(i8* %s, i8* %sub) {", 换行)
    ir = 连接(ir, "  %_sp = ptrtoint i8* %s to i64", 换行)
    ir = 连接(ir, "  %_st = and i64 %_sp, 1", 换行)
    ir = 连接(ir, "  %_sc = icmp eq i64 %_st, 0", 换行)
    ir = 连接(ir, "  br i1 %_sc, label %srch, label %fail", 换行)
    ir = 连接(ir, "srch:", 换行)
    ir = 连接(ir, "  %_sp2 = ptrtoint i8* %sub to i64", 换行)
    ir = 连接(ir, "  %_st2 = and i64 %_sp2, 1", 换行)
    ir = 连接(ir, "  %_sc2 = icmp eq i64 %_st2, 0", 换行)
    ir = 连接(ir, "  br i1 %_sc2, label %scan, label %fail", 换行)
    ir = 连接(ir, "scan:", 换行)
    ir = 连接(ir, "  %_sdp = getelementptr i8, i8* %s, i32 8", 换行)
    ir = 连接(ir, "  %_subdp = getelementptr i8, i8* %sub, i32 8", 换行)
    ir = 连接(ir, "  %_slp = getelementptr i8, i8* %s, i32 4", 换行)
    ir = 连接(ir, "  %_sli = bitcast i8* %_slp to i32*", 换行)
    ir = 连接(ir, "  %_slen = load i32, i32* %_sli", 换行)
    ir = 连接(ir, "  %_sublp = getelementptr i8, i8* %sub, i32 4", 换行)
    ir = 连接(ir, "  %_subli = bitcast i8* %_sublp to i32*", 换行)
    ir = 连接(ir, "  %_sublen = load i32, i32* %_subli", 换行)
    ir = 连接(ir, "  %_subc = load i8, i8* %_subdp", 换行)
    ir = 连接(ir, "  br label %scan_loop", 换行)
    ir = 连接(ir, "scan_loop:", 换行)
    ir = 连接(ir, "  %_i = phi i32 [ 0, %scan ], [ %_ni, %scan_cont ]", 换行)
    ir = 连接(ir, "  %_ec = icmp eq i32 %_i, %_slen", 换行)
    ir = 连接(ir, "  br i1 %_ec, label %fail, label %scan_ch", 换行)
    ir = 连接(ir, "scan_ch:", 换行)
    ir = 连接(ir, "  %_spos = getelementptr i8, i8* %_sdp, i32 %_i", 换行)
    ir = 连接(ir, "  %_c = load i8, i8* %_spos", 换行)
    ir = 连接(ir, "  %_match = icmp eq i8 %_c, %_subc", 换行)
    ir = 连接(ir, "  br i1 %_match, label %found, label %scan_cont", 换行)
    ir = 连接(ir, "scan_cont:", 换行)
    ir = 连接(ir, "  %_ni = add i32 %_i, 1", 换行)
    ir = 连接(ir, "  br label %scan_loop", 换行)
    ir = 连接(ir, "found:", 换行)
    ir = 连接(ir, "  ret i32 %_i", 换行)
    ir = 连接(ir, "fail:", 换行)
    ir = 连接(ir, "  ret i32 -1", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_dict_new: header 16 bytes + 4 entries * 16 bytes = 80
    ir = 连接(ir, "define i8* @rt_dict_new() {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %_m = call i8* @_rt_malloc(i32 80)", 换行)
    ir = 连接(ir, "  %_tp = bitcast i8* %_m to i32*", 换行)
    ir = 连接(ir, "  store i32 3, i32* %_tp", 换行)
    ir = 连接(ir, "  %_cp = getelementptr i8, i8* %_m, i32 4", 换行)
    ir = 连接(ir, "  %_ci = bitcast i8* %_cp to i32*", 换行)
    ir = 连接(ir, "  store i32 0, i32* %_ci", 换行)
    ir = 连接(ir, "  %_ap = getelementptr i8, i8* %_m, i32 8", 换行)
    ir = 连接(ir, "  %_ai = bitcast i8* %_ap to i32*", 换行)
    ir = 连接(ir, "  store i32 4, i32* %_ai", 换行)
    ir = 连接(ir, "  ret i8* %_m", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_dict_set(dict, key, val)
    ir = 连接(ir, "define void @rt_dict_set(i8* %d, i8* %key, i8* %val) {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %_cp = getelementptr i8, i8* %d, i32 4", 换行)
    ir = 连接(ir, "  %_ci = bitcast i8* %_cp to i32*", 换行)
    ir = 连接(ir, "  %_cnt = load i32, i32* %_ci", 换行)
    ir = 连接(ir, "  %_app = getelementptr i8, i8* %d, i32 8", 换行)
    ir = 连接(ir, "  %_api = bitcast i8* %_app to i32*", 换行)
    ir = 连接(ir, "  %_cap = load i32, i32* %_api", 换行)
    ir = 连接(ir, "  %_ep = getelementptr i8, i8* %d, i32 16", 换行)
    ir = 连接(ir, "  br label %find", 换行)
    ir = 连接(ir, "find:", 换行)
    ir = 连接(ir, "  %_fi = phi i32 [ 0, %entry ], [ %_fni, %fnext ]", 换行)
    ir = 连接(ir, "  %_fd = icmp slt i32 %_fi, %_cnt", 换行)
    ir = 连接(ir, "  br i1 %_fd, label %cmp, label %not_found", 换行)
    ir = 连接(ir, "cmp:", 换行)
    ir = 连接(ir, "  %_off = mul i32 %_fi, 16", 换行)
    ir = 连接(ir, "  %_kp = getelementptr i8, i8* %_ep, i32 %_off", 换行)
    ir = 连接(ir, "  %_kpp = bitcast i8* %_kp to i8**", 换行)
    ir = 连接(ir, "  %_ek = load i8*, i8** %_kpp", 换行)
    ir = 连接(ir, "  %_eq = call i32 @_rt_str_eq(i8* %_ek, i8* %key)", 换行)
    ir = 连接(ir, "  %_ft = icmp ne i32 %_eq, 0", 换行)
    ir = 连接(ir, "  br i1 %_ft, label %update, label %fnext", 换行)
    ir = 连接(ir, "fnext:", 换行)
    ir = 连接(ir, "  %_fni = add i32 %_fi, 1", 换行)
    ir = 连接(ir, "  br label %find", 换行)
    ir = 连接(ir, "update:", 换行)
    ir = 连接(ir, "  %_uc = add i32 %_off, 8", 换行)
    ir = 连接(ir, "  %_up = getelementptr i8, i8* %_ep, i32 %_uc", 换行)
    ir = 连接(ir, "  %_upp = bitcast i8* %_up to i8**", 换行)
    ir = 连接(ir, "  store i8* %val, i8** %_upp", 换行)
    ir = 连接(ir, "  ret void", 换行)
    ir = 连接(ir, "not_found:", 换行)
    ir = 连接(ir, "  %_full = icmp sge i32 %_cnt, %_cap", 换行)
    ir = 连接(ir, "  br i1 %_full, label %grow, label %append", 换行)
    ir = 连接(ir, "grow:", 换行)
    ir = 连接(ir, "  %_ncap = mul i32 %_cap, 2", 换行)
    ir = 连接(ir, "  %_nbytes = mul i32 %_ncap, 16", 换行)
    ir = 连接(ir, "  %_ntotal = add i32 %_nbytes, 16", 换行)
    ir = 连接(ir, "  %_new = call i8* @_rt_malloc(i32 %_ntotal)", 换行)
    ir = 连接(ir, "  %_ntp = bitcast i8* %_new to i32*", 换行)
    ir = 连接(ir, "  store i32 3, i32* %_ntp", 换行)
    ir = 连接(ir, "  %_nlp = getelementptr i8, i8* %_new, i32 4", 换行)
    ir = 连接(ir, "  %_nli = bitcast i8* %_nlp to i32*", 换行)
    ir = 连接(ir, "  store i32 %_cnt, i32* %_nli", 换行)
    ir = 连接(ir, "  %_ncp = getelementptr i8, i8* %_new, i32 8", 换行)
    ir = 连接(ir, "  %_nci = bitcast i8* %_ncp to i32*", 换行)
    ir = 连接(ir, "  store i32 %_ncap, i32* %_nci", 换行)
    ir = 连接(ir, "  %_od = icmp sgt i32 %_cnt, 0", 换行)
    ir = 连接(ir, "  br i1 %_od, label %copy, label %set_ret", 换行)
    ir = 连接(ir, "copy:", 换行)
    ir = 连接(ir, "  %_ci2 = phi i32 [ 0, %grow ], [ %_cni, %copy ]", 换行)
    ir = 连接(ir, "  %_coff = mul i32 %_ci2, 16", 换行)
    ir = 连接(ir, "  %_csp = getelementptr i8, i8* %_ep, i32 %_coff", 换行)
    ir = 连接(ir, "  %_cspp = bitcast i8* %_csp to i8**", 换行)
    ir = 连接(ir, "  %_ck = load i8*, i8** %_cspp", 换行)
    ir = 连接(ir, "  %_cvo = add i32 %_coff, 8", 换行)
    ir = 连接(ir, "  %_cvp = getelementptr i8, i8* %_ep, i32 %_cvo", 换行)
    ir = 连接(ir, "  %_cvpp = bitcast i8* %_cvp to i8**", 换行)
    ir = 连接(ir, "  %_cv = load i8*, i8** %_cvpp", 换行)
    ir = 连接(ir, "  %_ndp = getelementptr i8, i8* %_new, i32 16", 换行)
    ir = 连接(ir, "  %_ndpo = getelementptr i8, i8* %_ndp, i32 %_coff", 换行)
    ir = 连接(ir, "  %_ndpp = bitcast i8* %_ndpo to i8**", 换行)
    ir = 连接(ir, "  store i8* %_ck, i8** %_ndpp", 换行)
    ir = 连接(ir, "  %_ndvo = add i32 %_coff, 8", 换行)
    ir = 连接(ir, "  %_ndvp = getelementptr i8, i8* %_ndp, i32 %_ndvo", 换行)
    ir = 连接(ir, "  %_ndvpp = bitcast i8* %_ndvp to i8**", 换行)
    ir = 连接(ir, "  store i8* %_cv, i8** %_ndvpp", 换行)
    ir = 连接(ir, "  %_cni = add i32 %_ci2, 1", 换行)
    ir = 连接(ir, "  %_cd = icmp slt i32 %_cni, %_cnt", 换行)
    ir = 连接(ir, "  br i1 %_cd, label %copy, label %free_old", 换行)
    ir = 连接(ir, "free_old:", 换行)
    ir = 连接(ir, "  call void @_rt_free(i8* %d)", 换行)
    ir = 连接(ir, "  br label %append", 换行)
    ir = 连接(ir, "set_ret:", 换行)
    ir = 连接(ir, "  br label %append", 换行)
    ir = 连接(ir, "append:", 换行)
    ir = 连接(ir, "  %_ae = phi i8* [ %_new, %free_old ], [ %_new, %set_ret ], [ %d, %not_found ]", 换行)
    ir = 连接(ir, "  %_acp = getelementptr i8, i8* %_ae, i32 4", 换行)
    ir = 连接(ir, "  %_aci = bitcast i8* %_acp to i32*", 换行)
    ir = 连接(ir, "  %_ac = load i32, i32* %_aci", 换行)
    ir = 连接(ir, "  %_aoff = mul i32 %_ac, 16", 换行)
    ir = 连接(ir, "  %_aep = getelementptr i8, i8* %_ae, i32 16", 换行)
    ir = 连接(ir, "  %_akp = getelementptr i8, i8* %_aep, i32 %_aoff", 换行)
    ir = 连接(ir, "  %_akpp = bitcast i8* %_akp to i8**", 换行)
    ir = 连接(ir, "  store i8* %key, i8** %_akpp", 换行)
    ir = 连接(ir, "  %_avo = add i32 %_aoff, 8", 换行)
    ir = 连接(ir, "  %_avp = getelementptr i8, i8* %_aep, i32 %_avo", 换行)
    ir = 连接(ir, "  %_avpp = bitcast i8* %_avp to i8**", 换行)
    ir = 连接(ir, "  store i8* %val, i8** %_avpp", 换行)
    ir = 连接(ir, "  %_nc = add i32 %_ac, 1", 换行)
    ir = 连接(ir, "  store i32 %_nc, i32* %_aci", 换行)
    ir = 连接(ir, "  ret void", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    // rt_dict_get(dict, key)
    ir = 连接(ir, "define i8* @rt_dict_get(i8* %d, i8* %key) {", 换行)
    ir = 连接(ir, "entry:", 换行)
    ir = 连接(ir, "  %_cp = getelementptr i8, i8* %d, i32 4", 换行)
    ir = 连接(ir, "  %_ci = bitcast i8* %_cp to i32*", 换行)
    ir = 连接(ir, "  %_cnt = load i32, i32* %_ci", 换行)
    ir = 连接(ir, "  %_ep = getelementptr i8, i8* %d, i32 16", 换行)
    ir = 连接(ir, "  br label %find", 换行)
    ir = 连接(ir, "find:", 换行)
    ir = 连接(ir, "  %_fi = phi i32 [ 0, %entry ], [ %_fni, %fnext ]", 换行)
    ir = 连接(ir, "  %_fd = icmp slt i32 %_fi, %_cnt", 换行)
    ir = 连接(ir, "  br i1 %_fd, label %cmp, label %nf", 换行)
    ir = 连接(ir, "cmp:", 换行)
    ir = 连接(ir, "  %_off = mul i32 %_fi, 16", 换行)
    ir = 连接(ir, "  %_kp = getelementptr i8, i8* %_ep, i32 %_off", 换行)
    ir = 连接(ir, "  %_kpp = bitcast i8* %_kp to i8**", 换行)
    ir = 连接(ir, "  %_ek = load i8*, i8** %_kpp", 换行)
    ir = 连接(ir, "  %_eq = call i32 @_rt_str_eq(i8* %_ek, i8* %key)", 换行)
    ir = 连接(ir, "  %_ft = icmp ne i32 %_eq, 0", 换行)
    ir = 连接(ir, "  br i1 %_ft, label %found, label %fnext", 换行)
    ir = 连接(ir, "fnext:", 换行)
    ir = 连接(ir, "  %_fni = add i32 %_fi, 1", 换行)
    ir = 连接(ir, "  br label %find", 换行)
    ir = 连接(ir, "found:", 换行)
    ir = 连接(ir, "  %_vo = add i32 %_off, 8", 换行)
    ir = 连接(ir, "  %_vp = getelementptr i8, i8* %_ep, i32 %_vo", 换行)
    ir = 连接(ir, "  %_vpp = bitcast i8* %_vp to i8**", 换行)
    ir = 连接(ir, "  %_v = load i8*, i8** %_vpp", 换行)
    ir = 连接(ir, "  ret i8* %_v", 换行)
    ir = 连接(ir, "nf:", 换行)
    ir = 连接(ir, "  ret i8* null", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)

    返回(ir)
}

// 生成桩函数的 LLVM IR 定义（未实现的运行时函数占位）
定义 生成_桩函数 () {
    设 ir = ""
    // rt_list_concat
    ir = 连接(ir, "define i8* @rt_list_concat(i8* %a, i8* %b) {", 换行)
    ir = 连接(ir, "  ret i8* %a", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    // rt_list_slice
    ir = 连接(ir, "define i8* @rt_list_slice(i8* %a, i8* %b, i8* %c) {", 换行)
    ir = 连接(ir, "  ret i8* %a", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    // rt_str_substr
    ir = 连接(ir, "define i8* @rt_str_substr(i8* %a, i8* %b, i8* %c) {", 换行)
    ir = 连接(ir, "  ret i8* %a", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    // rt_str_to_list: 字符串→字符列表
    ir = 连接(ir, "define i8* @rt_str_to_list(i8* %a) {", 换行)
    ir = 连接(ir, "  %_s2l_n = icmp eq i8* %a, null", 换行)
    ir = 连接(ir, "  br i1 %_s2l_n, label %_s2l_null, label %_s2l_ok", 换行)
    ir = 连接(ir, "_s2l_null:", 换行)
    ir = 连接(ir, "  %_s2l_e = call i8* @rt_list_new()", 换行)
    ir = 连接(ir, "  ret i8* %_s2l_e", 换行)
    ir = 连接(ir, "_s2l_ok:", 换行)
    ir = 连接(ir, "  %_s2l_lp = getelementptr i8, i8* %a, i32 4", 换行)
    ir = 连接(ir, "  %_s2l_li = bitcast i8* %_s2l_lp to i32*", 换行)
    ir = 连接(ir, "  %_s2l_len = load i32, i32* %_s2l_li", 换行)
    ir = 连接(ir, "  %_s2l_dp = getelementptr i8, i8* %a, i32 8", 换行)
    ir = 连接(ir, "  %_s2l_lst = call i8* @rt_list_new()", 换行)
    ir = 连接(ir, "  br label %_s2l_loop", 换行)
    ir = 连接(ir, "_s2l_loop:", 换行)
    ir = 连接(ir, "  %_s2l_i = phi i32 [ 0, %_s2l_ok ], [ %_s2l_ni, %_s2l_next ]", 换行)
    ir = 连接(ir, "  %_s2l_cur = phi i8* [ %_s2l_lst, %_s2l_ok ], [ %_s2l_nl, %_s2l_next ]", 换行)
    ir = 连接(ir, "  %_s2l_cmp = icmp slt i32 %_s2l_i, %_s2l_len", 换行)
    ir = 连接(ir, "  br i1 %_s2l_cmp, label %_s2l_body, label %_s2l_done", 换行)
    ir = 连接(ir, "_s2l_body:", 换行)
    ir = 连接(ir, "  %_s2l_chp = getelementptr i8, i8* %_s2l_dp, i32 %_s2l_i", 换行)
    ir = 连接(ir, "  %_s2l_ch = load i8, i8* %_s2l_chp", 换行)
    ir = 连接(ir, "  %_s2l_cs = call i8* @rt_str_new(i8* %_s2l_chp, i32 1)", 换行)
    ir = 连接(ir, "  %_s2l_nl = call i8* @rt_list_push_item(i8* %_s2l_cur, i8* %_s2l_cs)", 换行)
    ir = 连接(ir, "  br label %_s2l_next", 换行)
    ir = 连接(ir, "_s2l_next:", 换行)
    ir = 连接(ir, "  %_s2l_ni = add i32 %_s2l_i, 1", 换行)
    ir = 连接(ir, "  br label %_s2l_loop", 换行)
    ir = 连接(ir, "_s2l_done:", 换行)
    ir = 连接(ir, "  ret i8* %_s2l_cur", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    // rt_int_to_str: 整数→字符串(返回常量桩)
    ir = 连接(ir, "define i8* @rt_int_to_str(i8* %v) {", 换行)
    ir = 连接(ir, "  ret i8* null", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    // rt_dict_len: 字典条目数
    ir = 连接(ir, "define i32 @rt_dict_len(i8* %d) {", 换行)
    ir = 连接(ir, "  ret i32 0", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    // rt_dict_keys: 字典键列表
    ir = 连接(ir, "define i8* @rt_dict_keys(i8* %d) {", 换行)
    ir = 连接(ir, "  ret i8* null", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    // rt_str_contains: 字符串包含
    ir = 连接(ir, "define i32 @rt_str_contains(i8* %s, i8* %sub) {", 换行)
    ir = 连接(ir, "  ret i32 0", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    // rt_str_startswith: 前缀判断
    ir = 连接(ir, "define i32 @rt_str_startswith(i8* %s, i8* %p) {", 换行)
    ir = 连接(ir, "  ret i32 0", 换行)
    ir = 连接(ir, "}", 换行)
    ir = 连接(ir, 换行)
    返回(ir)
}

