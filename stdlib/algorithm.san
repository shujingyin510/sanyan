// 常用算法工具库
// 提供排序、搜索、数学算法等

定义 二分查找 （有序列表， 目标值） ｛
    // 在有序列表中二分查找目标值
    设 左 ＝ 0
    设 右 ＝ 表长（有序列表） － 1
    循环 （左 ＜＝ 右） ｛
        设 中 ＝ 向下取整（（左 ＋ 右） ／ 2）
        设 当前值 ＝ 取（有序列表， 中）
        若 （当前值 ＝＝ 目标值） ｛
            返回（中）
        ｝ 再若 （当前值 ＜ 目标值） ｛
            左 ＝ 中 ＋ 1
        ｝ 否则 ｛
            右 ＝ 中 － 1
        ｝
    ｝
    返回（－1）
｝

定义 冒泡排序 （列表） ｛
    // 冒泡排序算法
    设 长度 ＝ 表长（列表）
    设 结果 ＝ 列表（）
    遍历 元素 在 列表 ｛
        列表合（结果， 列表（元素））
    ｝
    遍历 i 从 0 到 长度 － 1 ｛
        遍历 j 从 0 到 长度 － i － 2 ｛
            若 （取（结果， j） ＞ 取（结果， j ＋ 1）） ｛
                设 临时 ＝ 取（结果， j）
                置元素（结果， j， 取（结果， j ＋ 1））
                置元素（结果， j ＋ 1， 临时）
            ｝
        ｝
    ｝
    返回（结果）
｝

定义 选择排序 （列表） ｛
    // 选择排序算法
    设 长度 ＝ 表长（列表）
    设 结果 ＝ 列表（）
    遍历 元素 在 列表 ｛
        列表合（结果， 列表（元素））
    ｝
    遍历 i 从 0 到 长度 － 2 ｛
        设 最小索引 ＝ i
        遍历 j 从 i ＋ 1 到 长度 － 1 ｛
            若 （取（结果， j） ＜ 取（结果， 最小索引）） ｛
                最小索引 ＝ j
            ｝
        ｝
        若 （最小索引 ！＝ i） ｛
            设 临时 ＝ 取（结果， i）
            置元素（结果， i， 取（结果， 最小索引））
            置元素（结果， 最小索引， 临时）
        ｝
    ｝
    返回（结果）
｝

定义 最大公约数 （a， b） ｛
    // 计算两个数的最大公约数
    若 （b ＝＝ 0） ｛
        返回（绝对值（a））
    ｝
    返回（最大公约数（b， a 余 b））
｝

定义 最小公倍数 （a， b） ｛
    // 计算两个数的最小公倍数
    若 （a ＝＝ 0 或 b ＝＝ 0） ｛
        返回（0）
    ｝
    返回（绝对值（a ＊ b） ／ 最大公约数（a， b））
｝

定义 是质数 （n） ｛
    // 检查是否为质数
    若 （n ＜ 2） ｛
        返回（假）
    ｝
    若 （n ＝＝ 2） ｛
        返回（真）
    ｝
    若 （n 余 2 ＝＝ 0） ｛
        返回（假）
    ｝
    设 i ＝ 3
    循环 （i ＊ i ＜＝ n） ｛
        若 （n 余 i ＝＝ 0） ｛
            返回（假）
        ｝
        i ＝ i ＋ 2
    ｝
    返回（真）
｝

定义 质数列表 （n） ｛
    // 生成前n个质数
    设 结果 ＝ 列表（）
    设 候选 ＝ 2
    循环 （表长（结果） ＜ n） ｛
        若 （是质数（候选）） ｛
            列表合（结果， 列表（候选））
        ｝
        候选 ＝ 候选 ＋ 1
    ｝
    返回（结果）
｝

定义 斐波那契 （n） ｛
    // 计算第n个斐波那契数
    若 （n ＜＝ 0） ｛
        返回（0）
    ｝
    若 （n ＝＝ 1） ｛
        返回（1）
    ｝
    设 a ＝ 0
    设 b ＝ 1
    遍历 i 从 2 到 n ｛
        设 临时 ＝ a ＋ b
        a ＝ b
        b ＝ 临时
    ｝
    返回（b）
｝

定义 阶乘 （n） ｛
    // 计算n的阶乘
    若 （n ＜ 0） ｛
        返回（空）
    ｝
    若 （n ＝＝ 0 或 n ＝＝ 1） ｛
        返回（1）
    ｝
    设 结果 ＝ 1
    遍历 i 从 2 到 n ｛
        结果 ＝ 结果 ＊ i
    ｝
    返回（结果）
｝

定义 幂运算 （底数， 指数） ｛
    // 快速幂运算
    若 （指数 ＝＝ 0） ｛
        返回（1）
    ｝
    若 （指数 ＜ 0） ｛
        返回（1 ／ 幂运算（底数， －指数））
    ｝
    设 结果 ＝ 1
    设 基 ＝ 底数
    设 指 ＝ 指数
    循环 （指 ＞ 0） ｛
        若 （指 余 2 ＝＝ 1） ｛
            结果 ＝ 结果 ＊ 基
        ｝
        基 ＝ 基 ＊ 基
        指 ＝ 向下取整（指 ／ 2）
    ｝
    返回（结果）
｝

