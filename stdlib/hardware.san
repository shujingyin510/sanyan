// stdlib/hardware.san — 硬件抽象层
// 提供 GPIO/I2C/SPI 操作的高层接口
// 底层通过 IoT ops（置/读/查）和设备注册实现

// ==================== GPIO 操作 ====================

// GPIO 引脚模式
设 GPIO输入 = "input"
设 GPIO输出 = "output"
设 GPIO上拉 = "pullup"
设 GPIO下拉 = "pulldown"

// GPIO 电平
设 GPIO高 = 真
设 GPIO低 = 假
设 GPIO不确定 = 可能

// 配置 GPIO 引脚模式
定义 GPIO配置(引脚, 模式) {
    设 设备名 = 连接("GPIO_", 转字符串(引脚))
    注册设备(设备名, "mock")
    // 模式通过写入配置寄存器实现
    返回(真)
}

// 读取 GPIO 引脚电平
// 返回：三值（真=高, 假=低, 可能=浮空/不确定）
定义 GPIO读取(引脚) {
    设 设备名 = 连接("GPIO_", 转字符串(引脚))
    返回(读(设备名))
}

// 写入 GPIO 引脚电平
// 参数：引脚号, 电平（真/假）
// 返回：写入状态
定义 GPIO写入(引脚, 电平) {
    设 设备名 = 连接("GPIO_", 转字符串(引脚))
    若 (电平) {
        置(设备名, "开")
    } 否则 {
        置(设备名, "关")
    }
    返回(真)
}

// GPIO 翻转
定义 GPIO翻转(引脚) {
    设 当前 = GPIO读取(引脚)
    若 (等于(当前, 真)) {
        GPIO写入(引脚, 假)
    } 否则 若 (等于(当前, 假)) {
        GPIO写入(引脚, 真)
    } 否则 {
        // 浮空状态，写入低电平
        GPIO写入(引脚, 假)
    }
    返回(真)
}

// GPIO 脉冲（高电平持续指定毫秒）
定义 GPIO脉冲(引脚, 持续时间) {
    GPIO写入(引脚, 真)
    等待(持续时间)
    GPIO写入(引脚, 假)
    返回(真)
}

// ==================== LED 控制 ====================

// LED 初始化
定义 LED初始化(引脚) {
    GPIO配置(引脚, GPIO输出)
    GPIO写入(引脚, 假)  // 默认关闭
    返回(真)
}

// LED 开启
定义 LED开(引脚) {
    GPIO写入(引脚, 真)
    返回(真)
}

// LED 关闭
定义 LED关(引脚) {
    GPIO写入(引脚, 假)
    返回(真)
}

// LED 闪烁
// 参数：引脚, 闪烁次数, 间隔(ms)
定义 LED闪烁(引脚, 次数, 间隔) {
    遍历 i 从 1 到 次数 {
        LED开(引脚)
        等待(间隔)
        LED关(引脚)
        等待(间隔)
    }
    返回(真)
}

// LED 呼吸灯效果（PWM 模拟）
// 参数：引脚, 周期(ms), 亮度步数
定义 LED呼吸(引脚, 周期, 步数) {
    设 步长时间 = 除(周期, 乘(步数, 2))

    // 渐亮
    遍历 i 从 1 到 步数 {
        LED开(引脚)
        等待(步长时间)
        LED关(引脚)
        等待(减(步长时间, 除(乘(i, 步长时间), 步数)))
    }

    // 渐暗
    遍历 i 从 步数 到 1 {
        LED开(引脚)
        等待(步长时间)
        LED关(引脚)
        等待(减(步长时间, 除(乘(i, 步长时间), 步数)))
    }
    返回(真)
}

// ==================== 按钮输入 ====================

// 按钮初始化
定义 按钮初始化(引脚) {
    GPIO配置(引脚, GPIO上拉)
    返回(真)
}

// 读取按钮状态
// 返回：三值（真=按下, 假=未按下, 可能=抖动）
定义 按钮读取(引脚) {
    设 第一次 = GPIO读取(引脚)
    等待(20)  // 消抖
    设 第二次 = GPIO读取(引脚)

    // 两次读取一致才返回确定值
    若 (等于(第一次, 第二次)) {
        返回(第一次)
    }
    // 不一致→抖动，返回不确定
    返回(可能)
}

// 等待按钮按下
定义 按钮等待按下(引脚, 超时) {
    设 开始 = 时间戳()
    循环 (真) {
        设 状态 = 按钮读取(引脚)
        若 (等于(状态, 真)) { 返回(真) }
        若 (大于(减(时间戳(), 开始), 超时)) { 返回(假) }
        等待(50)
    }
    返回(假)
}

// ==================== I2C 总线 ====================

// I2C 配置
定义 I2C配置(总线号, 时钟频率) {
    返回(字典(
        "总线", 总线号,
        "频率", 时钟频率,
        "设备", 字典()
    ))
}

// I2C 扫描总线上的设备
// 返回：设备地址列表
定义 I2C扫描(配置) {
    设 设备列表 = 列表()
    遍历 地址 从 1 到 127 {
        // 尝试读取每个地址
        设 设备名 = 连接("I2C_", 取键(配置, "总线"), "_", 转字符串(地址))
        设 状态 = 读(设备名)
        若 (非(等于(状态, 假))) {
            设备列表 = 列表合(设备列表, 列表(地址))
        }
    }
    返回(设备列表)
}

// I2C 写入字节
定义 I2C写入(配置, 地址, 寄存器, 数据) {
    设 设备名 = 连接("I2C_", 取键(配置, "总线"), "_", 转字符串(地址))
    设 命令 = 列表(寄存器, 数据)
    置(设备名, 转字符串(命令))
    返回(真)
}

// I2C 读取字节
定义 I2C读取(配置, 地址, 寄存器) {
    设 设备名 = 连接("I2C_", 取键(配置, "总线"), "_", 转字符串(地址))
    置(设备名, 连接("REG_", 转字符串(寄存器)))
    返回(读(设备名))
}

// ==================== SPI 总线 ====================

// SPI 配置
定义 SPI配置(总线号, 片选, 时钟频率, 模式) {
    返回(字典(
        "总线", 总线号,
        "片选", 片选,
        "频率", 时钟频率,
        "模式", 模式
    ))
}

// SPI 传输（同时发送和接收）
定义 SPI传输(配置, 发送数据) {
    设 设备名 = 连接("SPI_", 取键(配置, "总线"), "_", 取键(配置, "片选"))
    置(设备名, 转字符串(发送数据))
    返回(读(设备名))
}

// SPI 写入
定义 SPI写入(配置, 数据) {
    设 结果 = SPI传输(配置, 数据)
    返回(非(等于(结果, 假)))
}

// SPI 读取（发送 dummy 数据）
定义 SPI读取(配置, 长度) {
    设 dummy = 列表()
    遍历 i 从 1 到 长度 {
        dummy = 列表合(dummy, 列表(0))
    }
    返回(SPI传输(配置, dummy))
}

// ==================== 传感器抽象 ====================

// 温度传感器（I2C）
定义 温度传感器初始化(配置, 地址) {
    // 配置温度传感器寄存器
    I2C写入(配置, 地址, 0x01, 0x60)  // 配置寄存器
    返回(真)
}

// 读取温度（I2C）
定义 温度传感器读取(配置, 地址) {
    设 高字节 = I2C读取(配置, 地址, 0x00)
    设 低字节 = I2C读取(配置, 地址, 0x01)

    若 (等于(高字节, 假) 或 等于(低字节, 假)) {
        返回(列表(假, 0))  // 读取失败
    }

    // 组合高低字节
    设 原始值 = 加(乘(高字节, 256), 低字节)
    设 温度 = 除(原始值, 256)
    返回(列表(真, 温度))
}

// 超声波测距（GPIO）
定义 超声波测距(触发引脚, 回响引脚) {
    // 发送 10μs 触发脉冲
    GPIO写入(触发引脚, 真)
    等待(0.01)
    GPIO写入(触发引脚, 假)

    // 等待回响信号
    设 开始 = 时间戳()
    循环 (等于(GPIO读取(回响引脚), 假)) {
        若 (大于(减(时间戳(), 开始), 100)) {
            返回(列表(可能, 0))  // 超时，可能超出范围
        }
    }

    // 测量回响持续时间
    设 回响开始 = 时间戳()
    循环 (等于(GPIO读取(回响引脚), 真)) {
        若 (大于(减(时间戳(), 回响开始), 50)) {
            返回(列表(可能, 0))  // 超时
        }
    }
    设 持续时间 = 减(时间戳(), 回响开始)

    // 计算距离（声速 340m/s）
    设 距离 = 除(乘(持续时间, 17), 100)  // cm
    返回(列表(真, 距离))
}

// ==================== 导出 ====================

导出 GPIO配置 GPIO读取 GPIO写入 GPIO翻转 GPIO脉冲
导出 LED初始化 LED开 LED关 LED闪烁 LED呼吸
导出 按钮初始化 按钮读取 按钮等待按下
导出 I2C配置 I2C扫描 I2C写入 I2C读取
导出 SPI配置 SPI传输 SPI写入 SPI读取
导出 温度传感器初始化 温度传感器读取 超声波测距
