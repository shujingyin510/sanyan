// 数学工具库
定义 平方 (x) {
    返回(x * x)
}

定义 立方 (x) {
    返回(x ^ 3)
}

定义 平均值 (a, b) {
    返回((a + b) / 2)
}

定义 阶乘 (n) {
    若 (n <= 1) {
        返回(1)
    }
    返回(n * 阶乘(n - 1))
}

定义 斐波那契 (n) {
    若 (n <= 1) {
        返回(n)
    }
    返回(斐波那契(n - 1) + 斐波那契(n - 2))
}

定义 最大公约数 (a, b) {
    循环 (b != 0) {
        设 t = b
        b = a % b
        a = t
    }
    返回(a)
}

定义 素数判断 (n) {
    若 (n < 2) {
        返回(假)
    }
    遍历 i 从 2 到 (平方根(n)) {
        若 (n % i == 0) {
            返回(假)
        }
    }
    返回(真)
}

定义 圆面积 (半径) {
    返回((22 * 半径 * 半径) / 7)   // 近似π
}