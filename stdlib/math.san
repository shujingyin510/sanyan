// 数学工具库
定义 平方 （x） ｛
    返回（x ＊ x）
｝

定义 立方 （x） ｛
    返回（x ＾ 3）
｝

定义 平均值 （a， b） ｛
    返回（（a ＋ b） ／ 2）
｝

定义 阶乘 （n） ｛
    若 （n ＜＝ 1） ｛
        返回（1）
    ｝
    返回（n ＊ 阶乘（n － 1））
｝

定义 斐波那契 （n） ｛
    若 （n ＜＝ 1） ｛
        返回（n）
    ｝
    返回（斐波那契（n － 1） ＋ 斐波那契（n － 2））
｝

定义 最大公约数 （a， b） ｛
    循环 （b 不等于 0） ｛
        设 t ＝ b
        b ＝ a ％ b
        a ＝ t
    ｝
    返回（a）
｝

定义 素数判断 （n） ｛
    若 （n ＜ 2） ｛
        返回（假）
    ｝
    设 i ＝ 2
    设 limit ＝ 平方根（n）
    循环 （i ＜＝ limit） ｛
        若 （n ％ i 等于 0） ｛
            返回（假）
        ｝
        设 i ＝ i ＋ 1
    ｝
    返回（真）
｝

定义 圆面积 （半径） ｛
    返回（3.1415926 ＊ 半径 ＊ 半径）
｝

定义 最小公倍数(a, b) {
    若 a 等于 0 或 b 等于 0 { 返回 0; }
    返回 绝对值(a 乘 b) 除 最大公约数(a, b);
}

定义 是素数(n) {
    若 n 小于等于 1 { 返回 假; }
    若 n 小于等于 3 { 返回 真; }
    若 n 余 2 等于 0 或 n 余 3 等于 0 { 返回 假; }
    设 i = 5;
    循环 i 乘 i 小于等于 n {
        若 n 余 i 等于 0 或 n 余 (i 加 2) 等于 0 { 返回 假; }
        设 i = i 加 6;
    }
    返回 真;
}

// ==================== 矩阵操作 ====================

// 创建零矩阵（行×列）
定义 矩阵(行, 列) {
    设 m = 列表()
    遍历 i 从 1 到 行 {
        设 row = 列表()
        遍历 j 从 1 到 列 {
            row = 列表合(row, 列表(0))
        }
        m = 列表合(m, 列表(row))
    }
    返回(m)
}

// 获取矩阵元素
定义 矩阵取(m, 行, 列) {
    返回(取(取(m, 行), 列))
}

// 设置矩阵元素（返回新矩阵）
定义 矩阵置(m, 行, 列, 值) {
    设 new_m = 列表()
    遍历 i 从 0 到 减(取长(m), 1) {
        设 new_row = 列表()
        遍历 j 从 0 到 减(取长(取(m, i)), 1) {
            若 (等于(i, 行) 且 等于(j, 列)) {
                new_row = 列表合(new_row, 列表(值))
            } 否则 {
                new_row = 列表合(new_row, 列表(矩阵取(m, i, j)))
            }
        }
        new_m = 列表合(new_m, 列表(new_row))
    }
    返回(new_m)
}

// 矩阵加法
定义 矩阵加(a, b) {
    设 行数 = 取长(a)
    设 列数 = 取长(取(a, 0))
    设 result = 矩阵(行数, 列数)
    遍历 i 从 0 到 减(行数, 1) {
        遍历 j 从 0 到 减(列数, 1) {
            result = 矩阵置(result, i, j, 加(矩阵取(a, i, j), 矩阵取(b, i, j)))
        }
    }
    返回(result)
}

// 矩阵减法
定义 矩阵减(a, b) {
    设 行数 = 取长(a)
    设 列数 = 取长(取(a, 0))
    设 result = 矩阵(行数, 列数)
    遍历 i 从 0 到 减(行数, 1) {
        遍历 j 从 0 到 减(列数, 1) {
            result = 矩阵置(result, i, j, 减(矩阵取(a, i, j), 矩阵取(b, i, j)))
        }
    }
    返回(result)
}

// 矩阵标量乘法
定义 矩阵标量乘(m, 标量) {
    设 行数 = 取长(m)
    设 列数 = 取长(取(m, 0))
    设 result = 矩阵(行数, 列数)
    遍历 i 从 0 到 减(行数, 1) {
        遍历 j 从 0 到 减(列数, 1) {
            result = 矩阵置(result, i, j, 乘(矩阵取(m, i, j), 标量))
        }
    }
    返回(result)
}

// 矩阵乘法
定义 矩阵乘(a, b) {
    设 行数 = 取长(a)
    设 中间 = 取长(取(a, 0))
    设 列数 = 取长(取(b, 0))
    设 result = 矩阵(行数, 列数)
    遍历 i 从 0 到 减(行数, 1) {
        遍历 j 从 0 到 减(列数, 1) {
            设 sum = 0
            遍历 k 从 0 到 减(中间, 1) {
                sum = 加(sum, 乘(矩阵取(a, i, k), 矩阵取(b, k, j)))
            }
            result = 矩阵置(result, i, j, sum)
        }
    }
    返回(result)
}

// 矩阵转置
定义 矩阵转置(m) {
    设 行数 = 取长(m)
    设 列数 = 取长(取(m, 0))
    设 result = 矩阵(列数, 行数)
    遍历 i 从 0 到 减(行数, 1) {
        遍历 j 从 0 到 减(列数, 1) {
            result = 矩阵置(result, j, i, 矩阵取(m, i, j))
        }
    }
    返回(result)
}

// 单位矩阵
定义 单位矩阵(n) {
    设 m = 矩阵(n, n)
    遍历 i 从 0 到 减(n, 1) {
        m = 矩阵置(m, i, i, 1)
    }
    返回(m)
}

// 矩阵行列式（2×2）
定义 行列式2(m) {
    返回(减(
        乘(矩阵取(m, 0, 0), 矩阵取(m, 1, 1)),
        乘(矩阵取(m, 0, 1), 矩阵取(m, 1, 0))
    ))
}

// 矩阵行列式（通用，递归展开）
定义 行列式(m) {
    设 n = 取长(m)
    若 (等于(n, 1)) { 返回(矩阵取(m, 0, 0)) }
    若 (等于(n, 2)) { 返回(行列式2(m)) }
    设 det = 0
    遍历 j 从 0 到 减(n, 1) {
        设 minor = 矩阵()
        遍历 i 从 1 到 减(n, 1) {
            设 row = 列表()
            遍历 k 从 0 到 减(n, 1) {
                若 (不等于(k, j)) {
                    row = 列表合(row, 列表(矩阵取(m, i, k)))
                }
            }
            minor = 列表合(minor, 列表(row))
        }
        设 sign = 1
        若 (不等于(余(j, 2), 0)) { sign = -1 }
        det = 加(det, 乘(乘(sign, 矩阵取(m, 0, j)), 行列式(minor)))
    }
    返回(det)
}

// 矩阵伴随矩阵（用于求逆）
定义 伴随矩阵(m) {
    设 n = 取长(m)
    设 adj = 矩阵(n, n)
    遍历 i 从 0 到 减(n, 1) {
        遍历 j 从 0 到 减(n, 1) {
            // 构造余子式
            设 minor = 矩阵()
            遍历 r 从 0 到 减(n, 1) {
                若 (不等于(r, i)) {
                    设 row = 列表()
                    遍历 c 从 0 到 减(n, 1) {
                        若 (不等于(c, j)) {
                            row = 列表合(row, 列表(矩阵取(m, r, c)))
                        }
                    }
                    minor = 列表合(minor, 列表(row))
                }
            }
            设 sign = 1
            若 (不等于(余(加(i, j), 2), 0)) { sign = -1 }
            adj = 矩阵置(adj, j, i, 乘(sign, 行列式(minor)))
        }
    }
    返回(adj)
}

// 矩阵求逆（使用伴随矩阵法）
定义 矩阵求逆(m) {
    设 det = 行列式(m)
    若 (等于(det, 0)) {
        输出("错误：矩阵不可逆（行列式为0）")
        返回(无)
    }
    设 adj = 伴随矩阵(m)
    设 n = 取长(m)
    设 inv = 矩阵(n, n)
    遍历 i 从 0 到 减(n, 1) {
        遍历 j 从 0 到 减(n, 1) {
            inv = 矩阵置(inv, i, j, 除(矩阵取(adj, i, j), det))
        }
    }
    返回(inv)
}

// ==================== 向量操作 ====================

// 向量点积
定义 向量点积(a, b) {
    设 sum = 0
    遍历 i 从 0 到 减(取长(a), 1) {
        sum = 加(sum, 乘(取(a, i), 取(b, i)))
    }
    返回(sum)
}

// 向量长度（模）
定义 向量长度(v) {
    返回(平方根(向量点积(v, v)))
}

// 向量归一化
定义 向量归一化(v) {
    设 len = 向量长度(v)
    若 (等于(len, 0)) { 返回(v) }
    设 result = 列表()
    遍历 i 从 0 到 减(取长(v), 1) {
        result = 列表合(result, 列表(除(取(v, i), len)))
    }
    返回(result)
}

// 向量叉积（3D）
定义 向量叉积(a, b) {
    返回(列表(
        减(乘(取(a, 1), 取(b, 2)), 乘(取(a, 2), 取(b, 1))),
        减(乘(取(a, 2), 取(b, 0)), 乘(取(a, 0), 取(b, 2))),
        减(乘(取(a, 0), 取(b, 1)), 乘(取(a, 1), 取(b, 0)))
    ))
}

// 向量距离（欧氏距离）
定义 向量距离(a, b) {
    设 sum = 0
    遍历 i 从 0 到 减(取长(a), 1) {
        设 diff = 减(取(a, i), 取(b, i))
        sum = 加(sum, 乘(diff, diff))
    }
    返回(平方根(sum))
}

// ==================== 统计操作 ====================

// 求和
定义 求和(列表) {
    设 sum = 0
    遍历 x 在 列表 {
        sum = 加(sum, x)
    }
    返回(sum)
}

// 均值
定义 均值(列表) {
    若 (等于(取长(列表), 0)) { 返回(0) }
    返回(除(求和(列表), 取长(列表)))
}

// 中位数
定义 中位数(列表) {
    设 sorted = 排序(列表)
    设 n = 取长(sorted)
    若 (等于(余(n, 2), 0)) {
        设 mid = 除(n, 2)
        返回(除(加(取(sorted, 减(mid, 1)), 取(sorted, mid)), 2))
    }
    返回(取(sorted, 除(n, 2)))
}

// 众数（出现次数最多的值）
定义 众数(列表) {
    设 counts = 字典()
    设 max_count = 0
    设 mode = 取(列表, 0)
    遍历 x 在 列表 {
        设 key = 转字符串(x)
        设 c = 0
        若 (字典包含(counts, key)) {
            c = 取键(counts, key)
        }
        c = 加(c, 1)
        置键(counts, key, c)
        若 (大于(c, max_count)) {
            max_count = c
            mode = x
        }
    }
    返回(mode)
}

// 方差
定义 方差(列表) {
    设 avg = 均值(列表)
    设 sum_sq = 0
    遍历 x 在 列表 {
        设 diff = 减(x, avg)
        sum_sq = 加(sum_sq, 乘(diff, diff))
    }
    返回(除(sum_sq, 取长(列表)))
}

// 标准差
定义 标准差(列表) {
    返回(平方根(方差(列表)))
}

// 最大值
定义 最大值(列表) {
    设 max_val = 取(列表, 0)
    遍历 x 在 列表 {
        若 (大于(x, max_val)) { max_val = x }
    }
    返回(max_val)
}

// 最小值
定义 最小值(列表) {
    设 min_val = 取(列表, 0)
    遍历 x 在 列表 {
        若 (小于(x, min_val)) { min_val = x }
    }
    返回(min_val)
}

// 范围（最大值 - 最小值）
定义 范围(列表) {
    返回(减(最大值(列表), 最小值(列表)))
}

// 百分位数
定义 百分位数(列表, p) {
    设 sorted = 排序(列表)
    设 n = 取长(sorted)
    设 idx = 除(乘(p, 减(n, 1)), 100)
    设 lower = 取(sorted, 取整(idx))
    设 upper = 取(sorted, 加(取整(idx), 1))
    设 frac = 减(idx, 取整(idx))
    返回(加(乘(减(1, frac), lower), 乘(frac, upper)))
}

// 四分位数
定义 四分位数(列表) {
    返回(字典(
        "Q1", 百分位数(列表, 25),
        "Q2", 百分位数(列表, 50),
        "Q3", 百分位数(列表, 75)
    ))
}

// 协方差
定义 协方差(x列表, y列表) {
    设 x均 = 均值(x列表)
    设 y均 = 均值(y列表)
    设 sum = 0
    遍历 i 从 0 到 减(取长(x列表), 1) {
        sum = 加(sum, 乘(减(取(x列表, i), x均), 减(取(y列表, i), y均)))
    }
    返回(除(sum, 取长(x列表)))
}

// 相关系数（皮尔逊）
定义 相关系数(x列表, y列表) {
    设 cov = 协方差(x列表, y列表)
    设 sx = 标准差(x列表)
    设 sy = 标准差(y列表)
    若 (等于(乘(sx, sy), 0)) { 返回(0) }
    返回(除(cov, 乘(sx, sy)))
}

// ==================== 概率分布 ====================

// 正态分布概率密度函数
定义 正态密度(x, 均值, 标准差) {
    设 pi = 3.14159265358979
    设 e = 2.71828182845905
    设 系数 = 除(1, 乘(标准差, 平方根(乘(2, pi))))
    设 指数 = 除(乘(-0.5, 平方(除(减(x, 均值), 标准差))), 1)
    返回(乘(系数, e))
}

// 二项分布概率
定义 二项概率(n, k, p) {
    // C(n,k) * p^k * (1-p)^(n-k)
    设 comb = 1
    遍历 i 从 0 到 减(k, 1) {
        comb = 除(乘(comb, 减(n, i)), 加(i, 1))
    }
    返回(乘(乘(comb, 幂(p, k)), 幂(减(1, p), 减(n, k))))
}

// 泊松分布概率
定义 泊松概率(lambda, k) {
    设 e = 2.71828182845905
    返回(除(乘(幂(lambda, k), 幂(e, 负(lambda))), 阶乘(k)))
}
