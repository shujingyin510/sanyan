// 数学工具库
定义 平方 (x) {
    x * x
}

定义 立方 (x) {
    x ^ 3
}

定义 平均值 (a, b) {
    (a + b) / 2
}

定义 圆面积 (半径) {
    22 / 7 * 半径 * 半径
}

定义 斐波那契 (n) {
    若 (n <= 1) {
        返回(n)
    }    // 注意这里没有分号
    设 a = 0
    设 b = 1
    遍历 i 从 2 到 n {
        设 temp = a + b
        a = b
        b = temp
    }
    返回(b)
}