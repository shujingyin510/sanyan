// llvmgen.san V4 — 寄存器线程化

定义 新寄存器 (reg) {
    设 next = 加(reg, 1)
    返回(列表(连接("%", next), next))
}

定义 box (v, reg) {
    设 r = 新寄存器(reg); 设 r1 = 取(r, 0); reg = 取(r, 1)
    设 r = 新寄存器(reg); 设 r2 = 取(r, 0); reg = 取(r, 1)
    设 r = 新寄存器(reg); 设 r3 = 取(r, 0); reg = 取(r, 1)
    设 s = 连接("  ", r1, " = shl i64 ", v, ", 1", 换行)
    s = 连接(s, "  ", r2, " = or i64 ", r1, ", 1", 换行)
    s = 连接(s, "  ", r3, " = inttoptr i64 ", r2, " to i8*", 换行)
    返回(列表(s, r3, reg))
}

定义 unbox (p, reg) {
    设 r = 新寄存器(reg); 设 r1 = 取(r, 0); reg = 取(r, 1)
    设 r = 新寄存器(reg); 设 r2 = 取(r, 0); reg = 取(r, 1)
    设 s = 连接("  ", r1, " = ptrtoint i8* ", p, " to i64", 换行)
    s = 连接(s, "  ", r2, " = ashr i64 ", r1, ", 1", 换行)
    返回(列表(s, r2, reg))
}

定义 header () {
    设 s = "; ModuleID = 'sanyan'"; s = 连接(s, 换行)
    s = 连接(s, "target triple = \"x86_64-pc-linux-gnu\""); s = 连接(s, 换行)
    s = 连接(s, 换行); s = 连接(s, "declare i32 @printf(i8*, ...)"); s = 连接(s, 换行)
    s = 连接(s, 换行)
    s = 连接(s, "@.fmt = private constant [4 x i8] c\"%d\\0a\\00\""); s = 连接(s, 换行)
    s = 连接(s, 换行); s = 连接(s, "define i8* @main() {"); s = 连接(s, 换行)
    s = 连接(s, "entry:"); s = 连接(s, 换行)
    返回(s)
}

定义 footer () {
    返回(连接("  ret i8* null", 换行, "}", 换行))
}

设 换行 = "\n"

定义 parse_int (s) {
    若 (是数字(s)) { 返回(s) }
    设 result = 0
    设 i = 0
    设 len = 取长(s)
    设 neg = 假
    若 (前缀(s, "-")) {
        neg = 真
        i = 1
    }
    设 digs = "0123456789"
    循环 (小于(i, len)) {
        设 ch = 子串(s, i, 1)
        设 idx = 查找(digs, ch)
        若 (小于(idx, 0)) { 返回(0) }
        设 tmp = 乘(result, 10)
        result = 加(tmp, idx)
        i = 加(i, 1)
    }
    若 (neg) { result = 减(0, result) }
    返回(result)
}

定义 编译 (ast, reg) {
    // 字符串 → 尝试转数字
    若 (是字符串(ast)) {
        设 ast = parse_int(ast)
    }
    // 数字 → 字面量
    若 (是数字(ast)) {
        设 n = ast
        设 r = 新寄存器(reg); 设 rn = 取(r, 0); reg = 取(r, 1)
        设 s = 连接("  ", rn, " = add i64 0, ", n, 换行)
        设 bb = box(rn, reg); s = 连接(s, 取(bb, 0)); 设 bv = 取(bb, 1); reg = 取(bb, 2)
        返回(列表(s, bv, reg))
    }

    若 (非(是列表(ast))) {
        返回(列表("", "null", reg))
    }

    设 op = 取(ast, 0)
    设 args = 切片(ast, 1)

    若 (字符串相等(op, "set")) {
        设 name = 取(args, 0)
        设 arg_val = 取(args, 1)
        设 val_r = 编译(arg_val, reg)
        设 s = 取(val_r, 0)
        设 val_reg = 取(val_r, 1)
        reg = 取(val_r, 2)
        设 r = 新寄存器(reg); 设 a = 取(r, 0); reg = 取(r, 1)
        s = 连接(s, "  ", a, " = alloca i8*", 换行)
        s = 连接(s, "  store i8* ", val_reg, ", i8** ", a, 换行)
        返回(列表(s, val_reg, reg))
    }

    若 (字符串相等(op, "add")) {
        设 l_val = 取(args, 0)
        设 r_val = 取(args, 1)
        设 l_r = 编译(l_val, reg)
        设 s = 取(l_r, 0); 设 lv = 取(l_r, 1); reg = 取(l_r, 2)
        设 r_r = 编译(r_val, reg)
        s = 连接(s, 取(r_r, 0)); 设 rv = 取(r_r, 1); reg = 取(r_r, 2)
        设 ub = unbox(lv, reg); s = 连接(s, 取(ub, 0)); 设 l_raw = 取(ub, 1); reg = 取(ub, 2)
        设 ub = unbox(rv, reg); s = 连接(s, 取(ub, 0)); 设 r_raw = 取(ub, 1); reg = 取(ub, 2)
        设 r = 新寄存器(reg); 设 res = 取(r, 0); reg = 取(r, 1)
        s = 连接(s, "  ", res, " = add i64 ", l_raw, ", ", r_raw, 换行)
        设 bb = box(res, reg); s = 连接(s, 取(bb, 0)); 设 bv = 取(bb, 1); reg = 取(bb, 2)
        返回(列表(s, bv, reg))
    }

    若 (字符串相等(op, "print")) {
        设 p_val = 取(args, 0)
        设 v_r = 编译(p_val, reg)
        设 s = 取(v_r, 0); 设 vr = 取(v_r, 1); reg = 取(v_r, 2)
        设 r = 新寄存器(reg); 设 r1 = 取(r, 0); reg = 取(r, 1)
        设 r = 新寄存器(reg); 设 r2 = 取(r, 0); reg = 取(r, 1)
        设 r = 新寄存器(reg); 设 r3 = 取(r, 0); reg = 取(r, 1)
        设 r = 新寄存器(reg); 设 r4 = 取(r, 0); reg = 取(r, 1)
        s = 连接(s, "  ", r1, " = ptrtoint i8* ", vr, " to i64", 换行)
        s = 连接(s, "  ", r2, " = and i64 ", r1, ", 1", 换行)
        s = 连接(s, "  ", r3, " = icmp ne i64 ", r2, ", 0", 换行)
        s = 连接(s, "  br i1 ", r3, ", label %int_", r4, ", label %str_", r4, 换行)
        s = 连接(s, "int_", r4, ":", 换行)
        s = 连接(s, "  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([4 x i8], [4 x i8]* @.fmt, i32 0, i32 0), i64 ", vr, ")", 换行)
        s = 连接(s, "  br label %done_", r4, 换行)
        s = 连接(s, "str_", r4, ":", 换行)
        s = 连接(s, "  call void @rt_print_str(i8* ", vr, ")", 换行)
        s = 连接(s, "  br label %done_", r4, 换行)
        s = 连接(s, "done_", r4, ":", 换行)
        返回(列表(s, vr, reg))
    }

    若 (字符串相等(op, "do")) {
        设 s = ""; 设 last = "null"
        遍历 stmt 在 args {
            设 r = 编译(stmt, reg)
            s = 连接(s, 取(r, 0)); last = 取(r, 1); reg = 取(r, 2)
        }
        返回(列表(s, last, reg))
    }

    返回(列表("", "null", reg))
}

定义 编译顶层 (ast) {
    设 reg = 0
    设 s = header()
    设 r = 编译(ast, reg)
    s = 连接(s, 取(r, 0))
    s = 连接(s, footer())
    返回(s)
}

导出 编译顶层
