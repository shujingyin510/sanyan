;; 日志库 — 结构化日志记录
;;
;; 用法:
;;   导入("stdlib/logging")
;;   日志_初始化("app.log")
;;   日志_信息("应用启动")
;;   日志_警告("磁盘空间不足")
;;   日志_错误("连接失败")
;;   日志_调试("x = 10")

(定义 日志_级别_调试 0)
(定义 日志_级别_信息 1)
(定义 日志_级别_警告 2)
(定义 日志_级别_错误 3)

(定义 日志_当前级别 日志_级别_信息)
(定义 日志_输出文件 "")
(日志_控制台 #t)

(定义 日志_初始化 (文件 级别)
  (做
    (设 日志_输出文件 文件)
    (若 (等于 级别 "调试") (设 日志_当前级别 日志_级别_调试))
    (若 (等于 级别 "信息") (设 日志_当前级别 日志_级别_信息))
    (若 (等于 级别 "警告") (设 日志_当前级别 日志_级别_警告))
    (若 (等于 级别 "错误") (设 日志_当前级别 日志_级别_错误))
    (日志_信息 "日志系统已初始化")))

(定义 日志_格式 (级别 消息)
  (做
    (设 时间 (转字符串 (时间戳)))
    (连接 "[" 时间 "] [" 级别 "] " 消息)))

(定义 日志_写 (格式化消息)
  (做
    (若 日志_控制台 (输出 格式化消息))
    (若 (不等于 日志_输出文件 "")
      (写文件 日志_输出文件 (连接 (读文件 日志_输出文件) 格式化消息 "\n")))
    #t))

(定义 日志_调试 (消息)
  (若 (大于等于 日志_当前级别 日志_级别_调试)
    (日志_写 (日志_格式 "DEBUG" 消息))
    #f))

(定义 日志_信息 (消息)
  (若 (大于等于 日志_当前级别 日志_级别_信息)
    (日志_写 (日志_格式 "INFO" 消息))
    #f))

(定义 日志_警告 (消息)
  (若 (大于等于 日志_当前级别 日志_级别_警告)
    (日志_写 (日志_格式 "WARN" 消息))
    #f))

(定义 日志_错误 (消息)
  (若 (大于等于 日志_当前级别 日志_级别_错误)
    (日志_写 (日志_格式 "ERROR" 消息))
    #f))

(定义 日志_设置级别 (级别)
  (做
    (若 (等于 级别 "调试") (设 日志_当前级别 日志_级别_调试))
    (若 (等于 级别 "信息") (设 日志_当前级别 日志_级别_信息))
    (若 (等于 级别 "警告") (设 日志_当前级别 日志_级别_警告))
    (若 (等于 级别 "错误") (设 日志_当前级别 日志_级别_错误))
    #t))

(定义 日志_关闭控制台 ()
  (设 日志_控制台 #f))

(定义 日志_开启控制台 ()
  (设 日志_控制台 #t))
