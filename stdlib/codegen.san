// stdlib/codegen.san — LLVM 代码生成器
// 从 stdlib/combined.san 拆分
#include "stdlib/parser.san"


// llvmgen.san V4 — 寄存器线程化

定义 新寄存器 (reg) {
    设 id = 新寄存器ID()
    返回(列表(连接("%", id), id))
}

定义 header () {
    设 s = "; ModuleID = 'sanyan'"; s = 连接(s, 换行)
    s = 连接(s, "target triple = \"x86_64-pc-linux-gnu\""); s = 连接(s, 换行)
    s = 连接(s, 换行)
    s = 连接(s, "declare void @san_sys_write(i32, i8*, i32)"); s = 连接(s, 换行)
    s = 连接(s, "declare i8* @_rt_malloc(i32)"); s = 连接(s, 换行)
    s = 连接(s, "declare void @_rt_free(i8*)"); s = 连接(s, 换行)
    s = 连接(s, "declare i8* @san_read_file(i8*, i32*)"); s = 连接(s, 换行)
    s = 连接(s, "declare void @san_write_file(i8*, i8*, i32)"); s = 连接(s, 换行)
    s = 连接(s, "declare i8* @_next_reg_str()"); s = 连接(s, 换行)
    s = 连接(s, "@_rt_buf = global [22 x i8] zeroinitializer"); s = 连接(s, 换行)
    s = 连接(s, 声明运行时())
    s = 连接(s, "@g_error = external global i8*"); s = 连接(s, 换行)
    s = 连接(s, 换行)
    返回(s)
}

定义 footer () {
    返回(连接("  ret i8* null", 换行, "}", 换行))
}

设 换行 = "\n"

设 comp_env = 新字典()          // name → alloca register
设 函数库列表 = 新列表()         // list of function IR strings
设 函数参数表 = 新字典()         // name → param_count (e.g., "%5")

定义 声明运行时 () {
    设 s = "declare i8* @rt_awake(i8* noalias, i8* noalias, i8* noalias, i8* nocapture readonly)" ; s = 连接(s, 换行)
    // rt_list_*, rt_dict_*, rt_print_* 由 生成运行时IR() 提供定义，不需declare
    返回(s)
}

设 字符串常量表 = 新字典()     // string_content → global_name
设 字符串常量列表 = 新列表()   // list of global constant IR strings
设 字符串计数器 = 0

定义 新标签 (prefix) {
    设 id = 新标签ID()
    返回(连接(prefix, id))
}

定义 取字符串常量 (content) {
    设 existing = 查键(字符串常量表, content)
    若 (大于(取长(existing), 0)) {
        返回(existing)
    }
    设 idx = 字典取长(字符串常量表)
    设 name = 连接("@.str.", idx)
    存变量(字符串常量表, content, name)
    返回(name)
}

定义 生成字符串常量定义 () {
    设 result = ""
    设 全部键列表 = 字典键列表(字符串常量表)
    设 k列表长度 = 列表取长(全部键列表)
    设 ki = 0
    设 kc = 加(k列表长度, 1)
    循环 (小于(ki, kc)) {
        若 (小于(ki, k列表长度)) {
            设 content = 取(全部键列表, ki)
            设 name = 查键(字符串常量表, content)
            设 len = 加(取字长(content), 1)
            设 escaped = 转义LLVM字符串(content)
            result = 连接(result, name, " = private constant [", len, " x i8] c\"", escaped, "\\00\"", 换行)
        }
        ki = 加(ki, 1)
    }
    返回(result)
}

定义 parse_int (s) {
    若 (是数字(s)) { 返回(s) }
    设 result = 0
    设 i = 0
    设 len = 取长(s)
    设 neg = 假
    若 (前缀(s, "-")) {
        neg = 真
        i = 1
    }
    设 digs = "0123456789"
    循环 (小于(i, len)) {
        设 ch = 子串(s, i, 1)
        设 idx = 查找(digs, ch)
        若 (小于(idx, 0)) { 返回(0) }
        设 tmp = 乘(result, 10)
        result = 加(tmp, idx)
        i = 加(i, 1)
    }
    若 (neg) { result = 减(0, result) }
    返回(result)
}

定义 是否为数字字符串 (s) {
    若 (非(是字符串(s))) { 返回(假) }
    若 (等于(取长(s), 0)) { 返回(假) }
    设 i = 0; 设 len = 取长(s)
    若 (前缀(s, "-")) { i = 1 }
    若 (等于(i, len)) { 返回(假) }
    设 digs = "0123456789"
    循环 (小于(i, len)) {
        设 ch = 子串(s, i, 1)
        设 idx = 查找(digs, ch)
        若 (小于(idx, 0)) { 返回(假) }
        i = 加(i, 1)
    }
    返回(真)
}

定义 最后一行 (text) {
    设 len = 取长(text)
    若 (等于(len, 0)) { 返回("") }
    设 end = 减(len, 1)
    循环 (end >= 0) {
        设 ch = 子串(text, end, 1)
        若 (非(字符串包含(换行, ch))) { 跳出 }
        end = 减(end, 1)
    }
    若 (end < 0) { 返回("") }
    设 i = end
    循环 (i >= 0) {
        设 ch = 子串(text, i, 1)
        若 (字符串包含(换行, ch)) {
            返回(子串(text, 加(i, 1), 减(end, i)))
        }
        i = 减(i, 1)
    }
    返回(子串(text, 0, 加(end, 1)))
}

定义 不以终止指令结尾 (text) {
    设 last = 最后一行(text)
    若 (等于(取长(last), 0)) { 返回(真) }
    若 (字符串包含(last, "ret")) { 返回(假) }
    若 (字符串包含(last, "br label")) { 返回(假) }
    若 (字符串包含(last, "br i1")) { 返回(假) }
    返回(真)
}

定义 确保终止 (s, merge_label) {
    若 (不以终止指令结尾(s)) {
        s = 连接(s, "  br label %", merge_label, 换行)
    }
    返回(s)
}

定义 编译 (_c_ce, ast, reg) {
    若 (是列表(ast)) {
        设 _c_op = 取(ast, 0)
        设 _c_args = 切片(ast, 1)

    若 (字符串相等(_c_op, "设") 或 字符串相等(_c_op, "set")) {
        设 _c_name = 列表取(_c_args, 0)
        设 _c_arg_val = 列表取(_c_args, 1)
        设 _c_val_r = 编译(_c_ce, _c_arg_val, reg)
        设 _c_s = 列表取(_c_val_r, 0)
        设 _c_val_reg = 列表取(_c_val_r, 1)
        reg = 列表取(_c_val_r, 2)
        // 检查是否为模块级全局变量
        设 _c_gv = 查键(全局变量表, _c_name)
        若 (大于(取长(_c_gv), 0)) {
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** @", _c_gv, 换行)
            返回(列表(_c_s, _c_val_reg, reg))
        }
        设 _c_existing = 查键(_c_ce, _c_name)
        若 (等于(取长(_c_existing), 0)) {
            设 _c_r = 新寄存器(reg); 设 _c_a = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", _c_a, " = alloca i8*", 换行)
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** ", _c_a, 换行)
            存变量(_c_ce, _c_name, _c_a)
        } 否则 {
            设 _c_a = _c_existing
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** ", _c_a, 换行)
        }
        返回(列表(_c_s, _c_val_reg, reg))
    }

    若 (字符串相等(_c_op, "新寄存器ID")) {
        设 _c_r = 新寄存器(reg); 设 rx = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_s = 连接("  ", rx, " = call i8* @_next_reg_str()", 换行)
        返回(列表(_c_s, rx, reg))
    }

    若 (字符串相等(_c_op, "新标签ID")) {
        设 _c_r = 新寄存器(reg); 设 rx = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_s = 连接("  ", rx, " = call i8* @_next_reg_str()", 换行)
        返回(列表(_c_s, rx, reg))
    }

    若 (字符串相等(_c_op, "加") 或 字符串相等(_c_op, "add")) {
        设 _c_l_val = 列表取(_c_args, 0)
        设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = add i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
         返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "减") 或 字符串相等(_c_op, "sub")) {
        设 _c_arg_count = 列表取长(_c_args)
        若 (等于(_c_arg_count, 1)) {
            设 _c_v_val = 列表取(_c_args, 0)
            设 _c_v_r = 编译(_c_ce, _c_v_val, reg)
            设 _c_s = 列表取(_c_v_r, 0); 设 vv = 列表取(_c_v_r, 1); reg = 列表取(_c_v_r, 2)
            设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", vv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_raw = 连接("%", ub_val)
            设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", res, " = sub i64 0, ", _c_raw, 换行)
            设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
            返回(列表(_c_s, _c_bv, reg))
        }
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_arg_count = 列表取长(_c_args)
        若 (等于(_c_arg_count, 1)) {
            // Unary negation: -x → sub 0, x
            设 _c_v_val = 列表取(_c_args, 0)
            设 _c_v_r = 编译(_c_ce, _c_v_val, reg)
            设 _c_s = 列表取(_c_v_r, 0); 设 vv = 列表取(_c_v_r, 1); reg = 列表取(_c_v_r, 2)
            设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", vv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_raw = 连接("%", ub_val)
            设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", res, " = sub i64 0, ", _c_raw, 换行)
            设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
            返回(列表(_c_s, _c_bv, reg))
        }
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = sub i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "乘") 或 字符串相等(_c_op, "mul")) {
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = mul i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "除") 或 字符串相等(_c_op, "div")) {
        设 _c_l_val = 列表取(_c_args, 0); 设 _c_r_val = 列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表取(_c_l_r, 0); 设 lv = 列表取(_c_l_r, 1); reg = 列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表取(_c_r_r, 0)); 设 rv = 列表取(_c_r_r, 1); reg = 列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = sdiv i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
