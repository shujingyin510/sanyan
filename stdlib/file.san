// 文件系统工具库
// 提供文件复制、移动、删除、目录列表、路径处理等操作

定义 存在 （路径） ｛
    // 检查文件或目录是否存在
    尝试 ｛
        设 内容 ＝ 读文件（路径）
        返回（真）
    ｝ 捕获 （错误） ｛
        返回（假）
    ｝
｝

定义 复制 （源路径， 目标路径） ｛
    // 复制文件
    设 内容 ＝ 读文件（源路径）
    写文件（目标路径， 内容）
    返回（真）
｝

定义 追加 （路径， 内容） ｛
    // 追加内容到文件末尾
    设 旧内容 ＝ ""
    尝试 ｛
        旧内容 ＝ 读文件（路径）
    ｝ 捕获 （错误） ｛
        旧内容 ＝ ""
    ｝
    写文件（路径， 连接（旧内容， 内容））
    返回（真）
｝

定义 读行 （路径） ｛
    // 读取文件所有行，返回列表
    设 内容 ＝ 读文件（路径）
    返回（分割（内容， "\n"））
｝

定义 写行 （路径， 行列表） ｛
    // 将行列表写入文件，每行一个
    设 内容 ＝ 合并（行列表， "\n"）
    写文件（路径， 内容）
    返回（真）
｝

定义 文件大小 （路径） ｛
    // 返回文件内容的字符数
    设 内容 ＝ 读文件（路径）
    返回（取长（内容））
｝

// ==================== 路径处理 ====================

定义 路径目录 (路径) {
    // 获取路径的目录部分
    设 最后斜杠 = -1
    设 i = 0
    循环 (i 小于 取长(路径)) {
        设 c = 子串(路径, i, 1)
        若 (c 等于 "/" 或 c 等于 "\\") {
            设 最后斜杠 = i
        }
        设 i = 加(i, 1)
    }
    若 (最后斜杠 小于 0) { 返回(".") }
    返回(子串(路径, 0, 最后斜杠))
}

定义 路径文件名 (路径) {
    // 获取路径的文件名部分
    设 最后斜杠 = -1
    设 i = 0
    循环 (i 小于 取长(路径)) {
        设 c = 子串(路径, i, 1)
        若 (c 等于 "/" 或 c 等于 "\\") {
            设 最后斜杠 = i
        }
        设 i = 加(i, 1)
    }
    若 (最后斜杠 小于 0) { 返回(路径) }
    返回(子串(路径, 加(最后斜杠, 1), 取长(路径)))
}

定义 路径扩展名 (路径) {
    // 获取文件扩展名
    设 文件名 = 路径文件名(路径)
    设 最后点 = -1
    设 i = 0
    循环 (i 小于 取长(文件名)) {
        若 (子串(文件名, i, 1) 等于 ".") {
            设 最后点 = i
        }
        设 i = 加(i, 1)
    }
    若 (最后点 小于 0) { 返回("") }
    返回(子串(文件名, 加(最后点, 1), 取长(文件名)))
}

定义 路径合并 (基础, 相对) {
    // 合并两个路径
    若 (等于(基础, ".")) { 返回(相对) }
    设 尾部 = 子串(基础, 减(取长(基础), 1), 1)
    若 (尾部 等于 "/" 或 尾部 等于 "\\") {
        返回(连接(基础, 相对))
    }
    返回(连接(连接(基础, "/"), 相对))
}

定义 路径绝对化 (路径) {
    // 检查路径是否是绝对路径
    若 (等于(取长(路径), 0)) { 返回(假) }
    设 首字符 = 子串(路径, 0, 1)
    // Unix 绝对路径以 / 开头
    若 (首字符 等于 "/") { 返回(真) }
    // Windows 绝对路径以 X:\ 开头
    若 (大于等于(取长(路径), 3)) {
        若 (子串(路径, 1, 2) 等于 ":\\") { 返回(真) }
    }
    返回(假)
}

// ==================== 文件信息 ====================

定义 文件行数 (路径) {
    // 获取文件行数
    设 行 = 读行(路径)
    返回(取长(行))
}

定义 文件首行 (路径) {
    // 获取文件第一行
    设 行 = 读行(路径)
    若 (等于(取长(行), 0)) { 返回("") }
    返回(取(行, 0))
}

定义 文件末行 (路径) {
    // 获取文件最后一行
    设 行 = 读行(路径)
    若 (等于(取长(行), 0)) { 返回("") }
    返回(取(行, 减(取长(行), 1)))
}

定义 文件搜索 (路径, 关键词) {
    // 在文件中搜索关键词，返回匹配行号列表
    设 行 = 读行(路径)
    设 结果 = 列表()
    遍历 i 从 0 到 减(取长(行), 1) {
        若 (包含(取(行, i), 关键词)) {
            结果 = 列表合(结果, 列表(i))
        }
    }
    返回(结果)
}

定义 文件替换 (路径, 旧文本, 新文本) {
    // 替换文件中的文本
    设 内容 = 读文件(路径)
    设 新内容 = 替换(内容, 旧文本, 新文本)
    写文件(路径, 新内容)
    返回(真)
}
