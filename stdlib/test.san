// 三言测试框架
// 提供断言和测试套件功能
// 使用可变字典存储状态以跨函数调用持久化

// ── 内部状态（可变字典） ──
设 _状态 = 字典("总数", 0, "通过", 0, "失败", 0, "跳过", 0, "套件", "", "setUp", 无, "tearDown", 无)

// ── 断言操作 ──

定义 断言真 (值) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    若 (值) {
        置键(_状态, "通过", 取键(_状态, "通过") + 1)
        返回(真)
    }
    置键(_状态, "失败", 取键(_状态, "失败") + 1)
    输出("  ✗ 断言失败: 期望真，实际为假")
    返回(假)
}

定义 断言假 (值) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    若 (值) {
        置键(_状态, "失败", 取键(_状态, "失败") + 1)
        输出("  ✗ 断言失败: 期望假，实际为真")
        返回(假)
    }
    置键(_状态, "通过", 取键(_状态, "通过") + 1)
    返回(真)
}

定义 断言相等 (实际, 期望) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    若 (实际 等于 期望) {
        置键(_状态, "通过", 取键(_状态, "通过") + 1)
        返回(真)
    }
    置键(_状态, "失败", 取键(_状态, "失败") + 1)
    输出(连接("  ✗ 断言失败: 期望 ", 连接(字符串(期望), 连接("，实际 ", 字符串(实际)))))
    返回(假)
}

定义 断言不等 (实际, 期望) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    若 (实际 不等于 期望) {
        置键(_状态, "通过", 取键(_状态, "通过") + 1)
        返回(真)
    }
    置键(_状态, "失败", 取键(_状态, "失败") + 1)
    输出(连接("  ✗ 断言失败: 期望不等于 ", 连接(字符串(期望), 连接("，但两者相等"))))
    返回(假)
}

定义 断言相等列表 (实际, 期望) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    设 实际长 = 取长(实际)
    设 期望长 = 取长(期望)
    若 (实际长 不等于 期望长) {
        置键(_状态, "失败", 取键(_状态, "失败") + 1)
        输出(连接("  ✗ 列表长度不等: 期望 ", 连接(字符串(期望长), 连接("，实际 ", 字符串(实际长)))))
        返回(假)
    }
    设 i = 0
    设 ok = 真
    循环 (i 小于 实际长) {
        若 (取(实际, i) 不等于 取(期望, i)) {
            置键(_状态, "失败", 取键(_状态, "失败") + 1)
            输出(连接("  ✗ 列表第 ", 连接(字符串(i), " 项不等")))
            设 ok = 假
            设 i = 实际长
        }
        设 i = i + 1
    }
    若 (ok) {
        置键(_状态, "通过", 取键(_状态, "通过") + 1)
    }
    返回(ok)
}

定义 断言包含 (容器, 项) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    若 (包含(容器, 项)) {
        置键(_状态, "通过", 取键(_状态, "通过") + 1)
        返回(真)
    }
    置键(_状态, "失败", 取键(_状态, "失败") + 1)
    输出(连接("  ✗ 断言失败: 容器不包含 ", 字符串(项)))
    返回(假)
}

定义 断言接近 (实际, 期望, 容差) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    设 差 = 实际 - 期望
    若 (差 小于 0) {
        设 差 = 0 - 差
    }
    若 (差 小于 容差) {
        置键(_状态, "通过", 取键(_状态, "通过") + 1)
        返回(真)
    }
    置键(_状态, "失败", 取键(_状态, "失败") + 1)
    输出(连接("  ✗ 断言失败: 期望接近 ", 连接(字符串(期望), 连接("，实际 ", 字符串(实际)))))
    返回(假)
}

定义 断言错误 (函数体, 参数列表) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    尝试 {
        应用(函数体, 参数列表)
        置键(_状态, "失败", 取键(_状态, "失败") + 1)
        输出("  ✗ 断言失败: 期望错误，但未抛出")
        返回(假)
    } 捕获 (错误) {
        置键(_状态, "通过", 取键(_状态, "通过") + 1)
        返回(真)
    }
}

// ── 测试套件 ──

定义 测试套件 (名称) {
    置键(_状态, "套件", 名称)
    置键(_状态, "总数", 0)
    置键(_状态, "通过", 0)
    置键(_状态, "失败", 0)
    置键(_状态, "跳过", 0)
    置键(_状态, "setUp", 无)
    置键(_状态, "tearDown", 无)
    输出(连接("── ", 连接(名称, " ──")))
}

定义 设置前置 (函数体) {
    置键(_状态, "setUp", 函数体)
}

定义 设置后置 (函数体) {
    置键(_状态, "tearDown", 函数体)
}

定义 测试 (名称, 函数体) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    // 执行 setUp
    设 setUp = 取键(_状态, "setUp")
    若 (setUp 不等于 无) {
        尝试 { setUp() } 捕获 (e) {
            输出(连接("  ✗ setUp 失败: ", 字符串(e)))
            置键(_状态, "失败", 取键(_状态, "失败") + 1)
            返回(假)
        }
    }
    // 执行测试
    设 结果 = 假
    尝试 {
        设 结果 = 函数体()
    } 捕获 (e) {
        输出(连接("  ✗ 测试异常: ", 字符串(e)))
        设 结果 = 假
    }
    // 执行 tearDown
    设 tearDown = 取键(_状态, "tearDown")
    若 (tearDown 不等于 无) {
        尝试 { tearDown() } 捕获 (e) {
            输出(连接("  ✗ tearDown 失败: ", 字符串(e)))
        }
    }
    若 (结果) {
        置键(_状态, "通过", 取键(_状态, "通过") + 1)
        输出(连接("  ✓ ", 名称))
    } 否则 {
        置键(_状态, "失败", 取键(_状态, "失败") + 1)
        输出(连接("  ✗ ", 名称))
    }
}

定义 跳过测试 (名称, 原因) {
    置键(_状态, "总数", 取键(_状态, "总数") + 1)
    置键(_状态, "跳过", 取键(_状态, "跳过") + 1)
    输出(连接("  ○ ", 连接(名称, 连接(" (跳过: ", 连接(原因, ")")))))
}

定义 测试报告 () {
    输出("── 测试报告 ──")
    输出(连接("套件: ", 取键(_状态, "套件")))
    输出(连接("总计: ", 字符串(取键(_状态, "总数"))))
    输出(连接("通过: ", 字符串(取键(_状态, "通过"))))
    输出(连接("失败: ", 字符串(取键(_状态, "失败"))))
    设 跳过数 = 取键(_状态, "跳过")
    若 (跳过数 大于 0) {
        输出(连接("跳过: ", 字符串(跳过数)))
    }
    若 (取键(_状态, "失败") 等于 0) {
        输出("全部通过 ✓")
    }
    返回(取键(_状态, "失败") 等于 0)
}

导出 断言真 断言假 断言相等 断言不等 断言相等列表 断言包含 断言接近 断言错误 测试套件 设置前置 设置后置 测试 跳过测试 测试报告
