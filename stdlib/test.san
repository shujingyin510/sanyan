// 三言测试框架
// 提供断言和测试套件功能

// ── 内部状态 ──
设 _测试总数 = 0
设 _通过数 = 0
设 _失败数 = 0
设 _当前套件 = ""

// ── 断言操作 ──

定义 断言真 (值) {
    设 _测试总数 = _测试总数 + 1
    若 (值) {
        设 _通过数 = _通过数 + 1
        返回(真)
    }
    设 _失败数 = _失败数 + 1
    输出("  ✗ 断言失败: 期望真，实际为假")
    返回(假)
}

定义 断言假 (值) {
    设 _测试总数 = _测试总数 + 1
    若 (值) {
        设 _失败数 = _失败数 + 1
        输出("  ✗ 断言失败: 期望假，实际为真")
        返回(假)
    }
    设 _通过数 = _通过数 + 1
    返回(真)
}

定义 断言相等 (实际, 期望) {
    设 _测试总数 = _测试总数 + 1
    若 (实际 等于 期望) {
        设 _通过数 = _通过数 + 1
        返回(真)
    }
    设 _失败数 = _失败数 + 1
    输出(连接("  ✗ 断言失败: 期望 ", 连接(字符串(期望), 连接("，实际 ", 字符串(实际)))))
    返回(假)
}

定义 断言不等 (实际, 期望) {
    设 _测试总数 = _测试总数 + 1
    若 (实际 不等于 期望) {
        设 _通过数 = _通过数 + 1
        返回(真)
    }
    设 _失败数 = _失败数 + 1
    输出(连接("  ✗ 断言失败: 期望不等于 ", 连接(字符串(期望), 连接("，但两者相等"))))
    返回(假)
}

定义 断言相等列表 (实际, 期望) {
    设 _测试总数 = _测试总数 + 1
    设 实际长 = 取长(实际)
    设 期望长 = 取长(期望)
    若 (实际长 不等于 期望长) {
        设 _失败数 = _失败数 + 1
        输出(连接("  ✗ 列表长度不等: 期望 ", 连接(字符串(期望长), 连接("，实际 ", 字符串(实际长)))))
        返回(假)
    }
    设 i = 0
    设 ok = 真
    循环 (i 小于 实际长) {
        若 (取(实际, i) 不等于 取(期望, i)) {
            设 _失败数 = _失败数 + 1
            输出(连接("  ✗ 列表第 ", 连接(字符串(i), " 项不等")))
            设 ok = 假
            设 i = 实际长
        }
        设 i = i + 1
    }
    若 (ok) {
        设 _通过数 = _通过数 + 1
    }
    返回(ok)
}

定义 断言包含 (容器, 项) {
    设 _测试总数 = _测试总数 + 1
    若 (包含(容器, 项)) {
        设 _通过数 = _通过数 + 1
        返回(真)
    }
    设 _失败数 = _失败数 + 1
    输出(连接("  ✗ 断言失败: 容器不包含 ", 字符串(项)))
    返回(假)
}

定义 断言接近 (实际, 期望, 容差) {
    设 _测试总数 = _测试总数 + 1
    设 差 = 实际 - 期望
    若 (差 小于 0) {
        设 差 = 0 - 差
    }
    若 (差 小于 容差) {
        设 _通过数 = _通过数 + 1
        返回(真)
    }
    设 _失败数 = _失败数 + 1
    输出(连接("  ✗ 断言失败: 期望接近 ", 连接(字符串(期望), 连接("，实际 ", 字符串(实际)))))
    返回(假)
}

// ── 测试套件 ──

定义 测试套件 (名称) {
    设 _当前套件 = 名称
    设 _测试总数 = 0
    设 _通过数 = 0
    设 _失败数 = 0
    输出(连接("── ", 连接(名称, " ──")))
}

定义 测试 (名称, 函数体) {
    设 _测试总数 = _测试总数 + 1
    设 结果 = 执行(函数体)
    若 (结果) {
        设 _通过数 = _通过数 + 1
        输出(连接("  ✓ ", 名称))
    }
    输出(连接("  ✗ ", 名称))
}

定义 测试报告 () {
    输出("── 测试报告 ──")
    输出(连接("套件: ", _当前套件))
    输出(连接("总计: ", 字符串(_测试总数)))
    输出(连接("通过: ", 字符串(_通过数)))
    输出(连接("失败: ", 字符串(_失败数)))
    若 (_失败数 等于 0) {
        输出("全部通过 ✓")
    }
    返回(_失败数 等于 0)
}

导出 断言真 断言假 断言相等 断言不等 断言相等列表 断言包含 断言接近 测试套件 测试 测试报告
