／／ 三言测试框架 v2
／／ 用法：
／／   设 test ＝ 导入("stdlib/test.san")
／／   test.测试套件("我的测试")
／／   test.测试("加法测试", 函数() {
／／       test.断言相等(加法(1, 2), 3)
／／   })
／／   test.测试报告()

设 _测试总数 ＝ 0
设 _测试通过 ＝ 0
设 _测试失败 ＝ 0
设 _当前套件 ＝ ""

定义 测试套件 (名称) {
    _当前套件 = 名称
    输出(连接("═══ 测试套件: ", 名称, " ═══"))
}

定义 测试 (名称, 测试函数) {
    _测试总数 = _测试总数 + 1
    输出(连接("  运行: ", 名称))
    尝试 {
        测试函数()
        _测试通过 = _测试通过 + 1
        输出("    [通过]")
    } 捕获 (错误) {
        _测试失败 = _测试失败 + 1
        输出(连接("    [失败] ", 错误))
    }
}

定义 _断言失败 (消息) {
    输出(连接("      ", 消息))
    返回(消息)
}

定义 断言相等 (实际, 期望) {
    若 (实际 不等于 期望) {
        _断言失败(连接("断言失败: 期望 ", 期望, "，但得到 ", 实际))
    }
}

定义 断言不相等 (实际, 不期望) {
    若 (实际 等于 不期望) {
        _断言失败(连接("断言失败: 不应为 ", 不期望, "，但得到了"))
    }
}

定义 断言真 (值) {
    若 (值 不等于 真) {
        _断言失败("断言失败: 期望 真，但得到 假")
    }
}

定义 断言假 (值) {
    若 (值 不等于 假) {
        _断言失败("断言失败: 期望 假，但得到 真")
    }
}

定义 断言包含 (容器, 元素) {
    若 (包含(容器, 元素) 不等于 真) {
        _断言失败(连接("断言失败: 容器不包含 ", 元素))
    }
}

定义 断言大于 (实际, 期望) {
    若 (实际 不大于 期望) {
        _断言失败(连接("断言失败: ", 实际, " 不大于 ", 期望))
    }
}

定义 断言小于 (实际, 期望) {
    若 (实际 不小于 期望) {
        _断言失败(连接("断言失败: ", 实际, " 不小于 ", 期望))
    }
}

定义 断言大于等于 (实际, 期望) {
    若 (实际 小于 期望) {
        _断言失败(连接("断言失败: ", 实际, " 小于 ", 期望))
    }
}

定义 断言小于等于 (实际, 期望) {
    若 (实际 大于 期望) {
        _断言失败(连接("断言失败: ", 实际, " 大于 ", 期望))
    }
}

定义 断言错误 (待测函数, 参数列表) {
    设 抛出异常 = 假
    尝试 {
        应用(待测函数, 参数列表)
    } 捕获 (错误) {
        抛出异常 = 真
    }
    若 (抛出异常 不等于 真) {
        _断言失败("断言失败: 期望抛出异常，但未抛出")
    }
}

定义 测试报告 () {
    输出("")
    输出("═══ 测试报告 ═══")
    输出(连接("总计: ", _测试总数))
    输出(连接("通过: ", _测试通过))
    输出(连接("失败: ", _测试失败))
    若 (_测试失败 等于 0) {
        输出("所有测试通过！")
    } 否则 {
        输出(连接("有 ", _测试失败, " 个测试失败"))
    }
    输出("═══════════════")
    返回(_测试失败 等于 0)
}
