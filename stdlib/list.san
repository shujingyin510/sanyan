// 列表工具库
定义 求和 (lst) {
    归并(函数(a, b) { a + b }, lst)
}

定义 求积 (lst) {
    归并(函数(a, b) { a * b }, lst)
}

定义 反转 (lst) {
    设 result = 列表()
    设 len = 表长(lst)
    遍历 i 从 1 到 len {
        置元素(result, 0, lst(i - 1))
    }
    返回(result)
}

定义 删除 (lst, 索引) {
    // 使用前缀形式的逻辑或
    若 (或(索引 < 0, 索引 >= 表长(lst))) {
        返回(lst)
    }
    设 result = 列表()
    遍历 i 从 0 到 (表长(lst) - 1) {
        若 (i != 索引) {
            置元素(result, 表长(result), lst(i))
        }
    }
    返回(result)
}