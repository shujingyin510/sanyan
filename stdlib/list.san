定义 求和 (lst) {
    返回 (归并(函数(a, b) { a + b }, lst))
}

定义 求积 (lst) {
    返回 (归并(函数(a, b) { a * b }, lst))
}

定义 反转 (lst) {
    设 result = 列表()
    设 len = 表长(lst)
    遍历 i 从 1 到 len {
        设 result = 列表合(result, 列表(lst(len - i)))
    }
    返回(result)
}

定义 去重 (lst) {
    设 result = 列表()
    遍历 i 从 0 到 (表长(lst) - 1) {
        设 元素 = lst(i)
        设 已存在 = 假
        遍历 j 从 0 到 (表长(result) - 1) {
            若 (result(j) == 元素) {
                已存在 = 真
                跳出
            }
        }
        若 (已存在 == 假) {
            设 result = 列表合(result, 列表(元素))
        }
    }
    返回(result)
}

定义 排序 (lst) {
    设 n = 表长(lst)
    遍历 i 从 0 到 (n - 2) {
        遍历 j 从 0 到 (n - i - 2) {
            若 (lst(j) > lst(j + 1)) {
                设 temp = lst(j)
                置元素(lst, j, lst(j + 1))
                置元素(lst, j + 1, temp)
            }
        }
    }
    返回(lst)
}

定义 查找 (lst, 目标) {
    遍历 i 从 0 到 (表长(lst) - 1) {
        若 (lst(i) == 目标) {
            返回(i)
        }
    }
    返回(-1)
}