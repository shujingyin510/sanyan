// 列表工具库
定义 求和 (lst) {
    归并(函数(a, b) { 返回(a + b) }, lst)
}

定义 求积 (lst) {
    归并(函数(a, b) { 返回(a * b) }, lst)
}

定义 反转 (lst) {
    设 result = 列表()
    设 len = 表长(lst)
    遍历 i 从 1 到 len {
        置元素(result, 0, lst(i - 1))
    }
    返回(result)
}

定义 删除 (lst, 索引) {
    若 (或(索引 < 0, 索引 >= 表长(lst))) {
        返回(lst)
    }
    设 result = 列表()
    遍历 i 从 0 到 (表长(lst) - 1) {
        若 (i != 索引) {
            设 元素 = lst(i)
            置元素(result, 表长(result), 元素)
        }
    }
    返回(result)
}

定义 去重 (lst) {
    设 result = 列表()
    遍历 i 从 0 到 (表长(lst) - 1) {
        设 元素 = lst(i)
        设 已存在 = 假
        遍历 j 从 0 到 (表长(result) - 1) {
            若 (result(j) == 元素) {
                已存在 = 真
                返回(假)   // 跳出内循环（无法直接 break，用返回假退出遍历函数，此处逻辑需修复）
            }
        }
        若 (已存在 == 假) {
            置元素(result, 表长(result), 元素)
        }
    }
    返回(result)
}
// 注意：去重函数中 return false 会错误地提前退出函数，此处仅为示意。实际应使用更安全的逻辑。