;; 模板库 — 字符串模板引擎
;;
;; 用法:
;;   导入("stdlib/template")
;;   设 result (模板_渲染 "你好, {{name}}!" (字典 "name" "世界"))
;;   ;; => "你好, 世界!"

(定义 模板_渲染 (模板 变量)
  (做
    (设 结果 模板)
    (设 键列表 (字典键列表 变量))
    (遍历 键 键列表
      (做
        (设 占位符 (连接 "{{" 键 "}}"))
        (设 值 (转字符串 (取键 变量 键)))
        (设 结果 (替换 结果 占位符 值))))
    结果))

(定义 模板_渲染_嵌套 (模板 变量 前缀)
  (做
    (设 结果 模板)
    (设 键列表 (字典键列表 变量))
    (遍历 键 键列表
      (做
        (设 完整键 (若 (等于 前缀 "") 键 (连接 前缀 "." 键)))
        (设 值 (取键 变量 键))
        (若 (是字典 值)
          (设 结果 (模板_渲染_嵌套 结果 值 完整键))
          (做
            (设 占位符 (连接 "{{" 完整键 "}}"))
            (设 结果 (替换 结果 占位符 (转字符串 值)))))))
    结果))

(定义 模板_条件 (模板 条件 内容)
  (若 条件 内容 ""))

(定义 模板_循环 (模板 列表 变量名 渲染函数)
  (做
    (设 结果 "")
    (遍历 项 列表
      (做
        (设 变量 (字典 变量名 项))
        (设 结果 (连接 结果 (渲染函数 变量)))))
    结果))

(定义 模板_默认 (值 默认值)
  (若 (等于 值 无) 默认值 值))

(定义 模板_截断 (文本 最大长度)
  (若 (大于 (取长 文本) 最大长度)
    (连接 (子串 文本 0 最大长度) "...")
    文本))

(定义 模板_填充 (文本 宽度 对齐)
  (做
    (设 长度 (取长 文本))
    (若 (大于等于 长度 宽度)
      文本
      (做
        (设 填充字符 " ")
        (设 填充数量 (- 宽度 长度))
        (设 填充文本 "")
        (循环 (大于 填充数量 0)
          (做
            (设 填充文本 (连接 填充文本 填充字符))
            (设 填充数量 (- 填充数量 1))))
        (若 (等于 对齐 "右")
          (连接 填充文本 文本)
          (连接 文本 填充文本))))))
