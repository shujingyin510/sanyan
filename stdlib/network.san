// stdlib/network.san — 网络通信库
// 提供 TCP/UDP 客户端操作，基于内置 http读/http写 扩展
// 注意：底层网络操作依赖 Python 运行时的 socket 实现

// ==================== 连接状态（三值） ====================
// 连接状态用三值逻辑表示：
//   真 = 已连接
//   假 = 连接失败
//   可能 = 连接中/断开重连

// ==================== TCP 客户端 ====================

// TCP 连接配置
定义 TCP配置(主机, 端口, 超时) {
    返回(字典(
        "协议", "tcp",
        "主机", 主机,
        "端口", 端口,
        "超时", 超时,
        "缓冲区", 4096
    ))
}

// 创建 TCP 客户端（返回配置对象）
定义 TCP客户端(主机, 端口) {
    返回(TCP配置(主机, 端口, 5000))
}

// TCP 发送数据
// 参数：客户端配置, 数据（字符串或字节列表）
// 返回：发送状态（真/假/可能）
定义 TCP发送(客户端, 数据) {
    设 主机 = 取键(客户端, "主机")
    设 端口 = 取键(客户端, "端口")

    // 构造 HTTP 请求模拟 TCP 发送
    // 实际实现需要底层 socket 支持
    尝试 {
        设 url = 连接("http://", 主机, ":", 转字符串(端口))
        设 结果 = http写(url, 数据)
        若 (等于(结果, "") 或 等于(结果, 假)) {
            返回(假)
        }
        返回(真)
    } 捕获 (e) {
        返回(假)
    }
}

// TCP 接收数据
// 参数：客户端配置, 缓冲区大小
// 返回：列表(状态, 数据)
定义 TCP接收(客户端, 缓冲区大小) {
    设 主机 = 取键(客户端, "主机")
    设 端口 = 取键(客户端, "端口")

    尝试 {
        设 url = 连接("http://", 主机, ":", 转字符串(端口))
        设 数据 = http读(url)
        若 (等于(数据, "") 或 等于(数据, 假)) {
            返回(列表(假, ""))
        }
        返回(列表(真, 数据))
    } 捕获 (e) {
        返回(列表(假, ""))
    }
}

// TCP 请求-响应模式
// 参数：客户端配置, 请求数据
// 返回：列表(状态, 响应数据)
定义 TCP请求(客户端, 请求数据) {
    设 发送状态 = TCP发送(客户端, 请求数据)
    若 (非(发送状态)) {
        返回(列表(假, "发送失败"))
    }
    返回(TCP接收(客户端, 4096))
}

// ==================== UDP 客户端 ====================

// UDP 配置
定义 UDP配置(主机, 端口) {
    返回(字典(
        "协议", "udp",
        "主机", 主机,
        "端口", 端口,
        "超时", 3000
    ))
}

// UDP 发送（无连接，fire-and-forget）
// 返回：发送状态（真/假）
定义 UDP发送(配置, 数据) {
    设 主机 = 取键(配置, "主机")
    设 端口 = 取键(配置, "端口")

    尝试 {
        // UDP 通过 HTTP POST 模拟（实际需要底层 socket）
        设 url = 连接("http://", 主机, ":", 转字符串(端口), "/udp")
        设 结果 = http写(url, 数据)
        返回(非(等于(结果, 假)))
    } 捕获 (e) {
        返回(假)
    }
}

// ==================== 连接池 ====================

// 连接池管理
定义 创建连接池(最大连接数) {
    返回(字典(
        "连接", 列表(),
        "最大数", 最大连接数,
        "活跃数", 0
    ))
}

// 从池中获取连接
定义 池获取连接(池, 主机, 端口) {
    设 连接列表 = 取键(池, "连接")
    设 最大数 = 取键(池, "最大数")
    设 活跃数 = 取键(池, "活跃数")

    // 检查是否有可用连接
    若 (大于(活跃数, 0)) {
        // 返回第一个可用连接
        设 conn = 取(连接列表, 0)
        设 剩余 = 切片(连接列表, 1)
        置键(池, "连接", 剩余)
        置键(池, "活跃数", 减(活跃数, 1))
        返回(列表(真, conn))
    }

    // 创建新连接
    若 (小于(活跃数, 最大数)) {
        设 新连接 = TCP客户端(主机, 端口)
        置键(池, "活跃数", 加(活跃数, 1))
        返回(列表(真, 新连接))
    }

    // 池已满
    返回(列表(假, "连接池已满"))
}

// 归还连接到池
定义 池归还连接(池, 连接) {
    设 连接列表 = 取键(池, "连接")
    设 最大数 = 取键(池, "最大数")
    设 活跃数 = 取键(池, "活跃数")

    若 (小于(取长(连接列表), 最大数)) {
        置键(池, "连接", 列表合(连接列表, 列表(连接)))
        返回(真)
    }
    返回(假)  // 池已满，丢弃连接
}

// ==================== 重试机制 ====================

// 带重试的网络操作
// 参数：操作函数, 最大重试次数, 重试间隔(ms)
// 返回：列表(状态, 结果)
定义 重试操作(操作, 最大重试, 间隔) {
    设 尝试次数 = 0
    循环 (小于(尝试次数, 最大重试)) {
        设 结果 = 操作()
        设 状态 = 取(结果, 0)
        若 (等于(状态, 真)) {
            返回(结果)
        }
        尝试次数 = 加(尝试次数, 1)
        若 (小于(尝试次数, 最大重试)) {
            等待(间隔)
        }
    }
    返回(列表(假, "重试次数耗尽"))
}

// ==================== 健康检查 ====================

// 检查服务是否可达
// 返回：三值状态（真=可达, 假=不可达, 可能=响应慢）
定义 健康检查(主机, 端口, 超时) {
    设 客户端 = TCP配置(主机, 端口, 超时)
    设 开始时间 = 时间戳()

    尝试 {
        设 结果 = TCP请求(客户端, "PING")
        设 状态 = 取(结果, 0)
        设 耗时 = 减(时间戳(), 开始时间)

        若 (非(状态)) { 返回(假) }
        若 (大于(耗时, 超时)) { 返回(可能) }  // 响应慢
        返回(真)                                // 正常
    } 捕获 (e) {
        返回(假)
    }
}

// 批量健康检查
// 参数：服务列表（每个元素为 字典("主机", ..., "端口", ...)）
// 返回：字典(服务名 → 状态)
定义 批量健康检查(服务列表) {
    设 结果 = 字典()
    遍历 服务 在 服务列表 {
        设 主机 = 取键(服务, "主机")
        设 端口 = 取键(服务, "端口")
        设 名称 = 取键(服务, "名称")
        设 状态 = 健康检查(主机, 端口, 3000)
        置键(结果, 名称, 状态)
    }
    返回(结果)
}

// ==================== 导出 ====================

导出 TCP客户端 TCP配置 TCP发送 TCP接收 TCP请求
导出 UDP配置 UDP发送
导出 创建连接池 池获取连接 池归还连接
导出 重试操作 健康检查 批量健康检查
