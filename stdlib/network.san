// stdlib/network.san — 网络便捷层（基于内置 http请求 三态信封）
//
// 诚实声明：三言目前没有底层 socket 运行时。本库只提供 HTTP 之上的
// 可达性 / 重试便捷函数。旧版声称的 TCP/UDP「客户端」与「连接池」实为
// HTTP POST 模拟（自注"实际实现需要底层 socket 支持"），v3.57.0 移除——
// 需要真 TCP/UDP 请走 FFI（SANYAN_FFI=1 后 py导入("socket")，见手册 §20）。
//
// 门控：SANYAN_NET=0 全局禁网；本机地址默认被 SSRF 防护封锁，
// 自测成环需 SANYAN_NET_ALLOW_LOCAL=1（见手册 网络算子小节）。

// ==================== 健康检查 ====================

// 检查服务是否可达（GET url）
// 返回三态判：真 = 可达(2xx/3xx)；假 = 不可达/HTTP 错误(4xx/5xx)；
//            可能 = 超时——超时 ≠ 宕机（examples/health_check.san 的论证，
//            这里由 http请求 信封的 判 直接给出，不再靠模拟）
定义 健康检查(url, 超时秒) {
    设 超时秒数 = 超时秒
    设 信封 = http请求("GET", url)
    返回(信封判(信封))
}

// 批量健康检查
// 参数：服务列表（每个元素为 字典("名称", ..., "url", ...)）
// 返回：字典(服务名 → 三态状态)
定义 批量健康检查(服务列表) {
    设 结果 = 字典()
    遍历 服务 在 服务列表 {
        设 名称 = 取键(服务, "名称")
        设 地址 = 取键(服务, "url")
        设 状态 = 健康检查(地址, 5)
        置键(结果, 名称, 状态)
    }
    返回(结果)
}

// ==================== 重试机制 ====================

// 带重试的网络操作
// 参数：操作函数（返回 列表(状态, 结果)）, 最大重试次数, 重试间隔(ms)
// 返回：列表(状态, 结果)
定义 重试操作(操作, 最大重试, 间隔) {
    设 尝试次数 = 0
    循环 (小于(尝试次数, 最大重试)) {
        设 结果 = 操作()
        设 状态 = 取(结果, 0)
        若 (等于(状态, 真)) {
            返回(结果)
        }
        尝试次数 = 加(尝试次数, 1)
        若 (小于(尝试次数, 最大重试)) {
            等待(间隔)
        }
    }
    返回(列表(假, "重试次数耗尽"))
}

// ==================== 导出 ====================

导出 健康检查 批量健康检查 重试操作
