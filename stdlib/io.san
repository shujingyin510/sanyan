// 输入输出工具库
定义 打印行 (s) {
    输出(s)
}

定义 打印格式 (a, b, c) {
    输出(a + b + c)
}

定义 读取文件 (路径) {
    返回(读文件(路径))
}

定义 写入文件 (路径, 内容) {
    写文件(路径, 内容)
    返回(真)
}

定义 追加日志 (路径, 消息) {
    设 旧内容 = ""
    尝试 {
        旧内容 = 读文件(路径)
    } 捕获 (错误) {
        旧内容 = ""
    }
    设 新内容 = 连接(旧内容, 原文{
}, 消息)    // 原文块插入真实换行
    写文件(路径, 新内容)
    输出(消息)
}