// stdlib/sugar.san — 糖语法解析器（Sanyan 版）
// 将糖语法源代码解析为 AST，输出格式与 Python sugar/parser.py 兼容
// 注意：字符串比较必须用 str_equals，不能用 ==

// ==================== 词法分析 ====================

设 空白 = " \n\t\r\u3000"
设 换行符 = "\n"

设 全角映射 = 字典(
    "（", "(", "）", ")", "｛", "{", "｝", "}", "［", "[", "］", "]",
    "＝", "=", "＞", ">", "＜", "<", "＋", "+", "－", "-", "＊", "*", "／", "/",
    "％", "%", "＾", "^", "，", ",", "；", ";", "：", ":", "！", "!",
    "　", " ",
    "０", "0", "１", "1", "２", "2", "３", "3", "４", "4",
    "５", "5", "６", "6", "７", "7", "８", "8", "９", "9",
)

设 字符串开始 = "\"'\u201c\u2018\u300c\u300e"
设 字符串结束 = 字典(
    "\"", "\"", "'", "'",
    "\u201c", "\u201d", "\u2018", "\u2019",
    "\u300c", "\u300d", "\u300e", "\u300f",
)

定义 键取值 (d, key, fallback) {
    尝试 {
        返回(取键(d, key))
    } 捕获 (e) {
        返回(fallback)
    }
}

定义 映射全角 (ch) {
    返回(键取值(全角映射, ch, ch))
}

定义 生成token (类型, 值) {
    返回(列表(类型, 值))
}

定义 词法分析 (source) {
    设 len = 取长(source)
    设 chars = 字列(source)
    设 tokens = 列表()
    设 i = 0

    循环 (i < len) {
        设 c = 取(chars, i)

        // 换行
        若 (str_equals(c, 换行符)) { i = i + 1; 继续 }

        // 空白
        若 (查找(空白, c) >= 0) { i = i + 1; 继续 }

        // 行注释 //, ／／ 或 #
        若 (str_equals(c, "/") 或 str_equals(c, "／") 或 str_equals(c, "#")) {
            设 is_comment = 假
            若 (str_equals(c, "#")) { is_comment = 真 }
            若 (非(is_comment) 且 i + 1 < len) {
                设 nxt = 取(chars, i + 1)
                若 (str_equals(nxt, "/") 或 str_equals(nxt, "／")) { is_comment = 真 }
            }
            若 (is_comment) {
                循环 (i < len 且 非(str_equals(取(chars, i), 换行符))) { i = i + 1 }
                继续
            }
        }

        // 字符串
        若 (查找(字符串开始, c) >= 0) {
            设 quote = c
            设 end_quote = 键取值(字符串结束, c, c)
            设 start = i
            i = i + 1
            循环 (i < len 且 非(str_equals(取(chars, i), end_quote))) {
                若 (str_equals(取(chars, i), "\\")) { i = i + 1 }
                i = i + 1
            }
            若 (i < len) { i = i + 1 }
            设 val = 子串(source, start, i - start)
            tokens = 列表合(tokens, 列表(生成token("字符串", val)))
            继续
        }

        // 全角映射
        设 mapped = 映射全角(c)

        // 符号
        若 (str_equals(mapped, "(") 或 str_equals(mapped, ")") 或
            str_equals(mapped, "{") 或 str_equals(mapped, "}") 或
            str_equals(mapped, "[") 或 str_equals(mapped, "]") 或
            str_equals(mapped, ",") 或 str_equals(mapped, ";") 或
            str_equals(mapped, ":") 或 str_equals(mapped, ".")) {
            tokens = 列表合(tokens, 列表(生成token("符号", mapped)))
            i = i + 1
            继续
        }

        // 运算符
        若 (str_equals(mapped, "=") 或 str_equals(mapped, ">") 或
            str_equals(mapped, "<") 或 str_equals(mapped, "+") 或
            str_equals(mapped, "-") 或 str_equals(mapped, "*") 或
            str_equals(mapped, "/") 或 str_equals(mapped, "%") 或
            str_equals(mapped, "^") 或 str_equals(mapped, "!")) {
            // 合并多字符运算符: >=, <=, !=
            若 (i + 1 < len) {
                设 next_c = 取(chars, i + 1)
                设 next_mapped = 映射全角(next_c)
                若 (str_equals(mapped, ">") 且 str_equals(next_mapped, "=")) {
                    tokens = 列表合(tokens, 列表(生成token("运算符", ">=")))
                    i = i + 2; 继续
                }
                若 (str_equals(mapped, "<") 且 str_equals(next_mapped, "=")) {
                    tokens = 列表合(tokens, 列表(生成token("运算符", "<=")))
                    i = i + 2; 继续
                }
                若 (str_equals(mapped, "!") 且 str_equals(next_mapped, "=")) {
                    tokens = 列表合(tokens, 列表(生成token("运算符", "!=")))
                    i = i + 2; 继续
                }
                若 (str_equals(mapped, "=") 且 str_equals(next_mapped, "=")) {
                    tokens = 列表合(tokens, 列表(生成token("运算符", "==")))
                    i = i + 2; 继续
                }
            }
            tokens = 列表合(tokens, 列表(生成token("运算符", mapped)))
            i = i + 1
            继续
        }

        // 数字（含全角数字）
        设 is_digit = 假
        若 (查找("0123456789", mapped) >= 0) { is_digit = 真 }
        // 处理全角数字
        若 (str_equals(c, "０")) { mapped = "0"; is_digit = 真 }
        若 (str_equals(c, "１")) { mapped = "1"; is_digit = 真 }
        若 (str_equals(c, "２")) { mapped = "2"; is_digit = 真 }
        若 (str_equals(c, "３")) { mapped = "3"; is_digit = 真 }
        若 (str_equals(c, "４")) { mapped = "4"; is_digit = 真 }
        若 (str_equals(c, "５")) { mapped = "5"; is_digit = 真 }
        若 (str_equals(c, "６")) { mapped = "6"; is_digit = 真 }
        若 (str_equals(c, "７")) { mapped = "7"; is_digit = 真 }
        若 (str_equals(c, "８")) { mapped = "8"; is_digit = 真 }
        若 (str_equals(c, "９")) { mapped = "9"; is_digit = 真 }

        若 (is_digit) {
            设 start = i
            i = i + 1
            设 is_float = 假
            循环 (i < len) {
                设 ch = 取(chars, i)
                设 ch_mapped = 映射全角(ch)
                若 (查找("0123456789", ch_mapped) >= 0) { i = i + 1; 继续 }
                若 (str_equals(ch_mapped, ".") 且 非(is_float)) {
                    is_float = 真; i = i + 1; 继续
                }
                跳出
            }
            设 val = 子串(source, start, i - start)
            // 全角数字转为半角
            设 converted = ""
            设 j = 0
            循环 (j < 取长(val)) {
                设 ch = 子串(val, j, 1)
                设 m = 映射全角(ch)
                converted = 连接(converted, m)
                j = j + 1
            }
            设 new_token = 生成token("数字", converted)
            设 token_list = 列表(new_token)
            tokens = 列表合(tokens, token_list)
            继续
        }

        // 标识符 / 单词
        设 start = i
        循环 (i < len) {
            设 ch = 取(chars, i)
            设 is_break = 假
            若 (查找(空白, ch) >= 0) { is_break = 真 }
            若 (查找("(){)}[],;:.", ch) >= 0) { is_break = 真 }
            // 全角符号也作为边界
            若 (查找("（）｛｝［］，；：", ch) >= 0) { is_break = 真 }
            若 (查找("＝＞＜＋－＊／％＾！", ch) >= 0) { is_break = 真 }
            若 (查找(" \n\t\r\u3000", ch) >= 0) { is_break = 真 }
            若 (is_break) { 跳出 }
            i = i + 1
        }
        若 (i > start) {
            设 val = 子串(source, start, i - start)
            tokens = 列表合(tokens, 列表(生成token("标识符", val)))
        }
    }

    返回(tokens)
}

// ==================== 语法分析 ====================

定义 取当前 (tokens) {
    若 (表长(tokens) == 0) { 返回(假) }
    返回(取(tokens, 0))
}

定义 消耗 (tokens, 期望类型, 期望值) {
    设 tok = 取当前(tokens)
    若 (非(是列表(tok))) { 1 / 0 }
    设 ttype = 取(tok, 0)
    设 tval = 取(tok, 1)
    若 (str_equals(ttype, 期望类型) 且 (非(是字符串(期望值)) 或 str_equals(tval, 期望值))) {
        若 (表长(tokens) == 1) { 返回(列表()) }
        返回(切片(tokens, 1))
    }
    1 / 0
}

定义 匹配 (tokens, 期望类型, 期望值) {
    设 tok = 取当前(tokens)
    若 (非(是列表(tok))) { 返回(假) }
    设 ttype = 取(tok, 0)
    设 tval = 取(tok, 1)
    若 (str_equals(ttype, 期望类型) 且 (非(是字符串(期望值)) 或 str_equals(tval, 期望值))) {
        返回(真)
    }
    返回(假)
}

// 解析括号分组 (expr) 或函数调用 fn(expr, ...)
定义 解析主表达式 (tokens) {
    设 tok = 取当前(tokens)
    若 (非(是列表(tok))) { 1 / 0 }

    设 ttype = 取(tok, 0)
    设 tval = 取(tok, 1)

    // 数字
    若 (str_equals(ttype, "数字")) {
        返回(列表(tval, 切片(tokens, 1)))
    }

    // 字符串
    若 (str_equals(ttype, "字符串")) {
        返回(列表(tval, 切片(tokens, 1)))
    }

    // 符号 '(' — 分组或 S 表达式
    若 (str_equals(ttype, "符号") 且 str_equals(tval, "(")) {
        设 rest = 切片(tokens, 1)
        设 result = 解析表达式(rest, 0)
        设 node = 取(result, 0)
        设 rest2 = 取(result, 1)
        rest2 = 消耗(rest2, "符号", ")")
        返回(列表(node, rest2))
    }

    // 匹配表达式: 匹配 expr { pat → body, ... }
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "匹配")) {
        设 rest = 切片(tokens, 1)
        // 解析被匹配的表达式
        设 expr_r = 解析表达式(rest, 0)
        设 expr = 取(expr_r, 0)
        rest = 取(expr_r, 1)
        rest = 消耗(rest, "符号", "{")
        // 收集分支: pat → body
        设 分支列表 = 列表()
        循环 (真) {
            若 (等于(表长(rest), 0)) { 1 / 0 }
            设 check = 取当前(rest)
            若 (是列表(check) 且 str_equals(取(check, 0), "符号") 且 str_equals(取(check, 1), "}")) {
                rest = 切片(rest, 1)
                跳出
            }
            // 解析模式
            设 pat_r = 解析主表达式(rest)
            设 pat = 取(pat_r, 0)
            rest = 取(pat_r, 1)
            // 跳过 →
            rest = 消耗(rest, "标识符", "→")
            // 解析体
            设 body_r = 解析主表达式(rest)
            设 body = 取(body_r, 0)
            rest = 取(body_r, 1)
            分支列表 = 列表合(分支列表, 列表(列表(pat, body)))
            // 跳过逗号
            设 comma = 取当前(rest)
            若 (是列表(comma) 且 str_equals(取(comma, 0), "符号") 且 str_equals(取(comma, 1), ",")) {
                rest = 切片(rest, 1)
            }
        }
        // 构建嵌套 if-else 链
        设 n_branches = 表长(分支列表)
        若 (等于(n_branches, 0)) { 1 / 0 }
        // 从最后一个分支开始逆序构建
        设 result_node = 取(取(分支列表, 减(n_branches, 1)), 1)  // 最后一个body
        设 i = 减(n_branches, 2)
        循环 (i >= 0) {
            设 branch = 取(分支列表, i)
            设 pat_i = 取(branch, 0)
            设 body_i = 取(branch, 1)
            // 检查是否为通配符 _
            若 (是字符串(pat_i) 且 str_equals(pat_i, "_")) {
                result_node = body_i
            } 否则 {
                result_node = 列表("if", 列表("等于", expr, pat_i), body_i, result_node)
            }
            i = 减(i, 1)
        }
        返回(列表(result_node, rest))
    }

    // 符号 '[' — 列表字面量
    若 (str_equals(ttype, "符号") 且 str_equals(tval, "[")) {
        设 rest = 切片(tokens, 1)
        设 elems = 列表()
        循环 (真) {
            若 (匹配(rest, "符号", "]")) {
                rest = 消耗(rest, "符号", "]")
                跳出
            }
            若 (匹配(rest, "符号", ",")) {
                rest = 消耗(rest, "符号", ",")
                继续
            }
            设 r = 解析表达式(rest, 0)
            elems = 列表合(elems, 列表(取(r, 0)))
            rest = 取(r, 1)
        }
        设 node = 列表合(列表("列表"), elems)
        返回(列表(node, rest))
    }

    // 符号 '.' — 错误
    若 (str_equals(ttype, "符号") 且 str_equals(tval, ".")) {
        1 / 0
    }

    // 标识符
    若 (str_equals(ttype, "标识符")) {
        设 rest = 切片(tokens, 1)

        // 匿名函数: 函数(params) { body }
        若 (str_equals(tval, "函数") 且 匹配(rest, "符号", "(")) {
            rest = 消耗(rest, "符号", "(")
            设 params = 列表()
            循环 (真) {
                若 (匹配(rest, "符号", ")")) {
                    rest = 消耗(rest, "符号", ")")
                    跳出
                }
                若 (匹配(rest, "符号", ",")) {
                    rest = 消耗(rest, "符号", ",")
                    继续
                }
                设 p_tok = 取当前(rest)
                若 (非(是列表(p_tok))) { 1 / 0 }
                params = 列表合(params, 列表(取(p_tok, 1)))
                rest = 切片(rest, 1)
            }
            设 body_r = 解析主表达式(rest)
            设 body = 取(body_r, 0)
            rest = 取(body_r, 1)
            返回(列表(列表("函数", params, body), rest))
        }

        // 检查是否是函数调用 fn(...)
        若 (匹配(rest, "符号", "(")) {
            // 消耗 '('
            rest = 消耗(rest, "符号", "(")
            设 args = 列表()
            循环 (真) {
                若 (匹配(rest, "符号", ")")) {
                    rest = 消耗(rest, "符号", ")")
                    跳出
                }
                若 (匹配(rest, "符号", ",")) {
                    rest = 消耗(rest, "符号", ",")
                    继续
                }
                设 r = 解析表达式(rest, 0)
                args = 列表合(args, 列表(取(r, 0)))
                rest = 取(r, 1)
            }
            设 fname = 键取值(函数名映射, tval, tval)
            设 node = 列表合(列表(fname), args)
            返回(列表(node, rest))
        }
        // 点号访问 a.b 或 a.b(...)
        若 (匹配(rest, "符号", ".")) {
            rest = 消耗(rest, "符号", ".")
            设 r = 解析主表达式(rest)
            设 rhs = 取(r, 0)
            rest = 取(r, 1)
            若 (是字符串(rhs)) {
                设 node = 连接(tval, ".", rhs)
                返回(列表(node, rest))
            }
            // a.b(...) — lhs 是列表 ["方法", args...]
            若 (是列表(rhs)) {
                设 method_name = 连接(tval, ".", 取(rhs, 0))
                设 method_args = 切片(rhs, 1)
                设 node = 列表合(列表(method_name), method_args)
                返回(列表(node, rest))
            }
            1 / 0
        }
        返回(列表(tval, rest))
    }

    // 符号 '{' — 代码块
    若 (str_equals(ttype, "符号") 且 str_equals(tval, "{")) {
        设 rest = 切片(tokens, 1)
        设 stmts = 列表()
        循环 (真) {
            若 (匹配(rest, "符号", "}")) {
                rest = 消耗(rest, "符号", "}")
                跳出
            }
            若 (匹配(rest, "符号", ";")) {
                rest = 消耗(rest, "符号", ";")
                继续
            }
            设 r = 解析语句(rest)
            stmts = 列表合(stmts, 列表(取(r, 0)))
            rest = 取(r, 1)
        }
        若 (表长(stmts) == 1) {
            设 node = 取(stmts, 0)
        } 否则 {
            设 node = 列表合(列表("do"), stmts)
        }
        返回(列表(node, rest))
    }

    1 / 0
}

// 运算符优先级
设 前缀运算符 = 列表("-", "!")

// 函数名映射（中文 → 内部英文名）—— 统一为英文AST
设 函数名映射 = 字典(
    "输出", "print", "输入", "input",
    "读", "read", "读取", "read",
    "查", "query", "查询", "query",
    "置", "write", "写入", "write",
    "等待", "sleep",
    "导入", "import",
    // 算术
    "加", "add", "减", "sub", "乘", "mul", "除", "div",
    // 比较
    "小于", "lt", "大于", "gt", "等于", "eq",
    "不大于", "lte", "不小于", "gte",
    // 列表/字典
    "取", "get", "取长", "len", "取键", "get_key", "置键", "set_key",
    // 字符串
    "连接", "concat", "子串", "substr", "包含", "contains",
    // 类型
    "是数字", "is_number", "是字符串", "is_string", "是列表", "is_list",
    "非", "not",
)

设 运算符映射 = 字典(
    "+", "add", "-", "sub", "*", "mul", "/", "div", "%", "mod", "^", "pow",
    ">", "gt", "<", "lt", ">=", "gte", "<=", "lte",
    "=", "eq", "!=", "ne", "==", "eq", "!", "非",
)

定义 映射运算符 (op) {
    返回(键取值(运算符映射, op, op))
}

定义 获取优先级 (op) {
    若 (str_equals(op, ".")) { 返回(80) }
    若 (str_equals(op, "!") 或 str_equals(op, "非") 或 str_equals(op, "not")) { 返回(70) }
    若 (str_equals(op, "^") 或 str_equals(op, "pow")) { 返回(70) }
    若 (str_equals(op, "*") 或 str_equals(op, "/") 或 str_equals(op, "%") 或
        str_equals(op, "mul") 或 str_equals(op, "div") 或 str_equals(op, "mod")) { 返回(60) }
    若 (str_equals(op, "+") 或 str_equals(op, "-") 或
        str_equals(op, "add") 或 str_equals(op, "sub")) { 返回(50) }
    若 (str_equals(op, ">") 或 str_equals(op, "<") 或
        str_equals(op, ">=") 或 str_equals(op, "<=") 或
        str_equals(op, "gt") 或 str_equals(op, "lt") 或
        str_equals(op, "gte") 或 str_equals(op, "lte")) { 返回(40) }
    若 (str_equals(op, "=") 或 str_equals(op, "!=") 或 str_equals(op, "==") 或
        str_equals(op, "eq") 或 str_equals(op, "ne")) { 返回(30) }
    若 (str_equals(op, "and")) { 返回(20) }
    若 (str_equals(op, "or")) { 返回(10) }
    返回(0)
}

定义 解析表达式 (tokens, 最小优先级) {
    设 tok = 取当前(tokens)
    若 (非(是列表(tok))) { 1 / 0 }

    设 ttype = 取(tok, 0)
    设 tval = 取(tok, 1)

    // 前缀运算符
    若 (str_equals(ttype, "运算符") 且 包含(前缀运算符, tval)) {
        设 rest = 切片(tokens, 1)
        设 r = 解析表达式(rest, 70)
        设 mapped = 映射运算符(tval)
        设 node = 列表(mapped, 取(r, 0))
        rest = 取(r, 1)
        返回(列表(node, rest))
    }

    // 主表达式
    设 result = 解析主表达式(tokens)
    设 left = 取(result, 0)
    设 rest = 取(result, 1)

    // 处理管道 |> 运算符
    循环 (真) {
        若 (等于(表长(rest), 0)) { 跳出 }
        设 ptok = 取当前(rest)
        若 (非(是列表(ptok))) { 跳出 }
        设 ptype = 取(ptok, 0)
        设 pval = 取(ptok, 1)
        若 (非(str_equals(ptype, "标识符") 且 str_equals(pval, "|>"))) { 跳出 }
        rest = 切片(rest, 1)
        若 (等于(表长(rest), 0)) { 跳出 }
        // 解析右侧: 标识符 可选后跟 (...)
        设 rtok = 取当前(rest)
        若 (非(是列表(rtok))) { 跳出 }
        若 (str_equals(取(rtok, 0), "标识符")) {
            设 fn_name = 取(rtok, 1)
            rest = 切片(rest, 1)
            设 ptok2 = 取当前(rest)
            若 (是列表(ptok2) 且 str_equals(取(ptok2, 0), "符号") 且 str_equals(取(ptok2, 1), "(")) {
                rest = 切片(rest, 1)
                设 call_args = 列表(left)
                循环 (真) {
                    若 (等于(表长(rest), 0)) { 跳出 }
                    设 ctok = 取当前(rest)
                    若 (非(是列表(ctok))) { 跳出 }
                    若 (str_equals(取(ctok, 0), "符号") 且 str_equals(取(ctok, 1), ")")) {
                        rest = 切片(rest, 1)
                        跳出
                    }
                    设 check_comma = 取当前(rest)
                    若 (是列表(check_comma) 且 str_equals(取(check_comma, 0), "符号") 且 str_equals(取(check_comma, 1), ",")) {
                        rest = 切片(rest, 1)
                    }
                    设 arg_r = 解析表达式(rest, 0)
                    call_args = 列表合(call_args, 列表(取(arg_r, 0)))
                    rest = 取(arg_r, 1)
                }
                left = 列表合(列表(fn_name), call_args)
            } 否则 {
                left = 列表(fn_name, left)
            }
        } 否则 {
            跳出
        }
    }

    // 处理中缀运算符
    循环 (真) {
        设 tok2 = 取当前(rest)
        若 (非(是列表(tok2))) { 跳出 }
        设 ttype2 = 取(tok2, 0)
        设 tval2 = 取(tok2, 1)
        设 is_op = 假

        若 (str_equals(ttype2, "运算符") 或
             (str_equals(ttype2, "标识符") 且
              (str_equals(tval2, "and") 或 str_equals(tval2, "or") 或
               str_equals(tval2, "非") 或 str_equals(tval2, "eq") 或
               str_equals(tval2, "ne") 或 str_equals(tval2, "gt") 或
               str_equals(tval2, "lt") 或 str_equals(tval2, "gte") 或
               str_equals(tval2, "lte") 或 str_equals(tval2, "不大于") 或
               str_equals(tval2, "不小于") 或 str_equals(tval2, "同") 或
               str_equals(tval2, "add") 或 str_equals(tval2, "sub") 或
               str_equals(tval2, "mul") 或 str_equals(tval2, "div") 或
               str_equals(tval2, "mod") 或 str_equals(tval2, "pow")))) {
             is_op = 真
        }

        若 (非(is_op)) {
            // 索引访问 a[i]
            若 (str_equals(ttype2, "符号") 且 str_equals(tval2, "[")) {
                rest = 切片(rest, 1)
                设 idx_r = 解析表达式(rest, 0)
                设 idx = 取(idx_r, 0)
                rest = 取(idx_r, 1)
                rest = 消耗(rest, "符号", "]")
                left = 列表("取", left, idx)
                继续
            }
            跳出
        }

        设 prec = 获取优先级(tval2)
        若 (prec < 最小优先级) { 跳出 }

        rest = 切片(rest, 1)

        // 特殊处理 '='
        若 (str_equals(tval2, "=")) {
            // a = b → ["设", a, b]
            设 r = 解析表达式(rest, prec)
            left = 列表("set", left, 取(r, 0))
            rest = 取(r, 1)
            继续
        }

        设 r = 解析表达式(rest, prec + 1)
        设 right = 取(r, 0)
        rest = 取(r, 1)
        设 mapped_op = 映射运算符(tval2)
        left = 列表(mapped_op, left, right)
    }

    返回(列表(left, rest))
}

定义 解析语句 (tokens) {
    设 tok = 取当前(tokens)
    若 (非(是列表(tok))) { 返回(列表(假, 列表())) }

    设 ttype = 取(tok, 0)
    设 tval = 取(tok, 1)

    // 若 ... { ... } 否则 { ... }
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "若")) {
        设 rest = 切片(tokens, 1)
        设 cond_r = 解析表达式(rest, 0)
        设 cond = 取(cond_r, 0)
        rest = 取(cond_r, 1)
        设 then_r = 解析主表达式(rest)
        设 then_body = 取(then_r, 0)
        rest = 取(then_r, 1)

        设 else_body = 假
        // 处理 再若 (elif) → 构造嵌套 if
        若 (匹配(rest, "标识符", "再若")) {
            rest = 消耗(rest, "标识符", "再若")
            设 elif_r = 解析表达式(rest, 0)
            设 elif_cond = 取(elif_r, 0)
            rest = 取(elif_r, 1)
            设 elif_body_r = 解析主表达式(rest)
            设 elif_body = 取(elif_body_r, 0)
            rest = 取(elif_body_r, 1)
            else_body = 列表("if", elif_cond, elif_body)
            // 检查再若/否则后缀
            若 (匹配(rest, "标识符", "否则")) {
                rest = 消耗(rest, "标识符", "否则")
                设 el_r = 解析主表达式(rest)
                设 el_body = 取(el_r, 0)
                rest = 取(el_r, 1)
                else_body = 列表合(else_body, 列表(el_body))
            }
        } 否则 若 (匹配(rest, "标识符", "否则")) {
            rest = 消耗(rest, "标识符", "否则")
            若 (匹配(rest, "标识符", "若")) {
                设 r = 解析语句(rest)
                else_body = 取(r, 0)
                rest = 取(r, 1)
            } 否则 {
                设 else_r = 解析主表达式(rest)
                else_body = 取(else_r, 0)
                rest = 取(else_r, 1)
            }
        }

        设 node = 列表("if", cond, then_body)
        若 (是列表(else_body)) { node = 列表合(node, 列表(else_body)) }
        返回(列表(node, rest))
    }

    // 循环 (cond) { body }
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "循环")) {
        设 rest = 切片(tokens, 1)
        设 cond_r = 解析表达式(rest, 0)
        设 cond = 取(cond_r, 0)
        rest = 取(cond_r, 1)
        设 body_r = 解析主表达式(rest)
        设 body = 取(body_r, 0)
        rest = 取(body_r, 1)
        返回(列表(列表("loop", cond, body), rest))
    }

    // 遍历 var 从 start 到 end { body }  或  遍历 var 在 container { body }
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "遍历")) {
        设 rest = 切片(tokens, 1)
        设 name_tok = 取当前(rest)
        若 (非(是列表(name_tok))) { 1 / 0 }
        设 var_name = 取(name_tok, 1)
        rest = 切片(rest, 1)

        // 遍历 var 在 container { body }
        若 (匹配(rest, "标识符", "在")) {
            rest = 消耗(rest, "标识符", "在")
            设 container_r = 解析表达式(rest, 0)
            设 container = 取(container_r, 0)
            rest = 取(container_r, 1)
            设 body_r = 解析主表达式(rest)
            设 body = 取(body_r, 0)
            rest = 取(body_r, 1)
            返回(列表(列表("forin", var_name, container, body), rest))
        }

        // 遍历 var 从 start 到 end { body }
        // 可选的 从
        若 (匹配(rest, "标识符", "从")) { rest = 消耗(rest, "标识符", "从") }

        设 start_r = 解析表达式(rest, 0)
        设 start_ast = 取(start_r, 0)
        rest = 取(start_r, 1)

        // 可选的 到
        若 (匹配(rest, "标识符", "到")) { rest = 消耗(rest, "标识符", "到") }

        设 end_r = 解析表达式(rest, 0)
        设 end_ast = 取(end_r, 0)
        rest = 取(end_r, 1)

        设 body_r = 解析主表达式(rest)
        设 body = 取(body_r, 0)
        rest = 取(body_r, 1)
        返回(列表(列表("for", var_name, start_ast, end_ast, body), rest))
    }

    // 设 x = val
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "设")) {
        设 rest = 切片(tokens, 1)
        设 name_tok = 取当前(rest)
        若 (非(是列表(name_tok))) { 1 / 0 }
        设 name = 取(name_tok, 1)
        rest = 切片(rest, 1)

        // 检查 '='
        若 (匹配(rest, "运算符", "=")) {
            rest = 消耗(rest, "运算符", "=")
        }

        设 val_r = 解析表达式(rest, 0)
        设 val = 取(val_r, 0)
            返回(列表(列表("set", name, val), 取(val_r, 1)))
    }

    // 置 设备 = 状态
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "置")) {
        设 rest = 切片(tokens, 1)
        设 name_tok = 取当前(rest)
        若 (非(是列表(name_tok))) { 1 / 0 }
        设 name = 连接("\"", 取(name_tok, 1), "\"")
        rest = 切片(rest, 1)
        若 (匹配(rest, "运算符", "=")) { rest = 消耗(rest, "运算符", "=") }
        设 val_r = 解析表达式(rest, 0)
        设 val = 取(val_r, 0)
        返回(列表(列表("置", name, val), 取(val_r, 1)))
    }

    // 读 传感器
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "读")) {
        设 rest = 切片(tokens, 1)
        设 name_tok = 取当前(rest)
        若 (非(是列表(name_tok))) { 1 / 0 }
        设 name = 连接("\"", 取(name_tok, 1), "\"")
        rest = 切片(rest, 1)
        返回(列表(列表("读", name), rest))
    }

    // 查 设备
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "查")) {
        设 rest = 切片(tokens, 1)
        设 name_tok = 取当前(rest)
        若 (非(是列表(name_tok))) { 1 / 0 }
        设 name = 连接("\"", 取(name_tok, 1), "\"")
        rest = 切片(rest, 1)
        返回(列表(列表("查", name), rest))
    }

    // 对 对象 { body }
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "对")) {
        设 rest = 切片(tokens, 1)
        设 name_tok = 取当前(rest)
        若 (非(是列表(name_tok))) { 1 / 0 }
        设 name = 连接("\"", 取(name_tok, 1), "\"")
        rest = 切片(rest, 1)
        设 body_r = 解析主表达式(rest)
        设 body = 取(body_r, 0)
        rest = 取(body_r, 1)
        返回(列表(列表("对", name, body), rest))
    }

    // 定义 fn (params) { body }
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "定义")) {
        设 rest = 切片(tokens, 1)
        设 name_tok = 取当前(rest)
        若 (非(是列表(name_tok))) { 1 / 0 }
        设 name = 取(name_tok, 1)
        rest = 切片(rest, 1)

        // 参数列表 (params)
        rest = 消耗(rest, "符号", "(")
        设 params = 列表()
        循环 (真) {
            若 (匹配(rest, "符号", ")")) {
                rest = 消耗(rest, "符号", ")")
                跳出
            }
            若 (匹配(rest, "符号", ",")) {
                rest = 消耗(rest, "符号", ",")
                继续
            }
            设 p_tok = 取当前(rest)
            若 (非(是列表(p_tok))) { 1 / 0 }
            params = 列表合(params, 列表(取(p_tok, 1)))
            rest = 切片(rest, 1)
        }

        // 函数体
        设 body_r = 解析主表达式(rest)
        设 body = 取(body_r, 0)
        rest = 取(body_r, 1)
        返回(列表(列表("fn", name, params, body), rest))
    }

    // 函数 (params) { body } — 匿名函数
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "函数")) {
        设 rest = 切片(tokens, 1)
        rest = 消耗(rest, "符号", "(")
        设 params = 列表()
        循环 (真) {
            若 (匹配(rest, "符号", ")")) {
                rest = 消耗(rest, "符号", ")")
                跳出
            }
            若 (匹配(rest, "符号", ",")) {
                rest = 消耗(rest, "符号", ",")
                继续
            }
            设 p_tok = 取当前(rest)
            若 (非(是列表(p_tok))) { 1 / 0 }
            params = 列表合(params, 列表(取(p_tok, 1)))
            rest = 切片(rest, 1)
        }
        设 body_r = 解析主表达式(rest)
        设 body = 取(body_r, 0)
        rest = 取(body_r, 1)
        返回(列表(列表("函数", params, body), rest))
    }

    // 尝试 { body } 捕获 (e) { handler }
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "尝试")) {
        设 rest = 切片(tokens, 1)
        设 try_r = 解析主表达式(rest)
        设 try_body = 取(try_r, 0)
        rest = 取(try_r, 1)
        设 catch_var = 假
        设 catch_body = 假
        设 has_catch = 假
        若 (匹配(rest, "标识符", "捕获")) {
            rest = 消耗(rest, "标识符", "捕获")
            // 支持 捕获 (e) { body } 和 捕获 { body }
            若 (匹配(rest, "符号", "(")) {
                rest = 消耗(rest, "符号", "(")
                设 cv = 取当前(rest)
                若 (是列表(cv)) { catch_var = 取(cv, 1); rest = 切片(rest, 1) }
                rest = 消耗(rest, "符号", ")")
            }
            设 ch_r = 解析主表达式(rest)
            catch_body = 取(ch_r, 0)
            rest = 取(ch_r, 1)
            has_catch = 真
        }
        设 node = 列表("try", try_body)
        若 (has_catch) {
            node = 列表合(node, 列表(列表("catch", catch_var, catch_body)))
        }
        返回(列表(node, rest))
    }

    // 返回 expr
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "返回")) {
        设 rest = 切片(tokens, 1)
        设 val_r = 解析表达式(rest, 0)
        返回(列表(列表("return", 取(val_r, 0)), 取(val_r, 1)))
    }

    // 跳出
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "跳出")) {
        设 rest = 切片(tokens, 1)
        若 (匹配(rest, "符号", ";")) { rest = 消耗(rest, "符号", ";") }
        返回(列表(列表("跳出"), rest))
    }

    // 继续
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "继续")) {
        设 rest = 切片(tokens, 1)
        若 (匹配(rest, "符号", ";")) { rest = 消耗(rest, "符号", ";") }
        返回(列表(列表("继续"), rest))
    }

    // 导出 name1 name2 …
    若 (str_equals(ttype, "标识符") 且 str_equals(tval, "导出")) {
        设 rest = 切片(tokens, 1)
        设 names = 列表()
        循环 (真) {
            设 tok = 取当前(rest)
            若 (非(是列表(tok))) { 跳出 }
            若 (非(str_equals(取(tok, 0), "标识符"))) { 跳出 }
            names = 列表合(names, 列表(取(tok, 1)))
            rest = 切片(rest, 1)
        }
        返回(列表(列表合(列表("export"), names), rest))
    }

    // 通用表达式
    返回(解析表达式(tokens, 0))
}

定义 解析 (source) {
    设 tokens = 词法分析(source)
    设 asts = 列表()
    循环 (表长(tokens) > 0) {
        设 r = 解析语句(tokens)
    设 node = 取(r, 0)
    若 (非(是列表(node))) {
        asts = 列表合(asts, 列表(node))
        跳出
    }
    asts = 列表合(asts, 列表(node))
        tokens = 取(r, 1)
    }
    若 (表长(asts) == 0) { 返回(假) }
    若 (表长(asts) == 1) { 返回(取(asts, 0)) }
    返回(列表合(列表("do"), asts))
}


// llvmgen.san V4 — 寄存器线程化

定义 新寄存器 (reg) {
    设 id = 新寄存器ID()
    返回(列表(连接("%", id), id))
}

定义 header () {
    设 s = "; ModuleID = 'sanyan'"; s = 连接(s, 换行)
    s = 连接(s, "target triple = \"x86_64-pc-linux-gnu\""); s = 连接(s, 换行)
    s = 连接(s, 换行)
    s = 连接(s, "declare void @san_sys_write(i32, i8*, i32)"); s = 连接(s, 换行)
    s = 连接(s, "declare i8* @_rt_malloc(i32)"); s = 连接(s, 换行)
    s = 连接(s, "declare void @_rt_free(i8*)"); s = 连接(s, 换行)
    s = 连接(s, "declare i8* @san_read_file(i8*, i32*)"); s = 连接(s, 换行)
    s = 连接(s, "declare void @san_write_file(i8*, i8*, i32)"); s = 连接(s, 换行)
    s = 连接(s, "declare i8* @_next_reg_str()"); s = 连接(s, 换行)
    s = 连接(s, "@_rt_buf = global [22 x i8] zeroinitializer"); s = 连接(s, 换行)
    s = 连接(s, 声明运行时())
    s = 连接(s, "@g_error = external global i8*"); s = 连接(s, 换行)
    s = 连接(s, 换行)
    返回(s)
}

定义 footer () {
    返回(连接("  ret i8* null", 换行, "}", 换行))
}

设 换行 = "\n"

设 comp_env = 新字典()          // name → alloca register
设 函数库列表 = 新列表()         // list of function IR strings
设 函数参数表 = 新字典()         // name → param_count (e.g., "%5")

定义 声明运行时 () {
    设 s = "declare i8* @rt_awake(i8* noalias, i8* noalias, i8* noalias, i8* nocapture readonly)" ; s = 连接(s, 换行)
    // rt_list_*, rt_dict_*, rt_print_* 由 生成运行时IR() 提供定义，不需declare
    返回(s)
}

设 字符串常量表 = 新字典()     // string_content → global_name
设 字符串常量列表 = 新列表()   // list of global constant IR strings
设 字符串计数器 = 0

定义 新标签 (prefix) {
    设 id = 新标签ID()
    返回(连接(prefix, id))
}

定义 取字符串常量 (content) {
    设 existing = 查键(字符串常量表, content)
    若 (大于(取长(existing), 0)) {
        返回(existing)
    }
    设 idx = 字典取长(字符串常量表)
    设 name = 连接("@.str.", idx)
    存变量(字符串常量表, content, name)
    返回(name)
}

定义 生成字符串常量定义 () {
    设 result = ""
    设 全部键列表 = 字典键列表(字符串常量表)
    设 k列表长度 = 列表取长(全部键列表)
    设 ki = 0
    设 kc = 加(k列表长度, 1)
    循环 (小于(ki, kc)) {
        若 (小于(ki, k列表长度)) {
            設 content = 列表取(全部键列表, ki)
            設 name = 查键(字符串常量表, content)
            設 len = 加(取字长(content), 1)
            設 escaped = 转义LLVM字符串(content)
            result = 连接(result, name, " = private constant [", len, " x i8] c\"", escaped, "\\00\"", 换行)
        }
        ki = 加(ki, 1)
    }
    返回(result)
}

定义 parse_int (s) {
    若 (是数字(s)) { 返回(s) }
    设 result = 0
    设 i = 0
    设 len = 取长(s)
    设 neg = 假
    若 (前缀(s, "-")) {
        neg = 真
        i = 1
    }
    设 digs = "0123456789"
    循环 (小于(i, len)) {
        设 ch = 子串(s, i, 1)
        设 idx = 查找(digs, ch)
        若 (小于(idx, 0)) { 返回(0) }
        设 tmp = 乘(result, 10)
        result = 加(tmp, idx)
        i = 加(i, 1)
    }
    若 (neg) { result = 减(0, result) }
    返回(result)
}

定义 是否为数字字符串 (s) {
    若 (非(是字符串(s))) { 返回(假) }
    若 (等于(取长(s), 0)) { 返回(假) }
    设 i = 0; 设 len = 取长(s)
    若 (前缀(s, "-")) { i = 1 }
    若 (等于(i, len)) { 返回(假) }
    设 digs = "0123456789"
    循环 (小于(i, len)) {
        设 ch = 子串(s, i, 1)
        设 idx = 查找(digs, ch)
        若 (小于(idx, 0)) { 返回(假) }
        i = 加(i, 1)
    }
    返回(真)
}

定义 最后一行 (text) {
    设 len = 取长(text)
    若 (等于(len, 0)) { 返回("") }
    设 end = 减(len, 1)
    循环 (end >= 0) {
        设 ch = 子串(text, end, 1)
        若 (非(字符串包含(换行, ch))) { 跳出 }
        end = 减(end, 1)
    }
    若 (end < 0) { 返回("") }
    设 i = end
    循环 (i >= 0) {
        设 ch = 子串(text, i, 1)
        若 (字符串包含(换行, ch)) {
            返回(子串(text, 加(i, 1), 减(end, i)))
        }
        i = 减(i, 1)
    }
    返回(子串(text, 0, 加(end, 1)))
}

定义 不以终止指令结尾 (text) {
    设 last = 最后一行(text)
    若 (等于(取长(last), 0)) { 返回(真) }
    若 (字符串包含(last, "ret")) { 返回(假) }
    若 (字符串包含(last, "br label")) { 返回(假) }
    若 (字符串包含(last, "br i1")) { 返回(假) }
    返回(真)
}

定义 确保终止 (s, merge_label) {
    若 (不以终止指令结尾(s)) {
        s = 连接(s, "  br label %", merge_label, 换行)
    }
    返回(s)
}

定义 编译 (_c_ce, ast, reg) {
    若 (是列表(ast)) {
        设 _c_op = 取(ast, 0)
        设 _c_args = 切片(ast, 1)

    若 (字符串相等(_c_op, "set")) {
        设 _c_name = 列表列表取(_c_args, 0)
        设 _c_arg_val = 列表列表取(_c_args, 1)
        设 _c_val_r = 编译(_c_ce, _c_arg_val, reg)
        设 _c_s = 列表列表取(_c_val_r, 0)
        设 _c_val_reg = 列表列表取(_c_val_r, 1)
        reg = 列表列表取(_c_val_r, 2)
        // 检查是否为模块级全局变量
        设 _c_gv = 查键(全局变量表, _c_name)
        若 (大于(取长(_c_gv), 0)) {
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** @", _c_gv, 换行)
            返回(列表(_c_s, _c_val_reg, reg))
        }
        设 _c_existing = 查键(_c_ce, _c_name)
        若 (等于(取长(_c_existing), 0)) {
            设 _c_r = 新寄存器(reg); 设 _c_a = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", _c_a, " = alloca i8*", 换行)
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** ", _c_a, 换行)
            存变量(_c_ce, _c_name, _c_a)
        } 否则 {
            设 _c_a = _c_existing
            _c_s = 连接(_c_s, "  store i8* ", _c_val_reg, ", i8** ", _c_a, 换行)
        }
        返回(列表(_c_s, _c_val_reg, reg))
    }

    若 (字符串相等(_c_op, "新寄存器ID")) {
        设 _c_r = 新寄存器(reg); 设 rx = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_s = 连接("  ", rx, " = call i8* @_next_reg_str()", 换行)
        返回(列表(_c_s, rx, reg))
    }

    若 (字符串相等(_c_op, "新标签ID")) {
        设 _c_r = 新寄存器(reg); 设 rx = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_s = 连接("  ", rx, " = call i8* @_next_reg_str()", 换行)
        返回(列表(_c_s, rx, reg))
    }

    若 (字符串相等(_c_op, "加") 或 字符串相等(_c_op, "add")) {
        设 _c_l_val = 列表列表取(_c_args, 0)
        设 _c_r_val = 列表列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表列表取(_c_l_r, 0); 设 lv = 列表列表取(_c_l_r, 1); reg = 列表列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表列表取(_c_r_r, 0)); 设 rv = 列表列表取(_c_r_r, 1); reg = 列表列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = add i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
         返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "减") 或 字符串相等(_c_op, "sub")) {
        设 _c_arg_count = 列表取长(_c_args)
        若 (等于(_c_arg_count, 1)) {
            设 _c_v_val = 列表列表取(_c_args, 0)
            设 _c_v_r = 编译(_c_ce, _c_v_val, reg)
            设 _c_s = 列表列表取(_c_v_r, 0); 设 vv = 列表列表取(_c_v_r, 1); reg = 列表列表取(_c_v_r, 2)
            设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", vv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_raw = 连接("%", ub_val)
            设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", res, " = sub i64 0, ", _c_raw, 换行)
            设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
            返回(列表(_c_s, _c_bv, reg))
        }
        设 _c_l_val = 列表列表取(_c_args, 0); 设 _c_r_val = 列表列表取(_c_args, 1)
        设 _c_arg_count = 列表取长(_c_args)
        若 (等于(_c_arg_count, 1)) {
            // Unary negation: -x → sub 0, x
            设 _c_v_val = 列表列表取(_c_args, 0)
            设 _c_v_r = 编译(_c_ce, _c_v_val, reg)
            设 _c_s = 列表列表取(_c_v_r, 0); 设 vv = 列表列表取(_c_v_r, 1); reg = 列表列表取(_c_v_r, 2)
            设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", vv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_raw = 连接("%", ub_val)
            设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
            _c_s = 连接(_c_s, "  ", res, " = sub i64 0, ", _c_raw, 换行)
            设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
            返回(列表(_c_s, _c_bv, reg))
        }
        设 _c_l_val = 列表列表取(_c_args, 0); 设 _c_r_val = 列表列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表列表取(_c_l_r, 0); 设 lv = 列表列表取(_c_l_r, 1); reg = 列表列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表列表取(_c_r_r, 0)); 设 rv = 列表列表取(_c_r_r, 1); reg = 列表列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = sub i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "乘") 或 字符串相等(_c_op, "mul")) {
        设 _c_l_val = 列表列表取(_c_args, 0); 设 _c_r_val = 列表列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表列表取(_c_l_r, 0); 设 lv = 列表列表取(_c_l_r, 1); reg = 列表列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表列表取(_c_r_r, 0)); 设 rv = 列表列表取(_c_r_r, 1); reg = 列表列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = mul i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "除") 或 字符串相等(_c_op, "div")) {
        设 _c_l_val = 列表列表取(_c_args, 0); 设 _c_r_val = 列表列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表列表取(_c_l_r, 0); 设 lv = 列表列表取(_c_l_r, 1); reg = 列表列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表列表取(_c_r_r, 0)); 设 rv = 列表列表取(_c_r_r, 1); reg = 列表列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 res = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", res, " = sdiv i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", res, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "小于") 或 字符串相等(_c_op, "lt")) {
        设 _c_l_val = 列表列表取(_c_args, 0); 设 _c_r_val = 列表列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表列表取(_c_l_r, 0); 设 lv = 列表列表取(_c_l_r, 1); reg = 列表列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表列表取(_c_r_r, 0)); 设 rv = 列表列表取(_c_r_r, 1); reg = 列表列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
        设 _c_r = 新寄存器(reg); 设 cmp = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        设 _c_r = 新寄存器(reg); 设 result = 列表取(_c_r, 0); reg = 列表取(_c_r, 1)
        _c_s = 连接(_c_s, "  ", cmp, " = icmp slt i64 ", _c_l_raw, ", ", _c_r_raw, 换行)
        _c_s = 连接(_c_s, "  ", result, " = zext i1 ", cmp, " to i64", 换行)
        设 _c_bb_shl = 新寄存器ID(); 设 bb_or = 新寄存器ID(); 设 bb_ptr = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_bb_shl, " = shl i64 ", result, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_or, " = or i64 %", _c_bb_shl, ", 1", 换行)
        _c_s = 连接(_c_s, "  %", bb_ptr, " = inttoptr i64 %", bb_or, " to i8*", 换行)
        设 _c_bv = 连接("%", bb_ptr)
        返回(列表(_c_s, _c_bv, reg))
    }

    若 (字符串相等(_c_op, "大于") 或 字符串相等(_c_op, "gt")) {
        设 _c_l_val = 列表列表取(_c_args, 0); 设 _c_r_val = 列表列表取(_c_args, 1)
        设 _c_l_r = 编译(_c_ce, _c_l_val, reg)
        设 _c_s = 列表列表取(_c_l_r, 0); 设 lv = 列表列表取(_c_l_r, 1); reg = 列表列表取(_c_l_r, 2)
        设 _c_r_r = 编译(_c_ce, _c_r_val, reg)
        _c_s = 连接(_c_s, 列表列表取(_c_r_r, 0)); 设 rv = 列表列表取(_c_r_r, 1); reg = 列表列表取(_c_r_r, 2)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", lv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_l_raw = 连接("%", ub_val)
        设 _c_ub_raw = 新寄存器ID(); 设 ub_val = 新寄存器ID()
        _c_s = 连接(_c_s, "  %", _c_ub_raw, " = ptrtoint i8* ", rv, " to i64", 换行)
        _c_s = 连接(_c_s, "  %", ub_val, " = ashr i64 %", _c_ub_raw, ", 1", 换行)
        设 _c_r_raw = 连接("%", ub_val)
