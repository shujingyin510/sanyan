// 三态统计函数库
// 用法：加载("stat")

定义 态计数 (数据) {
    设 正 = 0
    设 零 = 0
    设 负 = 0
    遍历 当前值 在 数据 {
        若 (当前值 == 真) {
            正 = 正 + 1
        } 再若 (当前值 == 可能) {
            零 = 零 + 1
        } 否则 {
            负 = 负 + 1
        }
    }
    返回(字典("真", 正, "可能", 零, "假", 负))
}

导出 态计数

定义 多数决 (数据) {
    设 计数 = 态计数(数据)
    设 总长 = 表长(数据)
    设 过半 = 总长 / 2
    若 (取键(计数, "真") > 过半) { 返回(真) }
    再若 (取键(计数, "假") > 过半) { 返回(假) }
    否则 { 返回(可能) }
}

导出 多数决
