// 日期时间工具库
// 基于当前时间戳提供格式化和计算

定义 是闰年 (年) {
    返回((年 % 4 == 0 且 年 % 100 != 0) 或 年 % 400 == 0)
}

定义 月份天数 (年, 月) {
    若 (月 == 2) {
        若 (是闰年(年)) { 返回(29) }
        返回(28)
    }
    若 (月 == 4 或 月 == 6 或 月 == 9 或 月 == 11) { 返回(30) }
    返回(31)
}

定义 当前 () {
    返回(当前时间)
}

定义 格式 (格式串) {
    // 简单的时间格式化
    // 支持占位符：{Y}年 {M}月 {D}日 {h}时 {m}分 {s}秒
    设 总秒 = 当前时间
    设 时 = (总秒 % (24 * 3600)) / 3600
    设 分 = (总秒 % 3600) / 60
    设 秒余 = 总秒 % 60

    // 计算日期（从 1970-01-01 开始，考虑闰年）
    设 总天 = 总秒 / (24 * 3600)
    设 年 = 1970
    设 剩余天 = 总天
    循环 (真) {
        设 天数 = 365
        若 (是闰年(年)) { 天数 = 366 }
        若 (剩余天 < 天数) { 跳出 }
        剩余天 = 剩余天 - 天数
        年 = 年 + 1
    }
    设 月 = 1
    循环 (真) {
        设 天数 = 月份天数(年, 月)
        若 (剩余天 < 天数) { 跳出 }
        剩余天 = 剩余天 - 天数
        月 = 月 + 1
    }
    设 日 = 剩余天 + 1

    设 结果 = 格式串
    结果 = 替换(结果, "{Y}", 连接("", 年))
    结果 = 替换(结果, "{M}", 连接("", 月))
    结果 = 替换(结果, "{D}", 连接("", 日))
    结果 = 替换(结果, "{h}", 连接("", 时))
    结果 = 替换(结果, "{m}", 连接("", 分))
    结果 = 替换(结果, "{s}", 连接("", 秒余))
    返回(结果)
}

定义 计时 (开始时间) {
    返回(当前时间 - 开始时间)
}
