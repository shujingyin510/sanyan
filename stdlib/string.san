// 字符串工具库
定义 重复 (s, n) {
    // 返回字符串 s 重复 n 次
    若 (n <= 0) {
        返回("")
    }
    设 result = ""
    遍历 i 从 1 到 n {
        result = 连接(result, s)
    }
    返回(result)
}

定义 是否包含 (字符串, 子串) {
    设 lenMain = 取长(字符串)
    设 lenSub = 取长(子串)
    若 (lenSub > lenMain) {
        返回(假)
    }
    遍历 i 从 0 到 (lenMain - lenSub) {
        设 match = 真
        遍历 j 从 0 到 (lenSub - 1) {
            若 (取(字列(字符串), i + j) != 取(字列(子串), j)) {
                match = 假
                返回(假)
            }
        }
        若 (match == 真) {
            返回(真)
        }
    }
    返回(假)
}

定义 修剪 (s) {
    返回(s)   // 占位，后续完善
}