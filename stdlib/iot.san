定义 全关 () {
    置 灯 = 灭
    置 风扇 = 关
    置 加热 = 关
    返回(真)
}

定义 全待机 () {
    置 灯 = 守
    置 风扇 = 守
    置 加热 = 守
    返回(可能)
}

定义 检测并动作 () {
    设 检测值 = 读(人体)
    若 (检测值 == 真) {
        置 灯 = 亮
        返回(真)
    } 再若 (检测值 == 可能) {
        置 灯 = 守
        返回(可能)
    } 否则 {
        置 灯 = 灭
        返回(假)
    }
}

定义 轮询传感器 (次数) {
    设 历史 = 列表()
    遍历 i 从 1 到 次数 {
        设 光线 = 读(光线)
        设 温度 = 读(温度)
        设 记录 = 列表(光线, 温度)
        设 历史 = 列表合(历史, 列表(记录))
        等待(1)
    }
    返回(历史)
}