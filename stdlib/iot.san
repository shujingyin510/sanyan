// IoT 控制工具库
定义 全关 () {
    置 灯 = 灭;
    置 风扇 = 关;
    置 加热 = 关;
    返回(真);
}

定义 全待机 () {
    置 灯 = 守;
    置 风扇 = 守;
    置 加热 = 守;
    返回(可能);
}

定义 检测并动作 () {
    // 人体传感器三态决策
    设 检测值 = 读 人体;
    若 (检测值 == 真) {
        置 灯 = 亮;
        返回(真);
    } 再若 (检测值 == 可能) {
        置 灯 = 守;
        返回(可能);
    } 否则 {
        置 灯 = 灭;
        返回(假);
    }
}