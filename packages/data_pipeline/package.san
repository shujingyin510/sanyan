// packages/data_pipeline/package.san — 数据处理管道库
// 提供数据转换、过滤、聚合等管道操作

// ==================== 管道核心 ====================

// 创建管道
定义 管道(数据) {
    返回(字典("数据", 数据, "步骤", 列表()))
}

// 管道映射
定义 管道映射(管道, 函数) {
    设 数据 = 取键(管道, "数据")
    设 步骤 = 取键(管道, "步骤")
    置键(管道, "步骤", 列表合(步骤, 列表(字典("类型", "映射", "函数", 函数))))
    返回(管道)
}

// 管道过滤
定义 管道过滤(管道, 函数) {
    设 步骤 = 取键(管道, "步骤")
    置键(管道, "步骤", 列表合(步骤, 列表(字典("类型", "过滤", "函数", 函数))))
    返回(管道)
}

// 管道执行
定义 管道执行(管道) {
    设 数据 = 取键(管道, "数据")
    设 步骤 = 取键(管道, "步骤")
    设 result = 数据
    遍历 步 在 步骤 {
        设 类型 = 取键(步, "类型")
        设 fn = 取键(步, "函数")
        若 (等于(类型, "映射")) {
            设 new_data = 列表()
            遍历 item 在 result {
                new_data = 列表合(new_data, 列表(fn(item)))
            }
            result = new_data
        }
        若 (等于(类型, "过滤")) {
            设 new_data = 列表()
            遍历 item 在 result {
                若 (fn(item)) {
                    new_data = 列表合(new_data, 列表(item))
                }
            }
            result = new_data
        }
    }
    返回(result)
}

// ==================== 数据转换 ====================

// 扁平化嵌套列表
定义 扁平化(列表) {
    设 result = 列表()
    遍历 item 在 列表 {
        若 (是列表(item)) {
            遍历 sub 在 item {
                result = 列表合(result, 列表(sub))
            }
        } 否则 {
            result = 列表合(result, 列表(item))
        }
    }
    返回(result)
}

// 去重
定义 去重(列表) {
    设 seen = 字典()
    设 result = 列表()
    遍历 item 在 列表 {
        设 key = 转字符串(item)
        若 (非(字典包含(seen, key))) {
            置键(seen, key, 真)
            result = 列表合(result, 列表(item))
        }
    }
    返回(result)
}

// 分组
定义 分组(列表, 键函数) {
    设 groups = 字典()
    遍历 item 在 列表 {
        设 key = 键函数(item)
        设 group = 列表()
        若 (字典包含(groups, key)) {
            group = 取键(groups, key)
        }
        group = 列表合(group, 列表(item))
        置键(groups, key, group)
    }
    返回(groups)
}

// 排序（带比较函数）
定义 自定义排序(列表, 比较函数) {
    // 简化实现：冒泡排序
    设 arr = 列表()
    遍历 x 在 列表 { arr = 列表合(arr, 列表(x)) }
    设 n = 取长(arr)
    遍历 i 从 0 到 减(n, 2) {
        遍历 j 从 0 到 减(减(n, i), 2) {
            若 (比较函数(取(arr, j), 取(arr, 加(j, 1)))) {
                设 temp = 取(arr, j)
                arr = 列表合(切片(arr, 0, j), 列表(取(arr, 加(j, 1))))
                arr = 列表合(切片(arr, 0, 加(j, 1)), 列表(temp))
                arr = 列表合(切片(arr, 0, j), 列表(取(arr, 加(j, 1))))
            }
        }
    }
    返回(arr)
}

// ==================== 聚合 ====================

// 计数
定义 计数(列表) {
    设 counts = 字典()
    遍历 item 在 列表 {
        设 key = 转字符串(item)
        设 c = 0
        若 (字典包含(counts, key)) {
            c = 取键(counts, key)
        }
        置键(counts, key, 加(c, 1))
    }
    返回(counts)
}

// 频率分布
定义 频率分布(列表) {
    设 counts = 计数(列表)
    设 total = 取长(列表)
    设 freq = 字典()
    遍历 key 在 取键(counts, "keys") {
        置键(freq, key, 除(取键(counts, key), total))
    }
    返回(freq)
}

// ==================== 窗口操作 ====================

// 滑动窗口
定义 滑动窗口(数据, 窗口大小) {
    设 windows = 列表()
    遍历 i 从 0 到 减(减(取长(数据), 窗口大小), 1) {
        设 window = 列表()
        遍历 j 从 0 到 减(窗口大小, 1) {
            window = 列表合(window, 列表(取(数据, 加(i, j))))
        }
        windows = 列表合(windows, 列表(window))
    }
    返回(windows)
}

导出 管道 管道映射 管道过滤 管道执行
导出 扁平化 去重 分组 自定义排序
导出 计数 频率分布 滑动窗口
