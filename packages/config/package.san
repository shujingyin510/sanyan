// packages/config/package.san — 配置管理库
// 提供配置文件读写、环境变量、配置合并等功能

// ==================== 配置加载 ====================

// 从 JSON 文件加载配置
定义 加载配置(文件路径) {
    尝试 {
        设 content = 读文件(文件路径)
        返回(解析JSON(content))
    } 捕获 (e) {
        输出("警告: 无法加载配置文件 ")
        输出(文件路径)
        输出(" - ")
        输出(e)
        输出("\n")
        返回(字典())
    }
}

// 保存配置到 JSON 文件
定义 保存配置(配置, 文件路径) {
    设 content = 转JSON(配置)
    写文件(文件路径, content)
    返回(真)
}

// ==================== 配置合并 ====================

// 深度合并两个配置（后者覆盖前者）
定义 合并配置(基础, 覆盖) {
    设 result = 字典()
    // 复制基础配置
    遍历 key 在 取键(基础, "keys") {
        置键(result, key, 取键(基础, key))
    }
    // 应用覆盖
    遍历 key 在 取键(覆盖, "keys") {
        设 base_val = 假
        设 cover_val = 取键(覆盖, key)
        若 (字典包含(基础, key)) {
            base_val = 取键(基础, key)
        }
        // 如果两者都是字典，递归合并
        若 (是字典(base_val) 且 是字典(cover_val)) {
            置键(result, key, 合并配置(base_val, cover_val))
        } 否则 {
            置键(result, key, cover_val)
        }
    }
    返回(result)
}

// ==================== 环境变量 ====================

// 获取环境变量（带默认值）
定义 环境变量(名称, 默认值) {
    设 val = 系统环境(名称)
    若 (等于(val, 假) 或 等于(val, "")) {
        返回(默认值)
    }
    返回(val)
}

// 从环境变量加载配置
定义 环境配置(前缀) {
    设 config = 字典()
    // 常见配置项
    设 keys = 列表("HOST", "PORT", "DEBUG", "LOG_LEVEL", "DATABASE_URL")
    遍历 key 在 keys {
        设 env_key = 连接(前缀, "_", key)
        设 val = 系统环境(env_key)
        若 (非(等于(val, 假))) {
            // 转换小写
            设 config_key = 小写(key)
            置键(config, config_key, val)
        }
    }
    返回(config)
}

// ==================== 配置验证 ====================

// 验证配置项是否存在
定义 验证必填(配置, 必填项) {
    设 缺失 = 列表()
    遍历 key 在 必填项 {
        若 (非(字典包含(配置, key))) {
            缺失 = 列表合(缺失, 列表(key))
        }
    }
    若 (大于(取长(缺失), 0)) {
        输出("错误: 缺少必填配置项: ")
        输出(缺失)
        输出("\n")
        返回(假)
    }
    返回(真)
}

// 验证配置值类型
定义 验证类型(配置, 规则) {
    遍历 key 在 取键(规则, "keys") {
        设 期望类型 = 取键(规则, key)
        设 实际值 = 取键(配置, key)
        若 (非(等于(实际值, 假))) {
            若 (等于(期望类型, "数字") 且 非(是数字(实际值))) {
                输出("错误: 配置项 ")
                输出(key)
                输出(" 应为数字\n")
                返回(假)
            }
            若 (等于(期望类型, "字符串") 且 非(是字符串(实际值))) {
                输出("错误: 配置项 ")
                输出(key)
                输出(" 应为字符串\n")
                返回(假)
            }
        }
    }
    返回(真)
}

// ==================== 多环境配置 ====================

// 加载多环境配置
定义 加载环境配置(基础路径, 环境) {
    // 加载基础配置
    设 基础 = 加载配置(基础路径)

    // 加载环境特定配置
    设 env_path = 替换(基础路径, ".json", 连接(".", 环境, ".json"))
    设 env_config = 加载配置(env_path)

    // 合并
    返回(合并配置(基础, env_config))
}

// 获取当前环境
定义 当前环境() {
    返回(环境变量("APP_ENV", "development"))
}

导出 加载配置 保存配置 合并配置
导出 环境变量 环境配置
导出 验证必填 验证类型
导出 加载环境配置 当前环境
