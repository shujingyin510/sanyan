// 字符串工具包
// 提供字符串填充、截断、转换、格式化功能

定义 字符串填充(文本, 宽度, 字符, 对齐) {
    // 填充字符串到指定宽度
    // 对齐: "左" / "右" / "中"
    设 长度 = 取长(文本)
    若 (大于等于(长度, 宽度)) { 返回(文本) }
    设 填充数量 = 减(宽度, 长度)
    设 填充文本 = ""
    设 i = 0
    循环 (小于(i, 填充数量)) {
        设 填充文本 = 连接(填充文本, 字符)
        设 i = 加(i, 1)
    }
    若 (等于(对齐, "右")) {
        返回(连接(填充文本, 文本))
    } 若 (等于(对齐, "中")) {
        设 左填充 = 除(填充数量, 2)
        设 右填充 = 减(填充数量, 左填充)
        设 左文本 = ""
        设 右文本 = ""
        设 i = 0
        循环 (小于(i, 左填充)) {
            设 左文本 = 连接(左文本, 字符)
            设 i = 加(i, 1)
        }
        设 i = 0
        循环 (小于(i, 右填充)) {
            设 右文本 = 连接(右文本, 字符)
            设 i = 加(i, 1)
        }
        返回(连接(连接(左文本, 文本), 右文本))
    } 否则 {
        返回(连接(文本, 填充文本))
    }
}

定义 字符串截断(文本, 最大长度, 后缀) {
    // 截断字符串到最大长度
    // 后缀默认为 "..."
    设 实际后缀 = 若 (等于(后缀, 无)) { "..." } 否则 { 后缀 }
    若 (小于等于(取长(文本), 最大长度)) { 返回(文本) }
    设 截断长度 = 减(最大长度, 取长(实际后缀))
    返回(连接(子串(文本, 0, 截断长度), 实际后缀))
}

定义 字符串重复(文本, 次数) {
    // 重复字符串指定次数
    设 结果 = ""
    设 i = 0
    循环 (小于(i, 次数)) {
        设 结果 = 连接(结果, 文本)
        设 i = 加(i, 1)
    }
    返回(结果)
}

定义 字符串反转(文本) {
    // 反转字符串
    设 结果 = ""
    设 i = 减(取长(文本), 1)
    循环 (大于等于(i, 0)) {
        设 结果 = 连接(结果, 子串(文本, i, 1))
        设 i = 减(i, 1)
    }
    返回(结果)
}

定义 字符串包含(文本, 子串) {
    // 检查字符串是否包含子串
    返回(不等于(查找(文本, 子串), -1))
}

定义 字符串开头(文本, 前缀) {
    // 检查字符串是否以指定前缀开头
    返回(前缀匹配(文本, 前缀))
}

定义 字符串结尾(文本, 后缀) {
    // 检查字符串是否以指定后缀结尾
    设 长度 = 取长(后缀)
    若 (小于(取长(文本), 长度)) { 返回(假) }
    返回(等于(子串(文本, 减(取长(文本), 长度), 长度), 后缀))
}

定义 字符串计数(文本, 子串) {
    // 计算子串出现次数
    设 计数 = 0
    设 位置 = 查找(文本, 子串)
    循环 (不等于(位置, -1)) {
        设 计数 = 加(计数, 1)
        设 位置 = 查找(子串(文本, 加(位置, 1), 取长(文本)), 子串)
        若 (不等于(位置, -1)) {
            设 位置 = 加(位置, 加(位置, 1))
        }
    }
    返回(计数)
}

定义 字符串左修剪(文本) {
    // 去除左侧空白
    设 i = 0
    循环 (且(小于(i, 取长(文本)), 等于(子串(文本, i, 1), " "))) {
        设 i = 加(i, 1)
    }
    返回(子串(文本, i, 取长(文本)))
}

定义 字符串右修剪(文本) {
    // 去除右侧空白
    设 长度 = 取长(文本)
    循环 (且(大于(长度, 0), 等于(子串(文本, 减(长度, 1), 1), " "))) {
        设 长度 = 减(长度, 1)
    }
    返回(子串(文本, 0, 长度))
}

定义 字符串修剪(文本) {
    // 去除两侧空白
    返回(字符串右修剪(字符串左修剪(文本)))
}

导出 字符串填充 字符串截断 字符串重复 字符串反转 字符串包含 字符串开头 字符串结尾 字符串计数 字符串左修剪 字符串右修剪 字符串修剪
