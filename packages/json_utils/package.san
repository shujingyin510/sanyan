// JSON 工具包
// 提供 JSON 解析、序列化、路径查询、格式化功能

定义 JSON解析(字符串) {
    // 解析 JSON 字符串为三言对象
    返回(解析JSON(字符串))
}

定义 JSON序列化(对象) {
    // 将三言对象序列化为 JSON 字符串
    返回(序列化JSON(对象))
}

定义 JSON美化(对象, 缩进) {
    // 美化输出 JSON 对象
    // 缩进默认为 2 个空格
    设 空格 = 若 (等于(缩进, 无)) { "  " } 否则 { 缩进 }
    返回(序列化JSON(对象))
}

定义 JSON取值(对象, 路径) {
    // 按路径取值，路径用 . 分隔
    // 例: JSON取值({a: {b: 1}}, "a.b") => 1
    若 (不是字典(对象)) { 返回(无) }
    设 部分 = 分割(路径, ".")
    设 当前 = 对象
    遍历 键 在 部分 {
        若 (是字典(当前) 且 含键(当前, 键)) {
            设 当前 = 取键(当前, 键)
        } 否则 {
            返回(无)
        }
    }
    返回(当前)
}

定义 JSON设值(对象, 路径, 值) {
    // 按路径设置值
    // 例: JSON设值({}, "a.b", 1) => {a: {b: 1}}
    若 (不是字典(对象)) { 返回(字典()) }
    设 部分 = 分割(路径, ".")
    设 当前 = 对象
    设 i = 0
    循环 (小于(i, 减(取长(部分), 1))) {
        设 键 = 取(部分, i)
        若 (不是字典(当前)) { 返回(对象) }
        若 (不包含(当前, 键)) {
            置键(当前, 键, 字典())
        }
        设 当前 = 取键(当前, 键)
        设 i = 加(i, 1)
    }
    设 最后键 = 取(部分, 减(取长(部分), 1))
    置键(当前, 最后键, 值)
    返回(对象)
}

定义 JSON合并(对象1, 对象2) {
    // 合并两个 JSON 对象
    若 (不是字典(对象1)) { 返回(对象2) }
    若 (不是字典(对象2)) { 返回(对象1) }
    设 结果 = 字典()
    遍历 键 在 字典键列表(对象1) {
        置键(结果, 键, 取键(对象1, 键))
    }
    遍历 键 在 字典键列表(对象2) {
        置键(结果, 键, 取键(对象2, 键))
    }
    返回(结果)
}

定义 JSON包含(对象, 路径) {
    // 检查路径是否存在
    返回(不等于(JSON取值(对象, 路径), 无))
}

导出 JSON解析 JSON序列化 JSON美化 JSON取值 JSON设值 JSON合并 JSON包含
