// ==================== JSON 工具 ====================

// JSON 路径查询（简化版）
定义 JSON路径(json_str, path) {
    设 obj = 解析JSON(json_str)
    设 parts = 分割(path, ".")
    设 current = obj
    遍历 part 在 parts {
        若 (是字典(current)) {
            若 (字典包含(current, part)) {
                current = 取键(current, part)
            } 否则 {
                返回(假)
            }
        } 否则 {
            返回(假)
        }
    }
    返回(current)
}

// ==================== 表单编码 ====================

// URL 编码
定义 URL编码(text) {
    设 result = text
    result = 替换(result, " ", "%20")
    result = 替换(result, "&", "%26")
    result = 替换(result, "=", "%3D")
    result = 替换(result, "?", "%3F")
    返回(result)
}

// 构建查询字符串
定义 构建查询(params) {
    设 parts = 列表()
    遍历 key 在 取键(params, "keys") {
        // 简化实现
    }
    返回(连接(parts, "&"))
}

// ==================== Cookie ====================

// 解析 Cookie 字符串
定义 解析Cookie(cookie_str) {
    设 cookies = 字典()
    设 pairs = 分割(cookie_str, ";")
    遍历 pair 在 pairs {
        设 trimmed = 去空白(pair)
        设 eq_idx = 查找(trimmed, "=")
        若 (大于(eq_idx, 0)) {
            设 key = 子串(trimmed, 0, eq_idx)
            设 val = 子串(trimmed, 加(eq_idx, 1), 减(取长(trimmed), 加(eq_idx, 1)))
            置键(cookies, key, val)
        }
    }
    返回(cookies)
}

导出 解析URL 构建URL
导出 HTML转义 HTML反转义 HTML标签
导出 JSON路径
导出 URL编码 构建查询
导出 解析Cookie
