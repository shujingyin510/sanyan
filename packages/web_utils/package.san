// packages/web_utils/package.san — Web 工具库
// 提供 URL 解析、HTML 转义、JSON 处理等 Web 开发常用工具

// ==================== URL 解析 ====================

// 解析 URL 为组件
定义 解析URL(url) {
    设 scheme = ""
    设 host = ""
    设 port = ""
    设 path = ""
    设 query = ""

    // 简化解析：查找协议
    设 idx = 查找(url, "://")
    若 (大于(idx, -1)) {
        scheme = 子串(url, 0, idx)
        url = 子串(url, 加(idx, 3), 减(取长(url), 加(idx, 3)))
    }

    // 查找路径
    设 path_idx = 查找(url, "/")
    若 (大于(path_idx, -1)) {
        host = 子串(url, 0, path_idx)
        path = 子串(url, path_idx, 减(取长(url), path_idx))
    } 否则 {
        host = url
    }

    // 查找端口
    设 port_idx = 查找(host, ":")
    若 (大于(port_idx, -1)) {
        port = 子串(host, 加(port_idx, 1), 减(取长(host), 加(port_idx, 1)))
        host = 子串(host, 0, port_idx)
    }

    // 查找查询参数
    设 q_idx = 查找(path, "?")
    若 (大于(q_idx, -1)) {
        query = 子串(path, 加(q_idx, 1), 减(取长(path), 加(q_idx, 1)))
        path = 子串(path, 0, q_idx)
    }

    返回(字典(
        "协议", scheme,
        "主机", host,
        "端口", port,
        "路径", path,
        "查询", query
    ))
}

// 构建 URL
定义 构建URL(组件) {
    设 url = ""
    设 scheme = 取键(组件, "协议")
    若 (非(等于(scheme, ""))) {
        url = 连接(url, scheme, "://")
    }
    url = 连接(url, 取键(组件, "主机"))
    设 port = 取键(组件, "端口")
    若 (非(等于(port, ""))) {
        url = 连接(url, ":", port)
    }
    url = 连接(url, 取键(组件, "路径"))
    设 query = 取键(组件, "查询")
    若 (非(等于(query, ""))) {
        url = 连接(url, "?", query)
    }
    返回(url)
}

// ==================== HTML 工具 ====================

// HTML 转义
定义 HTML转义(text) {
    设 result = text
    result = 替换(result, "&", "&amp;")
    result = 替换(result, "<", "&lt;")
    result = 替换(result, ">", "&gt;")
    result = 替换(result, "\"", "&quot;")
    result = 替换(result, "'", "&#39;")
    返回(result)
}

// HTML 反转义
定义 HTML反转义(text) {
    设 result = text
    result = 替换(result, "&amp;", "&")
    result = 替换(result, "&lt;", "<")
    result = 替换(result, "&gt;", ">")
    result = 替换(result, "&quot;", "\"")
    result = 替换(result, "&#39;", "'")
    返回(result)
}

