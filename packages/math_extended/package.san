// packages/math_extended/package.san — 扩展数学库
// 提供复数、向量、矩阵等高级数学运算

// ==================== 复数 ====================

// 创建复数（字典表示）
定义 复数(实部, 虚部) {
    返回(字典("实", 实部, "虚", 虚部))
}

// 复数加法
定义 复数加(a, b) {
    返回(复数(
        加(取键(a, "实"), 取键(b, "实")),
        加(取键(a, "虚"), 取键(b, "虚"))
    ))
}

// 复数乘法
定义 复数乘(a, b) {
    设 ar = 取键(a, "实")
    设 ai = 取键(a, "虚")
    设 br = 取键(b, "实")
    设 bi = 取键(b, "虚")
    返回(复数(
        减(乘(ar, br), 乘(ai, bi)),
        加(乘(ar, bi), 乘(ai, br))
    ))
}

// 复数模
定义 复数模(z) {
    设 r = 取键(z, "实")
    设 i = 取键(z, "虚")
    返回(平方根(加(乘(r, r), 乘(i, i))))
}

// 复数转字符串
定义 复数字符串(z) {
    设 r = 取键(z, "实")
    设 i = 取键(z, "虚")
    若 (大于等于(i, 0)) {
        返回(连接(转字符串(r), "+", 转字符串(i), "i"))
    }
    返回(连接(转字符串(r), 转字符串(i), "i"))
}

// ==================== 向量 ====================

// 向量加法
定义 向量加(a, b) {
    设 result = 列表()
    遍历 i 从 0 到 减(取长(a), 1) {
        result = 列表合(result, 列表(加(取(a, i), 取(b, i))))
    }
    返回(result)
}

// 向量减法
定义 向量减(a, b) {
    设 result = 列表()
    遍历 i 从 0 到 减(取长(a), 1) {
        result = 列表合(result, 列表(减(取(a, i), 取(b, i))))
    }
    返回(result)
}

// 向量标量乘
定义 向量标量乘(v, s) {
    设 result = 列表()
    遍历 i 从 0 到 减(取长(v), 1) {
        result = 列表合(result, 列表(乘(取(v, i), s)))
    }
    返回(result)
}

// 向量叉积（3D）
定义 向量叉积(a, b) {
    返回(列表(
        减(乘(取(a, 1), 取(b, 2)), 乘(取(a, 2), 取(b, 1))),
        减(乘(取(a, 2), 取(b, 0)), 乘(取(a, 0), 取(b, 2))),
        减(乘(取(a, 0), 取(b, 1)), 乘(取(a, 1), 取(b, 0)))
    ))
}

// 向量距离
定义 向量距离(a, b) {
    设 sum = 0
    遍历 i 从 0 到 减(取长(a), 1) {
        设 diff = 减(取(a, i), 取(b, i))
        sum = 加(sum, 乘(diff, diff))
    }
    返回(平方根(sum))
}

// ==================== 统计 ====================

// 移动平均
定义 移动平均(数据, 窗口) {
    设 result = 列表()
    遍历 i 从 0 到 减(取长(数据), 窗口) {
        设 sum = 0
        遍历 j 从 0 到 减(窗口, 1) {
            sum = 加(sum, 取(数据, 加(i, j)))
        }
        result = 列表合(result, 列表(除(sum, 窗口)))
    }
    返回(result)
}

// 指数加权移动平均
定义 EWMA(数据, alpha) {
    设 result = 列表(取(数据, 0))
    遍历 i 从 1 到 减(取长(数据), 1) {
        设 prev = 取(result, 减(取长(result), 1))
        设 curr = 取(数据, i)
        设 val = 加(乘(alpha, curr), 乘(减(1, alpha), prev))
        result = 列表合(result, 列表(val))
    }
    返回(result)
}

// 导出
导出 复数 复数加 复数乘 复数模 复数字符串
导出 向量加 向量减 向量标量乘 向量叉积 向量距离
导出 移动平均 EWMA
