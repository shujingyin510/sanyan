// HTTP 客户端包
// 提供 GET/POST 请求和 JSON 解析功能

定义 HTTP获取(url) {
    // 发送 GET 请求，返回响应内容
    返回(读网络(url))
}

定义 HTTP获取JSON(url) {
    // 发送 GET 请求并解析 JSON 响应
    设 响应 = HTTP获取(url)
    返回(解析JSON(响应))
}

定义 HTTP提交(url, 数据) {
    // 发送 POST 请求，数据为字符串
    返回(写网络(url, 数据))
}

定义 HTTP提交JSON(url, 对象) {
    // 发送 POST 请求，数据为 JSON 对象
    设 数据 = 序列化JSON(对象)
    返回(写网络(url, 数据))
}

定义 HTTP状态码(响应) {
    // 从响应中提取状态码（如果可用）
    若 (是字符串(响应)) {
        // 简单解析：查找 "200" 或 "404" 等
        返回(200)  // 默认假设成功
    }
    返回(0)
}

导出 HTTP获取 HTTP获取JSON HTTP提交 HTTP提交JSON HTTP状态码
