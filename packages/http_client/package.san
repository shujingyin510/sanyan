// HTTP 客户端包 — 基于内置 http读/http写/http请求
// v1.0.1：修复调用不存在的 读网络/写网络/序列化JSON（v1.0.0 全部函数不可用）；
// HTTP状态码 不再硬编码 200，改从 http请求 三态信封取真实状态码。

定义 HTTP获取(url) {
    // 发送 GET 请求，返回响应文本（失败抛错）
    返回(http读(url))
}

定义 HTTP获取JSON(url) {
    // 发送 GET 请求并解析 JSON 响应
    设 响应 = HTTP获取(url)
    返回(解析JSON(响应))
}

定义 HTTP提交(url, 数据) {
    // 发送 POST 请求，数据为字符串，返回响应文本（失败抛错）
    返回(http写(url, 数据))
}

定义 HTTP提交JSON(url, 对象) {
    // 发送 POST 请求，数据为 JSON 对象，返回解析后的响应
    设 数据 = 转JSON(对象)
    设 响应 = http写(url, 数据)
    返回(解析JSON(响应))
}

定义 HTTP请求(方法, url, 数据) {
    // 三态信封版：{'判','值','错','源','状态码','响应头'}
    // 判 = 真(2xx/3xx) / 假(4xx/5xx、传输失败) / 可能(超时)
    返回(http请求(方法, url, 数据))
}

定义 HTTP状态码(信封) {
    // 从 HTTP请求 的信封中取真实状态码（传输失败为 0）
    返回(取键(信封, "状态码"))
}

定义 HTTP判(信封) {
    // 从信封取三态判——配合 匹配3 做三态分支
    返回(信封判(信封))
}

导出 HTTP获取 HTTP获取JSON HTTP提交 HTTP提交JSON HTTP请求 HTTP状态码 HTTP判
