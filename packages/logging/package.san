// packages/logging/package.san — 结构化日志库
// 提供多级别日志、格式化输出、日志文件写入

设 LOG_DEBUG = 0
设 LOG_INFO = 1
设 LOG_WARN = 2
设 LOG_ERROR = 3
设 LOG_FATAL = 4

设 级别名称 = 字典(
    "0", "DEBUG",
    "1", "INFO",
    "2", "WARN",
    "3", "ERROR",
    "4", "FATAL"
)

// 日志配置
定义 日志配置(级别, 输出文件) {
    返回(字典(
        "级别", 级别,
        "文件", 输出文件,
        "缓冲", 列表()
    ))
}

// 格式化日志消息
定义 格式化日志(级别, 消息, 上下文) {
    设 时间 = 格式化时间(时间戳())
    设 级别名 = 取键(级别名称, 转字符串(级别))
    设 ctx = ""
    若 (非(等于(上下文, ""))) {
        ctx = 连接(" ", 转JSON(上下文))
    }
    返回(连接("[", 时间, "] [", 级别名, "] ", 消息, ctx))
}

// 写日志
定义 写日志(配置, 级别, 消息, 上下文) {
    设 当前级别 = 取键(配置, "级别")
    若 (小于(级别, 当前级别)) { 返回(假) }

    设 格式化 = 格式化日志(级别, 消息, 上下文)
    输出(格式化)

    设 文件 = 取键(配置, "文件")
    若 (非(等于(文件, ""))) {
        追加写文件(文件, 连接(格式化, "\n"))
    }
    返回(真)
}

// 日志函数
定义 调试(配置, 消息, 上下文) {
    返回(写日志(配置, LOG_DEBUG, 消息, 上下文))
}

定义 信息(配置, 消息, 上下文) {
    返回(写日志(配置, LOG_INFO, 消息, 上下文))
}

定义 警告(配置, 消息, 上下文) {
    返回(写日志(配置, LOG_WARN, 消息, 上下文))
}

定义 错误(配置, 消息, 上下文) {
    返回(写日志(配置, LOG_ERROR, 消息, 上下文))
}

定义 致命(配置, 消息, 上下文) {
    返回(写日志(配置, LOG_FATAL, 消息, 上下文))
}

// 性能计时
定义 计时开始() {
    返回(时间戳())
}

定义 计时结束(开始时间, 标签) {
    设 耗时 = 减(时间戳(), 开始时间)
    信息(日志配置(LOG_INFO, ""), 连接(标签, " 耗时: ", 转字符串(耗时), "ms"), "")
    返回(耗时)
}

导出 LOG_DEBUG LOG_INFO LOG_WARN LOG_ERROR LOG_FATAL
导出 日志配置 写日志 调试 信息 警告 错误 致命
导出 计时开始 计时结束
