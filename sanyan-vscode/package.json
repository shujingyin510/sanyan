{
  "name": "sanyan",
  "displayName": "三言 Sanyan Language",
  "description": "三言编程语言支持 — LSP 语法高亮/补全/诊断/跳转定义",
  "version": "0.2.0",
  "publisher": "sanyan",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shujingyin510/sanyan"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "keywords": ["sanyan", "三言", "chinese", "ternary"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:sanyan"],
  "contributes": {
    "languages": [
      {
        "id": "sanyan",
        "aliases": ["三言", "sanyan"],
        "extensions": [".san"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sanyan",
        "scopeName": "source.sanyan",
        "path": "./syntaxes/sanyan.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
