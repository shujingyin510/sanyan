{
  "name": "sanyan-language",
  "displayName": "三言 Sanyan Language",
  "description": "三言编程语言支持 — LSP 语法高亮/补全/诊断",
  "version": "0.1.0",
  "publisher": "sanyan",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:sanyan"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sanyan",
        "aliases": ["三言", "sanyan"],
        "extensions": [".san"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sanyan",
        "scopeName": "source.sanyan",
        "path": "./syntaxes/sanyan.tmLanguage.json"
      }
    ]
  }
}
