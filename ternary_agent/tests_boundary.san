// 三言 Agent — 边界测试（5 条）

设 dec = 导入("ternary_agent/decision.san")
设 iface = 导入("ternary_agent/llm_iface.san")

// 配置常量
设 最大犹豫次数 = 3
设 最小增益阈值 = 0.1

输出("=== 边界测试 ===")

// 1. JSON 解析失败 -> 默认 UNCERT
输出("1. JSON 解析失败 -> 默认 UNCERT")
设 r = iface.解析响应("{invalid_json}")
设 cog = 取键(r, "cogState")
若 (字符串相等(cog, "UNCERT")) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望 UNCERT，cogState=", 转字符串(cog)))
}

输出("")

// 2. 连续 4 次可能 -> 触发犹豫保护
输出("2. 连续 4 次可能 -> 触发犹豫保护")
设 历史 = 列表(1, 1, 1, 1)
设 r = dec.保护(4, 0.5, "低", 历史, 最大犹豫次数, 最小增益阈值)
设 决策 = 取(r, 0)
若 (决策 != 0) {
    输出(连接("  PASS: 决策=", 转字符串(决策)))
} 否则 {
    输出("  FAIL: 应该触发保护")
}

输出("")

// 3. 高风险 -> 直接拒绝
输出("3. 高风险 -> 直接拒绝")
设 r = dec.保护(0, 1.0, "高", 列表(), 最大犹豫次数, 最小增益阈值)
若 (取(r, 0) == -1) {
    输出(连接("  PASS: ", 取(r, 1)))
} 否则 {
    输出(连接("  FAIL: 决策=", 转字符串(取(r, 0))))
}

输出("")

// 4. 上游假 -> 传播拒绝下游
输出("4. 上游假 -> 传播拒绝下游")
设 r = dec.传播(-1, 1)
若 (r == -1) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望-1, 实际", 转字符串(r)))
}

输出("")

// 5. 上游可能 -> 下游真降级为可能
输出("5. 上游可能 -> 下游真降级为可能")
设 r = dec.传播(0, 1)
若 (r == 0) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望0, 实际", 转字符串(r)))
}
