// 三言 Agent — LLM HTTP 调用封装
// 用 curl 命令调用 OpenAI 兼容 API

定义 调用LLM (模型URL, API密钥, 模型名, 超时秒数, 系统提示, 用户消息) {
    设 body = 转JSON(字典(
        "model", 模型名,
        "messages", 列表(
            字典("role", "system", "content", 系统提示),
            字典("role", "user", "content", 用户消息)
        )
    ))
    设 cmd = 连接(
        "curl -s -m ", 转字符串(超时秒数),
        " -H \"Authorization: Bearer ", API密钥, "\"",
        " -H \"Content-Type: application/json\"",
        " -d '", body, "' ",
        模型URL
    )
    返回(执行(cmd))
}

导出 调用LLM
