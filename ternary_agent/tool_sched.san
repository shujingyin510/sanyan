// 三言 Agent — 工具调度层

设 工具风险 = 字典(
    "query_weather", "低",
    "send_email", "高",
    "delete_file", "高",
    "write_code", "中"
)

// === 工具执行性能追踪 ===
设 _工具性能 = 字典()

定义 调度工具 (tool, params) {
    若 (取长(tool) == 0) { 返回(列表("无工具调用", 1.0)) }

    设 风险 = "低"
    尝试 {
        设 风险 = 取键(工具风险, tool)
    } 捕获 (e) { }

    若 (字符串相等(风险, "高")) {
        返回(列表(连接("被安全门控拒绝：", tool), 0.0))
    }

    若 (字符串相等(tool, "query_weather")) {
        返回(列表(模拟天气(params), 1.0))
    }

    若 (字符串相等(tool, "write_code")) {
        返回(执行代码(params))
    }

    返回(列表(连接("tool ", tool, " done"), 0.8))
}

// === 代码执行工具 — 三态置信度传播 ===
// 流程: LLM生成代码 → 沙箱求值器执行 → (结果, 信度)
定义 执行代码 (需求描述) {
    设 结果 = ""
    设 信度 = 0.0

    尝试 {
        // 生成代码提示词
        设 prompt = 连接("用三言(Sanyan)写程序。三言语法：设 变量名 = 值，若 (条件) { ... }，循环 (条件) { ... }，返回(...)。只输出代码。需求：", 需求描述)
        设 代码 = 调用LLM(协议提示词, prompt)
        若 (取长(代码) < 5) {
            返回(列表("代码生成失败", 0.01))
        }
        设 内容 = 解析响应(代码)
        设 清洗后 = 取键(内容, "answer")
        若 (取长(清洗后) < 5) {
            设 清洗后 = 代码
        }

        // 沙箱执行（Python 端注册 新求值器/求值，不可用时降级）
        设 结果 = ""
        设 信度 = 0.8
        尝试 {
            设 evaluator = 新求值器()
            设 求值结果 = 求值(evaluator, 清洗后)
            设 结果 = 转字符串(求值结果)
        } 捕获 (e) {
            设 结果 = 连接("(沙箱不可用，代码已生成: ", 清洗后, ")", 转字符串(e))
            设 信度 = 0.3
        }
    } 捕获 (e) {
        设 结果 = 连接("执行错误: ", 转字符串(e))
        设 信度 = 0.1
        若 (字符串包含(结果, "语法")) {
            设 信度 = 0.05
        }
    }

    // 更新工具性能追踪
    设 工具名 = "write_code"
    设 追踪 = 字典()
    尝试 {
        若 (含键(_工具性能, 工具名)) { 设 追踪 = 取键(_工具性能, 工具名) }
        否则 { 设 追踪 = 字典("调用次数", 0, "成功次数", 0, "失败次数", 0, "总信度", 0.0, "最近错误", 列表()) }
    } 捕获 (e) { }

    置键(追踪, "调用次数", 加(取键(追踪, "调用次数"), 1))
    若 (信度 >= 0.5) {
        置键(追踪, "成功次数", 加(取键(追踪, "成功次数"), 1))
    } 否则 {
        置键(追踪, "失败次数", 加(取键(追踪, "失败次数"), 1))
        设 错误列表 = 取键(追踪, "最近错误")
        设 错误列表 = 列表合(错误列表, 列表(结果))
        置键(追踪, "最近错误", 错误列表)
    }
    置键(追踪, "总信度", 加(取键(追踪, "总信度"), 信度))
    置键(_工具性能, 工具名, 追踪)

    // 自适应降级：连续3次失败 → 标记为不可靠
    设 连续失败 = 0
    设 失败记录 = 取键(追踪, "最近错误")
    设 i = 减(表长(失败记录), 1)
    循环 (i >= 0) {
        设 连续失败 = 加(连续失败, 1)
        若 (连续失败 >= 3) {
            输出(连接("→ [系统] write_code 连续", 转字符串(连续失败), "次失败，建议人工介入"))
            跳出
        }
        设 i = 减(i, 1)
    }

    返回(列表(结果, 信度))
}

定义 工具审计报告 () {
    若 (取长(_工具性能) == 0) { 返回("无工具调用记录") }
    设 报告 = "=== 工具性能报告 ===\n"
    设 keys = 字典键列表(_工具性能)
    设 i = 0
    循环 (i < 表长(keys)) {
        设 k = 取(keys, i)
        设 追踪 = 取键(_工具性能, k)
        设 调用 = 取键(追踪, "调用次数")
        设 成功 = 取键(追踪, "成功次数")
        设 失败 = 取键(追踪, "失败次数")
        设 平均信度 = 除(取键(追踪, "总信度"), 调用)
        设 报告 = 连接(报告, k, ": 调用", 转字符串(调用), "次 成功", 转字符串(成功), "次 失败", 转字符串(失败), "次 均信度", 转字符串(平均信度), "\n")
        设 i = 加(i, 1)
    }
    返回(报告)
}

定义 模拟天气 (city) {
    若 (字符串相等(city, "北京")) { 返回("北京：晴 25度C") }
    若 (字符串相等(city, "上海")) { 返回("上海：多云 28度C") }
    返回(连接(city, "：未知"))
}

导出 调度工具 模拟天气 工具审计报告
