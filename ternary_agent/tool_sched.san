// 三言 Agent — 工具调度层

设 工具风险 = 字典(
    "query_weather", "低",
    "send_email", "高",
    "delete_file", "高"
)

定义 调度工具 (tool, params, 保护函数, 最大犹豫次数, 最小增益阈值) {
    若 (取长(tool) == 0) { 返回("无工具调用") }

    设 风险 = "低"
    尝试 {
        设 风险 = 取键(工具风险, tool)
    } 捕获 (e) { }

    若 (字符串相等(风险, "高")) {
        设 门控 = 保护函数(0, 1.0, "高", 列表(), 最大犹豫次数, 最小增益阈值)
        若 (取(门控, 0) == -1) { 返回(连接("被安全门控拒绝：", tool)) }
    }

    若 (字符串相等(tool, "query_weather")) {
        返回(模拟天气(params))
    }

    返回(连接("tool ", tool, " done"))
}

定义 模拟天气 (city) {
    若 (字符串相等(city, "北京")) { 返回("北京：晴 25度C") }
    若 (字符串相等(city, "上海")) { 返回("上海：多云 28度C") }
    返回(连接(city, "：未知"))
}

导出 调度工具 模拟天气
