// 三言 Agent — 决策核心（字典驱动版）
// 5态->3态映射 + 传播规则 + 犹豫保护 + 多数投票
// 注：配置常量（五态映射规则、最大犹豫次数等）由 agent_policy.san 提供

// --- 5态->3态映射（字典驱动）---
定义 映射到三态 (cogState)
{
    若 (含键(五态映射规则, cogState)) {
        返回(取键(五态映射规则, cogState))
    }
    返回(0)
}

// --- 传播规则 ---
定义 传播 (上游, 当前)
{
    若 (上游 == -1) { 返回(-1) }
    若 (上游 == 0 且 当前 == 1) { 返回(0) }
    返回(当前)
}

// --- 提取认知态 ---
定义 取认知 (mapped)
{
    若 (是字典(mapped)) { 返回(取键(mapped, "认知")) }
    返回(mapped)
}

// --- 提取执行态 ---
定义 取执行 (mapped)
{
    若 (是字典(mapped)) { 返回(取键(mapped, "执行")) }
    返回("就绪")
}

// --- 判断真正可能态 ---
定义 是可能态 (mapped)
{
    设 c = 取认知(mapped)
    设 e = 取执行(mapped)
    返回(c == 0 且 字符串相等(e, "就绪"))
}

// --- 犹豫保护（使用全局配置 最大犹豫次数/最小增益阈值）---
定义 保护 (可能次数, 增益, 风险, hist)
{
    若 (字符串相等(风险, "高")) { 返回(字典("action", "block", "reason", "高风险：不确定就不做", "投票结果", -1)) }
    若 (可能次数 >= 最大犹豫次数) { 返回(字典("action", "block", "reason", "犹豫次数用尽", "投票结果", 多数投票(hist))) }
    若 (增益 < 最小增益阈值) { 返回(字典("action", "continue", "reason", "信息增益不足(继续)", "投票结果", 多数投票(hist))) }
    返回(字典("action", "continue", "投票结果", 0))
}

// --- 获取规则权重（元认知反思用）---
定义 获取规则权重 (场景名)
{
    若 (含键(规则性能, 场景名)) {
        返回(取键(取键(规则性能, 场景名), "权重"))
    }
    返回(1.0)
}

// --- 多数投票 ---
定义 多数投票 (hist)
{
    设 真票 = 0
    设 假票 = 0
    设 len = 表长(hist)
    设 i = 0
    循环 (i < len) {
        设 v = 取(hist, i)
        若 (v == 1) { 设 真票 = 真票 + 1 }
        若 (v == -1) { 设 假票 = 假票 + 1 }
        设 i = i + 1
    }
    若 (真票 > 假票) { 返回(1) }
    若 (假票 > 真票) { 返回(-1) }
    返回(0)
}

// --- 否定词列表（用于关键词匹配中的否定检测）---
// 只使用单字否定词，避免"会不会"等疑问句误触发
设 否定词列表 = 列表(
    "不", "没", "别", "勿", "莫", "未", "非", "无"
)

// --- 否定检测：检查关键词前是否有否定词（单字紧邻）---
定义 有否定词 (文本, 关键词)
{
    // 检查文本中是否包含否定词+关键词的紧邻组合
    设 i = 0
    设 len = 表长(否定词列表)
    循环 (i < len) {
        设 否定词 = 取(否定词列表, i)
        设 组合 = 连接(否定词, 关键词)
        若 (字符串包含(文本, 组合)) {
            返回(真)
        }
        设 i = i + 1
    }
    返回(假)
}

// --- 关键词分数（带否定检测和加权）---
定义 关键词分数 (问题, 关键词列表)
{
    设 分数 = 0
    设 i = 0
    设 len = 表长(关键词列表)
    循环 (i < len) {
        设 kw = 取(关键词列表, i)
        若 (字符串包含(问题, kw)) {
            若 (有否定词(问题, kw)) {
                // 否定词修饰：分数减半
                设 分数 = 分数 - 1
            } 否则 {
                设 分数 = 分数 + 1
            }
        }
        设 i = i + 1
    }
    返回(分数)
}

// --- 匹配规则（遍历场景规则列表，信任感知 + 条件嵌套）---
定义 匹配规则 (问题, 当前信任)
{
    设 最佳 = 假
    设 最佳分 = 0
    设 i = 0
    设 len = 表长(场景规则)
    循环 (i < len) {
        设 规则 = 取(场景规则, i)
        设 场景名 = 取键(规则, "场景")
        设 kws = 分割(取键(规则, "关键词"), ",")
        设 分 = 关键词分数(问题, kws)
        // 高风险规则自动加权 2x（安全优先）
        尝试 {
            若 (含键(规则, "风险")) {
                若 (字符串相等(取键(规则, "风险"), "高")) { 设 分 = 分 * 2 }
            }
        } 捕获 (_) { }
        // 全部匹配模式
        尝试 {
            若 (含键(规则, "必须全部匹配")) {
                设 是否全中 = 取键(规则, "必须全部匹配")
                若 (是否全中) {
                    设 期望命中 = 表长(kws)
                    若 (小于(分, 期望命中)) { 设 分 = 0 }
                }
            }
        } 捕获 (_) { }
        // 信任感知：低信任时高风险规则升级权重
        尝试 {
            若 (含键(规则, "信任阈值")) {
                设 阈值 = 取键(规则, "信任阈值")
                若 (小于(当前信任, 阈值) 且 大于(分, 0)) {
                    设 分 = 分 * 3  // 低信任时该规则优先级暴涨
                }
            }
        } 捕获 (_) { }
        // 条件字段：支持简单表达式
        尝试 {
            若 (含键(规则, "条件")) {
                设 条件值 = 取键(规则, "条件")
                若 (字符串相等(条件值, "信任低") 且 大于等于(当前信任, 0.3)) { 设 分 = 0 }
                若 (字符串相等(条件值, "信任中") 且 或(小于(当前信任, 0.3), 大于等于(当前信任, 0.7))) { 设 分 = 0 }
                若 (字符串相等(条件值, "信任高") 且 小于(当前信任, 0.7)) { 设 分 = 0 }
            }
        } 捕获 (_) { }
        // 应用规则权重
        设 权重 = 获取规则权重(场景名)
        设 加权分 = 分 * 权重
        若 (加权分 > 最佳分) {
            设 最佳分 = 加权分
            设 最佳 = 规则
        }
        设 i = i + 1
    }
    若 (等于(最佳, 假)) {
        返回(字典("场景", "未知", "关键词", "", "风险", "低", "要求好感", 0, "默认动作", "NEED_HUMAN"))
    }
    返回(最佳)
}

导出 映射到三态 传播 取认知 取执行 是可能态 保护 多数投票 关键词分数 匹配规则
