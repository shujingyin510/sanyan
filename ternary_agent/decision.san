// 三言 Agent — 决策核心（字典驱动版）
// 5态->3态映射 + 传播规则 + 犹豫保护 + 多数投票
// 注：配置常量（五态映射规则、最大犹豫次数等）由 agent_policy.san 提供

// --- 5态->3态映射（字典驱动）---
定义 映射到三态 (cogState) {
    若 (含键(五态映射规则, cogState)) {
        返回(取键(五态映射规则, cogState))
    }
    返回(0)
}

// --- 传播规则 ---
定义 传播 (上游, 当前) {
    若 (上游 == -1) { 返回(-1) }
    若 (上游 == 0 且 当前 == 1) { 返回(0) }
    返回(当前)
}

// --- 提取认知态 ---
定义 取认知 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "认知")) }
    返回(mapped)
}

// --- 提取执行态 ---
定义 取执行 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "执行")) }
    返回("就绪")
}

// --- 判断真正可能态 ---
定义 是可能态 (mapped) {
    设 c = 取认知(mapped)
    设 e = 取执行(mapped)
    返回(c == 0 且 字符串相等(e, "就绪"))
}

// --- 犹豫保护（使用全局配置 最大犹豫次数/最小增益阈值）---
定义 保护 (可能次数, 增益, 风险, hist) {
    若 (字符串相等(风险, "高")) { 返回(列表(-1, "高风险：不确定就不做")) }
    若 (可能次数 >= 最大犹豫次数) { 返回(列表(多数投票(hist), "犹豫次数用尽")) }
    若 (增益 < 最小增益阈值) { 返回(列表(多数投票(hist), "信息增益不足")) }
    返回(列表(0, "continue"))
}

// --- 获取规则权重（元认知反思用）---
定义 获取规则权重 (场景名) {
    若 (含键(规则性能, 场景名)) {
        返回(取键(取键(规则性能, 场景名), "权重"))
    }
    返回(1.0)
}

// --- 多数投票 ---
定义 多数投票 (hist) {
    设 真票 = 0
    设 假票 = 0
    设 len = 表长(hist)
    设 i = 0
    循环 (i < len) {
        设 v = 取(hist, i)
        若 (v == 1) { 设 真票 = 真票 + 1 }
        若 (v == -1) { 设 假票 = 假票 + 1 }
        设 i = i + 1
    }
    若 (真票 > 假票) { 返回(1) }
    若 (假票 > 真票) { 返回(-1) }
    返回(0)
}

// --- 否定词列表（用于关键词匹配中的否定检测）---
// 只使用单字否定词，避免"会不会"等疑问句误触发
设 否定词列表 = 列表(
    "不", "没", "别", "勿", "莫", "未", "非", "无"
)

// --- 否定检测：检查关键词前是否有否定词（单字紧邻）---
定义 有否定词 (文本, 关键词) {
    // 检查文本中是否包含否定词+关键词的紧邻组合
    设 i = 0
    设 len = 表长(否定词列表)
    循环 (i < len) {
        设 否定词 = 取(否定词列表, i)
        设 组合 = 连接(否定词, 关键词)
        若 (字符串包含(文本, 组合)) {
            返回(真)
        }
        设 i = i + 1
    }
    返回(假)
}

// --- 关键词分数（带否定检测和加权）---
定义 关键词分数 (问题, 关键词列表) {
    设 分数 = 0
    设 i = 0
    设 len = 表长(关键词列表)
    循环 (i < len) {
        设 kw = 取(关键词列表, i)
        若 (字符串包含(问题, kw)) {
            若 (有否定词(问题, kw)) {
                // 否定词修饰：分数减半
                设 分数 = 分数 - 1
            } 否则 {
                设 分数 = 分数 + 1
            }
        }
        设 i = i + 1
    }
    返回(分数)
}

// --- 匹配规则（遍历场景规则列表，带权重）---
定义 匹配规则 (问题) {
    设 最佳 = 假
    设 最佳分 = 0
    设 i = 0
    设 len = 表长(场景规则)
    循环 (i < len) {
        设 规则 = 取(场景规则, i)
        设 场景名 = 取键(规则, "场景")
        设 kws = 分割(取键(规则, "关键词"), ",")
        设 分 = 关键词分数(问题, kws)
        // 应用规则权重（来自元认知反思）
        设 权重 = 获取规则权重(场景名)
        设 加权分 = 分 * 权重
        若 (加权分 > 最佳分) {
            设 最佳分 = 加权分
            设 最佳 = 规则
        }
        设 i = i + 1
    }
    // 无匹配时返回默认规则
    若 (等于(最佳, 假)) {
        返回(字典("场景", "未知", "关键词", "", "风险", "低", "要求好感", 0, "默认动作", "NEED_HUMAN"))
    }
    返回(最佳)
}

导出 映射到三态 传播 取认知 取执行 是可能态 保护 多数投票 关键词分数 匹配规则
