// 三言 Agent — 决策核心
// 5态->3态映射 + 传播规则 + 犹豫保护 + 多数投票
// 注：配置常量（最大犹豫次数、最小增益阈值）由调用方传入

// --- 5态->3态映射 ---
定义 映射到三态 (cogState) {
    若 (字符串相等(cogState, "AFFIRM")) { 返回(1) }
    若 (字符串相等(cogState, "NEGATE")) { 返回(-1) }
    若 (字符串相等(cogState, "CONFLICTED")) {
        返回(字典("认知", 0, "执行", "就绪", "子策略", "conflict"))
    }
    若 (字符串相等(cogState, "PENDING")) {
        返回(字典("认知", 1, "执行", "等待", "子策略", "pending"))
    }
    若 (字符串相等(cogState, "UNCERT")) {
        返回(字典("认知", 0, "执行", "就绪", "子策略", "uncertain"))
    }
    返回(字典("认知", 0, "执行", "就绪", "子策略", "default"))
}

// --- 传播规则 ---
定义 传播 (上游, 当前) {
    若 (上游 == -1) { 返回(-1) }
    若 (上游 == 0 且 当前 == 1) { 返回(0) }
    返回(当前)
}

// --- 提取认知态 ---
定义 取认知 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "认知")) }
    返回(mapped)
}

// --- 提取执行态 ---
定义 取执行 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "执行")) }
    返回("就绪")
}

// --- 判断真正可能态 ---
定义 是可能态 (mapped) {
    设 c = 取认知(mapped)
    设 e = 取执行(mapped)
    返回(c == 0 且 字符串相等(e, "就绪"))
}

// --- 犹豫保护（maxHesitate/minGain 由调用方传入） ---
定义 保护 (可能次数, 增益, 风险, hist, 最大犹豫次数, 最小增益阈值) {
    若 (字符串相等(风险, "高")) { 返回(列表(-1, "高风险：不确定就不做")) }
    若 (可能次数 >= 最大犹豫次数) { 返回(列表(多数投票(hist), "犹豫次数用尽")) }
    若 (增益 < 最小增益阈值) { 返回(列表(多数投票(hist), "信息增益不足")) }
    返回(列表(0, "continue"))
}

// --- 多数投票 ---
定义 多数投票 (hist) {
    设 真票 = 0
    设 假票 = 0
    设 len = 表长(hist)
    设 i = 0
    循环 (i < len) {
        设 v = 取(hist, i)
        若 (v == 1) { 设 真票 = 真票 + 1 }
        若 (v == -1) { 设 假票 = 假票 + 1 }
        设 i = i + 1
    }
    若 (真票 > 假票) { 返回(1) }
    若 (假票 > 真票) { 返回(-1) }
    返回(0)
}

导出 映射到三态 传播 取认知 取执行 是可能态 保护 多数投票
