// 三言 Agent - 配置集中到 agent_policy.san
// 运行: python -X utf8 run_agent.py "你的问题"
// 决策核心（映射/传播/保护/投票/规则匹配）统一在 decision.san
#include "ternary_agent/agent_policy.san"
#include "ternary_agent/decision.san"

// === 概率三态置信度工具 ===
// odds 比值形式：odds = p/(1-p), p = odds/(1+odds)
// 置信度概率化：用 odds 比值实现贝叶斯更新
定义 置信度到odds (p) {
    若 (p >= 0.99) { 返回(99.0) }
    若 (p <= 0.01) { 返回(0.0101) }
    返回(除(p, 减(1.0, p)))
}

定义 odds到置信度 (odds) {
    若 (odds >= 99.0) { 返回(0.99) }
    若 (odds <= 0.01) { 返回(0.01) }
    返回(除(odds, 加(1.0, odds)))
}

// === LLM 调用（带重试和降级）===
定义 调用LLM (系统提示, 用户消息) {
    若 (字符串相等(API密钥, "sk-你的key")) {
        返回(转JSON(字典("error", "API密钥未配置，请设置环境变量 SANYAN_API_KEY")))
    }
    设 body = 转JSON(字典(
        "model", 模型名,
        "messages", 列表(
            字典("role", "system", "content", 系统提示),
            字典("role", "user", "content", 用户消息)
        ),
        "temperature", 0.7
    ))
    设 headers = 字典(
        "Content-Type", "application/json",
        "Authorization", 连接("Bearer ", API密钥)
    )
    // 重试机制：最多 3 次，间隔 1s → 2s → 4s
    设 最大重试 = 3
    设 重试间隔 = 1000
    设 尝试次数 = 0
    循环 (尝试次数 < 最大重试) {
        尝试 {
            设 resp = http写(模型URL, body, headers)
            若 (非(等于(resp, "")) 且 非(等于(resp, 假))) {
                返回(resp)
            }
        } 捕获 (e) {
            输出(连接("⚠ LLM调用异常(重试", 连接(转字符串(尝试次数 + 1), ")")))
        }
        设 尝试次数 = 尝试次数 + 1
        若 (尝试次数 < 最大重试) {
            等待(重试间隔)
            设 重试间隔 = 重试间隔 * 2
        }
    }
    // 所有重试失败：降级到规则匹配
    输出("⚠ LLM 调用失败，降级到规则匹配")
    返回(转JSON(字典("error", "LLM不可用，已降级")))
}

定义 解析响应 (raw) {
    设 outer = 解析JSON(raw)
    若 (非(是字典(outer))) {
        返回(字典("cogState","UNCERT","actState","NEED_HUMAN","answer","格式异常","tool","","params",""))
    }
    尝试 {
        设 choices = 取键(outer, "choices")
        设 first = 取(choices, 0)
        设 msg = 取键(first, "message")
        设 content = 取键(msg, "content")
        设 parsed = 解析JSON(content)
        若 (非(是字典(parsed))) {
            返回(字典("cogState","UNCERT","actState","NEED_HUMAN","answer","JSON异常","tool","","params",""))
        }
        返回(字典(
            "cogState", 取键(parsed, "cog"),
            "actState", 取键(parsed, "act"),
            "answer", 取键(parsed, "answer"),
            "tool", 取键(parsed, "tool"),
            "params", 取键(parsed, "params")
        ))
    } 捕获 (e) {
        返回(字典("cogState","UNCERT","actState","NEED_HUMAN","answer","解析失败","tool","","params",""))
    }
}

// === 记忆 ===
设 记忆表 = 字典()

定义 记 (key, state, source) {
    置键(记忆表, key, 字典("state",state,"source",source,"ttl",时间戳()+默认TTL))
}

定义 忆 (key) {
    若 (非(含键(记忆表, key))) { 返回("") }
    设 entry = 取键(记忆表, key)
    若 (时间戳() > 取键(entry, "ttl")) { 删除键(记忆表, key); 返回("") }
    返回(取键(entry, "state"))
}

定义 记忆列表 () {
    设 out = ""
    设 keys = 字典键列表(记忆表)
    设 len = 表长(keys)
    设 i = 0
    循环 (i < len) {
        设 k = 取(keys, i)
        设 out = 连接(out, k, ":", 转字符串(忆(k)), "; ")
        设 i = i + 1
    }
    返回(out)
}

// 清理过期记忆条目（在每轮对话开始时调用）
定义 清理过期记忆 () {
    设 keys = 字典键列表(记忆表)
    设 len = 表长(keys)
    设 i = 0
    设 待删除 = 列表()
    // 先收集过期键
    循环 (i < len) {
        设 k = 取(keys, i)
        设 entry = 取键(记忆表, k)
        若 (是字典(entry) 且 含键(entry, "ttl")) {
            若 (时间戳() > 取键(entry, "ttl")) {
                设 待删除 = 列表合(待删除, 列表(k))
            }
        }
        设 i = 加(i, 1)
    }
    // 再批量删除
    设 清理数 = 表长(待删除)
    设 j = 0
    循环 (j < 清理数) {
        删除键(记忆表, 取(待删除, j))
        设 j = 加(j, 1)
    }
    若 (清理数 > 0) {
        输出(连接("→ [记忆] 清理 ", 连接(转字符串(清理数), " 条过期记忆")))
    }
}

// === 记忆持久化 ===
定义 保存记忆 () {
    写文件(记忆文件, 转JSON(记忆表))
}

定义 加载记忆 () {
    尝试 {
        设 raw = 读文件(记忆文件)
        若 (取长(raw) > 0) {
            设 loaded = 解析JSON(raw)
            若 (是字典(loaded)) {
                设 keys = 字典键列表(loaded)
                设 i = 0
                设 len = 表长(keys)
                循环 (i < len) {
                    设 k = 取(keys, i)
                    置键(记忆表, k, 取键(loaded, k))
                    设 i = i + 1
                }
            }
        }
    } 捕获 (e) {
        // 记忆加载失败（文件不存在/权限/JSON损坏），静默继续
        输出(连接("[记忆] 加载失败: ", 转字符串(e)))
    }
}

// === 上下文 ===
设 _ctx = 字典("冲突记录", 列表())

定义 判断相关性 (片段, 问题) {
    设 命中 = 0
    设 i = 0
    设 qlen = 取长(问题)
    循环 (i < qlen) {
        设 kw = 子串(问题, i, 1)
        若 (取长(kw) > 0 且 字符串包含(片段, kw)) { 设 命中 = 命中 + 1 }
        设 i = i + 1
    }
    若 (命中 >= 2) { 返回(1) }
    若 (命中 == 0) { 返回(-1) }
    返回(0)
}

定义 压缩上下文 (旧, 新) {
    设 all = 列表合(旧, 列表(新))
    设 keep = 列表()
    设 summary = 列表()
    设 len = 表长(all)
    设 i = 0
    循环 (i < len) {
        设 s = 取(all, i)
        设 rel = 判断相关性(s, 新)
        若 (rel == 1) { 设 keep = 列表合(keep, 列表(s)) }
        若 (rel == 0) {
            设 摘要 = 子串(s, 0, 50)
            若 (取长(s) > 50) { 设 摘要 = 连接(摘要, "...") }
            设 summary = 列表合(summary, 列表(摘要))
        }
        设 i = i + 1
    }
    返回(列表合(keep, summary))
}

定义 计算增益 (新, 旧) {
    设 joined = ""
    设 j = 0
    设 olen = 表长(旧)
    循环 (j < olen) {
        设 joined = 连接(joined, 取(旧, j))
        设 j = j + 1
    }
    设 oldLen = 取长(joined)
    设 newLen = 取长(新)
    若 (oldLen == 0) { 返回(1.0) }
    设 g = newLen / oldLen
    若 (g > 1) { 设 g = 1 }
    返回(g)
}

定义 记录冲突 (a, b, topic) {
    设 entry = 字典("a", a, "b", b, "topic", topic, "ts", 时间戳())
    设 旧 = 取键(_ctx, "冲突记录")
    置键(_ctx, "冲突记录", 列表合(旧, 列表(entry)))
}

定义 统计冲突 () {
    设 recs = 取键(_ctx, "冲突记录")
    // 仅在有冲突时打印
    若 (表长(recs) > 0) {
        输出(连接("冲突统计: ", 转字符串(表长(recs))))
    }
}

// === 工具 ===
定义 调度工具 (tool, params) {
    若 (取长(tool) == 0) { 返回("无工具") }

    // 白名单检查：不在白名单中的工具直接拒绝
    设 在白名单 = 假
    设 i = 0
    设 len = 表长(工具白名单)
    循环 (i < len) {
        若 (字符串相等(tool, 取(工具白名单, i))) {
            设 在白名单 = 真
            跳出
        }
        设 i = i + 1
    }
    若 (非(在白名单)) {
        输出(连接("⚠ 工具不在白名单: ", tool))
        返回(连接("安全拒绝: ", tool, " 不在允许的工具列表中"))
    }

    // 风险检查：高风险工具需要二次确认
    设 风险 = "低"
    尝试 { 设 风险 = 取键(工具风险, tool) } 捕获 (e) { }
    若 (字符串相等(风险, "高")) {
        输出(连接("⚠ 高风险工具需要确认: ", tool))
        尝试 {
            设 确认 = 输入(连接("确认执行 ", 连接(tool, "？(y/n): ")))
            若 (非(字符串相等(确认, "y"))) {
                返回(连接("用户拒绝: ", tool))
            }
        } 捕获 (e) {
            // 非交互模式下自动拒绝高风险工具
            返回(连接("安全拒绝: ", tool, " (非交互模式)"))
        }
    }

    若 (字符串相等(tool, "query_weather")) {
        设 城市 = params
        尝试 {
            设 url = 连接("https://wttr.in/", 城市, "?format=3")
            设 resp = http读(url)
            若 (取长(resp) > 0) { 返回(resp) }
        } 捕获 (e) { }
        若 (含键(天气数据, 城市)) { 返回(取键(天气数据, 城市)) }
        返回(连接(params, "天气数据暂不可用"))
    }
    返回(连接("tool ", tool, " done"))
}

// === 决策追踪辅助 ===
定义 认知态名 (s) {
    若 (含键(认知态中文, s)) { 返回(取键(认知态中文, s)) }
    返回(s)
}

定义 三态名 (v) {
    若 (含键(三态中文, v)) { 返回(取键(三态中文, v)) }
    返回(转字符串(v))
}

定义 三态描述 (v, c) {
    设 名 = 三态名(v)
    若 (c >= 1.0) { 返回(名) }
    返回(连接(名, 连接("(", 连接(转字符串(c), ")"))))
}

定义 映射描述 (mapped) {
    若 (是字典(mapped)) {
        返回(连接(连接("认知=", 转字符串(取键(mapped, "认知"))), 连接(" 执行=", 取键(mapped, "执行"))))
    }
    返回(三态名(mapped))
}

// === 决策记录 ===
// 注意：_决策记录 是全局字典，当前设计为单线程交互模式。
// 如需多线程并发调用，需在外层加锁保护（Python threading.Lock）。
设 _决策记录 = 字典("最新轮次", 0)

定义 清空决策记录 () {
    设 keys = 字典键列表(_决策记录)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        若 (取长(k) > 0) { 删除键(_决策记录, k) }
        设 i = i + 1
    }
    置键(_决策记录, "最新轮次", 0)
}

定义 记录决策 (轮次, 问题, cog, act, 映射值, 上游, 传播后, 动作, 回答, 置信度, 规则场景, 规则风险, 规则好感) {
    设 key = 连接("轮次_", 转字符串(轮次))
    置键(_决策记录, key, 字典(
        "问题", 问题,
        "认知态", cog,
        "认知态中文", 认知态名(cog),
        "执行态", act,
        "映射值", 映射值,
        "上游", 上游,
        "传播结果", 传播后,
        "动作", 动作,
        "回答", 回答,
        "置信度", 置信度,
        "规则场景", 规则场景,
        "规则风险", 规则风险,
        "规则好感", 规则好感,
        "时间戳", 时间戳()
    ))
    置键(_决策记录, "最新轮次", 轮次)
}

定义 解释决策 (轮次) {
    设 key = 连接("轮次_", 转字符串(轮次))
    若 (非(含键(_决策记录, key))) {
        输出(连接("未找到第", 转字符串(轮次), "轮的决策记录"))
        返回(0)
    }
    设 rec = 取键(_决策记录, key)
    设 置信度 = 取键(rec, "置信度")
    输出("━━ 决策解释 ━━━━━━━━━━━━━━━━")
    输出(连接("问题：", 取键(rec, "问题")))
    输出(连接("① LLM 认知态：", 取键(rec, "认知态"), "(", 取键(rec, "认知态中文"), ")"))
    输出(连接("② 执行态：", 取键(rec, "执行态")))
    设 映射值 = 取键(rec, "映射值")
    输出(连接("③ 5→3映射：", 三态描述(映射值, 置信度)))
    设 上游 = 取键(rec, "上游")
    设 传播结果 = 取键(rec, "传播结果")
    输出(连接("④ 传播：上游=", 三态名(上游), " × 当前=", 三态描述(映射值, 置信度), " → 结果=", 三态名(传播结果)))
    输出(连接("⑤ 动作：", 取键(rec, "动作")))
    输出(连接("⑥ 回答：", 取键(rec, "回答")))
    输出("━━━━━━━━━━━━━━━━━━━━━━━━")
}

// === 交互命令函数 ===
// 最近决策：显示最近一轮决策解释
定义 最近决策 () {
    设 最新轮次 = 取键(_决策记录, "最新轮次")
    若 (最新轮次 <= 0) {
        输出("暂无决策记录")
        返回(0)
    }
    解释决策(最新轮次)
}

// 解释原因：显示指定轮次的决策原因链
定义 解释原因 (轮次) {
    解释决策(轮次)
}

// 策略概览：显示当前策略配置
定义 策略概览 () {
    输出("━━ 策略概览 ━━━━━━━━━━━━━━━━")
    输出(连接("模型：", 模型名))
    输出(连接("最大轮次：", 转字符串(最大轮次)))
    输出(连接("记忆文件：", 记忆文件))
    输出("场景规则：")
    设 i = 0
    循环 (i < 表长(场景规则)) {
        设 规则 = 取(场景规则, i)
        输出(连接("  ", 连接(取键(规则, "场景"), 连接(" → 风险=", 取键(规则, "风险")))))
        设 i = 加(i, 1)
    }
    输出("━━━━━━━━━━━━━━━━━━━━━━━━")
}

// === 元认知反思模块 ===
// 规则性能追踪：场景名 → {触发次数, 正确次数, 权重}
设 规则性能 = 字典()

定义 记录规则触发 (场景名, 结果正确) {
    若 (非(含键(规则性能, 场景名))) {
        置键(规则性能, 场景名, 字典("触发", 0, "正确", 0, "权重", 1.0))
    }
    设 记录 = 取键(规则性能, 场景名)
    置键(记录, "触发", 加(取键(记录, "触发"), 1))
    若 (结果正确) {
        置键(记录, "正确", 加(取键(记录, "正确"), 1))
    }
}

定义 获取规则权重 (场景名) {
    若 (含键(规则性能, 场景名)) {
        返回(取键(取键(规则性能, 场景名), "权重"))
    }
    返回(1.0)
}

定义 反思评估 () {
    输出("=== 元认知反思 ===")
    设 调整数 = 0
    设 场景列表 = 字典键列表(规则性能)
    设 i = 0
    设 len = 表长(场景列表)
    循环 (i < len) {
        设 场景名 = 取(场景列表, i)
        设 记录 = 取键(规则性能, 场景名)
        设 触发 = 取键(记录, "触发")
        设 正确 = 取键(记录, "正确")
        若 (触发 >= 3) {
            设 准确率 = 除(正确, 触发)
            若 (准确率 < 0.5) {
                置键(记录, "权重", 0.5)
                输出(连接("  ⚠ ", 连接(场景名, 连接(" 准确率 ", 连接(转字符串(准确率), " → 降权 0.5")))))
                设 调整数 = 加(调整数, 1)
            } 否则 若 (准确率 > 0.8) {
                置键(记录, "权重", 1.0)
            }
        }
        设 i = i + 1
    }
    若 (调整数 == 0) { 输出("  所有规则表现正常") }
    输出("━━━━━━━━━━━━━━━━━━━━━━━━")
}

// === 系统提示构建 ===
// 构建 LLM 系统提示词，组合协议提示词和上下文信息
定义 构建系统提示 () {
    返回(协议提示词)
}

// === 规则降级 ===
// LLM 不可用时，基于规则匹配生成安全响应
定义 规则降级 (用户问题, 规则) {
    设 场景名 = 取键(规则, "场景")
    设 风险等级 = 取键(规则, "风险")
    若 (字符串相等(场景名, "借钱")) {
        返回(字典("cogState", "NEGATE", "actState", "READY", "answer", "关于借钱的事，我需要谨慎考虑。"))
    }
    若 (字符串相等(场景名, "投资")) {
        返回(字典("cogState", "UNCERT", "actState", "NEED_HUMAN", "answer", "投资有风险，建议您咨询专业人士。"))
    }
    若 (字符串相等(场景名, "天气查询")) {
        设 城市 = 取键(规则, "城市")
        若 (且(不(字符串相等(城市, "")), 不(字符串相等(城市, "未知")))) {
            设 天气 = query_weather(城市)
            返回(字典("cogState", "AFFIRM", "actState", "READY", "answer", 连接(城市, 连接("天气：", 天气))))
        }
        返回(字典("cogState", "UNCERT", "actState", "NEED_HUMAN", "answer", "请告诉我您想查询哪个城市的天气？"))
    }
    返回(字典("cogState", "AFFIRM", "actState", "READY", "answer", "好的，我明白了。"))
}

定义 Agent运行 (用户问题) {
    设 上下文 = 列表()
    设 可能次数 = 0
    设 历史 = 列表()
    设 历史置信度 = 列表()  // 追踪每轮传播后的置信度
    设 轮次 = 取键(_决策记录, "最新轮次")

    // 匹配场景规则
    设 规则 = 匹配规则(用户问题)
    设 场景名 = 取键(规则, "场景")
    设 风险等级 = 取键(规则, "风险")
    设 好感要求 = 取键(规则, "要求好感")
    输出(连接("→ [规则] 场景=", 连接(场景名, 连接(" 风险=", 风险等级))))

    循环 (真) {
        设 轮次 = 加(轮次, 1)
        置键(_决策记录, "最新轮次", 轮次)
        清理过期记忆()
        设 系统提示 = 构建系统提示()
        设 raw = 调用LLM(系统提示, 用户问题)
        设 r = 解析响应(raw)
        设 cog = 取键(r, "cogState")
        设 act = 取键(r, "actState")

        // LLM 失败降级：使用规则匹配生成响应
        若 (字符串相等(cog, "UNCERT") 且 字符串相等(act, "NEED_HUMAN") 且 字符串包含(取键(r, "answer"), "降级")) {
            输出("→ [降级] LLM 不可用，使用规则匹配")
            设 规则结果 = 规则降级(用户问题, 规则)
            设 cog = 取键(规则结果, "cogState")
            设 act = 取键(规则结果, "actState")
            置键(r, "answer", 取键(规则结果, "answer"))
            置键(r, "cogState", cog)
            置键(r, "actState", act)
        }

        设 置信度 = 0.5
        若 (含键(认知态置信度, cog)) { 设 置信度 = 取键(认知态置信度, cog) }
        输出(连接(连接(连接("→ [第", 转字符串(轮次)), 连接("轮] LLM返回 | 认知态=", cog)), 连接("(", 认知态名(cog), ")")))
        输出(连接("  → 执行态=", act))

        设 映射 = 映射到三态(cog)
        设 认知值 = 取认知(映射)
        输出(连接(连接("→ [5→3映射] ", 连接(认知态名(cog), " → ", 映射描述(映射))), 连接("  认知值=", 三态描述(认知值, 置信度))))

        设 上一轮 = 1
        设 上游置信度 = 1.0
        设 hlen = 表长(历史)
        若 (hlen > 0) {
            设 上一轮 = 取(历史, 减(hlen, 1))
            设 上游置信度 = 取(历史置信度, 减(hlen, 1))
        }
        设 传播后 = 传播(上一轮, 认知值)
        设 历史 = 列表合(历史, 列表(传播后))
        // 贝叶斯置信度传播（odds 比值形式）
        // odds = p/(1-p), 后验odds = 先验odds × 似然比
        设 先验odds = 除(上游置信度, 减(1, 上游置信度))
        设 似然比 = 除(置信度, 减(1, 置信度))
        设 后验odds = 先验odds * 似然比
        设 传播置信度 = 除(后验odds, 加(1, 后验odds))
        若 (传播置信度 < 0.01) { 设 传播置信度 = 0.01 }
        若 (传播置信度 > 0.99) { 设 传播置信度 = 0.99 }
        设 历史置信度 = 列表合(历史置信度, 列表(传播置信度))
        输出(连接(连接("→ [传播] 上游=", 三态描述(上一轮, 上游置信度)), 连接(" × 当前=", 三态描述(认知值, 置信度)), 连接(" → 结果=", 三态描述(传播后, 传播置信度))))

        若 (字符串相等(cog, "CONFLICTED")) {
            记录冲突("LLM", "unknown", 用户问题)
            输出("→ [冲突] 检测到矛盾信息，已记录")
        }

        // NEED_TOOL 优先级最高
        若 (字符串相等(act, "NEED_TOOL")) {
            输出(连接("→ [执行] 需要工具：", 取键(r, "tool")))
            设 tr = 调度工具(取键(r, "tool"), 取键(r, "params"))
            记(连接("tool_", 转字符串(轮次)), tr, 取键(r, "tool"))
            记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, 连接("调用工具:", 取键(r, "tool")), tr, 传播置信度, 场景名, 风险等级, 好感要求)
            输出(连接("→ 工具结果：", tr))
            输出(连接("→ 回答：", 取键(r, "answer")))
            输出("━━━━━━━━━━━━━━━━━━━━━━━━")
            跳出
        }

        // NEED_HUMAN → 问用户
        若 (字符串相等(act, "NEED_HUMAN")) {
            输出("→ [执行] 需要询问用户")
            记(连接("ans_", 转字符串(轮次)), 取键(r, "answer"), "agent")
            记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, "询问用户", 取键(r, "answer"), 传播置信度, 场景名, 风险等级, 好感要求)
            输出(连接("→ 回答：", 取键(r, "answer")))
            输出("━━━━━━━━━━━━━━━━━━━━━━━━")
            跳出
        }

        若 (传播后 == 1) {
            输出("→ [执行] 确信，直接回答")
            记(连接("ans_", 转字符串(轮次)), 取键(r, "answer"), "agent")
            记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, "确信回答", 取键(r, "answer"), 传播置信度, 场景名, 风险等级, 好感要求)
            输出(连接("→ 回答：", 取键(r, "answer")))
            输出("━━━━━━━━━━━━━━━━━━━━━━━━")
            跳出
        }

        若 (传播后 == -1) {
            输出("→ [执行] 拒绝（传播结果为假）")
            记(连接("ans_", 转字符串(轮次)), 连接("拒绝: ", 取键(r, "answer")), "agent")
            记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, "拒绝回答", 连接("拒绝: ", 取键(r, "answer")), 传播置信度, 场景名, 风险等级, 好感要求)
            输出(连接("→ 拒绝：", 取键(r, "answer")))
            输出("━━━━━━━━━━━━━━━━━━━━━━━━")
            跳出
        }

        // 可能态：输出回答退出
        记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, "可能态", 取键(r, "answer"), 传播置信度, 场景名, 风险等级, 好感要求)
        输出("→ [执行] 可能态，输出当前回答")
        输出(连接("→ 回答：", 取键(r, "answer")))
        输出("━━━━━━━━━━━━━━━━━━━━━━━━")
        跳出
    }

    统计冲突()

    // 每 10 轮触发一次元认知反思
    若 (轮次 > 0 且 轮次 % 10 == 0) {
        反思评估()
    }
}

// === 入口 ===
加载记忆()
输出("三言 Agent v0.2.0")
