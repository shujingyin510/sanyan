// 三言 Agent - 配置集中到 agent_policy.san
// 运行: python -X utf8 run_agent.py "你的问题"
// 注意：以下决策函数是 decision.san 的策略扩展版，
//       使用 agent_policy.san 的五态映射规则而非硬编码。
//       基础版见 decision.san（被 tests.san 测试）。
#include "ternary_agent/agent_policy.san"

// === 决策核心 ===
定义 映射到三态 (cogState) {
    若 (含键(五态映射规则, cogState)) {
        返回(取键(五态映射规则, cogState))
    }
    返回(0)
}

定义 传播 (上游, 当前) {
    若 (上游 == -1) { 返回(-1) }
    若 (上游 == 0 且 当前 == 1) { 返回(0) }
    返回(当前)
}

定义 取认知 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "认知")) }
    返回(mapped)
}

定义 取执行 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "执行")) }
    返回("就绪")
}

定义 保护 (可能次数, 增益, 风险, hist) {
    若 (字符串相等(风险, "高")) { 返回(列表(-1, "高风险拒绝")) }
    若 (可能次数 >= 最大犹豫次数) { 返回(列表(多数投票(hist), "次数用尽")) }
    若 (增益 < 最小增益阈值) { 返回(列表(多数投票(hist), "增益不足")) }
    返回(列表(0, "continue"))
}

定义 多数投票 (hist) {
    设 真票 = 0
    设 假票 = 0
    设 len = 表长(hist)
    设 i = 0
    循环 (i < len) {
        设 v = 取(hist, i)
        若 (v == 1) { 设 真票 = 真票 + 1 }
        若 (v == -1) { 设 假票 = 假票 + 1 }
        设 i = i + 1
    }
    若 (真票 > 假票) { 返回(1) }
    若 (假票 > 真票) { 返回(-1) }
    返回(0)
}

// === LLM 调用 ===
定义 调用LLM (系统提示, 用户消息) {
    若 (字符串相等(API密钥, "sk-你的key")) {
        返回(转JSON(字典("error", "API密钥未配置，请设置环境变量 DEEPSEEK_API_KEY")))
    }
    设 body = 转JSON(字典(
        "model", 模型名,
        "messages", 列表(
            字典("role", "system", "content", 系统提示),
            字典("role", "user", "content", 用户消息)
        ),
        "temperature", 0.7
    ))
    设 headers = 字典(
        "Content-Type", "application/json",
        "Authorization", 连接("Bearer ", API密钥)
    )
    尝试 {
        设 resp = http写(模型URL, body, headers)
        若 (等于(resp, "") 或 等于(resp, 假)) {
            返回(转JSON(字典("error", "HTTP请求无响应")))
        }
        返回(resp)
    } 捕获 (e) {
        输出(连接("⚠ LLM调用异常: ", 转字符串(e)))
        返回(转JSON(字典("error", 连接("HTTP调用失败: ", 转字符串(e)))))
    }
}

定义 解析响应 (raw) {
    设 outer = 解析JSON(raw)
    若 (不(是字典(outer))) {
        返回(字典("cogState","UNCERT","actState","NEED_HUMAN","answer","格式异常","tool","","params",""))
    }
    尝试 {
        设 choices = 取键(outer, "choices")
        设 first = 取(choices, 0)
        设 msg = 取键(first, "message")
        设 content = 取键(msg, "content")
        设 parsed = 解析JSON(content)
        若 (不(是字典(parsed))) {
            返回(字典("cogState","UNCERT","actState","NEED_HUMAN","answer","JSON异常","tool","","params",""))
        }
        返回(字典(
            "cogState", 取键(parsed, "cog"),
            "actState", 取键(parsed, "act"),
            "answer", 取键(parsed, "answer"),
            "tool", 取键(parsed, "tool"),
            "params", 取键(parsed, "params")
        ))
    } 捕获 (e) {
        返回(字典("cogState","UNCERT","actState","NEED_HUMAN","answer","解析失败","tool","","params",""))
    }
}

// === 记忆 ===
设 记忆表 = 字典()

定义 记 (key, state, source) {
    置键(记忆表, key, 字典("state",state,"source",source,"ttl",时间戳()+默认TTL))
}

定义 忆 (key) {
    若 (不(含键(记忆表, key))) { 返回("") }
    设 entry = 取键(记忆表, key)
    若 (时间戳() > 取键(entry, "ttl")) { 删除键(记忆表, key); 返回("") }
    返回(取键(entry, "state"))
}

定义 记忆列表 () {
    设 out = ""
    设 keys = 字典键列表(记忆表)
    设 len = 表长(keys)
    设 i = 0
    循环 (i < len) {
        设 k = 取(keys, i)
        设 out = 连接(out, k, ":", 转字符串(忆(k)), "; ")
        设 i = i + 1
    }
    返回(out)
}

// 清理过期记忆条目（在每轮对话开始时调用）
定义 清理过期记忆 () {
    设 keys = 字典键列表(记忆表)
    设 len = 表长(keys)
    设 i = 0
    设 待删除 = 列表()
    // 先收集过期键
    循环 (i < len) {
        设 k = 取(keys, i)
        设 entry = 取键(记忆表, k)
        若 (是字典(entry) 且 含键(entry, "ttl")) {
            若 (时间戳() > 取键(entry, "ttl")) {
                设 待删除 = 列表合(待删除, 列表(k))
            }
        }
        设 i = 加(i, 1)
    }
    // 再批量删除
    设 清理数 = 表长(待删除)
    设 j = 0
    循环 (j < 清理数) {
        删除键(记忆表, 取(待删除, j))
        设 j = 加(j, 1)
    }
    若 (清理数 > 0) {
        输出(连接("→ [记忆] 清理 ", 连接(转字符串(清理数), " 条过期记忆")))
    }
}

// === 记忆持久化 ===
定义 保存记忆 () {
    写文件(记忆文件, 转JSON(记忆表))
}

定义 加载记忆 () {
    尝试 {
        设 raw = 读文件(记忆文件)
        若 (取长(raw) > 0) {
            设 loaded = 解析JSON(raw)
            若 (是字典(loaded)) {
                设 keys = 字典键列表(loaded)
                设 i = 0
                设 len = 表长(keys)
                循环 (i < len) {
                    设 k = 取(keys, i)
                    置键(记忆表, k, 取键(loaded, k))
                    设 i = i + 1
                }
            }
        }
    } 捕获 (e) { }
}

// === 上下文 ===
设 _ctx = 字典("冲突记录", 列表())

定义 判断相关性 (片段, 问题) {
    设 命中 = 0
    设 i = 0
    设 qlen = 取长(问题)
    循环 (i < qlen) {
        设 kw = 子串(问题, i, 1)
        若 (取长(kw) > 0 且 字符串包含(片段, kw)) { 设 命中 = 命中 + 1 }
        设 i = i + 1
    }
    若 (命中 >= 2) { 返回(1) }
    若 (命中 == 0) { 返回(-1) }
    返回(0)
}

定义 压缩上下文 (旧, 新) {
    设 all = 列表合(旧, 列表(新))
    设 keep = 列表()
    设 summary = 列表()
    设 len = 表长(all)
    设 i = 0
    循环 (i < len) {
        设 s = 取(all, i)
        设 rel = 判断相关性(s, 新)
        若 (rel == 1) { 设 keep = 列表合(keep, 列表(s)) }
        若 (rel == 0) {
            设 摘要 = 子串(s, 0, 50)
            若 (取长(s) > 50) { 设 摘要 = 连接(摘要, "...") }
            设 summary = 列表合(summary, 列表(摘要))
        }
        设 i = i + 1
    }
    返回(列表合(keep, summary))
}

定义 计算增益 (新, 旧) {
    设 joined = ""
    设 j = 0
    设 olen = 表长(旧)
    循环 (j < olen) {
        设 joined = 连接(joined, 取(旧, j))
        设 j = j + 1
    }
    设 oldLen = 取长(joined)
    设 newLen = 取长(新)
    若 (oldLen == 0) { 返回(1.0) }
    设 g = newLen / oldLen
    若 (g > 1) { 设 g = 1 }
    返回(g)
}

定义 记录冲突 (a, b, topic) {
    设 entry = 字典("a", a, "b", b, "topic", topic, "ts", 时间戳())
    设 旧 = 取键(_ctx, "冲突记录")
    置键(_ctx, "冲突记录", 列表合(旧, 列表(entry)))
}

定义 统计冲突 () {
    设 recs = 取键(_ctx, "冲突记录")
    输出(连接("冲突统计: ", 转字符串(表长(recs))))
}

// === 工具 ===
定义 调度工具 (tool, params) {
    若 (取长(tool) == 0) { 返回("无工具") }
    设 风险 = "低"
    尝试 { 设 风险 = 取键(工具风险, tool) } 捕获 (e) { }
    若 (字符串相等(风险, "高")) {
        设 门控 = 保护(0, 1.0, "高", 列表())
        若 (取(门控, 0) == -1) { 返回(连接("安全门控拒绝: ", tool)) }
    }
    若 (字符串相等(tool, "query_weather")) {
        设 城市 = params
        // 先尝试真实 API（wttr.in 免费天气预报）
        尝试 {
            设 url = 连接("https://wttr.in/", 城市, "?format=3")
            设 resp = http读(url)
            若 (取长(resp) > 0) { 返回(resp) }
        } 捕获 (e) { }
        // 回退到本地数据
        若 (含键(天气数据, 城市)) { 返回(取键(天气数据, 城市)) }
        返回(连接(params, "天气数据暂不可用"))
    }
    返回(连接("tool ", tool, " done"))
}

// === 决策追踪辅助 ===
定义 认知态名 (s) {
    若 (含键(认知态中文, s)) { 返回(取键(认知态中文, s)) }
    返回(s)
}

定义 三态名 (v) {
    若 (含键(三态中文, v)) { 返回(取键(三态中文, v)) }
    返回(转字符串(v))
}

定义 三态描述 (v, c) {
    设 名 = 三态名(v)
    若 (c >= 1.0) { 返回(名) }
    返回(连接(名, 连接("(", 连接(转字符串(c), ")"))))
}

定义 映射描述 (mapped) {
    若 (是字典(mapped)) {
        返回(连接(连接("认知=", 转字符串(取键(mapped, "认知"))), 连接(" 执行=", 取键(mapped, "执行"))))
    }
    返回(三态名(mapped))
}

// === 决策记录 ===
设 _决策记录 = 字典("最新轮次", 0)

定义 清空决策记录 () {
    设 keys = 字典键列表(_决策记录)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        若 (取长(k) > 0) { 删除键(_决策记录, k) }
        设 i = i + 1
    }
    置键(_决策记录, "最新轮次", 0)
}

定义 记录决策 (轮次, 问题, cog, act, 映射值, 上游, 传播后, 动作, 回答, 置信度, 规则场景, 规则风险, 规则好感) {
    设 key = 连接("轮次_", 转字符串(轮次))
    置键(_决策记录, key, 字典(
        "问题", 问题,
        "认知态", cog,
        "认知态中文", 认知态名(cog),
        "执行态", act,
        "映射值", 映射值,
        "上游", 上游,
        "传播结果", 传播后,
        "动作", 动作,
        "回答", 回答,
        "置信度", 置信度,
        "规则场景", 规则场景,
        "规则风险", 规则风险,
        "规则好感", 规则好感,
        "时间戳", 时间戳()
    ))
    置键(_决策记录, "最新轮次", 轮次)
}

定义 解释决策 (轮次) {
    设 key = 连接("轮次_", 转字符串(轮次))
    若 (不(含键(_决策记录, key))) {
        输出(连接("未找到第", 转字符串(轮次), "轮的决策记录"))
        返回(0)
    }
    设 rec = 取键(_决策记录, key)
    设 置信度 = 取键(rec, "置信度")
    输出("━━ 决策解释 ━━━━━━━━━━━━━━━━")
    输出(连接("问题：", 取键(rec, "问题")))
    输出(连接("① LLM 认知态：", 取键(rec, "认知态"), "(", 取键(rec, "认知态中文"), ")"))
    输出(连接("② 执行态：", 取键(rec, "执行态")))
    设 映射值 = 取键(rec, "映射值")
    输出(连接("③ 5→3映射：", 三态描述(映射值, 置信度)))
    设 上游 = 取键(rec, "上游")
    设 传播结果 = 取键(rec, "传播结果")
    输出(连接("④ 传播：上游=", 三态名(上游), " × 当前=", 三态描述(映射值, 置信度), " → 结果=", 三态名(传播结果)))
    输出(连接("⑤ 动作：", 取键(rec, "动作")))
    输出(连接("⑥ 回答：", 取键(rec, "回答")))
    输出("━━━━━━━━━━━━━━━━━━━━━━━━")
}

// 解释原因：用自然语言解释 Agent 为什么这么决策
定义 解释原因 (轮次) {
    设 key = 连接("轮次_", 转字符串(轮次))
    若 (不(含键(_决策记录, key))) {
        输出(连接("未找到第", 转字符串(轮次), "轮的决策记录"))
        返回(0)
    }
    设 rec = 取键(_决策记录, key)
    设 置信度 = 取键(rec, "置信度")
    设 规则场景 = 取键(rec, "规则场景")
    设 规则风险 = 取键(rec, "规则风险")
    设 规则好感 = 取键(rec, "规则好感")
    设 动作 = 取键(rec, "动作")
    设 认知态中文 = 取键(rec, "认知态中文")
    设 传播结果 = 取键(rec, "传播结果")
    设 回答 = 取键(rec, "回答")

    输出("━━ 为什么这么做 ━━━━━━━━━━━━━━")
    输出(连接("问题：", 取键(rec, "问题")))

    // 规则层面
    输出(连接("【规则】场景=", 连接(规则场景, 连接("，风险=", 连接(规则风险, 连接("，好感要求≥", 转字符串(规则好感)))))))
    若 (字符串相等(规则风险, "高")) {
        输出("  → 高风险场景，建议人工确认")
    }
    若 (字符串相等(规则风险, "中")) {
        输出("  → 中等风险场景，需结合上下文判断")
    }

    // LLM 认知层面
    输出(连接("【认知】LLM=", 连接(认知态中文, 连接("，置信度=", 转字符串(置信度)))))
    若 (置信度 >= 0.8) {
        输出("  → 高置信度，LLM 很确定")
    } 再若 (置信度 >= 0.4) {
        输出("  → 中等置信度，LLM 有一定把握")
    } 否则 {
        输出("  → 低置信度，LLM 不太确定，建议人工确认")
    }

    // 传播层面
    输出(连接("【传播】结果=", 三态名(传播结果)))
    若 (传播结果 == 1) {
        输出("  → 三态传播通过，决策链支持此结论")
    } 再若 (传播结果 == 0) {
        输出("  → 传播结果为可能，尚不确定")
    } 否则 {
        输出("  → 传播结果为假，决策链不支持")
    }

    // 动作层面
    输出(连接("【动作】", 动作))
    若 (字符串相等(动作, "拒绝回答")) {
        输出("  → 拒绝原因：三态传播结果为假")
        输出(连接("  → 建议：", 回答))
    }
    若 (字符串相等(动作, "确信回答")) {
        输出("  → 高置信度 + 传播通过，直接回答")
        输出(连接("  → 答复：", 回答))
    }
    若 (字符串相等(动作, "询问用户")) {
        输出("  → LLM 不确定，需要向用户确认")
        输出(连接("  → 询问：", 回答))
    }
    若 (字符串相等(动作, "可能态")) {
        输出("  → LLM 输出可能态，保持现状")
        输出(连接("  → 回应：", 回答))
    }

    // 建议
    输出("【建议】")
    若 (字符串包含(动作, "工具")) {
        输出("  → 已调用工具获取信息，可根据工具结果继续决策")
    } 再若 (字符串相等(规则风险, "高") 且 置信度 < 0.9) {
        输出("  → 高风险场景 + 非最高置信度，强烈建议人工复核后再执行")
    } 再若 (置信度 < 0.4) {
        输出("  → 置信度偏低，建议提供更多上下文后重新提问")
    } 否则 {
        输出(连接("  → 当前决策置信度=", 连接(三态描述(传播结果, 置信度), "，可采纳")))
    }
    输出("━━━━━━━━━━━━━━━━━━━━━━━━")
}

定义 最近决策 () {
    设 最新 = 取键(_决策记录, "最新轮次")
    若 (最新 == 0) { 输出("暂无决策记录"); 返回(0) }
    解释决策(最新)
}

// === 声明式规则引擎 ===

// 匹配规则：根据用户问题查找最匹配的场景规则
// 检查文本中是否含否定词（在关键词附近）
定义 含否定词 (文本, 关键词位置) {
    设 否定词列表 = 列表("不", "别", "没", "无", "未", "莫", "休")
    设 i = 0
    设 len = 表长(否定词列表)
    循环 (i < len) {
        设 nw = 取(否定词列表, i)
        设 npos = 查找(文本, nw)
        // 否定词在关键词前 5 个字范围内则判定为否定
        若 (npos >= 0 且 减(关键词位置, npos) < 5) {
            返回(真)
        }
        设 i = 加(i, 1)
    }
    返回(假)
}

// 匹配关键词：按最长匹配优先，检测否定词
定义 关键词分数 (文本, 关键词) {
    设 pos = 查找(文本, 关键词)
    若 (pos < 0) { 返回(-1) }
    // 基础分数 = 关键词长度（越长越精确）
    设 score = 取长(关键词)
    // 否定词扣分
    若 (含否定词(文本, pos)) { 设 score = 减(score, 100) }
    // 精确词匹配加分
    若 (等于(pos, 0) 或 等于(取(字列(文本), 减(pos, 1)), " ")) {
        设 score = 加(score, 10)
    }
    返回(score)
}

定义 匹配规则 (问题) {
    设 最佳规则 = 字典("场景", "未知", "关键词", "", "风险", "低", "要求好感", 0, "默认动作", "READY")
    设 最佳分数 = -1
    设 i = 0
    设 len = 表长(场景规则)
    循环 (i < len) {
        设 rule = 取(场景规则, i)
        设 关键词串 = 取键(rule, "关键词")
        设 关键词列表 = 分割(关键词串, ",")
        设 j = 0
        设 klen = 表长(关键词列表)
        设 匹配数 = 0
        循环 (j < klen) {
            设 kw = 取(关键词列表, j)
            设 s = 关键词分数(问题, kw)
            若 (s >= 0) {
                设 匹配数 = 加(匹配数, 1)
                若 (s > 最佳分数) {
                    设 最佳分数 = s
                    设 最佳规则 = rule
                }
            }
            设 j = 加(j, 1)
        }
        // 多个关键词匹配加分
        若 (匹配数 > 1) { 设 最佳分数 = 加(最佳分数, 匹配数) }
        设 i = 加(i, 1)
    }
    // 否定句降级为低风险
    若 (最佳分数 < 0) {
        设 i2 = 0
        循环 (i2 < len) {
            设 rule = 取(场景规则, i2)
            设 关键词串 = 取键(rule, "关键词")
            设 关键词列表 = 分割(关键词串, ",")
            设 j2 = 0
            循环 (j2 < 表长(关键词列表)) {
                设 kw = 取(关键词列表, j2)
                设 pos = 查找(问题, kw)
                若 (pos >= 0 且 含否定词(问题, pos)) {
                    // 否定句：保持场景但降低风险
                    置键(rule, "风险", "低")
                    返回(rule)
                }
                设 j2 = 加(j2, 1)
            }
            设 i2 = 加(i2, 1)
        }
    }
    返回(最佳规则)
}

// 验证策略：检查场景规则格式是否正确
定义 验证策略 () {
    设 问题数 = 0
    设 i = 0
    设 len = 表长(场景规则)
    循环 (i < len) {
        设 rule = 取(场景规则, i)
        若 (不(含键(rule, "场景"))) { 输出(连接("  ✗ 规则 ", 转字符串(i), "：缺少\"场景\"字段")); 设 问题数 = 问题数 + 1 }
        若 (不(含键(rule, "关键词"))) { 输出(连接("  ✗ 规则 ", 转字符串(i), "：缺少\"关键词\"字段")); 设 问题数 = 问题数 + 1 }
        若 (不(含键(rule, "风险"))) { 输出(连接("  ✗ 规则 ", 转字符串(i), "：缺少\"风险\"字段")); 设 问题数 = 问题数 + 1 }
        若 (不(含键(rule, "默认动作"))) { 输出(连接("  ✗ 规则 ", 转字符串(i), "：缺少\"默认动作\"字段")); 设 问题数 = 问题数 + 1 }
        设 i = i + 1
    }
    若 (问题数 == 0) {
        输出(连接("✓ 策略验证通过，共 ", 转字符串(len), " 条规则"))
    } 否则 {
        输出(连接("✗ 策略验证发现 ", 转字符串(问题数), " 个问题"))
    }
    返回(问题数)
}

// 策略概览：用中文展示当前策略配置
定义 策略概览 () {
    输出("━━ 当前策略 ━━━━━━━━━━━━━━━━")
    输出(连接("模型：", 模型名))
    输出(连接("最大轮次：", 转字符串(最大轮次)))
    输出(连接("犹豫次数上限：", 转字符串(最大犹豫次数)))
    输出(连接("增益阈值：", 转字符串(最小增益阈值)))
    输出(连接("高确信阈值：", 转字符串(取键(置信度阈值, "高确信"))))
    输出(连接("工具数量：", 转字符串(表长(字典键列表(工具风险)))))
    输出("")
    输出("场景规则：")
    设 i = 0
    设 len = 表长(场景规则)
    循环 (i < len) {
        设 rule = 取(场景规则, i)
        输出(连接("  ", 连接(取键(rule, "场景"), 连接("（风险:", 连接(取键(rule, "风险"), 连接("，好感≥", 连接(转字符串(取键(rule, "要求好感")), "）")))))))
        设 i = i + 1
    }
    输出("━━━━━━━━━━━━━━━━━━━━━━━━")
}

// === Agent 主循环 ===
定义 Agent运行 (用户问题) {
    设 上下文 = 列表()
    设 可能次数 = 0
    设 历史 = 列表()
    设 历史置信度 = 列表()  // 追踪每轮传播后的置信度
    设 轮次 = 取键(_决策记录, "最新轮次")

    // 匹配场景规则
    设 规则 = 匹配规则(用户问题)
    设 场景名 = 取键(规则, "场景")
    设 风险等级 = 取键(规则, "风险")
    设 好感要求 = 取键(规则, "要求好感")
    输出(连接("→ [规则] 场景=", 连接(场景名, 连接(" 风险=", 风险等级))))

    循环 (真) {
        设 轮次 = 加(轮次, 1)
        置键(_决策记录, "最新轮次", 轮次)
        清理过期记忆()
        设 系统提示 = 构建系统提示()
        设 raw = 调用LLM(系统提示, 用户问题)
        若 (等于(raw, "")) {
            输出("❌ LLM 调用失败")
            跳出
        }
        设 r = 解析响应(raw)
        设 cog = 取键(r, "cogState")
        设 act = 取键(r, "actState")
        设 置信度 = 0.5
        若 (含键(认知态置信度, cog)) { 设 置信度 = 取键(认知态置信度, cog) }
        输出(连接(连接(连接("→ [第", 转字符串(轮次)), 连接("轮] LLM返回 | 认知态=", cog)), 连接("(", 认知态名(cog), ")")))
        输出(连接("  → 执行态=", act))

        设 映射 = 映射到三态(cog)
        设 认知值 = 取认知(映射)
        输出(连接(连接("→ [5→3映射] ", 连接(认知态名(cog), " → ", 映射描述(映射))), 连接("  认知值=", 三态描述(认知值, 置信度))))

        设 上一轮 = 1
        设 上游置信度 = 1.0
        设 hlen = 表长(历史)
        若 (hlen > 0) {
            设 上一轮 = 取(历史, 减(hlen, 1))
            设 上游置信度 = 取(历史置信度, 减(hlen, 1))
        }
        设 传播后 = 传播(上一轮, 认知值)
        设 历史 = 列表合(历史, 列表(传播后))
        // 贝叶斯置信度传播：后验 = 上游置信度 × 当前置信度
        设 传播置信度 = 上游置信度 * 置信度
        若 (传播置信度 < 0.01) { 设 传播置信度 = 0.01 }
        设 历史置信度 = 列表合(历史置信度, 列表(传播置信度))
        输出(连接(连接("→ [传播] 上游=", 三态描述(上一轮, 上游置信度)), 连接(" × 当前=", 三态描述(认知值, 置信度)), 连接(" → 结果=", 三态描述(传播后, 传播置信度))))

        若 (字符串相等(cog, "CONFLICTED")) {
            记录冲突("LLM", "unknown", 用户问题)
            输出("→ [冲突] 检测到矛盾信息，已记录")
        }

        // NEED_TOOL 优先级最高
        若 (字符串相等(act, "NEED_TOOL")) {
            输出(连接("→ [执行] 需要工具：", 取键(r, "tool")))
            设 tr = 调度工具(取键(r, "tool"), 取键(r, "params"))
            记(连接("tool_", 转字符串(轮次)), tr, 取键(r, "tool"))
            记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, 连接("调用工具:", 取键(r, "tool")), tr, 传播置信度, 场景名, 风险等级, 好感要求)
            输出(连接("→ 工具结果：", tr))
            输出(连接("→ 回答：", 取键(r, "answer")))
            输出("━━━━━━━━━━━━━━━━━━━━━━━━")
            跳出
        }

        // NEED_HUMAN → 问用户
        若 (字符串相等(act, "NEED_HUMAN")) {
            输出("→ [执行] 需要询问用户")
            记(连接("ans_", 转字符串(轮次)), 取键(r, "answer"), "agent")
            记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, "询问用户", 取键(r, "answer"), 传播置信度, 场景名, 风险等级, 好感要求)
            输出(连接("→ 回答：", 取键(r, "answer")))
            输出("━━━━━━━━━━━━━━━━━━━━━━━━")
            跳出
        }

        若 (传播后 == 1) {
            输出("→ [执行] 确信，直接回答")
            记(连接("ans_", 转字符串(轮次)), 取键(r, "answer"), "agent")
            记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, "确信回答", 取键(r, "answer"), 传播置信度, 场景名, 风险等级, 好感要求)
            输出(连接("→ 回答：", 取键(r, "answer")))
            输出("━━━━━━━━━━━━━━━━━━━━━━━━")
            跳出
        }

        若 (传播后 == -1) {
            输出("→ [执行] 拒绝（传播结果为假）")
            记(连接("ans_", 转字符串(轮次)), 连接("拒绝: ", 取键(r, "answer")), "agent")
            记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, "拒绝回答", 连接("拒绝: ", 取键(r, "answer")), 传播置信度, 场景名, 风险等级, 好感要求)
            输出(连接("→ 拒绝：", 取键(r, "answer")))
            输出("━━━━━━━━━━━━━━━━━━━━━━━━")
            跳出
        }

        // 可能态：输出回答退出
        记录决策(轮次, 用户问题, cog, act, 认知值, 上一轮, 传播后, "可能态", 取键(r, "answer"), 传播置信度, 场景名, 风险等级, 好感要求)
        输出("→ [执行] 可能态，输出当前回答")
        输出(连接("→ 回答：", 取键(r, "answer")))
        输出("━━━━━━━━━━━━━━━━━━━━━━━━")
        跳出
    }

    统计冲突()
}

// === 入口 ===
加载记忆()
输出("三言 Agent v0.2.0")
