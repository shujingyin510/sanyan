// 三言 Agent — 边界测试 & 关键路径测试（自包含版）
// 所有函数定义内联，无需外部导入

// ============================================================
// 决策核心
// ============================================================

定义 映射到三态 (cogState) {
    若 (字符串相等(cogState, "AFFIRM")) { 返回(1) }
    若 (字符串相等(cogState, "NEGATE")) { 返回(-1) }
    若 (字符串相等(cogState, "CONFLICTED")) {
        返回(字典("认知", 0, "执行", "就绪", "子策略", "conflict"))
    }
    若 (字符串相等(cogState, "PENDING")) {
        返回(字典("认知", 1, "执行", "等待", "子策略", "pending"))
    }
    若 (字符串相等(cogState, "UNCERT")) {
        返回(字典("认知", 0, "执行", "就绪", "子策略", "uncertain"))
    }
    返回(字典("认知", 0, "执行", "就绪", "子策略", "default"))
}

定义 传播 (上游, 当前) {
    若 (上游 == -1) { 返回(-1) }
    若 (上游 == 0 且 当前 == 1) { 返回(0) }
    返回(当前)
}

定义 取认知 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "认知")) }
    返回(mapped)
}

定义 取执行 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "执行")) }
    返回("就绪")
}

定义 是可能态 (mapped) {
    设 c = 取认知(mapped)
    设 e = 取执行(mapped)
    返回(c == 0 且 字符串相等(e, "就绪"))
}

定义 保护 (可能次数, 增益, 风险, hist, 最大犹豫次数, 最小增益阈值) {
    若 (字符串相等(风险, "高")) { 返回(列表(-1, "高风险：不确定就不做")) }
    若 (可能次数 >= 最大犹豫次数) { 返回(列表(多数投票(hist), "犹豫次数用尽")) }
    若 (增益 < 最小增益阈值) { 返回(列表(多数投票(hist), "信息增益不足")) }
    返回(列表(0, "continue"))
}

定义 多数投票 (hist) {
    设 真票 = 0
    设 假票 = 0
    设 len = 表长(hist)
    设 i = 0
    循环 (i < len) {
        设 v = 取(hist, i)
        若 (v == 1) { 设 真票 = 真票 + 1 }
        若 (v == -1) { 设 假票 = 假票 + 1 }
        设 i = i + 1
    }
    若 (真票 > 假票) { 返回(1) }
    若 (假票 > 真票) { 返回(-1) }
    返回(0)
}

// ============================================================
// 上下文管理器
// ============================================================

// 用字典存储可变状态（三言中 设 在函数内创建局部变量）
设 _状态 = 字典("冲突记录", 列表())

定义 判断相关性 (片段, 问题) {
    设 命中 = 0
    设 i = 0
    设 qlen = 取长(问题)
    循环 (i < qlen) {
        设 kw = 子串(问题, i, 1)
        若 (取长(kw) > 0 且 字符串包含(片段, kw)) { 设 命中 = 命中 + 1 }
        设 i = i + 1
    }
    若 (命中 >= 2) { 返回(1) }
    若 (命中 == 0) { 返回(-1) }
    返回(0)
}

定义 生成摘要 (片段) {
    若 (取长(片段) > 50) { 返回(连接(子串(片段, 0, 50), "...")) }
    返回(片段)
}

定义 压缩上下文 (旧, 新) {
    设 all = 列表合(旧, 列表(新))
    设 keep = 列表()
    设 summary = 列表()
    设 len = 表长(all)
    设 i = 0
    循环 (i < len) {
        设 s = 取(all, i)
        设 rel = 判断相关性(s, 新)
        若 (rel == 1) { 设 keep = 列表合(keep, 列表(s)) }
        若 (rel == 0) { 设 summary = 列表合(summary, 列表(生成摘要(s))) }
        设 i = i + 1
    }
    返回(列表合(keep, summary))
}

定义 计算增益 (新, 旧) {
    设 joined = ""
    设 j = 0
    设 olen = 表长(旧)
    循环 (j < olen) {
        设 joined = 连接(joined, 取(旧, j))
        设 j = j + 1
    }
    设 oldLen = 取长(joined)
    设 newLen = 取长(新)
    若 (oldLen == 0) { 返回(1.0) }
    设 g = newLen / oldLen
    若 (g > 1) { 设 g = 1 }
    返回(g)
}

定义 记录冲突 (srcA, srcB, topic) {
    设 entry = 字典(
        "a", srcA, "b", srcB, "topic", topic, "ts", 时间戳()
    )
    设 旧记录 = 取键(_状态, "冲突记录")
    置键(_状态, "冲突记录", 列表合(旧记录, 列表(entry)))
}

定义 统计冲突 () {
    设 冲突记录 = 取键(_状态, "冲突记录")
    输出("=== 冲突统计 ===")
    设 n = 表长(冲突记录)
    输出(连接("总数：", 转字符串(n)))
    设 k = 0
    设 clen = 表长(冲突记录)
    循环 (k < clen) {
        设 r = 取(冲突记录, k)
        输出(连接("  ", 转字符串(取键(r, "ts")), " ", 取键(r, "topic")))
        设 k = k + 1
    }
}

// ============================================================
// 边界测试
// ============================================================
设 最大犹豫次数 = 3
设 最小增益阈值 = 0.1

输出("=== 边界测试 ===")

输出("1. 连续 4 次可能 -> 触发犹豫保护")
设 历史 = 列表(1, 1, 1, 1)
设 r = 保护(4, 0.5, "低", 历史, 最大犹豫次数, 最小增益阈值)
若 (取(r, 0) != 0) {
    输出(连接("  PASS: 决策=", 转字符串(取(r, 0))))
} 否则 {
    输出("  FAIL")
}

输出("")
输出("2. 高风险 -> 直接拒绝")
设 r = 保护(0, 1.0, "高", 列表(), 最大犹豫次数, 最小增益阈值)
若 (取(r, 0) == -1) {
    输出(连接("  PASS: ", 取(r, 1)))
} 否则 {
    输出(连接("  FAIL: 决策=", 转字符串(取(r, 0))))
}

输出("")
输出("3. 上游假 -> 传播拒绝下游")
设 r = 传播(-1, 1)
若 (r == -1) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望-1, 实际", 转字符串(r)))
}

输出("")
输出("4. 上游可能 -> 下游真降级为可能")
设 r = 传播(0, 1)
若 (r == 0) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望0, 实际", 转字符串(r)))
}

输出("")
输出("5. AFFIRM -> 认知=1")
设 m = 映射到三态("AFFIRM")
设 认知 = 取认知(m)
若 (认知 == 1) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望1, 实际", 转字符串(认知)))
}

输出("")
输出("6. NEGATE -> 认知=-1")
设 m = 映射到三态("NEGATE")
设 认知 = 取认知(m)
若 (认知 == -1) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望-1, 实际", 转字符串(认知)))
}

输出("")
输出("7. CONFLICTED -> 认知=0 + 记录冲突")
设 m = 映射到三态("CONFLICTED")
设 认知 = 取认知(m)
若 (认知 == 0) {
    输出("  PASS: 认知=0")
} 否则 {
    输出(连接("  FAIL: 认知=", 转字符串(认知)))
}
记录冲突("源A", "源B", "测试冲突")
输出("  PASS: 冲突已记录")

输出("")
输出("8. 多数投票：真票占优")
设 hist = 列表(1, 1, -1, 0, 1)
设 r = 多数投票(hist)
若 (r == 1) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望1, 实际", 转字符串(r)))
}

输出("")
输出("9. 多数投票：平局")
设 hist = 列表(1, -1)
设 r = 多数投票(hist)
若 (r == 0) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望0, 实际", 转字符串(r)))
}

输出("")
输出("10. 信息增益计算")
设 旧 = 列表("abc", "def")
设 新 = "ghijkl"
设 g = 计算增益(新, 旧)
若 (g > 0) {
    输出(连接("  PASS: 增益=", 转字符串(g)))
} 否则 {
    输出("  FAIL")
}

输出("")
输出("11. 上下文压缩")
设 历史上下文 = 列表(
    "今天天气很好适合出门散步",
    "明天可能有暴雨需要带伞",
    "这周末有台风不适合外出",
    "端午节快到了可以计划出游",
    "花粉过敏指数较高建议减少户外活动"
)
设 新信息 = "我想知道这周末适合出门吗"
设 压缩后 = 压缩上下文(历史上下文, 新信息)
输出(连接("  PASS: 原始", 转字符串(表长(历史上下文)), "条 压缩后", 转字符串(表长(压缩后)), "条"))
若 (表长(压缩后) > 0) {
    输出("  PASS")
} 否则 {
    输出("  FAIL")
}

输出("")
统计冲突()
