// 桃花村 社会算子配置 — 修改此文件即可调整世界观规则
// village_observe.san 通过 #include 加载

// ── 互信行为影响算子 ──
设 互信算子 = 字典(
    "帮助", 0.020,
    "赞扬", 0.010,
    "交易", 0.005,
    "问候", 0.003,
    "争吵", -0.030,
    "欺骗", -0.080,
    "赠礼", 0.050,
    "闲聊", 0.001
)

// ── 基础互信值（基于关系类型）──
设 关系互信 = 字典(
    "夫妻", 0.95,
    "朋友", 0.75,
    "邻居", 0.55,
    "熟人", 0.35,
    "陌生人", 0.10
)

// ── 天气影响算子 ──
设 天气影响 = 字典(
    "下雨", "雨淅淅沥沥下着",
    "阴天", "天阴沉沉的",
    "晴天", "阳光很好"
)

// ── 时段描述 ──
设 时段描述 = 字典(
    "早晨", "清晨",
    "中午", "正午",
    "下午", "午后",
    "晚上", "傍晚",
    "深夜", "深夜"
)

// ── 地点列表 ──
设 地点列表 = 列表("铁匠铺", "井边", "村口", "山脚下", "菜地", "郎中家")

// ── 传闻池 ──
设 传闻池 = 列表(
    "庄稼今年特别好。",
    "在商量合伙做生意。",
    "山里最近有野猪出没。",
    "最近身体不太好。",
    "准备修自家屋顶。",
    "昨天在河边捡到一块玉石。",
    "打算去镇上赶集。"
)

// ── 夜间事件池 ──
设 夜间事件池 = 列表(
    "远处传来几声狗叫。",
    "有NPC半夜起来喂了趟牲口。",
    "有NPC提着灯笼在村子里巡逻了一圈。",
    "猫头鹰咕咕叫了几声。",
    "有人家的门吱呀响了一声。",
    "一阵风吹过竹林，沙沙作响。"
)

// ── 全局参数 ──
设 观察速度 = 0
设 最大天数 = 30
设 传闻概率 = 0.3   // 每次互动生成传闻的概率
设 移动概率 = 0.4   // NPC 换位置的概率
设 深夜阈值 = 4     // >=此值视为深夜
设 回家概率 = 80    // 深夜回家概率 (%)
