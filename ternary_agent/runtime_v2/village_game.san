// 三言 Agent Runtime v3 — 村庄模拟
// 8个NPC + 传闻传播网 + 声望系统

// ============================================================
// 全局状态
// ============================================================
设 _V = 字典(
    "天数", 0, "轮次", 0, "当前NPC", "老王",
    "声望", 50,
    "时段", 1,   // 0凌晨 1早晨 2中午 3下午 4晚上 5深夜
    "天气", "晴天",  // 晴天/阴天/下雨
    "传闻队列", 列表()
)

// ============================================================
// 时间系统
// ============================================================
设 时段名 = 列表("凌晨","早晨","中午","下午","晚上","深夜")

定义 取时段名 () { 返回(取(时段名, 取键(_V, "时段"))) }

定义 时间流逝 () {
    设 t = 取键(_V, "时段") + 1
    若 (t > 5) { 设 t = 0 }
    置键(_V, "时段", t)
}

定义 睡觉 () {
    // 睡觉：跳到第二天早晨
    设 天数 = 取键(_V, "天数") + 1; 置键(_V, "天数", 天数)
    置键(_V, "时段", 1) // 早晨
    推进时间(1); 传播传闻()
    // 每日好感微降，天气刷新
    设 keys = 字典键列表(NPC数据); 设 i = 0; 设 len = 表长(keys)
    循环 (i < len) { 改NPC好感(取(keys, i), -1); 设 i = i + 1 }
    刷新天气()
    输出(""); 输出(连接("════ 第 ", 转字符串(取键(_V, "天数")), " 天  ", 取时段名(), "  ", 取键(_V, "天气"), " ════"))
    村庄日常()
}

// ============================================================
// 天气系统
// ============================================================
定义 刷新天气 () {
    设 r = 取键(_V, "天数") % 10
    若 (r == 0 或 r == 1) { 置键(_V, "天气", "下雨") }
    否则 若 (r == 2 或 r == 3) { 置键(_V, "天气", "阴天") }
    否则 { 置键(_V, "天气", "晴天") }
}

// ============================================================
// NPC日程：每人每个时段的行为
// ============================================================
设 NPC日程 = 字典(
    "老王", 字典(
        0, "在家睡觉", 1, "在门口浇菜", 2, "在屋里吃饭",
        3, "在门口晒太阳", 4, "在院子里乘凉", 5, "准备睡觉"
    ),
    "李婶", 字典(
        0, "在家睡觉", 1, "在井边打水", 2, "在灶台做饭",
        3, "在院子里晾衣服", 4, "在门口择菜", 5, "准备休息"
    ),
    "铁匠张", 字典(
        0, "在铺后睡觉", 1, "在生火炉子", 2, "在歇息喝茶",
        3, "在打铁铺打铁", 4, "在收拾工具", 5, "已关铺休息"
    ),
    "村长刘", 字典(
        0, "在家睡觉", 1, "在村口转悠", 2, "在树下乘凉",
        3, "在召集开会", 4, "在写村志", 5, "已熄灯睡觉"
    ),
    "刘嫂", 字典(
        0, "在家睡觉", 1, "在洗衣服", 2, "在做饭",
        3, "在串门唠嗑", 4, "在收拾屋子", 5, "准备睡觉"
    ),
    "郎中大", 字典(
        0, "在睡觉", 1, "在晒草药", 2, "在看诊",
        3, "在研磨药材", 4, "在整理药方", 5, "已关门休息"
    ),
    "猎户赵", 字典(
        0, "在睡觉", 1, "在进山打猎", 2, "在剥兽皮",
        3, "在卖猎物", 4, "在修弓箭", 5, "在喝闷酒"
    ),
    "小贩孙", 字典(
        0, "在睡觉", 1, "在摆摊", 2, "在吃午饭",
        3, "在吆喝卖货", 4, "在收摊算账", 5, "已收摊离开"
    )
)

定义 取NPC行为 (name) {
    设 t = 取键(_V, "时段")
    设 schedule = 取键(NPC日程, name)
    设 行为 = 取键(schedule, t)

    // 天气影响行为
    设 天气 = 取键(_V, "天气")
    若 (字符串相等(天气, "下雨")) {
        若 (字符串相等(name, "老王") 且 t == 1) { 设 行为 = "在屋里躲雨" }
        若 (字符串相等(name, "李婶") 且 t == 3) { 设 行为 = "在屋里整理" }
        若 (字符串相等(name, "铁匠张") 且 t == 3) { 设 行为 = "在修工具" }
        若 (字符串相等(name, "刘嫂") 且 t == 3) { 设 行为 = "在家做针线" }
    }
    返回(行为)
}

// ============================================================
// NPC 数据（8人）
// ============================================================
设 NPC数据 = 字典(
    "老王",   字典("角色","老农","好感",50,"位置","村东","性格","憨厚"),
    "李婶",   字典("角色","农妇","好感",50,"位置","村东","性格","爽朗"),
    "铁匠张", 字典("角色","铁匠","好感",50,"位置","村中","性格","直爽"),
    "村长刘", 字典("角色","村长","好感",50,"位置","村中","性格","稳重"),
    "刘嫂",   字典("角色","村长妻","好感",50,"位置","村中","性格","爱打听"),
    "郎中大", 字典("角色","郎中","好感",50,"位置","村西","性格","和善"),
    "猎户赵", 字典("角色","猎户","好感",50,"位置","村北","性格","孤僻"),
    "小贩孙", 字典("角色","小贩","好感",50,"位置","村口","性格","精明")
)

// ============================================================
// 关系网（两个NPC之间的关系类型）
// ============================================================
设 关系网 = 字典(
    "老王_李婶",   "夫妻",
    "老王_铁匠张", "朋友",
    "李婶_刘嫂",   "朋友",
    "刘嫂_村长刘", "夫妻",
    "村长刘_铁匠张","熟人",
    "村长刘_郎中大","熟人",
    "猎户赵_小贩孙","邻居",
    "铁匠张_小贩孙","熟人",
    "郎中大_刘嫂", "熟人"
)
定义 取关系 (a, b) {
    设 key1 = 连接(a, "_", b)
    设 key2 = 连接(b, "_", a)
    若 (含键(关系网, key1)) { 返回(取键(关系网, key1)) }
    若 (含键(关系网, key2)) { 返回(取键(关系网, key2)) }
    返回("陌生人")
}
定义 传播速度 (关系) {
    若 (字符串相等(关系, "夫妻")) { 返回(10) }
    若 (字符串相等(关系, "朋友")) { 返回(7) }
    若 (字符串相等(关系, "邻居")) { 返回(5) }
    若 (字符串相等(关系, "熟人")) { 返回(3) }
    返回(1)
}

// ============================================================
// 记忆系统
// ============================================================
设 记忆表 = 字典()
设 衰减率 = 5
设 遗忘阈值 = 5

定义 创建记忆 (id, 内容, 状态) {
    置键(记忆表, id, 字典("id",id,"内容",内容,"状态",状态,"创建时间",时间戳(),"最后访问",时间戳(),"访问次数",0,"强度",80))
}
定义 回忆 (id) {
    若 (不(含键(记忆表, id))) { 返回(字典("强度",0)) }
    设 节点 = 取键(记忆表, id)
    置键(节点, "访问次数", 取键(节点, "访问次数") + 1)
    设 s = 取键(节点, "强度") + 5; 若 (s > 100) { 设 s = 100 }
    置键(节点, "强度", s)
    返回(节点)
}
定义 推进时间 (天数) {
    设 秒数 = 天数 * 86400
    设 keys = 字典键列表(记忆表)
    设 i = 0; 设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i); 设 节点 = 取键(记忆表, k)
        设 d = 秒数 * 衰减率 / 86400; 设 ns = 取键(节点, "强度") - d
        若 (ns < 0) { 设 ns = 0 }; 置键(节点, "强度", ns)
        若 (ns < 遗忘阈值) { 删除键(记忆表, k) }
        设 i = i + 1
    }
}

// ============================================================
// 传闻传播引擎
// ============================================================
定义 广播传闻 (源NPC, 内容, 状态) {
    // 记录传闻，在睡觉时逐跳传播
    设 队列 = 取键(_V, "传闻队列")
    置键(_V, "传闻队列", 列表合(队列, 列表(字典(
        "源", 源NPC, "内容", 内容, "状态", 状态, "跳数", 0
    ))))
}
定义 传播传闻 () {
    设 新队列 = 列表()
    设 队列 = 取键(_V, "传闻队列")
    设 i = 0; 设 len = 表长(队列)
    循环 (i < len) {
        设 rum = 取(队列, i)
        设 跳数 = 取键(rum, "跳数") + 1
        若 (跳数 > 3) { 设 i = i + 1; 继续 }
        设 源 = 取键(rum, "源"); 设 内容 = 取键(rum, "内容"); 设 状态 = 取键(rum, "状态")
        // 找到所有与源有关系的NPC，传播给他们
        设 npcKeys = 字典键列表(NPC数据)
        设 j = 0; 设 nlen = 表长(npcKeys)
        循环 (j < nlen) {
            设 目标 = 取(npcKeys, j)
            若 (字符串相等(目标, 源)) { 设 j = j + 1; 继续 }
            设 关系 = 取关系(源, 目标)
            设 速度 = 传播速度(关系)
            若 (速度 >= 跳数 * 2) {
                // 到达此NPC，创建传闻记忆
                设 memKey = 连接(目标, "_传闻_", 内容)
                若 (不(含键(记忆表, memKey))) {
                    创建记忆(memKey, 连接("听说: ", 内容), 状态)
                }
                // 继续传播
                设 新队列 = 列表合(新队列, 列表(字典("源",目标,"内容",内容,"状态",状态,"跳数",跳数)))
            }
            设 j = j + 1
        }
        设 i = i + 1
    }
    置键(_V, "传闻队列", 新队列)
}

// ============================================================
// 声望系统
// ============================================================
定义 改变声望 (delta) {
    设 r = 取键(_V, "声望") + delta
    若 (r > 100) { 设 r = 100 }; 若 (r < 0) { 设 r = 0 }
    置键(_V, "声望", r)
    // 声望影响所有NPC基础好感（缓慢趋近声望值）
    设 npcKeys = 字典键列表(NPC数据)
    设 i = 0; 设 len = 表长(npcKeys)
    循环 (i < len) {
        设 n = 取(npcKeys, i); 设 data = 取键(NPC数据, n)
        设 当前好感 = 取键(data, "好感")
        若 (r > 当前好感) { 置键(data, "好感", 当前好感 + 1) }
        否则 若 (r < 当前好感) { 置键(data, "好感", 当前好感 - 1) }
        设 i = i + 1
    }
}
定义 取NPC好感 (name) {
    若 (含键(NPC数据, name)) { 返回(取键(取键(NPC数据, name), "好感")) }
    返回(50)
}
定义 改NPC好感 (name, delta) {
    若 (含键(NPC数据, name)) {
        设 data = 取键(NPC数据, name)
        设 fav = 取键(data, "好感") + delta
        若 (fav > 100) { 设 fav = 100 }; 若 (fav < 0) { 设 fav = 0 }
        置键(data, "好感", fav)
    }
}
定义 心情 (fav) {
    若 (fav >= 80) { 返回("开心") }; 若 (fav >= 60) { 返回("友好") }
    若 (fav >= 40) { 返回("平淡") }; 若 (fav >= 20) { 返回("冷淡") }
    返回("疏远")
}

// ============================================================
// NPC长期目标（影响行为和对话）
// ============================================================
设 NPC目标 = 字典(
    "老王",   "攒钱修房子",
    "李婶",   "把菜园种好",
    "铁匠张", "打出全村最好的刀",
    "村长刘", "今年修好村口的路",
    "刘嫂",   "给孙子做新衣裳",
    "郎中大", "找齐药方上的草药",
    "猎户赵", "打到一头鹿",
    "小贩孙", "这个月多赚三成"
)

// ============================================================
// NPC回复 v2 — 联想链 + 可能态 + 多样化 + 长期目标
// ============================================================
定义 NPC回复 (玩家输入) {
    设 npc = 取键(_V, "当前NPC")
    设 data = 取键(NPC数据, npc)
    设 角色 = 取键(data, "角色"); 设 性格 = 取键(data, "性格")
    设 fav = 取键(data, "好感")
    设 回复 = ""
    设 是送礼 = 字符串包含(玩家输入, "送") 或 字符串包含(玩家输入, "给")

    // ── 切换NPC ──
    若 (字符串包含(玩家输入, "老王")) { 置键(_V, "当前NPC", "老王"); 设 回复 = "你走到村东老王家。" }
    否则 若 (字符串包含(玩家输入, "李婶")) { 置键(_V, "当前NPC", "李婶"); 设 回复 = "你走到村东李婶家。" }
    否则 若 (字符串包含(玩家输入, "铁匠")) { 置键(_V, "当前NPC", "铁匠张"); 设 回复 = "你听到叮当声，铁匠铺到了。" }
    否则 若 (字符串包含(玩家输入, "村长")) { 置键(_V, "当前NPC", "村长刘"); 设 回复 = "你走到村中最大的房子。" }
    否则 若 (字符串包含(玩家输入, "刘嫂")) { 置键(_V, "当前NPC", "刘嫂"); 设 回复 = "刘嫂正在门口择菜。" }
    否则 若 (字符串包含(玩家输入, "郎中")) { 置键(_V, "当前NPC", "郎中大"); 设 回复 = "一股药香扑面而来。" }
    否则 若 (字符串包含(玩家输入, "猎户")) { 置键(_V, "当前NPC", "猎户赵"); 设 回复 = "猎户家门口挂着几张兽皮。" }
    否则 若 (字符串包含(玩家输入, "小贩")) { 置键(_V, "当前NPC", "小贩孙"); 设 回复 = "小贩正在整理货摊。" }

    // ── 送礼（联想链主动触发）──
    否则 若 (是送礼) {
        改NPC好感(npc, 8); 改变声望(1)
        广播传闻(npc, 连接("玩家给", npc, "送了东西"), 1)
        若 (字符串包含(玩家输入, "苹果")) {
            创建记忆(连接(npc, "_苹果"), 连接(npc, "收到了苹果"), 1)
            若 (含键(记忆表, 连接(npc, "_花"))) {
                设 回复 = "又是苹果又是花的，你太客气了！"
            } 否则 { 设 回复 = "谢谢，这苹果不错！" }
        } 否则 若 (字符串包含(玩家输入, "花")) {
            创建记忆(连接(npc, "_花"), 连接(npc, "收到了花"), 1)
            若 (含键(记忆表, 连接(npc, "_苹果"))) { 设 回复 = "花真好看！上次的苹果也甜。" }
            否则 { 设 回复 = "哟，还带花来了！" }
        } 否则 若 (字符串包含(玩家输入, "酒")) {
            改NPC好感(npc, 5); 创建记忆(连接(npc, "_酒"), 连接(npc, "收到了酒"), 1)
            若 (含键(记忆表, 连接(npc, "_苹果")) 且 含键(记忆表, 连接(npc, "_花"))) {
                设 回复 = "哈哈！苹果花酒都齐了，你这朋友我交定了！"
            } 否则 { 设 回复 = "哈哈好东西，来来喝两杯！" }
        } 否则 若 (字符串包含(玩家输入, "肉") 或 字符串包含(玩家输入, "猎物")) {
            改NPC好感(npc, 3); 设 回复 = "这可是好东西！晚上炖一锅。"
        } 否则 {
            设 回复 = "谢谢！好久没人送我东西了。"
        }
        创建记忆(连接(npc, "_送礼"), "玩家送了礼物", 1)
    }

    // ── 奇怪物品（可能态可视化）──
    否则 若 (字符串包含(玩家输入, "石头") 或 字符串包含(玩家输入, "树枝") 或 字符串包含(玩家输入, "怪物")) {
        设 备选 = 列表(
            "这...这是什么东西？",
            "我没见过这玩意儿，你认真的？",
            "嗯...先放地上吧，让我看看。",
            "你捡这个干嘛？",
            "我有点不确定该不该收。"
        )
        设 轮次 = 取键(_V, "轮次")
        设 回复 = 连接("(想了想) ", 取(备选, 轮次 % 5))
        广播传闻(npc, 连接("玩家给", npc, "送了个奇怪东西"), 0)
    }

    // ── 借钱 ──
    否则 若 (字符串包含(玩家输入, "借钱")) {
        若 (含键(记忆表, 连接(npc, "_苹果"))) { 回忆(连接(npc, "_苹果"))
            设 回复 = "看在上次的份上...好吧，记得还。"; 改NPC好感(npc, -3)
        } 否则 若 (fav >= 55) { 设 回复 = "行吧，借多少？"; 改NPC好感(npc, -3) }
        否则 { 设 回复 = "不太熟，不合适吧。"; 改NPC好感(npc, -5) }
        广播传闻(npc, 连接("玩家问", npc, "借钱了"), -1)
    }

    // ── 还钱 ──
    否则 若 (字符串包含(玩家输入, "还钱")) {
        改NPC好感(npc, 10); 改变声望(2)
        若 (含键(记忆表, 连接(npc, "_借钱"))) { 删除键(记忆表, 连接(npc, "_借钱")) }
        设 回复 = "哎哟还真还啊，你这个人不错！"
        广播传闻(npc, 连接("玩家还给", npc, "钱了"), 1)
    }

    // ── 帮忙 ──
    否则 若 (字符串包含(玩家输入, "帮忙") 或 字符串包含(玩家输入, "帮助")) {
        若 (fav >= 60) { 设 回复 = "没问题，咱俩谁跟谁！" }
        否则 若 (fav >= 40) { 设 回复 = "行，能帮就帮一把。" }
        否则 { 设 回复 = "我最近有点忙..." }
        改NPC好感(npc, 5); 改变声望(2)
        广播传闻(npc, 连接("玩家帮", npc, "干活了"), 1)
    }

    // ── 打听 ──
    否则 若 (字符串包含(玩家输入, "听说") 或 字符串包含(玩家输入, "村里") 或 字符串包含(玩家输入, "新鲜事")) {
        设 有传闻 = 假; 设 回复 = ""
        设 keys = 字典键列表(记忆表); 设 i = 0; 设 len = 表长(keys)
        循环 (i < len) {
            设 k = 取(keys, i)
            若 (字符串包含(k, 连接(npc, "_传闻_"))) { 设 有传闻 = 真; 设 回复 = 取键(取键(记忆表, k), "内容") }
            设 i = i + 1
        }
        若 (不(有传闻)) { 设 回复 = "没什么新鲜事。要不你去村口小贩那看看？" }
    }

    // ── 打招呼（多样化）──
    否则 若 (字符串包含(玩家输入, "你好") 或 字符串包含(玩家输入, "早") 或 字符串包含(玩家输入, "在吗")) {
        设 天气 = 取键(_V, "天气")
        设 目标 = 取键(NPC目标, npc)
        设 轮次 = 取键(_V, "轮次")
        若 (fav >= 70) {
            设 备选 = 列表(
                连接("哟来了！今天正好在想", 目标, "的事。"),
                连接("来得正好！", 目标, "有进展了。"),
                连接("哈哈，看见你就高兴！", 目标, "也快了。")
            )
            若 (字符串相等(天气, "下雨")) { 设 回复 = "下雨天还来，快进来！" }
            否则 { 设 回复 = 取(备选, 轮次 % 3) }
        }
        否则 若 (fav >= 50) {
            若 (字符串相等(天气, "下雨")) { 设 回复 = "这雨下的...进来坐？" }
            否则 { 设 回复 = "早啊，吃过没？" }
        }
        否则 若 (fav >= 30) { 设 回复 = "你好，有什么事？" }
        否则 { 设 回复 = 连接(npc, "没搭理你。") }
    }

    // ── 再见 ──
    否则 若 (字符串包含(玩家输入, "再见") 或 字符串包含(玩家输入, "走了")) {
        若 (fav >= 60) { 设 回复 = "好嘞，有空常来！" }
        否则 { 设 回复 = "嗯，慢走。" }
    }

    // ── 你是谁 ──
    否则 若 (字符串包含(玩家输入, "你是谁")) {
        设 回复 = 连接("我是", npc, "，在村里当", 角色, "。")
    }

    // ── 通用（多样化 + 长期目标）──
    否则 {
        设 目标 = 取键(NPC目标, npc)
        设 轮次 = 取键(_V, "轮次")
        若 (fav >= 70) {
            设 备选 = 列表(
                "哈哈，说得对！",
                连接("是啊，等", 目标, "就好了。"),
                "跟我想一块去了！"
            )
            设 回复 = 取(备选, 轮次 % 3)
        }
        否则 若 (fav >= 50) { 设 回复 = "嗯，是这么回事。" }
        否则 { 设 回复 = "嗯。" }
    }
    返回(回复)
}

// ============================================================
// 每日村庄事件
// ============================================================
定义 村庄日常 () {
    设 天数 = 取键(_V, "天数"); 设 rnd = 天数 % 8
    若 (rnd == 0) { 输出("  今天是赶集的日子，村口热闹起来。"); 改NPC好感("小贩孙", 2) }
    否则 若 (rnd == 1) { 输出("  铁匠铺传来打铁声，铁匠张一早就开工了。") }
    否则 若 (rnd == 2) { 输出("  郎中大在门口晒草药，院子里飘着药香。") }
    否则 若 (rnd == 3) { 输出("  刘嫂端着盆去井边洗衣服，跟李婶唠起了家常。") }
    否则 若 (rnd == 4) { 输出("  猎户赵背着弓出了村，说是进山打猎。") }
    否则 若 (rnd == 5) { 输出("  村长刘召集了几个人在树下开会，商量修路的事。") }
    否则 若 (rnd == 6) {
        输出("  傍晚时分，炊烟四起，各家各户开始做饭。")
        设 keys = 字典键列表(NPC数据); 设 i = 0; 设 len = 表长(keys)
        循环 (i < len) { 设 n = 取(keys, i); 改NPC好感(n, 0); 设 i = i + 1 }
    }
    否则 { 输出("  一阵风吹过，村里的树叶沙沙作响。") }

    // 声望影响随机事件
    设 声望 = 取键(_V, "声望")
    若 (声望 >= 70) { 输出("  有人看见你，笑着打了个招呼。") }
    否则 若 (声望 <= 30) { 输出("  几个村民看见你，低下了头快步走开。") }
}

// ============================================================
// 状态面板
// ============================================================
定义 显示状态 () {
    设 声望 = 取键(_V, "声望")
    设 npc = 取键(_V, "当前NPC")
    设 tname = 取时段名(); 设 天气 = 取键(_V, "天气")
    输出(连接("┌─ 第 ", 转字符串(取键(_V, "天数")), " 天  ", tname, "  ", 天气, "  声望:", 转字符串(声望), " ──"))
    输出(连接("│ 当前: ", npc, " — ", 取NPC行为(npc)))
    输出(连接("│ 目标: ", 取键(NPC目标, npc)))
    输出("├─ NPC好感 ───────────────")
    设 keys = 列表("老王","李婶","铁匠张","村长刘","刘嫂","郎中大","猎户赵","小贩孙")
    设 i = 0; 设 len = 表长(keys)
    循环 (i < len) {
        设 n = 取(keys, i); 设 fav = 取NPC好感(n)
        设 bar = "██████████"; 设 b = fav / 10; 设 bi = 0
        设 bar2 = ""
        循环 (bi < 10) { 若 (bi < b) { 设 bar2 = 连接(bar2, "█") } 否则 { 设 bar2 = 连接(bar2, "░") }; 设 bi = bi + 1 }
        设 mark = ""; 若 (字符串相等(n, npc)) { 设 mark = "◄" }
        输出(连接("│ ", mark, " ", n, " ", bar2, " ", 转字符串(fav)))
        设 i = i + 1
    }
    输出("└──────────────────────────")
}

// ============================================================
// 游戏主循环
// ============================================================
定义 游戏开始 () {
    输出("═══════════════════════════════════")
    输出("     桃花村 8人关系网 v2.0")
    输出("  每次互动时间推进 睡觉进入下一天")
    输出("  状态/退出")
    输出("═══════════════════════════════════")
    输出("")

    循环 (1) {
        设 npc = 取键(_V, "当前NPC")
        设 data = 取键(NPC数据, npc)
        设 fav = 取键(data, "好感"); 设 m = 心情(fav)
        设 行为 = 取NPC行为(npc)
        若 (字符串相等(npc, "老王")) { 输出("~老王 在门口晒太阳~") }
        否则 { 输出(连接("~", npc, "~")) }
        设 输入文本 = 输入("玩家 > ")

        若 (取长(输入文本) == 0) { 继续 }
        若 (字符串相等(输入文本, "退出")) { 跳出 }

        若 (字符串相等(输入文本, "睡觉")) {
            睡觉()
            继续
        }

        若 (字符串相等(输入文本, "状态")) {
            显示状态()
            继续
        }

        // 每次互动推进时间
        时间流逝()
        设 轮次 = 取键(_V, "轮次") + 1; 置键(_V, "轮次", 轮次)
        设 回复 = NPC回复(输入文本)
        输出(连接(连接("  ", npc), 连接(": ", 回复)))

        // 时段切换提示
        设 t = 取键(_V, "时段")
        若 (t == 0) { 输出("  * 天快亮了...") }
        若 (t == 4) { 输出("  * 天色渐暗，该休息了。") }
    }

    输出(连接("你离开了桃花村。共 ", 连接(转字符串(取键(_V, "天数")), " 天。")))
    输出(连接("声望: ", 转字符串(取键(_V, "声望"))))
}

游戏开始()

// ============================================================
// LLM 对话管道 — NPC 回复由大模型生成
// ============================================================
设 对话历史 = 字典()
设 LLM启用 = 假
设 模型URL = "https://api.deepseek.com/v1/chat/completions"
设 模型名 = "deepseek-chat"
设 API密钥 = "sk-你的key"  // run_village_demo.py 启动时替换为环境变量 LLM_KEY

// 构建 NPC 系统提示词（角色+性格+关系+记忆+当前状态）
定义 构建NPC提示 (npc) {
    设 data = 取键(NPC数据, npc)
    设 角色 = 取键(data, "角色")
    设 性格 = 取键(data, "性格")
    设 fav = 取键(data, "好感")
    设 关系 = ""
    设 m = 心情(fav)

    // 构建该 NPC 与玩家的关系描述
    设 npcKeys = 字典键列表(NPC数据)
    设 关系列表 = 列表()
    设 i = 0; 设 len = 表长(npcKeys)
    循环 (i < len) {
        设 other = 取(npcKeys, i)
        若 (非(字符串相等(other, npc))) {
            设 rel = 取关系(npc, other)
             若 (非(字符串相等(rel, "陌生人"))) {
                设 关系列表 = 列表合(关系列表, 列表(连接(other, "是", rel)))
            }
        }
        设 i = i + 1
    }

    // 搜索 NPC 的相关记忆
   设 相关记忆 = 列表()
   设 memKeys = 字典键列表(记忆表)
   设 i = 0; 设 mlen = 表长(memKeys)
   循环 (i < mlen) {
       设 k = 取(memKeys, i)
       若 (字符串包含(k, npc) 且 不(字符串包含(k, "传闻"))) {
           设 node = 取键(记忆表, k)
           若 (是字典(node) 且 含键(node, "内容")) {
               设 相关记忆 = 列表合(相关记忆, 列表(取键(node, "内容")))
           }
       }
       设 i = i + 1
   }

    // 搜索传闻
   设 传闻列表 = 列表()
   设 i = 0; 设 mlen = 表长(memKeys)
   循环 (i < mlen) {
       设 k = 取(memKeys, i)
       若 (字符串包含(k, 连接(npc, "_传闻"))) {
           设 node = 取键(记忆表, k)
           若 (是字典(node) 且 含键(node, "内容")) {
               设 传闻列表 = 列表合(传闻列表, 列表(取键(node, "内容")))
           }
       }
       设 i = i + 1
   }

    // 拼接系统提示词
   设 prompt = 连接(连接("你是桃花村的", 角色), 连接("，名叫", npc))
   设 prompt = 连接(prompt, 连接("。", 性格))
   设 prompt = 连接(prompt, 连接("。现在心情:", m))
   若 (表长(关系列表) > 0) {
       设 prompt = 连接(prompt, "。与你有关的人：")
       设 j = 0; 设 rlen = 表长(关系列表)
       循环 (j < rlen) {
           设 prompt = 连接(prompt, 取(关系列表, j))
           若 (j < rlen - 1) { 设 prompt = 连接(prompt, "，") }
           设 j = j + 1
       }
   }
   若 (表长(相关记忆) > 0) {
       设 prompt = 连接(prompt, "。你知道的事：")
       设 j = 0; 设 rlen = 表长(相关记忆)
       循环 (j < rlen) {
           设 prompt = 连接(prompt, 取(相关记忆, j))
           若 (j < rlen - 1) { 设 prompt = 连接(prompt, "；") }
           设 j = j + 1
       }
   }
   若 (表长(传闻列表) > 0) {
       设 prompt = 连接(prompt, "。你听到的传闻：")
       设 j = 0; 设 rlen = 表长(传闻列表)
       循环 (j < rlen) {
           设 prompt = 连接(prompt, 取(传闻列表, j))
           若 (j < rlen - 1) { 设 prompt = 连接(prompt, "；") }
           设 j = j + 1
       }
   }
   设 prompt = 连接(prompt, "。今天是第")
   设 prompt = 连接(prompt, 连接(转字符串(取键(_V, "天数")), "天"))
   设 prompt = 连接(prompt, 连接("，", 连接(取时段名(), 连接("，天气", 取键(_V, "天气")))))
   设 prompt = 连接(prompt, "。有人来找你说话。请用中文简短回复（1-3句话），保持角色性格。")
   返回(prompt)
}

// LLM 调用 NPC 对话
定义 NPC对话 (玩家输入) {
    若 (非(LLM启用)) { 返回(NPC回复(玩家输入)) }

    设 npc = 取键(_V, "当前NPC")
    设 data = 取键(NPC数据, npc)
    设 fav = 取键(data, "好感")

    // 构建消息
    设 系统提示 = 构建NPC提示(npc)
    设 消息 = 列表(字典("role", "system", "content", 系统提示))

    // 加载对话历史（最近 5 轮）
    设 历史 = 列表()
    若 (含键(对话历史, npc)) {
        设 历史 = 取键(对话历史, npc)
        设 hlen = 表长(历史)
        若 (hlen > 10) { 设 历史 = 切片(历史, hlen - 10, hlen) }
    }
    设 消息 = 列表合(消息, 历史)
    设 消息 = 列表合(消息, 列表(字典("role", "user", "content", 连接("(好感:", 转字符串(fav), 连接(")", 玩家输入)))))

    // 调用 LLM
    若 (字符串相等(API密钥, "sk-你的key")) {
        返回(连接(npc, "（LLM未配置，使用规则模式）"))
    }
    设 body = 转JSON(字典("model", 模型名, "messages", 消息, "temperature", 0.8))
    设 headers = 字典("Content-Type", "application/json", "Authorization", 连接("Bearer ", API密钥))

    尝试 {
        设 raw = http写(模型URL, body, headers)
        若 (取长(raw) == 0) { 返回(连接(npc, " 看了看你，没说话。")) }
        设 outer = 解析JSON(raw)
        设 choices = 取键(outer, "choices")
        若 (表长(choices) > 0) {
            设 msg = 取键(取(choices, 0), "message")
            设 回答 = 取键(msg, "content")
            // 保存对话历史
            设 历史 = 列表合(历史, 列表(
                字典("role", "user", "content", 玩家输入),
                字典("role", "assistant", "content", 回答)
            ))
            置键(对话历史, npc, 历史)
            // 根据回答内容调整好感
            若 (字符串包含(回答, "谢谢") 或 字符串包含(回答, "高兴") 或 字符串包含(回答, "开心")) {
                改NPC好感(npc, 2)
            }
            若 (字符串包含(回答, "讨厌") 或 字符串包含(回答, "滚") 或 字符串包含(回答, "走开")) {
                改NPC好感(npc, -3)
            }
            返回(连接(npc, "：", 回答))
        }
    } 捕获 (e) {
        输出(连接("[LLM] 调用失败，使用规则回复: ", 转字符串(e)))
    }
    返回(NPC回复(玩家输入))  // 降级到规则回复
}

// 开关 LLM 模式
定义 启用LLM () { 设 LLM启用 = 真; 输出("LLM 对话模式已启用") }
定义 禁用LLM () { 设 LLM启用 = 假; 输出("LLM 已禁用，使用规则回复") }

// ============================================================
// 观察者模式 — 无玩家干预，NPC 自主生活，全部入睡才过天
// ============================================================
设 观察模式 = 假
设 NPC活跃 = 字典()  // NPC名 → 真(醒着) / 假(睡了)

定义 初始活跃 () {
    设 keys = 字典键列表(NPC数据)
    设 i = 0; 设 len = 表长(keys)
    循环 (i < len) {
        置键(NPC活跃, 取(keys, i), 真)
        设 i = i + 1
    }
}

定义 全部入睡 () {
    设 keys = 字典键列表(NPC活跃)
    设 i = 0; 设 len = 表长(keys)
    循环 (i < len) {
        若 (取键(NPC活跃, 取(keys, i))) { 返回(假) }
        设 i = i + 1
    }
    返回(真)
}

// NPC 自主行动：随机选两个 NPC 互动
定义 NPC自主行动 () {
    设 keys = 字典键列表(NPC数据)
    设 len = 表长(keys)
    设 活跃列表 = 列表()
    设 i = 0
    循环 (i < len) {
        设 name = 取(keys, i)
        若 (取键(NPC活跃, name)) {
            设 活跃列表 = 列表合(活跃列表, 列表(name))
        }
        设 i = i + 1
    }

    设 alen = 表长(活跃列表)
    若 (alen < 2) { 返回(假) }

    // 随机选两个 NPC 互动
    设 idx1 = 随机数(0, alen - 1)
    设 idx2 = 随机数(0, alen - 1)
    若 (idx1 == idx2) {
        设 idx2 = 余(加(idx2, 1), alen)
    }
    设 n1 = 取(活跃列表, idx1)
    设 n2 = 取(活跃列表, idx2)

    // NPC 互动（LLM 或规则）
    若 (LLM启用) {
        设 互动提示 = 连接(连接(n1, "和"), 连接(n2, "在聊天。", 连接(n1, "先说：")))
        尝试 {
            设 回复 = NPC对话(互动提示)
        } 捕获 (e) {
            设 回复 = 连接(n1, 连接("和", n2, "聊了几句。"))
        }
    } 否则 {
       输出(连接(n1, 连接("和", 连接(n2, "在", 取时段名(), "闲聊。"))))
    }

    // 深夜时段：NPC 随机决定休息
    设 时段 = 取键(_V, "时段")
    若 (时段 >= 4) {
        // 80% 概率去睡觉
        若 (随机数(0, 100) < 80) {
            置键(NPC活跃, n1, 假)
            输出(连接(n1, " 回家睡了。"))
        }
        若 (随机数(0, 100) < 80) {
            置键(NPC活跃, n2, 假)
            输出(连接(n2, " 回家睡了。"))
        }
    }
}

// 观察循环：NPC 自主生活直到全部入睡
定义 观察一日 () {
    设 天数 = 取键(_V, "天数")
    置键(_V, "天数", 加(天数, 1))
    输出(连接("════ 第 ", 连接(转字符串(取键(_V, "天数")), 连接(" 天  ", 取键(_V, "天气"), " ════"))))
    初始活跃()
    刷新天气()

    循环 (非(全部入睡())) {
        时间流逝()
        村庄日常()
        NPC自主行动()
        若 (取键(_V, "时段") == 5) {
            // 深夜强制入睡
            设 keys = 字典键列表(NPC活跃)
            设 i = 0; 设 len = 表长(keys)
            循环 (i < len) {
                设 name = 取(keys, i)
                若 (取键(NPC活跃, name)) {
                    置键(NPC活跃, name, 假)
                    输出(连接(name, " 夜深了，回家睡了。"))
                }
                设 i = i + 1
            }
        }
    }

    推进时间(1); 传播传闻()
    // 每日好感微降
    设 keys = 字典键列表(NPC数据); 设 i = 0; 设 len = 表长(keys)
    循环 (i < len) {
        改NPC好感(取(keys, i), -1)
        设 i = i + 1
    }
    显示状态()
}

// 启用观察模式
定义 开始观察 () {
    设 观察模式 = 真
    输出("桃花村观察模式启动 - 无玩家干预，NPC自主生活")
    循环 (真) {
        观察一日()
    }
}
