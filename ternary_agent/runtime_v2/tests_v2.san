// 三言 Agent Runtime v2 — 测试集
// 时间记忆 + 关联激活 + NPC行为验证

// ============================================================
// 时间记忆系统
// ============================================================
设 衰减率 = 5
设 遗忘阈值 = 5
设 访问增强值 = 5
设 强度上限 = 100
设 记忆表 = 字典()

定义 创建记忆 (id, 内容, 状态, 来源) {
    置键(记忆表, id, 字典(
        "id", id, "内容", 内容, "状态", 状态,
        "创建时间", 时间戳(), "最后访问", 时间戳(),
        "访问次数", 0, "强度", 80, "来源", 来源
    ))
}

定义 取节点 (id) {
    若 (含键(记忆表, id)) { 返回(取键(记忆表, id)) }
    返回(字典("强度", -1))
}

定义 推进时间 (天数) {
    设 秒数 = 天数 * 86400
    设 keys = 字典键列表(记忆表)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(记忆表, k)
        设 衰减量 = 秒数 * 衰减率 / 86400
        设 新强度 = 取键(节点, "强度") - 衰减量
        若 (新强度 < 0) { 设 新强度 = 0 }
        置键(节点, "强度", 新强度)
        若 (新强度 < 遗忘阈值) { 删除键(记忆表, k) }
        设 i = i + 1
    }
}

定义 回忆 (id) {
    若 (不(含键(记忆表, id))) { 返回(字典("强度", -1)) }
    设 节点 = 取键(记忆表, id)
    设 衰减量 = 0
    设 新强度 = 取键(节点, "强度") - 衰减量
    设 次数 = 取键(节点, "访问次数") + 1
    置键(节点, "访问次数", 次数)
    设 新强度 = 新强度 + 访问增强值
    若 (新强度 > 强度上限) { 设 新强度 = 强度上限 }
    置键(节点, "强度", 新强度)
    置键(节点, "最后访问", 时间戳())
    返回(节点)
}

// ============================================================
// 关联系统
// ============================================================
设 节点表 = 字典()
设 边表 = 字典()

定义 添加关联 (源, 目标, 权重) {
    若 (不(含键(节点表, 源))) { 置键(节点表, 源, 字典("名称", 源, "激活值", 0)) }
    若 (不(含键(节点表, 目标))) { 置键(节点表, 目标, 字典("名称", 目标, "激活值", 0)) }
    置键(边表, 连接(源, "->", 目标), 权重)
}

定义 激活传播 (起始概念) {
    设 nodeKeys = 字典键列表(节点表)
    设 i = 0
    设 nlen = 表长(nodeKeys)
    循环 (i < nlen) {
        设 n = 取键(节点表, 取(nodeKeys, i))
        置键(n, "激活值", 0)
        设 i = i + 1
    }
    若 (含键(节点表, 起始概念)) {
        置键(取键(节点表, 起始概念), "激活值", 100)
    }
    设 跳数 = 0
    循环 (跳数 < 3) {
        设 edgeKeys = 字典键列表(边表)
        设 j = 0
        设 elen = 表长(edgeKeys)
        循环 (j < elen) {
            设 边键 = 取(edgeKeys, j)
            设 权重 = 取键(边表, 边键)
            设 pos = 查找(边键, "->")
            若 (pos < 0) { 设 j = j + 1; 继续 }
            设 源 = 子串(边键, 0, pos)
            设 目标 = 子串(边键, pos + 2, 取长(边键) - pos - 2)
            若 (含键(节点表, 源) 且 含键(节点表, 目标)) {
                设 源节点 = 取键(节点表, 源)
                设 目标节点 = 取键(节点表, 目标)
                设 源激活 = 取键(源节点, "激活值")
                若 (源激活 > 0) {
                    设 传播值 = 源激活 * 权重 * 70 / 10000
                    设 新值 = 取键(目标节点, "激活值") + 传播值
                    若 (新值 > 100) { 设 新值 = 100 }
                    置键(目标节点, "激活值", 新值)
                }
            }
            设 j = j + 1
        }
        设 跳数 = 跳数 + 1
    }
}

定义 取节点激活 (name) {
    若 (含键(节点表, name)) { 返回(取键(取键(节点表, name), "激活值")) }
    返回(-1)
}

// ============================================================
// 测试
// ============================================================
设 _结果 = 字典("通过", 0, "失败", 0)

定义 断言真 (msg, 值) {
    若 (值 != 0) {
        输出(连接("[PASS] ", msg))
        置键(_结果, "通过", 取键(_结果, "通过") + 1)
    } 否则 {
        输出(连接("[FAIL] ", msg))
        置键(_结果, "失败", 取键(_结果, "失败") + 1)
    }
}

定义 断言相等 (msg, 实际, 期望) {
    若 (实际 == 期望) {
        输出(连接("[PASS] ", msg))
        置键(_结果, "通过", 取键(_结果, "通过") + 1)
    } 否则 {
        输出(连接("[FAIL] ", msg, " 期望:", 转字符串(期望), " 实际:", 转字符串(实际)))
        置键(_结果, "失败", 取键(_结果, "失败") + 1)
    }
}

输出("=== Runtime v2 测试 ===")
输出("")

// 1. 记忆创建
输出("--- 时间记忆 ---")
创建记忆("t1", "事件A", 1, "test")
设 n = 取节点("t1")
断言真("1.1 记忆创建后强度>0", 取键(n, "强度") > 0)
断言相等("1.2 初始强度为80", 取键(n, "强度"), 80)

// 2. 访问增强
回忆("t1")
设 n = 取节点("t1")
断言相等("2.1 访问后强度+5", 取键(n, "强度"), 85)
断言相等("2.2 访问次数+1", 取键(n, "访问次数"), 1)

// 3. 时间衰减
创建记忆("t2", "事件B", 1, "test")
推进时间(2)  // 2天后
设 n = 取节点("t2")
断言真("3.1 2天后强度衰减", 取键(n, "强度") < 80)

// 4. 遗忘清理
创建记忆("t3", "事件C", 1, "test")
推进时间(20)  // 20天后必衰减到<5
设 n = 取节点("t3")
断言真("4.1 长期无访问被遗忘", 取键(n, "强度") < 遗忘阈值 或 取键(n, "强度") == -1)

// 5. 关联图
输出("")
输出("--- 关联激活 ---")
添加关联("苹果", "水果", 80)
添加关联("水果", "健康", 50)
激活传播("苹果")
设 苹果激活 = 取节点激活("苹果")
设 水果激活 = 取节点激活("水果")
设 健康激活 = 取节点激活("健康")
断言相等("5.1 起始节点满激活", 苹果激活, 100)
断言真("5.2 水果被激活", 水果激活 > 0)
断言真("5.3 健康被激活", 健康激活 >= 0)

// 6. 无关联节点
设 未知激活 = 取节点激活("不认识")
断言相等("6.1 无关节点未激活", 未知激活, -1)

// 汇总
输出("")
输出("====================")
输出(连接("通过: ", 转字符串(取键(_结果, "通过")), "  失败: ", 转字符串(取键(_结果, "失败"))))
若 (取键(_结果, "失败") == 0) { 输出("全部通过!") } 否则 { 输出("有失败项") }
