// 桃花村 观察模式 — 空间+去重+夜间事件
#include "ternary_agent/runtime_v2/village_config.san"

设 观察速度 = 0
设 最大天数 = 30
设 对话缓存 = 字典()
设 NPC活跃 = 字典()
设 NPC位置 = 字典()
设 位置列表 = 列表("铁匠铺", "井边", "村口", "山脚下", "菜地", "郎中家")

定义 初始活跃 () {
    设 keys = 字典键列表(NPC数据); 设 i = 0; 设 len = 表长(keys)
    循环 (i < len) { 置键(NPC活跃, 取(keys, i), 真); 设 i = 加(i, 1) }
}

定义 初始位置 () {
    设 keys = 字典键列表(NPC数据); 设 i = 0; 设 len = 表长(keys)
    循环 (i < len) {
        设 name = 取(keys, i)
        设 idx = 随机数(0, 减(表长(位置列表), 1))
        置键(NPC位置, name, 取(位置列表, idx))
        设 i = 加(i, 1)
    }
}

定义 全部入睡 () {
    设 keys = 字典键列表(NPC活跃); 设 i = 0; 设 len = 表长(keys)
    循环 (i < len) { 若 (取键(NPC活跃, 取(keys, i))) { 返回(假) }; 设 i = 加(i, 1) }
    返回(真)
}

定义 NPC互动 () {
    设 keys = 字典键列表(NPC数据); 设 len = 表长(keys)
    设 活跃列表 = 列表(); 设 i = 0
    循环 (i < len) {
        设 name = 取(keys, i)
        若 (取键(NPC活跃, name)) { 设 活跃列表 = 列表合(活跃列表, 列表(name)) }
        设 i = 加(i, 1)
    }
    设 alen = 表长(活跃列表); 若 (alen < 2) { 返回(假) }

    设 idx1 = 随机数(0, 减(alen, 1))
    设 idx2 = 余(加(idx1, 加(1, 随机数(0, 减(alen, 2)))), alen)
    设 n1 = 取(活跃列表, idx1); 设 n2 = 取(活跃列表, idx2)

    生成对话(n1, n2)

    设 话1 = "嗯。"; 设 话2 = "是啊。"
    若 (含键(对话缓存, n1)) { 设 话1 = 取键(对话缓存, n1); 删除键(对话缓存, n1) }
    若 (含键(对话缓存, n2)) { 设 话2 = 取键(对话缓存, n2); 删除键(对话缓存, n2) }

    设 pos1 = 取键(NPC位置, n1)
    输出(连接("  [", 连接(pos1, 连接("] ", 连接(n1, 连接("：\"", 连接(话1, "\"")))))))
    等待(观察速度)
    输出(连接("  ", 连接(n2, 连接("：\"", 连接(话2, "\"")))))
    等待(观察速度)

    若 (含键(对话缓存, "_scene")) {
        设 场景 = 取键(对话缓存, "_scene")
        删除键(对话缓存, "_scene")
        输出(连接("  ", 场景))
    }
    若 (含键(对话缓存, "_trit")) {
        设 注解 = 取键(对话缓存, "_trit")
        删除键(对话缓存, "_trit")
        输出(注解)
    }
    若 (含键(对话缓存, "_rumor")) {
        设 传闻 = 取键(对话缓存, "_rumor")
        删除键(对话缓存, "_rumor")
        广播传闻(n1, 传闻, 1)
    }

    设 时段 = 取键(_V, "时段")
    若 (时段 >= 4) {
        若 (随机数(0, 100) < 80) { 置键(NPC活跃, n1, 假); 置键(NPC位置, n1, "家里"); 输出(连接("  ", n1, " 回屋了。")) }
        若 (随机数(0, 100) < 80) { 置键(NPC活跃, n2, 假); 置键(NPC位置, n2, "家里"); 输出(连接("  ", n2, " 回屋了。")) }
    }
}

// 夜间随机事件（Python 层处理：氛围 + 负反馈 + 记忆）
定义 夜间事件 () { 夜间冲突事件() }

定义 显示观察状态 () {
    设 天数 = 取键(_V, "天数")
    输出(连接("┌─ 第 ", 转字符串(天数), " 天  ", 取时段名(), "  ", 取键(_V, "天气"), " ──"))
    设 keys = 字典键列表(NPC数据); 设 i = 0; 设 len = 表长(keys)
    循环 (i < len) {
        设 name = 取(keys, i)
        若 (取键(NPC活跃, name)) { 输出(连接("  ", name, " — ", 取键(NPC位置, name))) } 否则 { 输出(连接("  ", name, " — 💤")) }
        设 i = 加(i, 1)
    }
}

定义 观察一日 () {
    置键(_V, "天数", 加(取键(_V, "天数"), 1))
    置键(_V, "时段", 1); 刷新天气(); 传播传闻(); 初始活跃(); 初始位置()
    输出(连接("════ 第 ", 转字符串(取键(_V, "天数")), " 天  ", 取键(_V, "天气"), " ════"))
    等待(观察速度)

    循环 (非(全部入睡())) {
        时间流逝()
        等待(观察速度)
        若 (取键(_V, "时段") >= 5) {
            设 keys = 字典键列表(NPC活跃); 设 i = 0; 设 len = 表长(keys)
            循环 (i < len) { 置键(NPC活跃, 取(keys, i), 假); 设 i = 加(i, 1) }
             夜间事件()
        } 否则 { NPC互动() }
    }
    推进时间(1)
    设 keys = 字典键列表(NPC数据); 设 i = 0; 设 len = 表长(keys)
    循环 (i < len) { 改NPC好感(取(keys, i), -1); 设 i = 加(i, 1) }
    显示观察状态()
}

定义 开始观察 () {
    输出(连接("观察（", 转字符串(最大天数), "天）"))
    循环 (真) {
        观察一日()
        若 (最大天数 > 0 且 取键(_V, "天数") >= 最大天数) { 输出(连接("结束。共", 转字符串(取键(_V, "天数")), " 天。")); 跳出 }
    }
}
