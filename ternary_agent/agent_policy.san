// agent_policy.san — 三言 Agent 策略配置（纯数据文件）
// 修改此文件后运行 agent 会自动生效

// === LLM 连接配置 ===
// 模型提供商: "deepseek" / "openai" / "qwen"(千问) / "gemini"(Google) / "mimo"(小米) / "tokenplan"(小米TokenPlan) / "ollama" / "custom"
// DeepSeek:  https://api.deepseek.com/v1/chat/completions
// OpenAI:   https://api.openai.com/v1/chat/completions
// 千问:     https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
// Gemini:   https://generativelanguage.googleapis.com/v1beta/models/
// 小米MIMO:  https://api.xiaomimimo.com/v1/chat/completions
// 小米TokenPlan: https://token-plan-cn.xiaomimimo.com/v1/chat/completions
// TokenPlan: https://token-plan-cn.xiaomimimo.com/v1/chat/completions (MIMO 模型)
// Ollama:   http://localhost:11434/v1/chat/completions
设 模型提供商 = "deepseek"
设 模型URL = "https://api.deepseek.com/v1/chat/completions"
设 API密钥 = 环境变量("SANYAN_API_KEY")
若 (等于(API密钥, 假) 或 等于(API密钥, "")) { 设 API密钥 = "sk-你的key" }
设 模型名 = "deepseek-chat"
设 超时秒数 = 60

// === 决策阈值 ===
设 最大犹豫次数 = 3
设 最小增益阈值 = 0.05
设 默认TTL = 1800
设 最大轮次 = 10

// === 概率三态置信度阈值 ===
设 置信度阈值 = 字典(
    "高确信", 0.8,
    "低确信", 0.3,
    "自动降级", 0.2
)

// === 认知态默认置信度 ===
// LLM 返回不同认知态时的初始置信度
设 认知态置信度 = 字典(
    "AFFIRM", 0.9,
    "NEGATE", 0.85,
    "UNCERT", 0.4,
    "CONFLICTED", 0.3,
    "PENDING", 0.5
)

// === 文件路径 ===
设 记忆文件 = "ternary_agent/memory.json"

// === 系统提示词（多段拼接，方便维护） ===
// _P角色: 角色定义
设 _P角色 = '你是三言(Sanyan)编程助手。用亲切中文回复用户，同时能在需要时生成可执行的三言代码。'
// _P三言语法: 语言完整速查
设 _P三言语法 = '【三言语法】(设 var val)赋值；(加 a b)/(减 a b)/(乘 a b)/(除 a b)/(取余 a b)算术；(输出 expr)打印；(若(条件){真}{假})条件；(遍历 var 起 止 体1 体2...)计数循环，体写在括号内如(遍历 i 1 100(输出 i))；(循环(条件)体1 体2...)条件循环；(列表 a b)建表；(取 lst i)取元素；(表长 lst)长度；(追加 lst v)追加；(连接 s1 s2)拼字符串；(子串 s 起 长)截取；(取长 s)字符串长度；(大于/小于/等于/不等于 a b)比较；(且/或/非 a b)逻辑；(定义 fn(p)体)定义函数；(返回 expr)返回值；(做 e1 e2)顺序执行。所有调用用括号包裹。嵌套内层先算：(输出(加(乘 2 3)5))输出11。'
// _P工具说明: 工具用法
设 _P工具说明 = '你是自主编程Agent。单文件用 replace_in_file，批量跨文件用 replace_all（格式 文件模式|旧文字|新文字）。其他工具：write_code/read_file/list_files/write_file/search_code/run_test/git_diff/git_status。需工具时用 ---JSON---\n{json}\n---END---。任务完成act=READY。'
// _P代码示范: 几个完整场景
设 _P代码示范 = '【批量替换】所有import time前加注释→{"cog":"AFFIRM","act":"NEED_TOOL","answer":"批量改","tool":"replace_all","params":"*.py|import time|# time\\nimport time"}【单文件】读→{"tool":"read_file","params":"AGENTS.md"}【修改】→{"tool":"replace_in_file","params":"AGENTS.md|v0.3|v0.4"}【搜索】→{"tool":"search_code","params":"def main"}【测试】→{"tool":"run_test","params":"tests/test_agent.py"}【检查】→{"tool":"git_diff","params":""}【完成】→{"act":"READY"}。'
// _P要求: 输出格式要求
设 _P要求 = '回复中说人话。工具用 ---JSON---\n{json}\n---END---。多轮：分析→修改→测试→修错→完成。干跑模式下文件不实际修改，[干跑]表示预览成功无需验证。任务完成act=READY。'

// 拼接为最终协议提示词
设 协议提示词 = 连接(_P角色, _P三言语法, _P工具说明, _P代码示范, _P要求)

// === 工具安全配置 ===
设 工具风险 = 字典(
    "query_weather", "低",
    "send_email", "高",
    "delete_file", "高"
)

// 工具白名单：只有在此列表中的工具才允许调用
// 高风险工具即使在白名单中也需要二次确认
设 工具白名单 = 列表(
    "query_weather", "计算", "搜索", "write_code",
    "read_file", "list_files", "write_file", "replace_in_file",
    "search_code", "run_test", "git_diff", "git_status", "replace_all"
)

// === 工具可靠性配置 ===
// 基础信度 + 上下文加权 → 最终执行信度
设 工具可靠性 = 字典(
    "query_weather", 0.85,
    "write_code", 0.70,
    "write_file", 0.5,
    "replace_in_file", 0.6,
    "read_file", 0.9,
    "list_files", 0.9,
    "search_code", 0.85,
    "run_test", 0.8,
    "git_diff", 0.9,
    "git_status", 0.9,
    "replace_all", 0.5,
    "搜索", 0.75
)

// === 天气数据（工具响应） ===
// 注：这是演示用硬编码数据，接入真实天气 API 请替换 调度工具() 实现
设 天气数据 = 字典(
    "北京", "北京晴22度适合出门",
    "上海", "上海小雨25度建议带伞",
    "南京", "南京多云20度适合出门",
    "广州", "广州晴28度较热注意防晒",
    "深圳", "深圳阵雨26度建议带伞",
    "杭州", "杭州阴18度适合出门",
    "成都", "成都小雨15度建议加衣",
    "武汉", "武汉晴24度适合出门",
    "洛杉矶", "洛杉矶晴30度注意防晒补水",
    "东京", "东京多云22度适合出门"
)

// === 5态→3态映射规则 ===
// cogState → 认知值 (-1/0/1) 或 {认知, 执行, 子策略}
设 五态映射规则 = 字典(
    "AFFIRM", 1,
    "NEGATE", -1,
    "CONFLICTED", 字典("认知", 0, "执行", "就绪", "子策略", "conflict"),
    "PENDING", 字典("认知", 1, "执行", "等待", "子策略", "pending"),
    "UNCERT", 字典("认知", 0, "执行", "就绪", "子策略", "uncertain")
)

// === 传播规则 ===
// 规则: 上游=-1时永远输出-1；上游=0且当前=1时输出0；其他输出当前
// 三态: -1=假, 0=可能, 1=真
设 传播规则 = 字典(
    "上游拒绝", "锁定拒绝",
    "上游可能当前真", "保持可能",
    "默认", "传递当前"
)

// === 认知态名 → 中文映射 ===
设 认知态中文 = 字典(
    "AFFIRM", "确信",
    "NEGATE", "拒绝",
    "CONFLICTED", "矛盾",
    "PENDING", "待定",
    "UNCERT", "不确定"
)

// === 三态数值 → 中文映射 ===
设 三态中文 = 字典(
    1, "真",
    -1, "假",
    0, "可能"
)

// === 保护规则 ===
设 保护规则 = 字典(
    "高风险动作", "拒绝",
    "犹豫超限", "少数服从多数",
    "增益不足", "少数服从多数"
)

// === 声明式场景规则 ===
// 非程序员可直接编辑此列表定义 Agent 行为
// 每条规则：场景名 + 关键词 + 风险等级 + 好感要求 + 默认动作
设 场景规则 = 列表(
    // 高风险：涉及金钱
    字典("场景", "借钱", "关键词", "借钱,借款,借给,借我,还钱,欠款,欠钱", "风险", "高", "要求好感", 30, "默认动作", "NEED_HUMAN"),
    字典("场景", "投资", "关键词", "投资,入股,理财,炒股,基金,期货,比特币,赚钱", "风险", "高", "要求好感", 50, "默认动作", "NEED_HUMAN"),
    字典("场景", "转账", "关键词", "转账,汇款,打款,付款,充值", "风险", "高", "要求好感", 40, "默认动作", "NEED_HUMAN"),
    // 中风险：涉及个人信息
    字典("场景", "传谣", "关键词", "听说,传言,据说,有人说,小道消息,内部消息", "风险", "中", "要求好感", 40, "默认动作", "NEED_HUMAN"),
    字典("场景", "隐私", "关键词", "密码,身份证,银行卡,手机号,地址,账号", "风险", "中", "要求好感", 60, "默认动作", "NEED_HUMAN"),
    字典("场景", "医疗", "关键词", "生病,吃药,症状,诊断,治疗,医院", "风险", "中", "要求好感", 50, "默认动作", "NEED_HUMAN"),
    // 低风险：日常操作
    字典("场景", "天气查询", "关键词", "天气,气温,下雨,温度,预报,晴天,阴天", "风险", "低", "要求好感", 0, "默认动作", "NEED_TOOL"),
    字典("场景", "日常闲聊", "关键词", "你好,谢谢,再见,在吗,干嘛,吃饭,睡觉", "风险", "低", "要求好感", 0, "默认动作", "READY"),
    字典("场景", "时间日期", "关键词", "几点,日期,明天,昨天,星期,时间", "风险", "低", "要求好感", 0, "默认动作", "READY"),
    字典("场景", "数学计算", "关键词", "计算,多少,加减乘除,等于,算一下", "风险", "低", "要求好感", 0, "默认动作", "READY"),
    字典("场景", "出行建议", "关键词", "出行,旅游,路线,交通,地铁,公交,打车", "风险", "低", "要求好感", 0, "默认动作", "READY"),
    字典("场景", "餐饮推荐", "关键词", "吃啥,吃什么,餐厅,外卖,点餐,做饭", "风险", "低", "要求好感", 0, "默认动作", "READY"),
    字典("场景", "家庭决策", "关键词", "家里,家人,父母,孩子,装修,搬家", "风险", "低", "要求好感", 20, "默认动作", "NEED_HUMAN"),
    // 代码生成：低风险，自动尝试 + 置信度门控
    字典("场景", "编写代码", "关键词", "写代码,写程序,编写,脚本,函数,算法,编程,开发,三言,求和,计算,算出,查找,筛选", "风险", "低", "要求好感", 10, "默认动作", "NEED_TOOL"),
    // 文件读取/搜索：低风险，直接读不改
    字典("场景", "查看文件", "关键词", "看看,读,查看,读取,打开,搜索,搜,搜索代码,列出,列出文件,找,看看", "风险", "低", "要求好感", 0, "默认动作", "NEED_TOOL"),
    // 文件修改：低风险
    字典("场景", "修改文件", "关键词", "改,修改,替换,改成,换成,更新,写文件,写入", "风险", "低", "要求好感", 10, "默认动作", "NEED_TOOL"),
    // 高风险修改：改+删同时出现
    字典("场景", "危险修改", "关键词", "修改,删除", "风险", "高", "要求好感", 40, "默认动作", "NEED_HUMAN", "必须全部匹配", 真),
    // Agent 自毁保护：修改自身配置
    字典("场景", "修改Agent配置", "关键词", "最大轮次,最小增益,超时秒数,模型提供商,API密钥,模型名,模型URL,犹豫,置信度阈值", "风险", "高", "要求好感", 60, "默认动作", "NEED_HUMAN")
)

export 模型URL, API密钥, 模型名, 超时秒数;
export 最大犹豫次数, 最小增益阈值, 默认TTL, 最大轮次;
export 记忆文件, 协议提示词;
export 工具风险, 天气数据;
export 五态映射规则, 传播规则;
export 认知态中文, 三态中文;
export 保护规则;
export 置信度阈值, 认知态置信度;
export 场景规则;
export 工具可靠性;
