// agent_policy.san — 三言 Agent 策略配置（纯数据文件）
// 修改此文件后运行 agent 会自动生效

// === LLM 连接配置 ===
// API密钥 优先从环境变量 DEEPSEEK_API_KEY 读取
设 模型URL = "https://api.deepseek.com/v1/chat/completions"
设 API密钥 = 环境变量("DEEPSEEK_API_KEY")
若 (等于(API密钥, 假)) { 设 API密钥 = "sk-你的key" }
设 模型名 = "deepseek-chat"
设 超时秒数 = 30

// === 决策阈值 ===
设 最大犹豫次数 = 3
设 最小增益阈值 = 0.1
设 默认TTL = 1800
设 最大轮次 = 5

// === 概率三态置信度阈值 ===
设 置信度阈值 = 字典(
    "高确信", 0.8,
    "低确信", 0.3,
    "自动降级", 0.2
)

// === 认知态默认置信度 ===
// LLM 返回不同认知态时的初始置信度
设 认知态置信度 = 字典(
    "AFFIRM", 0.9,
    "NEGATE", 0.85,
    "UNCERT", 0.4,
    "CONFLICTED", 0.3,
    "PENDING", 0.5
)

// === 文件路径 ===
设 记忆文件 = "ternary_agent/memory.json"

// === 系统提示词 ===
设 协议提示词 = '你是三态推理Agent。始终中文回复。纯JSON: {"cog":"AFFIRM","act":"READY","answer":"回答","tool":"","params":""}。cog: AFFIRM确信/NEGATE拒绝/UNCERT不确定/CONFLICTED矛盾。act: READY直接回答/NEED_TOOL调工具/NEED_HUMAN问用户。调工具时answer也要写对用户说的话(如"正在查询南京天气")。遇到矛盾信息用cog=CONFLICTED。工具: query_weather(城市名)。缺城市名用NEED_HUMAN。'

// === 工具风险映射 ===
设 工具风险 = 字典(
    "query_weather", "低",
    "send_email", "高",
    "delete_file", "高"
)

// === 天气数据（工具响应） ===
设 天气数据 = 字典(
    "北京", "北京晴22度适合出门",
    "上海", "上海小雨25度建议带伞",
    "南京", "南京多云20度适合出门",
    "广州", "广州晴28度较热注意防晒",
    "深圳", "深圳阵雨26度建议带伞",
    "杭州", "杭州阴18度适合出门",
    "成都", "成都小雨15度建议加衣",
    "武汉", "武汉晴24度适合出门",
    "洛杉矶", "洛杉矶晴30度注意防晒补水",
    "东京", "东京多云22度适合出门"
)

// === 5态→3态映射规则 ===
// cogState → 认知值 (-1/0/1) 或 {认知, 执行, 子策略}
设 五态映射规则 = 字典(
    "AFFIRM", 1,
    "NEGATE", -1,
    "CONFLICTED", 字典("认知", 0, "执行", "就绪", "子策略", "conflict"),
    "PENDING", 字典("认知", 1, "执行", "等待", "子策略", "pending"),
    "UNCERT", 字典("认知", 0, "执行", "就绪", "子策略", "uncertain")
)

// === 传播规则 ===
// 规则: 上游=-1时永远输出-1；上游=0且当前=1时输出0；其他输出当前
// 三态: -1=假, 0=可能, 1=真
设 传播规则 = 字典(
    "上游拒绝", "锁定拒绝",
    "上游可能当前真", "保持可能",
    "默认", "传递当前"
)

// === 认知态名 → 中文映射 ===
设 认知态中文 = 字典(
    "AFFIRM", "确信",
    "NEGATE", "拒绝",
    "CONFLICTED", "矛盾",
    "PENDING", "待定",
    "UNCERT", "不确定"
)

// === 三态数值 → 中文映射 ===
设 三态中文 = 字典(
    1, "真",
    -1, "假",
    0, "可能"
)

// === 保护规则 ===
设 保护规则 = 字典(
    "高风险动作", "拒绝",
    "犹豫超限", "少数服从多数",
    "增益不足", "少数服从多数"
)

// === 声明式场景规则 ===
// 非程序员可直接编辑此列表定义 Agent 行为
// 每条规则：场景名 + 关键词 + 风险等级 + 好感要求 + 默认动作
设 场景规则 = 列表(
    字典("场景", "借钱", "关键词", "借钱,借款,借给", "风险", "高", "要求好感", 30, "默认动作", "NEED_HUMAN"),
    字典("场景", "投资", "关键词", "投资,入股,理财,炒股", "风险", "高", "要求好感", 50, "默认动作", "NEED_HUMAN"),
    字典("场景", "传谣", "关键词", "听说,传言,据说,有人说", "风险", "中", "要求好感", 40, "默认动作", "NEED_HUMAN"),
    字典("场景", "天气查询", "关键词", "天气,气温,下雨,温度", "风险", "低", "要求好感", 0, "默认动作", "NEED_TOOL"),
    字典("场景", "日常闲聊", "关键词", "你好,谢谢,再见,在吗", "风险", "低", "要求好感", 0, "默认动作", "READY")
)

export 模型URL, API密钥, 模型名, 超时秒数;
export 最大犹豫次数, 最小增益阈值, 默认TTL, 最大轮次;
export 记忆文件, 协议提示词;
export 工具风险, 天气数据;
export 五态映射规则, 传播规则;
export 认知态中文, 三态中文;
export 保护规则;
export 置信度阈值, 认知态置信度;
export 场景规则;
