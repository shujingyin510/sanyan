// 三言 Agent — 关键路径测试（6 条）

设 dec = 导入("ternary_agent/decision.san")
设 ctx = 导入("ternary_agent/context_mgr.san")

输出("=== 关键路径测试 ===")

// 1. AFFIRM 直通
输出("1. AFFIRM 直通（真=1）")
设 m = dec.映射到三态("AFFIRM")
设 认知 = dec.取认知(m)
若 (认知 == 1) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望1, 实际", 转字符串(认知)))
}

输出("")

// 2. NEGATE 拒绝
输出("2. NEGATE 拒绝（假=-1）")
设 m = dec.映射到三态("NEGATE")
设 认知 = dec.取认知(m)
若 (认知 == -1) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望-1, 实际", 转字符串(认知)))
}

输出("")

// 3. CONFLICTED -> 可能态 + 冲突记录
输出("3. CONFLICTED -> 可能态 + 冲突记录")
设 m = dec.映射到三态("CONFLICTED")
设 认知 = dec.取认知(m)
若 (认知 == 0) {
    输出("  PASS: 认知=0")
} 否则 {
    输出(连接("  FAIL: 认知=", 转字符串(认知)))
}
ctx.记录冲突("源A", "源B", "测试冲突")
输出("  PASS: 冲突已记录")

输出("")

// 4. 多数投票：真票占优
输出("4. 多数投票：真票占优")
设 hist = 列表(1, 1, -1, 0, 1)
设 r = dec.多数投票(hist)
若 (r == 1) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望1, 实际", 转字符串(r)))
}

输出("")

// 5. 多数投票：平局
输出("5. 多数投票：平局->可能")
设 hist = 列表(1, -1)
设 r = dec.多数投票(hist)
若 (r == 0) {
    输出("  PASS")
} 否则 {
    输出(连接("  FAIL: 期望0, 实际", 转字符串(r)))
}

输出("")

// 6. 信息增益
输出("6. 信息增益计算")
设 旧 = 列表("abc", "def")
设 新 = "ghijkl"
设 g = ctx.计算增益(新, 旧)
若 (g > 0) {
    输出(连接("  PASS: 增益=", 转字符串(g)))
} 否则 {
    输出("  FAIL")
}
