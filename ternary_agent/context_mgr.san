// 三言 Agent — 上下文管理器

设 冲突记录 = 列表()

定义 判断相关性 (片段, 问题) {
    设 命中 = 0
    设 i = 0
    设 qlen = 取长(问题)
    循环 (i < qlen) {
        设 kw = 子串(问题, i, 1)
        若 (取长(kw) > 0 且 字符串包含(片段, kw)) { 设 命中 = 命中 + 1 }
        设 i = i + 1
    }
    若 (命中 >= 2) { 返回(1) }
    若 (命中 == 0) { 返回(-1) }
    返回(0)
}

定义 生成摘要 (片段) {
    若 (取长(片段) > 50) { 返回(连接(子串(片段, 0, 50), "...")) }
    返回(片段)
}

定义 压缩上下文 (旧, 新) {
    设 all = 列表合(旧, 列表(新))
    设 keep = 列表()
    设 summary = 列表()
    设 len = 表长(all)
    设 i = 0
    循环 (i < len) {
        设 s = 取(all, i)
        设 rel = 判断相关性(s, 新)
        若 (rel == 1) { 设 keep = 列表合(keep, 列表(s)) }
        若 (rel == 0) { 设 summary = 列表合(summary, 列表(生成摘要(s))) }
        设 i = i + 1
    }
    返回(列表合(keep, summary))
}

定义 计算增益 (新, 旧) {
    设 joined = ""
    设 j = 0
    设 olen = 表长(旧)
    循环 (j < olen) {
        设 joined = 连接(joined, 取(旧, j))
        设 j = j + 1
    }
    设 oldLen = 取长(joined)
    设 newLen = 取长(新)
    若 (oldLen == 0) { 返回(1.0) }
    设 g = newLen / oldLen
    若 (g > 1) { 设 g = 1 }
    返回(g)
}

定义 记录冲突 (srcA, srcB, topic) {
    设 冲突记录 = 列表合(冲突记录, 列表(字典(
        "a", srcA, "b", srcB, "topic", topic, "ts", 时间戳()
    )))
}

定义 统计冲突 () {
    输出("=== 冲突统计 ===")
    设 n = 表长(冲突记录)
    输出(连接("总数：", 转字符串(n)))
    设 k = 0
    设 clen = 表长(冲突记录)
    循环 (k < clen) {
        设 r = 取(冲突记录, k)
        输出(连接("  ", 转字符串(取键(r, "ts")), " ", 取键(r, "topic")))
        设 k = k + 1
    }
}

导出 判断相关性 生成摘要 压缩上下文 计算增益 记录冲突 统计冲突
