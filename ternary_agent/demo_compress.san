// 三言 Agent — 演示：上下文压缩
// 对比三态压缩的信息保留率

// ============================================================
// 上下文管理器（内联）
// ============================================================
设 _状态 = 字典("冲突记录", 列表())

定义 判断相关性 (片段, 问题) {
    设 命中 = 0
    设 i = 0
    设 qlen = 取长(问题)
    循环 (i < qlen) {
        设 kw = 子串(问题, i, 1)
        若 (取长(kw) > 0 且 字符串包含(片段, kw)) { 设 命中 = 命中 + 1 }
        设 i = i + 1
    }
    若 (命中 >= 2) { 返回(1) }
    若 (命中 == 0) { 返回(-1) }
    返回(0)
}

定义 生成摘要 (片段) {
    若 (取长(片段) > 50) { 返回(连接(子串(片段, 0, 50), "...")) }
    返回(片段)
}

定义 压缩上下文 (旧, 新) {
    设 all = 列表合(旧, 列表(新))
    设 keep = 列表()
    设 summary = 列表()
    设 len = 表长(all)
    设 i = 0
    循环 (i < len) {
        设 s = 取(all, i)
        设 rel = 判断相关性(s, 新)
        若 (rel == 1) { 设 keep = 列表合(keep, 列表(s)) }
        若 (rel == 0) { 设 summary = 列表合(summary, 列表(生成摘要(s))) }
        设 i = i + 1
    }
    返回(列表合(keep, summary))
}

// ============================================================
// 演示
// ============================================================
定义 演示压缩 () {
    设 历史 = 列表(
        "今天天气很好适合出门散步",
        "明天可能有暴雨需要带伞",
        "后天降温注意保暖",
        "大后天气温回升可以穿短袖",
        "这周末有台风不适合外出",
        "下周天气逐渐转凉建议穿长袖",
        "最近空气质量不错适合户外运动",
        "花粉过敏指数较高建议减少户外活动",
        "未来一周有两次降雨需要关注",
        "端午节快到了可以计划出游"
    )

    设 新信息 = "我想知道这周末适合出门吗"

    输出("=== 上下文压缩演示 ===")
    输出(连接("原始条目: ", 转字符串(表长(历史))))

    设 压缩后 = 压缩上下文(历史, 新信息)
    输出(连接("压缩后条目: ", 转字符串(表长(压缩后))))
    输出("")

    设 i = 0
    设 clen = 表长(压缩后)
    循环 (i < clen) {
        设 条目 = 取(压缩后, i)
        设 标记 = "保留"
        若 (取长(条目) > 53) { 设 标记 = "摘要" }
        输出(连接(标记, ": ", 条目))
        设 i = i + 1
    }

    设 原始总长 = 0
    设 j = 0
    设 hlen = 表长(历史)
    循环 (j < hlen) {
        设 原始总长 = 原始总长 + 取长(取(历史, j))
        设 j = j + 1
    }
    设 压缩总长 = 0
    设 k = 0
    设 clen2 = 表长(压缩后)
    循环 (k < clen2) {
        设 压缩总长 = 压缩总长 + 取长(取(压缩后, k))
        设 k = k + 1
    }

    输出("")
    output(connect("原始字符数: ", to_string(原始总长)))
    output(connect("压缩字符数: ", to_string(压缩总长)))
    设 rate = 100 - 压缩总长 * 100 / 原始总长
    output(connect("压缩率: ", to_string(rate), "%"))
}

演示压缩()
