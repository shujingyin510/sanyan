// test_math_se.san — S 表达式版
// 对照糖语法：
//   糖语法: test.测试("名称", 函数() { ... })
//   S表达式: （测试 test "名称" （函数 （） （做 ...）））
//
// 数学函数测试 — S 表达式版

（设 test （导入 "stdlib/test.san"））

（测试套件 test "三角函数"）
（测试 test "正弦"
  （函数 （） （做
    （断言真 test （等于 （正弦 0） 0））
  ））
）
（测试 test "余弦"
  （函数 （） （做
    （断言真 test （等于 （余弦 0） 1））
  ））
）

（测试套件 test "对数"）
（测试 test "对数运算"
  （函数 （） （做
    （断言真 test （等于 （常用对数 100） 2））
  ））
）

（测试套件 test "取整（整数参数）"）
（测试 test "向下取整"
  （函数 （） （做
    （断言相等 test （向下取整 3） 3）
  ））
）
（测试 test "向上取整"
  （函数 （） （做
    （断言相等 test （向上取整 3） 3）
  ））
）
（测试 test "四舍五入"
  （函数 （） （做
    （断言相等 test （四舍五入 3） 3）
  ））
）

（测试套件 test "幂运算"）
（测试 test "幂运算"
  （函数 （） （做
    （断言相等 test （幂 2 10） 1024）
    （断言相等 test （幂 5 0） 1）
  ））
）

（测试套件 test "比较运算"）
（测试 test "大于/小于"
  （函数 （） （做
    （断言真 test （大于 5 3））
    （断言假 test （小于 5 3））
  ））
）
（测试 test "大于等于/小于等于"
  （函数 （） （做
    （断言真 test （大于等于 5 5））
    （断言真 test （小于等于 5 5））
  ））
）
（测试 test "不大于"
  （函数 （） （做
    （断言假 test （不大于 5 3））
    （断言真 test （不大于 3 5））
    （断言真 test （不大于 5 5））
  ））
）
（测试 test "不小于"
  （函数 （） （做
    （断言真 test （不小于 5 3））
    （断言假 test （不小于 3 5））
    （断言真 test （不小于 5 5））
  ））
）

（测试报告 test）
