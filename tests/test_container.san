// 容器函数测试

设 test = 导入("stdlib/test.san")

// 排序
设 lst = 列表(3, 1, 4, 1, 5, 9, 2, 6)
设 排序结果 = 排序(lst)
输出(连接("排序: ", 排序结果))
test.断言相等列表(排序结果, 列表(1, 1, 2, 3, 4, 5, 6, 9))

// 反转
设 反转结果 = 反转(lst)
输出(连接("反转: ", 反转结果))
test.断言相等列表(反转结果, 列表(6, 2, 9, 5, 1, 4, 1, 3))

// 包含
设 包含4结果 = 包含(lst, 4)
输出(连接("包含 4: ", 包含4结果))
test.断言真(包含4结果)

设 包含7结果 = 包含(lst, 7)
输出(连接("包含 7: ", 包含7结果))
test.断言假(包含7结果)

// 去重
设 dup = 列表(1, 2, 2, 3, 3, 3)
设 去重结果 = 去重(dup)
输出(连接("去重: ", 去重结果))
test.断言相等列表(去重结果, 列表(1, 2, 3))

// 切片
设 切片结果 = 切片(lst, 1, 4)
输出(连接("切片 [1:4]: ", 切片结果))
test.断言相等列表(切片结果, 列表(1, 4, 1))

// 求和
设 求和结果 = 求和(lst)
输出(连接("求和: ", 求和结果))
test.断言相等(求和结果, 31)

// 合并
设 words = 列表("你", "好", "世", "界")
设 合并结果 = 合并(words, ",")
输出(连接("合并: ", 合并结果))
test.断言相等(合并结果, "你,好,世,界")

输出("容器函数测试完成")
