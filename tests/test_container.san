// 容器函数测试

// 排序
设 lst = 列表(3, 1, 4, 1, 5, 9, 2, 6)
输出(连接("排序: ", 排序(lst)))

// 反转
输出(连接("反转: ", 反转(lst)))

// 包含
输出(连接("包含 4: ", 包含(lst, 4)))
输出(连接("包含 7: ", 包含(lst, 7)))

// 去重
设 dup = 列表(1, 2, 2, 3, 3, 3)
输出(连接("去重: ", 去重(dup)))

// 切片
输出(连接("切片 [1:4]: ", 切片(lst, 1, 4)))

// 求和
输出(连接("求和: ", 求和(lst)))

// 合并
设 words = 列表("你", "好", "世", "界")
输出(连接("合并: ", 合并(words, ",")))

输出("容器函数测试完成")
