// 新功能测试：闭包、字典点号访问、三进制字面量、断言错误

输出("=== 新功能测试 ===")

// 1. Lambda 闭包
输出("── 闭包测试 ──")
设 外部变量 = 100
设 闭包函数 = 函数(x) { 返回(x + 外部变量) }
输出(连接("闭包捕获外部变量: ", 闭包函数(50)))

定义 创建计数器 () {
    设 计数 = 0
    返回(函数() {
        计数 = 计数 + 1
        返回(计数)
    })
}
设 计数器 = 创建计数器()
输出(连接("计数器第1次: ", 计数器()))
输出(连接("计数器第2次: ", 计数器()))
输出(连接("计数器第3次: ", 计数器()))

// 2. 字典点号访问
输出("── 字典点号访问 ──")
设 学生 = 字典("姓名", "小明", "年龄", 20, "成绩", 95)
输出(连接("姓名: ", 学生.姓名))
输出(连接("年龄: ", 学生.年龄))
输出(连接("成绩: ", 学生.成绩))

// 3. 三进制字面量
输出("── 三进制字面量 ──")
设 a = 三进制("+")
输出(连接("三进制 \"+\" = ", a))
设 b = 三进制("+-0")
输出(连接("三进制 \"+-0\" = ", b))
设 c = 三进制("---")
输出(连接("三进制 \"---\" = ", c))

// 4. 断言错误（可变参数）
输出("── 断言错误测试 ──")
设 test = 导入("stdlib/test.san")
定义 除法 (x, y) {
    若 (y 等于 0) { 返回("错误") }
    返回(x / y)
}
test.测试("断言错误测试", 函数() {
    test.断言错误(除法, 列表(10, 0))
})
test.测试报告()

输出("=== 新功能测试完成 ===")
