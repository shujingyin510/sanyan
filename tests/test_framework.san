// 测试框架测试

设 test = 导入("stdlib/test.san")

定义 加法 (x, y) {
    返回(x + y)
}

定义 除法 (x, y) {
    若 (y 等于 0) {
        输出("错误：除以零")
        返回(0)
    }
    返回(x / y)
}

test.测试套件("数学函数测试")

test.测试("加法测试", 函数() {
    test.断言相等(加法(1, 2), 3)
    test.断言相等(加法(0, 0), 0)
    test.断言相等(加法(-1, 1), 0)
})

test.测试("除法测试", 函数() {
    test.断言相等(除法(10, 2), 5)
    test.断言相等(除法(9, 3), 3)
})

test.测试("真值测试", 函数() {
    test.断言真(真)
    test.断言假(假)
})

test.测试("列表测试", 函数() {
    设 lst = 列表(1, 2, 3)
    test.断言包含(lst, 1)
    test.断言包含(lst, 2)
    test.断言包含(lst, 3)
})

test.测试报告()
