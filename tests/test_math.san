// 数学函数测试
设 test = 导入("stdlib/test.san")

test.测试套件("三角函数")
test.测试("正弦", 函数() {
    test.断言真(正弦(0) 等于 0)
})
test.测试("余弦", 函数() {
    test.断言真(余弦(0) 等于 1)
})

test.测试套件("对数")
test.测试("对数运算", 函数() {
    test.断言真(常用对数(100) 等于 2)
})

test.测试套件("取整（整数参数）")
test.测试("向下取整", 函数() {
    test.断言相等(向下取整(3), 3)
})
test.测试("向上取整", 函数() {
    test.断言相等(向上取整(3), 3)
})
test.测试("四舍五入", 函数() {
    test.断言相等(四舍五入(3), 3)
})

test.测试套件("幂运算")
test.测试("幂运算", 函数() {
    test.断言相等(幂(2, 10), 1024)
    test.断言相等(幂(5, 0), 1)
})

test.测试套件("比较运算")
test.测试("大于/小于", 函数() {
    test.断言真(5 > 3)
    test.断言假(5 < 3)
})
test.测试("大于等于/小于等于", 函数() {
    test.断言真(5 >= 5)
    test.断言真(5 <= 5)
})
test.测试("不大于", 函数() {
    test.断言假(5 不大于 3)
    test.断言真(3 不大于 5)
    test.断言真(5 不大于 5)
})
test.测试("不小于", 函数() {
    test.断言真(5 不小于 3)
    test.断言假(3 不小于 5)
    test.断言真(5 不小于 5)
})

test.测试报告()
