// 浮点数与 JSON 专项测试

// 1. 浮点数基本运算
设 a = 3.14
设 b = 2.0
输出("a + b = " + (a + b))
输出("a - b = " + (a - b))
输出("a * b = " + (a * b))
输出("a / b = " + (a / b))
输出("a % 1.5 = " + (a % 1.5))

// 2. 自动提升
设 c = 10
输出("c + 0.5 = " + (c + 0.5)) 

// 3. 数学函数
输出("sin(3.14159) = " + 正弦(3.14159))
输出("sqrt(2.0) = " + 平方根(2.0))

// 4. JSON 测试
设 字典对象 = 字典()
置键(字典对象, "姓名", "张三")
置键(字典对象, "分数", 95.5)
设 json串 = 转JSON(字典对象)
输出("JSON字符串: " + json串)

设 解析对象 = 解析JSON(json串)
输出("解析出的姓名: " + 取键(解析对象, "姓名"))
输出("解析出的分数: " + 取键(解析对象, "分数"))

// 5. 标准库扩展
加载("math")
输出("最大公约数(12, 18) = " + 最大公约数(12, 18))
输出("是素数(17) = " + 是素数(17))
输出("圆面积(10) = " + 圆面积(10))

加载("list")
设 列表对象 = 列表(1.1, 2.2, 3.3)
输出("列表求和: " + 求和(列表对象))
设 计数列表 = 列表(1, 2, 2, 3, 2)
输出("2在列表中的个数: " + 计数(计数列表, 2))
