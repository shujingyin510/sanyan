// 浮点数与 JSON 专项测试

设 test = 导入("stdlib/test.san")

// 1. 浮点数基本运算
设 a = 3.14
设 b = 2.0
设 浮点加 = a + b
输出("a + b = " + 浮点加)
test.断言真(浮点加 大于 5.13 且 浮点加 小于 5.15)

设 浮点减 = a - b
输出("a - b = " + 浮点减)
test.断言真(浮点减 大于 1.13 且 浮点减 小于 1.15)

设 浮点乘 = a * b
输出("a * b = " + 浮点乘)
test.断言真(浮点乘 大于 6.27 且 浮点乘 小于 6.29)

设 浮点除 = a / b
输出("a / b = " + 浮点除)
test.断言真(浮点除 大于 1.56 且 浮点除 小于 1.58)

设 浮点模 = a % 1.5
输出("a % 1.5 = " + 浮点模)
test.断言真(浮点模 大于 0.13 且 浮点模 小于 0.15)

// 2. 自动提升
设 c = 10
设 自动提升 = c + 0.5
输出("c + 0.5 = " + 自动提升)
test.断言真(自动提升 大于 10.49 且 自动提升 小于 10.51)

// 3. 数学函数
设 sin结果 = 正弦(3.14159)
输出("sin(3.14159) = " + sin结果)
test.断言真(sin结果 < 0.0001)

设 sqrt结果 = 平方根(2.0)
输出("sqrt(2.0) = " + sqrt结果)
test.断言真(sqrt结果 大于 1.414 且 sqrt结果 小于 1.415)

// 4. JSON 测试
设 字典对象 = 字典()
置键(字典对象, "姓名", "张三")
置键(字典对象, "分数", 95.5)
设 json串 = 转JSON(字典对象)
输出("JSON字符串: " + json串)
test.断言真(查找(json串, "张三") 不等于 -1)

设 解析对象 = 解析JSON(json串)
设 解析姓名 = 取键(解析对象, "姓名")
输出("解析出的姓名: " + 解析姓名)
test.断言相等(解析姓名, "张三")

设 解析分数 = 取键(解析对象, "分数")
输出("解析出的分数: " + 解析分数)
test.断言真(解析分数 大于 95.4 且 解析分数 小于 95.6)

// 5. 标准库扩展
加载("math")
设 gcd结果 = 最大公约数(12, 18)
输出("最大公约数(12, 18) = " + gcd结果)
test.断言相等(gcd结果, 6)

设 素数结果 = 是素数(17)
输出("是素数(17) = " + 素数结果)
test.断言真(素数结果)

设 面积结果 = 圆面积(10)
输出("圆面积(10) = " + 面积结果)
test.断言真(面积结果 大于 314.15 且 面积结果 小于 314.17)

加载("list")
设 列表对象 = 列表(1.1, 2.2, 3.3)
设 列表求和结果 = 求和(列表对象)
输出("列表求和: " + 列表求和结果)
test.断言真(列表求和结果 > 6.59 且 列表求和结果 < 6.62)

设 计数列表 = 列表(1, 2, 2, 3, 2)
设 计数结果 = 计数(计数列表, 2)
输出("2在列表中的个数: " + 计数结果)
test.断言相等(计数结果, 3)
