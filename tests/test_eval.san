// 测试纯 Sanyan 元循环求值器
// 内部操作使用英文名以绕过中文 skin 映射问题

设 e = 导入("stdlib/eval.san")
设 env = e.新建环境()

输出("=== 1. 基本运算 ===")
输出(e.求值(list("加", 3, 4), env))
输出(e.求值(list("乘", list("加", 2, 3), 4), env))
输出(e.求值(list("减", 10, 3), env))
输出(e.求值(list("幂", 2, 10), env))

输出("=== 2. 比较 ===")
输出(e.求值(list("大于", 5, 3), env))
输出(e.求值(list("等于", 4, 4), env))

输出("=== 3. 逻辑 ===")
输出(e.求值(list("且", 真, 真), env))
输出(e.求值(list("或", 假, 真), env))
输出(e.求值(list("非", 假), env))

输出("=== 4. list 操作 ===")
输出(e.求值(list("list_len", list("list", "a", "b", "c")), env))
输出(e.求值(list("get", list("list", 10, 20, 30), 1), env))

输出("=== 5. 若 ===")
输出(e.求值(list("若", 真, 42, 0), env))
输出(e.求值(list("若", 假, 42, 99), env))

输出("=== 6. 设 + 做 ===")
e.求值(list("做",
    list("设", "x", 10),
    list("设", "y", 20),
    list("加", "x", "y")
), env)

输出("=== 7. 定义函数 ===")
e.求值(list("定义", "双倍", list("x"), list("乘", "x", 2)), env)
输出(e.求值(list("双倍", 5), env))

e.求值(list("定义", "阶乘", list("n"),
    list("若", list("大于", "n", 1),
        list("乘", "n", list("阶乘", list("减", "n", 1))),
        1
    )
), env)
输出(e.求值(list("阶乘", 5), env))

输出("=== 8. 匿名函数 ===")
e.求值(list("设", "平方", list("函数", list("x"), list("乘", "x", "x"))), env)
输出(e.求值(list("平方", 6), env))

输出("=== 9. 闭包 ===")
e.求值(list("定义", "创建加数器", list("n"),
    list("函数", list("x"), list("加", "n", "x"))
), env)
设 加5 = e.求值(list("创建加数器", 5), env)
输出(e.求值(list(加5, 3), env))

输出("=== 10. 斐波那契 ===")
e.求值(list("定义", "斐波那契", list("n"),
    list("若", list("小于", "n", 2),
        "n",
        list("加",
            list("斐波那契", list("减", "n", 1)),
            list("斐波那契", list("减", "n", 2))
        )
    )
), env)
输出(e.求值(list("斐波那契", 6), env))

输出("=== eval 全部通过 ===")
