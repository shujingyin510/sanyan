// 测试纯 Sanyan 元循环求值器
// 内部操作使用英文名以绕过中文 skin 映射问题
设 test = 导入("stdlib/test.san")
设 e = 导入("stdlib/eval.san")
设 env = e.新建环境()

test.测试套件("元循环求值器")

test.测试("基本运算", 函数() {
    test.断言相等(e.求值(list("加", 3, 4), env), 7)
    test.断言相等(e.求值(list("乘", list("加", 2, 3), 4), env), 20)
    test.断言相等(e.求值(list("减", 10, 3), env), 7)
    test.断言相等(e.求值(list("幂", 2, 10), env), 1024)
})

test.测试("比较", 函数() {
    test.断言真(e.求值(list("大于", 5, 3), env))
    test.断言真(e.求值(list("等于", 4, 4), env))
})

test.测试("逻辑", 函数() {
    test.断言真(e.求值(list("且", 真, 真), env))
    test.断言真(e.求值(list("或", 假, 真), env))
    test.断言真(e.求值(list("非", 假), env))
})

test.测试("列表操作", 函数() {
    test.断言相等(e.求值(list("list_len", list("list", "a", "b", "c")), env), 3)
    test.断言相等(e.求值(list("get", list("list", 10, 20, 30), 1), env), 20)
})

test.测试("条件", 函数() {
    test.断言相等(e.求值(list("若", 真, 42, 0), env), 42)
    test.断言相等(e.求值(list("若", 假, 42, 99), env), 99)
})

test.测试("变量定义", 函数() {
    e.求值(list("做",
        list("设", "x", 10),
        list("设", "y", 20),
        list("加", "x", "y")
    ), env)
    设 x = e.查变量(env, "x")
    test.断言相等(x, 10)
})

test.测试("定义函数", 函数() {
    e.求值(list("定义", "双倍", list("x"), list("乘", "x", 2)), env)
    test.断言相等(e.求值(list("双倍", 5), env), 10)
})

test.测试("递归阶乘", 函数() {
    e.求值(list("定义", "阶乘", list("n"),
        list("若", list("大于", "n", 1),
            list("乘", "n", list("阶乘", list("减", "n", 1))),
            1
        )
    ), env)
    test.断言相等(e.求值(list("阶乘", 5), env), 120)
})

test.测试("匿名函数", 函数() {
    e.求值(list("设", "平方", list("函数", list("x"), list("乘", "x", "x"))), env)
    test.断言相等(e.求值(list("平方", 6), env), 36)
})

test.测试("闭包", 函数() {
    e.求值(list("定义", "创建加数器", list("n"),
        list("函数", list("x"), list("加", "n", "x"))
    ), env)
    设 加5 = e.求值(list("创建加数器", 5), env)
    test.断言相等(e.求值(list(加5, 3), env), 8)
})

test.测试报告()
