// 字符串函数测试

// 子串
设 s = "你好世界"
输出(连接("子串: ", 子串(s, 0, 2)))

// 替换
输出(连接("替换: ", 替换("hello world", "world", "三言")))

// 分割
设 parts = 分割("a,b,c", ",")
输出(连接("分割: ", parts))

// 查找
输出(连接("查找: ", 查找("hello world", "world")))

// 去空白
输出(连接("去空白: ", 去空白("  hello  ")))

// 大写/小写
输出(连接("大写: ", 大写("hello")))
输出(连接("小写: ", 小写("WORLD")))

// 前缀/后缀
输出(连接("前缀: ", 前缀("hello", "he")))
输出(连接("后缀: ", 后缀("hello", "lo")))

输出("字符串函数测试完成")
