// 字符串函数测试

设 test = 导入("stdlib/test.san")

// 子串
设 s = "你好世界"
设 子串结果 = 子串(s, 0, 2)
输出(连接("子串: ", 子串结果))
test.断言相等(子串结果, "你好")

// 替换
设 替换结果 = 替换("hello world", "world", "三言")
输出(连接("替换: ", 替换结果))
test.断言相等(替换结果, "hello 三言")

// 分割
设 parts = 分割("a,b,c", ",")
输出(连接("分割: ", parts))
test.断言相等(parts[0], "a")
test.断言相等(parts[1], "b")
test.断言相等(parts[2], "c")

// 查找
设 查找结果 = 查找("hello world", "world")
输出(连接("查找: ", 查找结果))
test.断言相等(查找结果, 6)

// 去空白
设 去空白结果 = 去空白("  hello  ")
输出(连接("去空白: ", 去空白结果))
test.断言相等(去空白结果, "hello")

// 大写/小写
设 大写结果 = 大写("hello")
输出(连接("大写: ", 大写结果))
test.断言相等(大写结果, "HELLO")

设 小写结果 = 小写("WORLD")
输出(连接("小写: ", 小写结果))
test.断言相等(小写结果, "world")

// 前缀/后缀
设 前缀结果 = 前缀("hello", "he")
输出(连接("前缀: ", 前缀结果))
test.断言真(前缀结果)

设 后缀结果 = 后缀("hello", "lo")
输出(连接("后缀: ", 后缀结果))
test.断言真(后缀结果)

输出("字符串函数测试完成")
