// 作用域隔离测试
// 验证函数内变量不泄漏到全局

设 全局变量 = 100

定义 测试函数 (参数) {
    设 局部变量 = 999
    全局变量 = 0
    输出(连接("函数内 全局变量: ", 全局变量))
    输出(连接("函数内 局部变量: ", 局部变量))
    返回(参数)
}

设 结果 = 测试函数(42)
输出(连接("函数返回: ", 结果))
输出(连接("函数外 全局变量: ", 全局变量))

// 验证作用域隔离：函数内修改的全局变量已恢复
若 (全局变量 等于 100) {
    输出("作用域隔离测试通过：全局变量已恢复")
} 否则 {
    输出("作用域隔离测试失败：全局变量未恢复")
}
