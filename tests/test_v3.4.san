// 三言 v3.4 功能回归测试
输出("=== 三言 v3.4 功能回归测试 ===")

// 1. 运算符优先级
设 x = 5
设 y = 3
输出(连接("运算符优先级: x>2且y<4 = ", x > 2 且 y < 4))
输出(连接("运算符优先级: x<2或y>4 = ", x < 2 或 y > 4))

// 2. 跳出关键字
输出("--- 跳出测试 ---")
遍历 i 从 1 到 10 {
    若 (i > 3) { 跳出 }
    输出(i)
}
输出("跳出测试完成")

// 3. 判语句
输出("--- 判语句测试 ---")
设 信号 = 随机态()
判 信号 {
    真 { 输出("信号: 确定") }
    可能 { 输出("信号: 持保留") }
    假 { 输出("信号: 否定") }
}

// 4. 异常处理
输出("--- 异常处理测试 ---")
尝试 {
    设 a = 读文件("nonexist.txt")
} 捕获 (e) {
    输出("文件不存在，捕获成功")
}

// 5. 容器与高阶函数
输出("--- 容器测试 ---")
设 lst = 列表(1, 2, 3, 4)
输出(连接("映射: ", 映射(函数(x) { x * 2 }, lst)))
输出(连接("过滤: ", 过滤(函数(x) { x > 2 }, lst)))
输出(连接("归并: ", 归并(函数(a, b) { a + b }, lst)))

// 6. 字符串插值
输出("--- 字符串插值测试 ---")
设 t = 25
输出(模板{温度: ${t}°C})

// 7. IoT 控制
输出("--- IoT 测试 ---")
置 灯 = 亮
查 灯
设 传感器读数 = 读 人体
输出(连接("人体传感器: ", 传感器读数))

输出("=== 所有测试完成 ===")
0