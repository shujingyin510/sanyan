// 容器操作测试
输出("=== 容器测试 ===")

// 列表
设 lst = 列表(1, 2, 3)
输出(连接("列表长度: ", 表长(lst)))
置元素(lst, 1, 99)
输出(连接("修改后: ", lst))

// 数组
设 arr = 数组(3, 0)
置元素(arr, 0, 100)
输出(连接("数组[0]: ", arr(0)))

// 字典（使用数字键，确保纯 ASCII 安全）
设 d = 字典(1, 10, 2, 20)
输出(连接("取键 1: ", 取键(d, 1)))
置键(d, 3, 30)
输出(连接("取键 3: ", 取键(d, 3)))

// 高阶函数
设 nums = 列表(1, 2, 3, 4, 5)
设 doubled = 映射(函数(x) { x * 2 }, nums)
输出(连接("映射: ", doubled))
设 evens = 过滤(函数(x) { x % 2 == 0 }, nums)
输出(连接("过滤偶数: ", evens))
设 total = 归并(函数(a, b) { a + b }, nums)
输出(连接("归并求和: ", total))

输出("容器测试完成")