// 全角字符完整性测试
// 测试所有全角符号的支持
设 test = 导入("stdlib/test.san")

test.测试套件("全角字符")
test.测试("全角数字与运算", 函数() {
    设 a＝５
    设 b＝３
    test.断言真(a 等于 5)
    test.断言真(b 等于 3)
    test.断言真(a＋b 等于 8)
})

test.测试("全角不等于", 函数() {
    设 a＝５
    设 b＝３
    test.断言真(a！＝b)
})

test.测试("全角负数", 函数() {
    设 c＝-10
    test.断言真(c 等于 -10)
})

test.测试("混合全角半角", 函数() {
    设 d＝5＋3
    test.断言真(d 等于 8)
})

test.测试("全角方括号", 函数() {
    设 列表＝【１，２，３】
    test.断言真(取(列表, 0) 等于 1)
    test.断言真(取(列表, 1) 等于 2)
    test.断言真(取(列表, 2) 等于 3)
})

test.测试("全角注释", 函数() {
    ＃ 这是全角注释
    test.断言真(真)
})

test.测试报告()
