// Break and catch test (no crash expected)
print("=== break test ===")
for i from 1 to 5 {
    if (i > 2) { break }
    print(i)
}
print("loop end")

print("=== catch language error test ===")
try {
    set z = x23
} catch (e) {
    print(concat("caught: ", e))
}

print("=== catch internal error test (should be caught by try) ===")
try {
    set y = 1 / 0
} catch (e) {
    print("internal error caught (expected)")
}
print("test complete")