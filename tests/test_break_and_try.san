// 三言 v3.4 跳出 与 窄异常捕获 独立测试
输出("=== 跳出测试 ===")
遍历 i 从 1 到 5 {
    若 (i > 2) { 跳出 }
    输出(i)
}
输出("循环结束")

输出("=== 异常捕获测试（语言错误） ===")
尝试 {
    设 x = x23
} 捕获 (e) {
    输出(连接("错误信息: ", e))
}

输出("=== 异常捕获测试（内部错误，不应捕获） ===")
尝试 {
    设 z = 1 / 0
} 捕获 (e) {
    输出("不应该看到这条")
}
输出("如果你看到我，说明非语言错误被误捕获了")
