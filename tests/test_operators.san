// 运算符优先级与逻辑测试
输出("=== 运算符测试 ===")

// 1. 算术优先级
设 a = 2 + 3 * 4
设 b = (2 + 3) * 4
输出(连接("2+3*4 = ", a))          // 14
输出(连接("(2+3)*4 = ", b))        // 20

// 2. 比较 > 逻辑 优先级
设 x = 5
设 y = 3
设 r1 = x > 2 且 y < 4
设 r2 = x < 2 或 y > 4
输出(连接("x>2且y<4 = ", r1))      // 真
输出(连接("x<2或y>4 = ", r2))      // 假

// 3. 复合条件
设 z = 10
若 (z > 5 且 z < 20) {
    输出("z在范围内")
} 否则 {
    输出("z超出范围")
}

输出("运算符测试完成")