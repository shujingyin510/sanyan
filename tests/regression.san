输出("=== 三言 v3.4 阶段一回归测试 ===")

// 1. 运算符优先级
设 x = 5
设 y = 3
设 r1 = x > 2 且 y < 4
设 r2 = x < 2 或 y > 4
输出(连接("优先级测试: ", r1, " ", r2))

// 2. 跳出
输出("--- 跳出测试 ---")
遍历 i 从 1 到 5 {
    若 (i > 2) { 跳出 }
    输出(i)
}
输出("跳出测试结束")

// 3. 判
输出("--- 判测试 ---")
设 信号 = 随机态()
判 信号 {
    真 { 输出("真") }
    可能 { 输出("可能") }
    假 { 输出("假") }
}

// 4. 异常处理（语言层错误）
输出("--- 异常测试 ---")
尝试 {
    设 z = 未定义变量
} 捕获 (e) {
    输出(连接("捕获语言错误: ", e))
}

// 5. 异常处理（非语言错误，应不被捕获）
输出("--- 非语言错误应崩溃 ---")
尝试 {
    设 z = 1 / 0    // Python 内部 ZeroDivisionError，不应被捕获
} 捕获 (e) {
    输出("不应该看到这条")
}
输出("如果你看到我，说明非语言错误被误捕获了")