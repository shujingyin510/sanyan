// tests/test_parse_se.san — 解析器测试（Sanyan 版 S 表达式解析器）
// 用单引号避免测试字符串中的 " 与语法冲突

设 p = 导入("stdlib/parse.san")
设 e = 导入("stdlib/eval.san")

输出("=== 1. 词法分析 ===")

设 tokens1 = p.词法分析('（加 1 2）')
输出(连接("tokens1: ", tokens1))

设 tokens2 = p.词法分析('（输出 "hello"）')
输出(连接("tokens2: ", tokens2))

设 str_token = 取(tokens2, 2)
输出(连接("str_token: ", str_token))

输出("=== 2. 解析 ===")

设 ast1 = p.解析源代码('（加 1 2）')
输出(连接("ast1: ", ast1))

设 ast2 = p.解析源代码('（加 1 （乘 2 3））')
输出(连接("ast2: ", ast2))

输出("=== 3. 解析 + 求值 ===")

设 env = e.新建环境()
// 注册常用常量
e.设变量(env, "真", 1)
e.设变量(env, "假", 0)

设 r1 = e.求值(p.解析源代码('（加 1 2）'), env)
输出(连接("1+2 = ", r1))

设 r2 = e.求值(p.解析源代码('（加 1 （乘 2 3））'), env)
输出(连接("1+2*3 = ", r2))

设 r3 = e.求值(p.解析源代码('（大于 5 3）'), env)
输出(连接("5>3 = ", r3))

设 r4 = e.求值(p.解析源代码('（且 真 假）'), env)
输出(连接("真且假 = ", r4))

e.求值(p.解析源代码('（设 x 10）'), env)
设 r5 = e.求值(p.解析源代码('（乘 x 2）'), env)
输出(连接("x*2 = ", r5))

输出("=== 4. 字符串字面量 ===")

设 r6 = e.求值(p.解析源代码('（输出 "hello"）'), env)
输出(连接("string: ", r6))

输出("=== 5. 定义函数 ===")

e.求值(p.解析源代码('（定义 平方 （x） （乘 x x））'), env)
设 r7 = e.求值(p.解析源代码('（平方 6）'), env)
输出(连接("平方(6) = ", r7))

输出("=== parser tests 全部通过 ===")
