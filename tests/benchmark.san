// 基准测试：测量关键操作的执行时间

设 开始时间 = 当前时间()

// 测试 1: 整数运算 (10000 次)
设 运算计数 = 0
设 运算结果 = 0
循环 (运算计数 < 10000) {
    运算结果 = 运算结果 + 运算计数 - (运算计数 / 2) * 1
    运算计数 = 运算计数 + 1
}
设 运算耗时 = 当前时间() - 开始时间
输出(连接("整数运算 10000 次: ", 运算耗时, " 秒"))

// 测试 2: 函数调用 (1000 次)
设 开始时间2 = 当前时间()
定义 递增 (x) {
    返回(x + 1)
}
设 调用计数 = 0
循环 (调用计数 < 1000) {
    设 调用计数 = 递增(调用计数)
}
设 调用耗时 = 当前时间() - 开始时间2
输出(连接("函数调用 1000 次: ", 调用耗时, " 秒"))

// 测试 3: 列表操作 (500 次)
设 开始时间3 = 当前时间()
设 列表计数 = 0
设 测试列表 = 列表()
循环 (列表计数 < 500) {
    设 测试列表 = 列表合(测试列表, 列表(列表计数))
    列表计数 = 列表计数 + 1
}
设 列表耗时 = 当前时间() - 开始时间3
输出(连接("列表操作 500 次: ", 列表耗时, " 秒"))

// 测试 4: 三值逻辑 (2000 次)
设 开始时间4 = 当前时间()
设 逻辑计数 = 0
循环 (逻辑计数 < 2000) {
    设 状态 = 随机态()
    若 (且(状态 等于 真, 逻辑计数 大于 1000)) {
        设 x = 1
    } 再若 (或(状态 等于 假, 逻辑计数 小于 500)) {
        设 x = 2
    } 否则 {
        设 x = 3
    }
    逻辑计数 = 逻辑计数 + 1
}
设 逻辑耗时 = 当前时间() - 开始时间4
输出(连接("三值逻辑 2000 次: ", 逻辑耗时, " 秒"))

设 总耗时 = 当前时间() - 开始时间
输出(连接("基准测试总耗时: ", 总耗时, " 秒"))
