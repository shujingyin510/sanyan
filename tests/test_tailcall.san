// 尾递归优化测试
// 验证尾递归不会栈溢出

设 test = 导入("stdlib/test.san")

定义 阶乘尾递归 (n, acc) {
    若 (n 等于 0) {
        返回(acc)
    }
    阶乘尾递归(n - 1, n * acc)
}

// 测试较大的值（非尾递归会栈溢出）
设 result = 阶乘尾递归(100, 1)
设 阶乘位数 = 取长(连接("", result))
输出(连接("100! 的位数: ", 阶乘位数))
test.断言相等(阶乘位数, 158)

// 斐波那契尾递归
定义 fib尾递归 (n, a, b) {
    若 (n 等于 0) {
        返回(a)
    }
    fib尾递归(n - 1, b, a + b)
}

设 fib_result = fib尾递归(30, 0, 1)
输出(连接("fib(30): ", fib_result))
test.断言相等(fib_result, 832040)

输出("尾递归优化测试完成")
