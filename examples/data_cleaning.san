// 数据清洗管道 — 三态 NULL 传播比 None/NaN 更安全
// 证明：三言「可能」明确告知"数据不够，无法判定"，而非输出误导性数值

输出（"=== 三态数据清洗管道 ==="）
输出（"痛点：Python 里 None > 5 报错，NaN == NaN 是 False"）
输出（"三言：可能 明确告知调用方，不猜"）

// ── 模拟带缺失值的评分记录 ──
定义 生成记录 （） ｛
    返回（字典（
        "姓名", 连接（"用户_", 随机数（1000， 9999）），
        "手机_已验证", 随机态（），
        "邮箱_已验证", 随机态（），
        "身份证_已验证", 随机态（），
        "地址_已验证", 随机态（）
    ））
｝

// ── 三言评分函数 ──
定义 三言评分 （记录） ｛
    设 总分 ＝ 0
    设 有效数 ＝ 0

    设 字段列表 ＝ 列表（
        "手机_已验证",
        "邮箱_已验证",
        "身份证_已验证",
        "地址_已验证"
    ）

    遍历 字段名 在 字段列表 ｛
        设 状态 ＝ 取键（记录， 字段名）
        若 （状态 ＝＝ 可能） ｛
            输出（连接（"    [跳过] ", 字段名, " = 可能（未验证，不影响评分）"））
        ｝ 再若 （状态 ＝＝ 真） ｛
            输出（连接（"    [通过] ", 字段名, " = 真"））
            总分 ＝ 总分 ＋ 1
            有效数 ＝ 有效数 ＋ 1
        ｝ 否则 ｛
            输出（连接（"    [未通过] ", 字段名, " = 假"））
            有效数 ＝ 有效数 ＋ 1
        ｝
    ｝

    若 （有效数 ＝＝ 0） ｛
        输出（"  全部字段未验证，无法评分"）
        返回（可能）  // 全部未验证，无法判断
    ｝
    输出（连接（"  有效字段: ", 有效数, "/4, 总分: ", 总分））
    返回（总分 ／ 有效数）
｝

// ── Python None 风格对比 ──
定义 None风格评分 （记录） ｛
    设 总分 ＝ 0
    设 有效数 ＝ 0

    设 字段列表 ＝ 列表（
        "手机_已验证",
        "邮箱_已验证",
        "身份证_已验证",
        "地址_已验证"
    ）

    遍历 字段名 在 字段列表 ｛
        设 状态 ＝ 取键（记录， 字段名）
        若 （状态 ＝＝ 可能） ｛
            // None 版无法表达"不确定"：跳过此字段，不计数
            输出（连接（"    [跳过] ", 字段名, " = None（跳过）"））
        ｝ 再若 （状态 ＝＝ 真） ｛
            总分 ＝ 总分 ＋ 1
            有效数 ＝ 有效数 ＋ 1
        ｝ 否则 ｛
            有效数 ＝ 有效数 ＋ 1
        ｝
    ｝

    若 （有效数 ＝＝ 0） ｛ 返回（0） ｝  // 返回 0，看起来像"评分差"
    返回（总分 ／ 有效数）
｝

// ── 运行对比 ──
输出（"")
输出（"--- 测试 3 条记录 ---"）
设 批次 ＝ 列表（）
设 i ＝ 0
循环 （i ＜ 3） ｛
    设 i ＝ i ＋ 1
    设 记录 ＝ 生成记录（）
    输出（连接（"", i, ". 记录: ", 取键（记录， "姓名"）））

    输出（"  [三言评分]"）
    设 三言分 ＝ 三言评分（记录）
    输出（连接（"  → 三言结果: ", 三言分））
    若 （三言分 ＝＝ 可能） ｛
        输出（"    ↑ 不猜，明确告诉下游数据不够"）
    ｝

    输出（"")
    输出（"  [Python None 风格评分]"）
    设 None分 ＝ None风格评分（记录）
    输出（连接（"  → None风格结果: ", None分））
    若 （三言分 ＝＝ 可能 且 None分 ！＝ 可能） ｛
        输出（"    ↑ None 版输出了数值 — 但数据根本不够！"）
    ｝

    输出（"")
｝

// ── 极端 case：全部字段未验证 ──
输出（"--- 极端 case：全部字段未验证 ---"）
设 全空记录 ＝ 字典（
    "姓名", "用户_未知",
    "手机_已验证", 可能，
    "邮箱_已验证", 可能，
    "身份证_已验证", 可能，
    "地址_已验证", 可能
）

输出（"  记录: 用户_未知"）
输出（"  [三言评分]"）
设 三言极 ＝ 三言评分（全空记录）
输出（连接（"  → 三言结果: ", 三言极））
若 （三言极 ＝＝ 可能） ｛
    输出（"    ↑ 不猜，不输出数值 — 正确的行为"）
｝

输出（"")
输出（"  [Python None 风格评分]"）
设 None极 ＝ None风格评分（全空记录）
输出（连接（"  → None风格结果: ", None极））
若 （三言极 ＝＝ 可能 且 None极 ！＝ 可能） ｛
    输出（"    ↑ None 版返回了 0 — 看起来像「评分差」，但其实是数据不够！"）
    输出（"    ↑ 下游可能误判为「用户信用差」，实际只是字段未验证"）
｝

输出（"")
输出（"=== 对比结论（诚实版）==="）
输出（"三言：可能 是一等值，默认就明确告知「数据不够」，组合时自动传播"）
输出（"Python：能写对（返回 None，见 data_cleaning.py 的 score_safe）"）
输出（"  但不被强制——返回 0 的 score_careless 那种坑太好踩，下游误判为「评分差」"）
输出（"")
输出（"Kleene 逻辑保证："）
输出（"  可能 且 可能 = 可能 — 不确定叠加不确定仍是不确定，无需手写 None 检查"）
输出（"")
输出（"诚实结论：差距偏小，优势在「默认安全 + 自动传播」，不是「Python 做不到」"）
