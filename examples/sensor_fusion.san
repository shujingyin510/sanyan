// examples/sensor_fusion.san — 三值逻辑传感器融合
// 场景：工业环境监测系统，融合温度/湿度/气体传感器
// 传感器可能返回正常值、异常值或离线（不确定）
// 三值逻辑天然处理"传感器离线"状态，无需额外标志位/枚举

// ==================== 传感器模拟 ====================

// 模拟传感器状态：返回 真(正常)/假(异常)/可能(离线)
定义 模拟传感器(名称, 故障率) {
    设 r = 随机数(1, 100)
    若 (r <= 故障率) {
        返回(假)   // 传感器故障
    }
    若 (r <= 加(故障率, 10)) {
        返回(可能) // 传感器离线/读数不确定
    }
    返回(真)       // 传感器正常
}

// 模拟温度传感器读数（摄氏度）
定义 读取温度() {
    设 状态 = 模拟传感器("温度", 15)
    若 (状态 等于 真) { 返回(列表(真, 随机数(18, 35))) }
    若 (状态 等于 可能) { 返回(列表(可能, 0)) }
    返回(列表(假, -999))
}

// 模拟湿度传感器读数（百分比）
定义 读取湿度() {
    设 状态 = 模拟传感器("湿度", 10)
    若 (状态 等于 真) { 返回(列表(真, 随机数(30, 80))) }
    若 (状态 等于 可能) { 返回(列表(可能, 0)) }
    返回(列表(假, -999))
}

// 模拟气体传感器读数（ppm）
定义 读取气体() {
    设 状态 = 模拟传感器("气体", 20)
    若 (状态 等于 真) { 返回(列表(真, 随机数(0, 500))) }
    若 (状态 等于 可能) { 返回(列表(可能, 0)) }
    返回(列表(假, -999))
}

// ==================== 三值融合逻辑 ====================

// 传感器融合：用三值逻辑判断整体环境状态
// 核心思想：任一传感器异常→整体异常；任一不确定→整体不确定
定义 融合环境状态(温度状态, 湿度状态, 气体状态) {
    // 用 且/或/非 运算符进行三值逻辑融合
    设 整体正常 = (温度状态 且 湿度状态) 且 气体状态

    // 任一传感器故障→整体故障
    若 (整体正常 等于 假) { 返回(假) }

    // 所有传感器正常→整体正常
    若 (整体正常 等于 真) { 返回(真) }

    // 否则→不确定（至少一个传感器离线）
    返回(可能)
}

// 安全阈值检查：温度在安全范围内
定义 温度安全(温度) {
    若 (温度 等于 -999) { 返回(可能) }  // 读数无效
    若 (温度 大于 40) { 返回(假) }       // 过热
    若 (温度 小于 10) { 返回(假) }       // 过冷
    返回(真)                              // 正常
}

// 安全阈值检查：湿度在安全范围内
定义 湿度安全(湿度) {
    若 (湿度 等于 -999) { 返回(可能) }
    若 (湿度 大于 90) { 返回(假) }
    若 (湿度 小于 20) { 返回(假) }
    返回(真)
}

// 安全阈值检查：气体浓度在安全范围内
定义 气体安全(气体) {
    若 (气体 等于 -999) { 返回(可能) }
    若 (气体 大于 400) { 返回(假) }      // 危险浓度
    若 (气体 大于 200) { 返回(可能) }    // 警告浓度
    返回(真)
}

// ==================== 决策逻辑 ====================

// 根据融合状态做出决策
定义 环境决策(整体状态, 温度, 湿度, 气体) {
    判 (整体状态) {
        假: {
            输出("🚨 警报：传感器故障或环境危险！")
            输出("  温度: ")
            输出(温度)
            输出("  湿度: ")
            输出(湿度)
            输出("  气体: ")
            输出(气体)
            返回("紧急停机")
        }
        可能: {
            输出("⚠️ 警告：部分传感器离线，降级运行")
            // 即使部分传感器离线，仍可用已知数据做保守决策
            若 (是数字(温度) 且 大于(温度, 35)) {
                返回("降级-开启风扇")
            }
            返回("降级-维持现状")
        }
        真: {
            输出("✅ 环境正常，全速运行")
            若 (大于(温度, 30)) { 返回("开启空调") }
            若 (小于(湿度, 40)) { 返回("开启加湿器") }
            返回("维持现状")
        }
    }
}

// ==================== 主程序 ====================

输出("═══════════════════════════════════════")
输出("  三值逻辑传感器融合系统 v1.0")
输出("═══════════════════════════════════════")
输出("")

设 统计正常 = 0
设 统计不确定 = 0
设 统计异常 = 0

遍历 轮次 从 1 到 10 {
    输出("--- 第 ")
    输出(轮次)
    输出(" 轮检测 ---")

    // 读取传感器
    设 温度读数 = 读取温度()
    设 湿度读数 = 读取湿度()
    设 气体读数 = 读取气体()

    设 温度状态 = 取(温度读数, 0)
    设 温度值 = 取(温度读数, 1)
    设 湿度状态 = 取(湿度读数, 0)
    设 湿度值 = 取(湿度读数, 1)
    设 气体状态 = 取(气体读数, 0)
    设 气体值 = 取(气体读数, 1)

    // 安全检查
    设 温度安 = 温度安全(温度值)
    设 湿度安 = 湿度安全(湿度值)
    设 气体安 = 气体安全(气体值)

    // 融合传感器状态和安全状态
    设 传感器融合 = 融合环境状态(温度状态, 湿度状态, 气体状态)
    设 安全融合 = 融合环境状态(温度安, 湿度安, 气体安)

    // 最终状态：传感器状态 且 安全状态
    设 最终状态 = (传感器融合 且 安全融合)

    输出("  传感器: 温度=")
    输出(温度状态)
    输出(" 湿度=")
    输出(湿度状态)
    输出(" 气体=")
    输出(气体状态)
    输出(" → 融合=")
    输出(传感器融合)
    输出("")

    输出("  安全性: 温度=")
    输出(温度安)
    输出(" 湿度=")
    输出(湿度安)
    输出(" 气体=")
    输出(气体安)
    输出(" → 融合=")
    输出(安全融合)
    输出("")

    // 决策
    设 决策 = 环境决策(最终状态, 温度值, 湿度值, 气体值)
    输出("  决策: ")
    输出(决策)
    输出("")
    输出("")

    // 统计
    判 (最终状态) {
        真: { 统计正常 = 加(统计正常, 1) }
        可能: { 统计不确定 = 加(统计不确定, 1) }
        假: { 统计异常 = 加(统计异常, 1) }
    }
}

输出("═══════════════════════════════════════")
输出("  统计汇总")
输出("═══════════════════════════════════════")
输出("  正常: ")
输出(统计正常)
输出(" 轮")
输出("  不确定: ")
输出(统计不确定)
输出(" 轮")
输出("  异常: ")
输出(统计异常)
输出(" 轮")
输出("")
输出("三值逻辑优势：无需 None/null/NaN 标志位，")
输出("用 且/或/非 运算符自然传播不确定性。")
