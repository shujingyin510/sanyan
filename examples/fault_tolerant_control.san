// examples/fault_tolerant_control.san — 三值逻辑容错控制
// 场景：工业水泵控制系统，含压力/流量/温度传感器
// 传感器可能正常、故障或离线，系统需在传感器失效时安全降级
// 三值逻辑用"可能"天然表达"不知道"，避免误判

// ==================== 设备模拟 ====================

定义 模拟水泵() {
    返回(字典("状态", "运行", "转速", 随机数(1000, 3000)))
}

定义 读取压力() {
    设 r = 随机数(1, 100)
    若 (r <= 10) { 返回(假) }       // 传感器故障
    若 (r <= 20) { 返回(可能) }     // 传感器离线
    返回(随机数(1, 10))             // 正常压力值 (bar)
}

定义 读取流量() {
    设 r = 随机数(1, 100)
    若 (r <= 8) { 返回(假) }
    若 (r <= 18) { 返回(可能) }
    返回(随机数(10, 100))           // 正常流量值 (L/min)
}

定义 读取泵温() {
    设 r = 随机数(1, 100)
    若 (r <= 12) { 返回(假) }
    若 (r <= 22) { 返回(可能) }
    返回(随机数(20, 80))            // 正常泵温 (°C)
}

// ==================== 三值安全判断 ====================

// 压力安全检查（三值输出）
定义 压力安全(压力) {
    若 (等于(压力, 假)) { 返回(可能) }      // 传感器故障→不确定
    若 (等于(压力, 可能)) { 返回(可能) }    // 传感器离线→不确定
    若 (大于(压力, 8)) { 返回(假) }         // 超压→危险
    若 (小于(压力, 2)) { 返回(假) }         // 欠压→危险
    返回(真)                                // 正常
}

// 流量安全检查
定义 流量安全(流量) {
    若 (等于(流量, 假)) { 返回(可能) }
    若 (等于(流量, 可能)) { 返回(可能) }
    若 (大于(流量, 90)) { 返回(假) }        // 流量过大
    若 (小于(流量, 15)) { 返回(假) }        // 流量过小（可能堵塞）
    返回(真)
}

// 泵温安全检查
定义 泵温安全(温度) {
    若 (等于(温度, 假)) { 返回(可能) }
    若 (等于(温度, 可能)) { 返回(可能) }
    若 (大于(温度, 70)) { 返回(假) }        // 过热
    若 (大于(温度, 60)) { 返回(可能) }      // 高温警告
    返回(真)
}

// ==================== 三值容错决策 ====================

// 核心决策：用三值逻辑做容错判断
// 关键优势：当传感器离线时，系统知道"不知道"，而非错误地假设安全或危险
定义 容错决策(压力状态, 流量状态, 泵温状态) {
    // 任一传感器确认危险→紧急停机
    若 (等于(压力状态, 假) 或 等于(流量状态, 假) 或 等于(泵温状态, 假)) {
        返回(字典("动作", "紧急停机", "原因", "传感器确认危险"))
    }

    // 所有传感器确认安全→正常运行
    设 全安全 = (压力状态 且 流量状态) 且 泵温状态
    若 (等于(全安全, 真)) {
        返回(字典("动作", "正常运行", "原因", "所有传感器确认安全"))
    }

    // 不确定状态：至少一个传感器离线
    // 三值逻辑的关键：系统明确知道"不知道"，而非猜测
    // 策略：降级运行，降低泵速，增加检查频率
    返回(字典("动作", "降级运行", "原因", "部分传感器离线，保守运行"))
}

// ==================== 主循环 ====================

输出("═══════════════════════════════════════════")
输出("  三值逻辑容错水泵控制系统 v1.0")
输出("═══════════════════════════════════════════")
输出("")

设 统计正常 = 0
设 统计降级 = 0
设 统计停机 = 0

遍历 周期 从 1 到 12 {
    输出("--- 控制周期 #")
    输出(周期)
    输出(" ---")

    // 读取传感器
    设 压力 = 读取压力()
    设 流量 = 读取流量()
    设 泵温 = 读取泵温()

    // 安全判断
    设 压力状态 = 压力安全(压力)
    设 流量状态 = 流量安全(流量)
    设 泵温状态 = 泵温安全(泵温)

    输出("  传感器读数: 压力=")
    输出(压力)
    输出(" 流量=")
    输出(流量)
    输出(" 泵温=")
    输出(泵温)
    输出("")

    输出("  安全状态:   压力=")
    输出(压力状态)
    输出(" 流量=")
    输出(流量状态)
    输出(" 泵温=")
    输出(泵温状态)
    输出("")

    // 容错决策
    设 决策 = 容错决策(压力状态, 流量状态, 泵温状态)
    设 动作 = 取键(决策, "动作")
    设 原因 = 取键(决策, "原因")

    输出("  决策: ")
    输出(动作)
    输出(" (")
    输出(原因)
    输出(")")
    输出("")
    输出("")

    // 统计
    若 (等于(动作, "正常运行")) { 统计正常 = 加(统计正常, 1) }
    若 (等于(动作, "降级运行")) { 统计降级 = 加(统计降级, 1) }
    若 (等于(动作, "紧急停机")) { 统计停机 = 加(统计停机, 1) }
}

输出("═══════════════════════════════════════════")
输出("  运行统计")
输出("═══════════════════════════════════════════")
输出("  正常运行: ")
输出(统计正常)
输出(" 个周期")
输出("  降级运行: ")
输出(统计降级)
输出(" 个周期")
输出("  紧急停机: ")
输出(统计停机)
输出(" 个周期")
输出("")
输出("三值逻辑优势：")
输出("  - 传感器离线≠传感器故障（可能≠假）")
输出("  - 系统明确知道'不知道'，而非错误假设")
输出("  - 降级运行策略自然从'可能'状态推导")
