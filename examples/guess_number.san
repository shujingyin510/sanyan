// 猜数字游戏 — 三言版
// 演示随机数、循环、条件判断、输入输出

输出("=== 猜数字游戏 ===")
输出("我想了一个 1-100 之间的数字，你来猜！")

设 目标 = 随机数(1, 100)
设 尝试次数 = 0
设 猜中 = 假

循环 (猜中 等于 假) {
    设 猜测 = 随机数(1, 100)
    尝试次数 = 尝试次数 + 1

    输出(连接("第 ", 尝试次数, " 次猜测: ", 猜测))

    若 (猜测 等于 目标) {
        输出(连接("猜中了！就是 ", 目标, "！用了 ", 尝试次数, " 次"))
        猜中 = 真
    } 再若 (猜测 大于 目标) {
        输出("猜大了")
    } 否则 {
        输出("猜小了")
    }
}

输出(连接("游戏结束，共尝试 ", 尝试次数, " 次"))
