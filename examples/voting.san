// 三态投票统计（赞成/弃权/反对）
输出("=== 三态投票统计 ===")

定义 统计 (投票列表) {
    设 赞成 = 0
    设 弃权 = 0
    设 反对 = 0
    遍历 i 从 0 到 (表长(投票列表) - 1) {
        设 票 = 投票列表(i)
        若 (票 == 真) {
            赞成 = 赞成 + 1
        } 再若 (票 == 可能) {
            弃权 = 弃权 + 1
        } 否则 {
            反对 = 反对 + 1
        }
    }
    输出(连接("赞成: ", 赞成, " 弃权: ", 弃权, " 反对: ", 反对))
    若 (赞成 > 反对) {
        返回(真)
    } 再若 (反对 > 赞成) {
        返回(假)
    } 否则 {
        返回(可能)
    }
}

设 投票 = 列表(真, 可能, 假, 真, 真, 可能, 假, 真)
设 结果 = 统计(投票)
输出(连接("投票结果: ", 结果))