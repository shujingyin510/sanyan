// examples/iot_state_machine.san — 三值逻辑IoT设备状态机
// 场景：智能门锁设备生命周期管理
// 设备状态可处于 确定状态 或 不确定状态（如网络断开时的"可能在线"）
// 三值逻辑天然表达"状态不确定"，无需额外的 Maybe/Optional 类型

// ==================== 设备状态定义 ====================

// 设备状态用三值表示：
//   真 = 确认在线/正常
//   假 = 确认离线/故障
//   可能 = 状态不确定（网络抖动、电池低但未关机等）

定义 检查网络() {
    设 r = 随机数(1, 100)
    若 (r <= 70) { 返回(真) }     // 网络正常
    若 (r <= 85) { 返回(可能) }   // 网络抖动
    返回(假)                       // 网络断开
}

定义 检查电池() {
    设 r = 随机数(1, 100)
    若 (r <= 60) { 返回(真) }     // 电量充足
    若 (r <= 80) { 返回(可能) }   // 电量低
    返回(假)                       // 电量耗尽
}

定义 检查锁芯() {
    设 r = 随机数(1, 100)
    若 (r <= 85) { 返回(真) }     // 锁芯正常
    若 (r <= 95) { 返回(可能) }   // 锁芯卡涩
    返回(假)                       // 锁芯故障
}

定义 检查指纹模块() {
    设 r = 随机数(1, 100)
    若 (r <= 75) { 返回(真) }     // 指纹模块正常
    若 (r <= 90) { 返回(可能) }   // 指纹模块响应慢
    返回(假)                       // 指纹模块故障
}

// ==================== 三值状态机 ====================

// 设备整体状态：用三值逻辑融合各子系统状态
定义 设备状态(网络, 电池, 锁芯, 指纹) {
    // 核心功能：锁芯必须正常
    若 (等于(锁芯, 假)) { 返回(假) }

    // 辅助功能：网络和指纹模块
    设 辅助正常 = (网络 且 指纹)

    // 电源：电池必须可用
    若 (等于(电池, 假)) { 返回(假) }

    // 综合判断
    设 整体 = (锁芯 且 电池) 且 辅助正常
    返回(整体)
}

// ==================== 状态驱动的动作 ====================

// 根据设备状态决定操作模式
定义 设备动作(状态, 网络, 电池) {
    判 (状态) {
        假: {
            输出("  🔴 设备故障，进入安全锁定模式")
            返回("安全锁定")
        }
        可能: {
            输出("  🟡 设备状态不确定，进入降级模式")
            // 不确定时的保守策略
            若 (等于(电池, 可能)) {
                输出("    → 电池状态不明，降低功耗")
                返回("低功耗模式")
            }
            若 (等于(网络, 可能)) {
                输出("    → 网络状态不明，缓存本地日志")
                返回("离线模式")
            }
            返回("降级运行")
        }
        真: {
            输出("  🟢 设备正常，全功能运行")
            返回("全功能")
        }
    }
}

// ==================== 状态转换逻辑 ====================

// 状态转换：用三值逻辑判断是否应该转换
定义 应该重启(当前状态, 电池, 网络) {
    // 只有在确认故障且电池充足时才重启
    若 (等于(当前状态, 假) 且 等于(电池, 真)) {
        返回(真)
    }
    // 状态不确定且网络可能恢复时，等待
    若 (等于(当前状态, 可能) 且 等于(网络, 可能)) {
        返回(可能)  // "也许应该重启"
    }
    返回(假)
}

// ==================== 主程序 ====================

输出("═══════════════════════════════════════════")
输出("  三值逻辑IoT设备状态机 v1.0")
输出("  场景：智能门锁生命周期管理")
输出("═══════════════════════════════════════════")
输出("")

设 统计全功能 = 0
设 统计降级 = 0
设 统计锁定 = 0
设 统计重启 = 0

遍历 时刻 从 1 到 15 {
    输出("═══ 时刻 #")
    输出(时刻)
    输出(" ═══")

    // 检查各子系统
    设 网络 = 检查网络()
    设 电池 = 检查电池()
    设 锁芯 = 检查锁芯()
    设 指纹 = 检查指纹模块()

    输出("  子系统: 网络=")
    输出(网络)
    输出(" 电池=")
    输出(电池)
    输出(" 锁芯=")
    输出(锁芯)
    输出(" 指纹=")
    输出(指纹)
    输出("")

    // 计算设备状态
    设 状态 = 设备状态(网络, 电池, 锁芯, 指纹)
    输出("  设备状态: ")
    输出(状态)

    // 执行动作
    设 动作 = 设备动作(状态, 网络, 电池)

    // 状态转换判断
    设 重启决策 = 应该重启(状态, 电池, 网络)
    若 (等于(重启决策, 真)) {
        输出("  ⟳ 执行设备重启...")
        统计重启 = 加(统计重启, 1)
    }
    若 (等于(重启决策, 可能)) {
        输出("  ⟳ 等待中（可能需要重启）...")
    }

    输出("")

    // 统计
    若 (等于(动作, "全功能")) { 统计全功能 = 加(统计全功能, 1) }
    若 (等于(动作, "低功耗模式") 或 等于(动作, "离线模式") 或 等于(动作, "降级运行")) {
        统计降级 = 加(统计降级, 1)
    }
    若 (等于(动作, "安全锁定")) { 统计锁定 = 加(统计锁定, 1) }
}

输出("═══════════════════════════════════════════")
输出("  设备运行统计")
输出("═══════════════════════════════════════════")
输出("  全功能运行: ")
输出(统计全功能)
输出(" 个时刻")
输出("  降级运行:   ")
输出(统计降级)
输出(" 个时刻")
输出("  安全锁定:   ")
输出(统计锁定)
输出(" 个时刻")
输出("  执行重启:   ")
输出(统计重启)
输出(" 次")
输出("")
输出("三值逻辑在状态机中的优势：")
输出("  - '可能'状态 = 等待观察，而非立即决策")
输出("  - 状态转换条件天然支持不确定性传播")
输出("  - 无需 Maybe/Optional/Null 模式")
输出("  - 状态组合用 且/或/非 运算符，无需嵌套 if-else")
