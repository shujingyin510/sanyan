// 文本分析示例：统计文本中的词频和字符频率
// 演示字符串操作、字典、排序、遍历

设 test = 导入("stdlib/test.san")

定义 词频 (文本) {
    设 词列表 = 分割(文本, " ")
    设 频率 = 字典()
    遍历 词 在 词列表 {
        若 (含键(频率, 词)) {
            设 旧值 = 取键(频率, 词)
            置键(频率, 词, 旧值 + 1)
        } 否则 {
            置键(频率, 词, 1)
        }
    }
    返回(频率)
}

定义 最高频 (频率表) {
    设 最高词 = ""
    设 最高数 = 0
    设 键 = 取键(频率表)
    遍历 词 在 键 {
        设 数 = 取键(频率表, 词)
        若 (数 > 最高数) {
            最高词 = 词
            最高数 = 数
        }
    }
    返回(连接(最高词, ": ", 最高数))
}

定义 字符频率 (文本) {
    设 频率 = 字典()
    设 i = 0
    设 len = 取长(文本)
    循环 (i < len) {
        设 c = 子串(文本, i, 1)
        若 (c 不等于 " ") {
            若 (含键(频率, c)) {
                设 旧值 = 取键(频率, c)
                置键(频率, c, 旧值 + 1)
            } 否则 {
                置键(频率, c, 1)
            }
        }
        i = i + 1
    }
    返回(频率)
}

test.测试套件("文本分析")

test.测试("词频统计", 函数() {
    设 文本 = "三言 三言 编程 语言 三言"
    设 freq = 词频(文本)
    test.断言相等(取键(freq, "三言"), 3)
    test.断言相等(取键(freq, "编程"), 1)
    test.断言相等(取键(freq, "语言"), 1)
})

test.测试("最高频词", 函数() {
    设 文本 = "a b c a b a"
    设 freq = 词频(文本)
    设 top = 最高频(freq)
    test.断言真(取长(top) > 0)
})

test.测试("字符频率", 函数() {
    设 文本 = "hello"
    设 freq = 字符频率(文本)
    test.断言相等(取键(freq, "l"), 2)
    test.断言相等(取键(freq, "h"), 1)
    test.断言相等(取键(freq, "e"), 1)
    test.断言相等(取键(freq, "o"), 1)
})

test.测试报告()
