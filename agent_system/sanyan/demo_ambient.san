// 三言 Agent — 演示2：模糊查询多轮跟踪
// 模拟 PENDING->反问->冲突 流程

// ============================================================
// 决策核心（内联）
// ============================================================
定义 映射到三态 (cogState) {
    若 (字符串相等(cogState, "AFFIRM")) { 返回(1) }
    若 (字符串相等(cogState, "NEGATE")) { 返回(-1) }
    若 (字符串相等(cogState, "CONFLICTED")) {
        返回(字典("认知", 0, "执行", "就绪", "子策略", "conflict"))
    }
    若 (字符串相等(cogState, "PENDING")) {
        返回(字典("认知", 1, "执行", "等待", "子策略", "pending"))
    }
    若 (字符串相等(cogState, "UNCERT")) {
        返回(字典("认知", 0, "执行", "就绪", "子策略", "uncertain"))
    }
    返回(字典("认知", 0, "执行", "就绪", "子策略", "default"))
}

定义 传播 (上游, 当前) {
    若 (上游 == -1) { 返回(-1) }
    若 (上游 == 0 且 当前 == 1) { 返回(0) }
    返回(当前)
}

定义 取认知 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "认知")) }
    返回(mapped)
}

定义 取执行 (mapped) {
    若 (是字典(mapped)) { 返回(取键(mapped, "执行")) }
    返回("就绪")
}

// ============================================================
// 上下文管理器（内联）
// ============================================================
设 _状态 = 字典("冲突记录", 列表())

定义 记录冲突 (srcA, srcB, topic) {
    设 entry = 字典("a", srcA, "b", srcB, "topic", topic, "ts", 时间戳())
    设 旧 = 取键(_状态, "冲突记录")
    置键(_状态, "冲突记录", 列表合(旧, 列表(entry)))
}

定义 统计冲突 () {
    设 recs = 取键(_状态, "冲突记录")
    输出("=== 冲突统计 ===")
    设 n = 表长(recs)
    输出(连接("总数：", 转字符串(n)))
    设 k = 0
    设 clen = 表长(recs)
    循环 (k < clen) {
        设 r = 取(recs, k)
        输出(连接("  ", 取键(r, "topic")))
        设 k = k + 1
    }
}

// ============================================================
// 工具模拟
// ============================================================
定义 模拟天气 (city) {
    若 (字符串相等(city, "北京")) { 返回("北京：晴 25度C") }
    若 (字符串相等(city, "上海")) { 返回("上海：多云 28度C") }
    返回(连接(city, "：未知"))
}

// ============================================================
// 演示
// ============================================================
定义 演示模糊查询 () {
    输出("=== 演示：模糊查询多轮跟踪 ===")
    输出("用户：这几天会下雨吗")
    输出("")

    设 历史 = 列表()

    输出("--- 轮 1：PENDING -> 反问位置 ---")
    设 r1 = 字典(
        "cogState", "PENDING",
        "actState", "NEED_HUMAN",
        "answer", "请问您在哪里？我需要知道你的城市。",
        "tool", "",
        "params", ""
    )
    设 m1 = 映射到三态(取键(r1, "cogState"))
    输出(连接("  认知态: ", 取键(r1, "cogState")))
    输出(连接("  映射: 认知=", 转字符串(取认知(m1)), " 执行=", 取执行(m1)))
    输出(连接("  Agent: ", 取键(r1, "answer")))
    设 历史 = 列表合(历史, 列表(0))

    输出("")
    输出("--- 轮 2：拿位置 + 双源冲突 ---")
    设 r2 = 字典(
        "cogState", "CONFLICTED",
        "actState", "NEED_TOOL",
        "answer", "",
        "tool", "query_weather",
        "params", "北京"
    )
    设 m2 = 映射到三态(取键(r2, "cogState"))
    设 c2 = 取认知(m2)
    设 上一轮 = 取(历史, 表长(历史) - 1)
    设 传播后 = 传播(上一轮, c2)
    设 历史 = 列表合(历史, 列表(传播后))
    输出(连接("  认知态: ", 取键(r2, "cogState")))
    输出(连接("  传播: 上游=", 转字符串(上一轮), " 当前=", 转字符串(c2), " 结果=", 转字符串(传播后)))
    设 t = 模拟天气(取键(r2, "params"))
    输出(连接("  工具结果: ", t))
    记录冲突("中国天气网", "AccuWeather", "北京天气")

    输出("")
    输出("--- 轮 3：CONFLICTED 终局 ---")
    设 r3 = 字典(
        "cogState", "CONFLICTED",
        "actState", "READY",
        "answer", "天气预报存在不一致，建议带伞以防万一。",
        "tool", "",
        "params", ""
    )
    输出(连接("  认知态: ", 取键(r3, "cogState")))
    输出(连接("  Agent: ", 取键(r3, "answer")))

    输出("")
    统计冲突()
}

演示模糊查询()
