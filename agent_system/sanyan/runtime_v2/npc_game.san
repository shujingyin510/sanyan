// 三言 Agent Runtime v2 — NPC 对话游戏 双人版
// 老王 + 李婶，社交传播，联想链，可能态

// ============================================================
// 全局状态
// ============================================================
设 _G = 字典("好感50", 50, "好感51", 50, "天数", 0, "轮次", 0, "当前NPC", "老王")

// ============================================================
// 时间衰减
// ============================================================
设 衰减率 = 5
设 遗忘阈值 = 5

定义 推进时间 (天数) {
    设 秒数 = 天数 * 86400
    设 keys = 字典键列表(记忆表)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(记忆表, k)
        设 衰减量 = 秒数 * 衰减率 / 86400
        设 新强度 = 取键(节点, "强度") - 衰减量
        若 (新强度 < 0) { 设 新强度 = 0 }
        置键(节点, "强度", 新强度)
        若 (新强度 < 遗忘阈值) { 删除键(记忆表, k) }
        设 i = i + 1
    }
}

// ============================================================
// 记忆系统
// ============================================================
设 记忆表 = 字典()

定义 创建记忆 (id, 内容, 状态) {
    置键(记忆表, id, 字典(
        "id", id, "内容", 内容, "状态", 状态,
        "创建时间", 时间戳(), "最后访问", 时间戳(),
        "访问次数", 0, "强度", 80
    ))
}

定义 回忆 (id) {
    若 (不(含键(记忆表, id))) { 返回(字典("内容","","强度",0)) }
    设 节点 = 取键(记忆表, id)
    设 次数 = 取键(节点, "访问次数") + 1
    置键(节点, "访问次数", 次数)
    设 新强度 = 取键(节点, "强度") + 5
    若 (新强度 > 100) { 设 新强度 = 100 }
    置键(节点, "强度", 新强度)
    置键(节点, "最后访问", 时间戳())
    返回(节点)
}

定义 记忆总数 () {
    返回(表长(字典键列表(记忆表)))
}

// ============================================================
// 可视化工具
// ============================================================
定义 强度条 (强度) {
    设 bar = ""
    设 blocks = 强度 / 10
    设 i = 0
    循环 (i < 10) {
        若 (i < blocks) { 设 bar = 连接(bar, "█") }
        否则 { 设 bar = 连接(bar, "░") }
        设 i = i + 1
    }
    返回(连接(bar, " ", 转字符串(强度), "%"))
}

// ============================================================
// 每日事件：NPC 主动行为
// ============================================================
定义 每日事件 () {
    设 天数 = 取键(_G, "天数")
    设 轮次 = 取键(_G, "轮次")
    设 rnd = 轮次 % 5  // 伪随机

    若 (rnd == 0) {
        若 (取键(_G, "好感50") >= 60 且 含键(记忆表, "老王_苹果")) {
            输出("  老王在门口朝你招手：今天带了啥好东西？")
        } 否则 若 (取键(_G, "好感51") >= 60 且 含键(记忆表, "送酒事件")) {
            输出("  李婶在院子里喊：来坐会儿，上次的酒还剩半瓶呢！")
        } 否则 若 (取键(_G, "好感50") < 30 且 取键(_G, "好感51") < 30) {
            输出("  村里很安静，好像没人注意到你。")
        } 否则 {
            输出("  村里炊烟袅袅，又是平常的一天。")
        }
    } 否则 若 (rnd == 1) {
        若 (含键(记忆表, "借钱")) {
            输出("  老王远远看见你，欲言又止，似乎在等你还钱...")
        } 否则 {
            输出("  李婶在井边打水，看见你笑了笑。")
        }
    } 否则 若 (rnd == 2) {
        若 (含键(记忆表, "老王_苹果") 且 含键(记忆表, "送花次数")) {
            设 m = 回忆("老王_苹果")
            若 (取键(m, "强度") > 40) {
                输出("  老王在院子里摆弄你送的花，看见你来很高兴。")
            } 否则 {
                输出("  老王在院子里发呆，好像在想什么。")
            }
        } 否则 {
            输出("  一阵风吹过，村里的树叶沙沙作响。")
        }
    } 否则 若 (rnd == 3) {
        若 (取键(_G, "好感50") >= 80) {
            输出("  老王老远就喊你：来啦来啦！快来坐！")
        } 否则 若 (取键(_G, "好感51") >= 80) {
            输出("  李婶提着一篮子菜，说要分你一半。")
        } 否则 {
            输出("  太阳慢慢升起来，村子里亮堂堂的。")
        }
    } 否则 {
        设 传闻数 = 0
        设 keys = 字典键列表(记忆表)
        设 i = 0
        设 len = 表长(keys)
        循环 (i < len) {
            若 (字符串包含(取(keys, i), "传闻_")) { 设 传闻数 = 传闻数 + 1 }
            设 i = i + 1
        }
        若 (传闻数 >= 2) {
            输出("  村里几个人在树下聊天，看见你过来，笑着指了指老王和李婶家的方向。")
        } 否则 {
            输出("  清晨的露水还没干，是个好天气。")
        }
    }
}

// ============================================================
// 社交传播：两口子晚上唠嗑，第二天互相知道
// ============================================================
设 _G = 字典("好感50", 50, "好感51", 50, "天数", 0, "轮次", 0, "当前NPC", "老王", "待传播", 列表(), "疑惑模式", 0)

定义 记录传播 (npc, 事件内容, 状态) {
    设 队列 = 取键(_G, "待传播")
    置键(_G, "待传播", 列表合(队列, 列表(字典("内容", 事件内容, "状态", 状态))))
}

定义 执行传播 () {
    设 队列 = 取键(_G, "待传播")
    设 i = 0
    设 len = 表长(队列)
    循环 (i < len) {
        设 item = 取(队列, i)
        设 内容 = 取键(item, "内容")
        设 状态 = 取键(item, "状态")
        若 (不(含键(记忆表, 连接("传闻_", 内容)))) {
            创建记忆(连接("传闻_", 内容), 内容, 状态)
        }
        设 i = i + 1
    }
    置键(_G, "待传播", 列表())
}

定义 取好感 () {
    设 npc = 取键(_G, "当前NPC")
    若 (字符串相等(npc, "老王")) { 返回(取键(_G, "好感50")) }
    返回(取键(_G, "好感51"))
}

定义 设好感 (val) {
    若 (val > 100) { 设 val = 100 }
    若 (val < 0) { 设 val = 0 }
    设 npc = 取键(_G, "当前NPC")
    若 (字符串相等(npc, "老王")) { 置键(_G, "好感50", val) }
    否则 { 置键(_G, "好感51", val) }
}

定义 心情 () {
    设 fav = 取好感()
    若 (取键(_G, "疑惑模式") == 1) { 返回("疑惑") }
    若 (fav >= 80) { 返回("开心") }
    若 (fav >= 60) { 返回("友好") }
    若 (fav >= 40) { 返回("平淡") }
    若 (fav >= 20) { 返回("冷淡") }
    返回("疏远")
}

定义 设置疑惑 () {
    置键(_G, "疑惑模式", 1)
}

// ============================================================
// NPC 回复引擎
// ============================================================
定义 NPC回复 (玩家输入) {
    设 回复 = ""
    设 npc = 取键(_G, "当前NPC")
    设 是送礼 = 字符串包含(玩家输入, "送") 或 字符串包含(玩家输入, "给")

    // ── 切换NPC ──
    若 (字符串包含(玩家输入, "老王")) {
        置键(_G, "当前NPC", "老王")
        设 回复 = "你走到老王家门口。"
    }
    否则 若 (字符串包含(玩家输入, "李婶")) {
        置键(_G, "当前NPC", "李婶")
        设 回复 = "你走到李婶家门口。"
    }

    // ── 奇怪物品 → 疑惑（可能态显性提示）──
    否则 若 (字符串包含(玩家输入, "石头") 或 字符串包含(玩家输入, "树枝") 或 字符串包含(玩家输入, "怪物") 或 字符串包含(玩家输入, "木头")) {
        设 备选 = 列表(
            "这...这是什么东西？从哪弄来的？",
            "我没见过这玩意儿...你是认真的吗？",
            "嗯...看着怪怪的，你先放地上吧。",
            "你捡这个干嘛？村口多的是。",
            "这东西有什么特别的吗？我没看明白。",
            "等等...让我仔细看看，这不会是什么宝贝吧？"
        )
        设 轮次 = 取键(_G, "轮次")
        设 回复 = 取(备选, 轮次 % 6)
        设置疑惑()
        创建记忆(连接(npc, "_奇怪物品"), "玩家送了奇怪的东西", 0)
        记录传播(npc, 连接(连接("玩家给", npc), "送了个奇怪玩意儿"), 0)
    }

    // ── 送礼 ──
    否则 若 (是送礼) {
        设 fav = 取好感() + 8
        设好感(fav)

        若 (字符串包含(玩家输入, "苹果")) {
            设 memKey = 连接(npc, "_苹果")
            若 (含键(记忆表, memKey)) {
                设 m = 回忆(memKey)
                若 (取键(m, "强度") > 80) {
                    设 回复 = "又是苹果！你每次都带苹果来，太客气了！"
                } 否则 {
                    设 回复 = "苹果啊！我最喜欢了，谢谢！"
                }
            } 否则 {
                创建记忆(memKey, 连接(npc, "收到了苹果"), 1)
                设 回复 = "这苹果看起来真不错，谢谢！"
            }
            记录传播(npc, 连接(npc, "收到了苹果"), 1)
        }
        否则 若 (字符串包含(玩家输入, "花")) {
            创建记忆("送花次数", "玩家多次送花", 1)
                设 回复 = "哟，还带花来了！"
                若 (字符串相等(npc, "老王")) {
                    设 回复 = 连接(回复, "我老伴在世的时候也喜欢花...")
                }
                若 (含键(记忆表, "老王_苹果事件") 且 字符串相等(npc, "老王")) {
                    设 m = 回忆("老王_苹果事件")
                    若 (取键(m, "强度") > 50) {
                        设 回复 = 连接(回复, "说起来，上次的苹果也很甜。")
                    }
                }
            记录传播(npc, 连接(连接("给", npc), "送了花"), 1)
        }
        否则 若 (字符串包含(玩家输入, "酒")) {
            设 fav2 = 取好感() + 5
            设好感(fav2)
            若 (含键(记忆表, "送酒事件")) {
                设 回复 = "哈哈又带酒来了！上次喝多了说了不少胡话吧..."
            } 否则 {
                设 回复 = "哈哈，好东西！来来来，坐下喝两杯！"
                创建记忆("送酒事件", "玩家送酒", 1)
            }
            记录传播(npc, 连接(连接("给", npc), "送了酒"), 1)
        }
        否则 若 (字符串包含(玩家输入, "吃")) {
            设 回复 = "哎哟，这怎么好意思呢。来来来，一起吃！"
        }
        否则 {
            设 回复 = "谢谢！好久没人给我送东西了。"
        }
        创建记忆("送礼", 连接("玩家送了东西给", npc), 1)
    }

    // ── 苹果回忆 ──
    否则 若 (字符串包含(玩家输入, "苹果")) {
        设 memKey = 连接(npc, "_苹果")
        若 (含键(记忆表, memKey)) {
            设 m = 回忆(memKey)
            设 强度 = 取键(m, "强度")
            若 (强度 > 50) {
                设 回复 = "哈哈，我还记得你上次给的苹果，挺甜的！"
            } 否则 若 (强度 > 20) {
                设 回复 = "苹果？好像有点印象...是不是你给过我？"
            } 否则 {
                设 回复 = "苹果？没什么印象了。"
            }
        } 否则 {
            设 回复 = "苹果不错，挺好吃的。"
            创建记忆(memKey, "玩家提到苹果", 1)
        }
    }

    // ── 借钱 ──
    否则 若 (字符串包含(玩家输入, "借钱") 或 字符串包含(玩家输入, "借点")) {
        设 fav = 取好感()
        设 memKey = 连接(npc, "_苹果")
        若 (含键(记忆表, memKey)) {
            回忆(memKey)
            设 回复 = "看在上次苹果的份上...好吧，不过要记得还啊。"
            设 fav = fav - 3
        } 否则 若 (fav >= 55) {
            设 回复 = "行吧...咱俩也算认识，借多少？"
            设 fav = fav - 3
        } 否则 若 (fav >= 40) {
            设 回复 = "借钱啊...说实话，我们交情还没到那份上。要不你找别人问问？"
            设 fav = fav - 2
        } 否则 {
            设 回复 = "我们还不熟，谈钱不太合适吧。"
            设 fav = fav - 5
        }
        设好感(fav)
        创建记忆("借钱", 连接(连接("玩家向", npc), "借钱"), -1)
        记录传播(npc, 连接(连接("玩家向", npc), "借钱了"), -1)
    }

    // ── 还钱 ──
    否则 若 (字符串包含(玩家输入, "还钱") 或 字符串包含(玩家输入, "还你")) {
        设 fav = 取好感() + 10
        设好感(fav)
        若 (含键(记忆表, "借钱")) {
            删除键(记忆表, "借钱")
            设 回复 = "哎哟，还真还啊！我就随口一说...行，你这人不错！"
        } 否则 {
            设 回复 = "还钱？你没欠我钱啊...不过你这人挺实在的。"
        }
        记录传播(npc, 连接(连接("玩家还给", npc), "钱了"), 1)
    }

    // ── 帮助 ──
    否则 若 (字符串包含(玩家输入, "帮忙") 或 字符串包含(玩家输入, "帮助")) {
        设 fav = 取好感()
        若 (fav >= 60) {
            设 回复 = "没问题，你的事就是我的事！"
         } 否则 若 (fav >= 40) {
            设 回复 = "行吧，能帮就帮一把。"
         } 否则 {
            设 回复 = "这个...我最近有点忙，不好意思啊。"
         }
        设 fav = fav + 3
        设好感(fav)
        记录传播(npc, 连接(连接("玩家找", npc), "帮忙了"), 1)
    }

    // ── 关联链：NPC主动联想 ──
    否则 若 (字符串包含(玩家输入, "最近怎么样") 或 字符串包含(玩家输入, "还好吗")) {
        设 memKey = 连接(npc, "_苹果")
         若 (含键(记忆表, memKey) 且 含键(记忆表, "送花次数")) {
            回忆(memKey)
            设 回复 = "托你的福！又是苹果又是花的，日子过得挺滋润。"
         } 否则 若 (含键(记忆表, "送酒事件")) {
            设 m = 回忆("送酒事件")
            若 (取键(m, "强度") > 50) {
                设 回复 = "还行，上次喝了你的酒，这几天都精神！"
            } 否则 {
                设 回复 = "还行，就这么过呗。"
            }
         } 否则 若 (含键(记忆表, "借钱")) {
            设 回复 = "还行吧...你要是方便的话，上次那钱..."
         } 否则 若 (取好感() >= 60) {
            设 回复 = "挺好挺好，你常来看看我就更好了！"
         } 否则 {
            设 回复 = "老样子，一天天过呗。"
         }
    }

    // ── 打听另一个NPC（社交传播体现）──
    否则 若 (字符串包含(玩家输入, "听说") 或 字符串包含(玩家输入, "知道")) {
        设 传闻 = 列表()
        设 keys = 字典键列表(记忆表)
        设 i = 0
        设 len = 表长(keys)
        循环 (i < len) {
            设 k = 取(keys, i)
            若 (字符串包含(k, "传闻_")) {
                设 m = 取键(记忆表, k)
                设 传闻 = 列表合(传闻, 列表(取键(m, "内容")))
            }
            设 i = i + 1
        }
        若 (表长(传闻) > 0) {
            设 回复 = 连接("我听说了，", 取(传闻, 0), "。")
        } 否则 {
            设 回复 = "没听说什么新鲜事。"
        }
    }

    // ── 打招呼 ──
    否则 若 (字符串包含(玩家输入, "你好") 或 字符串包含(玩家输入, "嗨") 或 字符串包含(玩家输入, "在吗") 或 字符串包含(玩家输入, "早")) {
        设 传闻数 = 0
        设 keys = 字典键列表(记忆表)
        设 i = 0
        设 len = 表长(keys)
        循环 (i < len) {
            若 (字符串包含(取(keys, i), "传闻_")) { 设 传闻数 = 传闻数 + 1 }
            设 i = i + 1
        }
        若 (记忆总数() - 传闻数 == 0) {
            若 (取好感() >= 70) {
                设 回复 = "虽然记不太清之前的事...但看见你就觉得亲切！"
            } 否则 若 (取好感() >= 40) {
                设 回复 = "你好，我们是不是在哪见过？觉得你有点面熟。"
            } 否则 {
                设 回复 = "你好啊，我们好像是第一次见面？"
            }
        } 否则 若 (取好感() >= 60 且 记忆总数() >= 4) {
            设 回复 = "哟，老熟人了！今天又来找我聊天？"
        } 否则 若 (取好感() >= 40) {
            设 回复 = "早啊，吃过没？"
        } 否则 {
            设 回复 = "你好，有什么事吗？"
        }
    }

    // ── 再见 ──
    否则 若 (字符串包含(玩家输入, "再见") 或 字符串包含(玩家输入, "拜拜") 或 字符串包含(玩家输入, "走了")) {
        若 (取好感() >= 60) {
            设 回复 = "好嘞，有空常来！"
        } 否则 {
            设 回复 = "嗯，慢走。"
        }
    }

    // ── 你是谁 ──
    否则 若 (字符串包含(玩家输入, "你叫") 或 字符串包含(玩家输入, "你是谁")) {
        若 (字符串相等(npc, "老王")) {
            设 回复 = "我叫老王，在这住了一辈子了。那位是我老伴李婶。"
        } 否则 {
            设 回复 = "我是李婶，老王的老伴。你找他有事？"
        }
    }

    // ── 讲故事 ──
    否则 若 (字符串包含(玩家输入, "故事") 或 字符串包含(玩家输入, "以前")) {
        若 (取好感() >= 60) {
            若 (字符串相等(npc, "老王")) {
                设 回复 = "以前啊...这村里可热闹了。村头老李家还闹过鬼呢，你信不信？"
            } 否则 {
                设 回复 = "以前的事啊，三天三夜都说不完。你想听哪一段？"
            }
        } 否则 {
            设 回复 = "以前的事啊，说来话长，改天再聊吧。"
        }
    }

    // ── 通用 ──
    否则 {
        设 fav = 取好感()
        若 (fav >= 70) {
            设 备选 = 列表("哈哈跟我想一块去了", "说得好", "行行行听你的")
            设 轮次 = 取键(_G, "轮次")
            设 回复 = 取(备选, 轮次 % 3)
        } 否则 若 (fav >= 50) {
            设 备选 = 列表("嗯是这么回事", "想想也是", "行吧")
            设 轮次 = 取键(_G, "轮次")
            设 回复 = 取(备选, 轮次 % 3)
        } 否则 若 (fav >= 30) {
            设 回复 = "嗯。"
        } 否则 {
            设 回复 = 连接(npc, "别过头去，没接话。")
        }
    }

    返回(回复)
}

// ============================================================
// 三态动作可视化
// ============================================================
定义 取动作 (回复) {
    若 (取键(_G, "疑惑模式") == 1) { 返回("想了想，歪着头") }
    若 (字符串包含(回复, "...") 或 字符串包含(回复, "不确定")) { 返回("犹豫了一下，") }
    若 (字符串包含(回复, "不行") 或 字符串包含(回复, "不合适")) { 返回("摇了摇头，") }
    若 (字符串包含(回复, "谢谢") 或 字符串包含(回复, "太客气")) { 返回("笑着") }
    若 (字符串包含(回复, "好吧") 或 字符串包含(回复, "行吧")) { 返回("想了想，") }
    若 (字符串包含(回复, "好久没")) { 返回("叹了口气，") }
    设 fav = 取好感()
    若 (fav >= 80) { 返回("热情地") }
    若 (fav >= 50) { 返回("") }
    返回("冷淡地")
}

// ============================================================
// NPC 主动行为：基于记忆的自主行动
// ============================================================
定义 NPC主动 () {
    设 rnd = 取键(_G, "轮次") % 10
    设 npc = 取键(_G, "当前NPC")

    // 组合检测：苹果+花+酒 → 特殊对话
    若 (含键(记忆表, 连接(npc, "_苹果")) 且 含键(记忆表, "送花次数") 且 含键(记忆表, "送酒事件")) {
        若 (rnd == 0) {
            输出(连接("  * ", npc, "感慨道：又是苹果又是花还有酒，我这一辈子都没这么滋润过..."))
        }
    }

    若 (rnd == 1 且 取好感() >= 80 且 含键(记忆表, 连接(npc, "_苹果"))) {
        输出(连接("  * ", npc, "从屋里拿出一个苹果递给你：这是上次的回礼。"))
    }
    否则 若 (rnd == 2 且 含键(记忆表, "借钱") 且 取键(_G, "天数") > 2) {
        输出(连接("  * ", npc, "欲言又止，似乎在犹豫要不要提还钱的事。"))
    }
    否则 若 (rnd == 3 且 含键(记忆表, "送花次数") 且 含键(记忆表, 连接(npc, "_苹果"))) {
        设 m = 回忆(连接(npc, "_苹果"))
        若 (取键(m, "强度") > 50) {
            输出(连接("  * ", npc, "摆弄着花，自言自语：有些人啊，就是有心..."))
        }
    }
    否则 若 (rnd == 4 且 取键(_G, "天数") >= 5 且 取好感() < 30) {
        输出(连接("  * ", npc, "看见你过来，默默地走开了几步。"))
    }
    否则 若 (rnd == 5 且 含键(记忆表, 连接(npc, "_奇怪物品"))) {
        输出(连接("  * ", npc, "瞥了一眼地上的奇怪东西，还在犯嘀咕。"))
    }
    否则 若 (rnd == 6 且 取好感() >= 70) {
        设 招呼 = 列表(
            "来坐会儿，我正好没事。",
            "今天天气不错，出来转转？",
            "吃了没？我这有刚蒸的馒头。"
        )
        输出(连接("  * ", npc, "主动招呼你：", 取(招呼, 取键(_G, "天数") % 3)))
    }
    否则 若 (rnd == 7 且 含键(记忆表, 连接(npc, "_苹果")) 且 含键(记忆表, "送酒事件")) {
        输出(连接("  * ", npc, "哼着小曲，心情不错的样子。"))
    }
    否则 若 (rnd == 8 且 含键(记忆表, "送花次数") 且 取好感() >= 70) {
        设 感叹 = 列表(
            "看着花，轻轻叹了口气。",
            "把花挪到太阳底下，浇了点水。",
            "闻了闻花，脸上露出笑容。"
        )
        输出(连接("  * ", npc, 取(感叹, 取键(_G, "天数") % 3)))
    }
    否则 若 (rnd == 9 且 取键(_G, "天数") >= 20) {
        输出(连接("  * 时间过了很久，", npc, "似乎已经不记得太多事了。"))
    }
}
定义 游戏开始 () {
    输出("═══════════════════════════════════")
    输出("       老王 & 李婶")
    输出("   两口子，结婚四十年了")
    输出("   你送谁东西，另一个也会听说")
    输出("")
    输出("   输入 老王 或 李婶 切换说话对象")
    输出("   输入 睡觉 进入下一天")
    输出("   输入 状态 查看关系")
    输出("   输入 退出 结束游戏")
    输出("═══════════════════════════════════")
    输出("")
    输出("你来到村里，老王坐在门口晒太阳，")
    输出("他老伴李婶在院子里晾衣服。")
    输出("")

    循环 (1) {
        设 npc = 取键(_G, "当前NPC")
         若 (字符串相等(npc, "老王")) {
            设 输入文本 = 输入("老王: ")
         } 否则 {
            设 输入文本 = 输入("李婶: ")
         }
        若 (取长(输入文本) == 0) { 继续 }
        若 (字符串相等(输入文本, "退出")) { 跳出 }

        若 (字符串相等(输入文本, "睡觉")) {
            设 天数 = 取键(_G, "天数") + 1
            置键(_G, "天数", 天数)
            推进时间(1)
            // 好感随时间自然衰减
            设 f50 = 取键(_G, "好感50") - 1
            设 f51 = 取键(_G, "好感51") - 1
            若 (f50 < 0) { 设 f50 = 0 }
            若 (f51 < 0) { 设 f51 = 0 }
            置键(_G, "好感50", f50)
            置键(_G, "好感51", f51)
            输出("")
            输出(连接("════ 第 ", 转字符串(天数), " 天 ════"))
            执行传播()
            每日事件()
            继续
        }

        若 (字符串相等(输入文本, "状态")) {
            设 老王好感 = 取键(_G, "好感50")
            设 李婶好感 = 取键(_G, "好感51")
            输出(连接("┌─ 第 ", 转字符串(取键(_G, "天数")), " 天 ─────────────────────"))
            输出(连接("│ 当前: ", npc, "   老王好感: ", 强度条(老王好感), "  李婶好感: ", 强度条(李婶好感)))
            设 keys = 字典键列表(记忆表)
            设 ki = 0
            设 klen = 表长(keys)
            若 (klen > 0) {
                输出("├─ 记忆 ──────────────────────")
                循环 (ki < klen) {
                    设 k = 取(keys, ki)
                    设 m = 取键(记忆表, k)
                    设 类型 = ""
                    若 (取键(m, "状态") == 1) { 设 类型 = "⊕" }
                    否则 若 (取键(m, "状态") == -1) { 设 类型 = "⊖" }
                    否则 { 设 类型 = "○" }
                    输出(连接("│ ", 类型, " ", 取键(m, "内容"), " ", 强度条(取键(m, "强度"))))
                    设 ki = ki + 1
                }
            } 否则 {
                输出("│  (无记忆)")
            }
            输出("└──────────────────────────────")
            继续
        }

         设 轮次 = 取键(_G, "轮次") + 1
         置键(_G, "轮次", 轮次)
         设 回复 = NPC回复(输入文本)
         设 动作 = 取动作(回复)
         输出(连接(npc, 动作, "(", 心情(), "): ", 回复))
         置键(_G, "疑惑模式", 0)
         NPC主动()
    }

    输出("")
    输出(连接("游戏结束。共 ", 转字符串(取键(_G, "天数")), " 天。"))
    输出(连接("老王好感:", 转字符串(取键(_G, "好感50")), "  李婶好感:", 转字符串(取键(_G, "好感51"))))
}

游戏开始()
