// 三言 Agent Runtime v2 — 关联激活系统
// 概念节点 + 加权边 + 激活传播 + 联想输出

// === 关联图存储 ===
设 节点表 = 字典()   // "概念名" → 节点字典
设 边表 = 字典()     // "源->目标" → 权重整数(0-100)

// === 配置 ===
设 传播衰减 = 70      // 每跳衰减系数(%)
设 激活阈值 = 30      // 激活值>此值才算活跃
设 激活上限 = 100

// === 节点操作 ===
定义 添加节点 (概念名) {
    若 (不(含键(节点表, 概念名))) {
        置键(节点表, 概念名, 字典(
            "名称", 概念名,
            "激活值", 0
        ))
    }
}

// === 边操作 ===
定义 添加关联 (源, 目标, 权重) {
    // 确保节点存在
    添加节点(源)
    添加节点(目标)
    // 添加边
    设 边键 = 连接(源, "->", 目标)
    置键(边表, 边键, 权重)
}

// === 激活传播 ===
定义 激活传播 (起始概念) {
    // 先重置所有节点激活值
    设 nodeKeys = 字典键列表(节点表)
    设 i = 0
    设 nlen = 表长(nodeKeys)
    循环 (i < nlen) {
        设 n = 取键(节点表, 取(nodeKeys, i))
        置键(n, "激活值", 0)
        设 i = i + 1
    }
    // 起始节点满激活
    若 (含键(节点表, 起始概念)) {
        设 start = 取键(节点表, 起始概念)
        置键(start, "激活值", 激活上限)
    }
    // 传播3跳
    设 跳数 = 0
    循环 (跳数 < 3) {
        设 edgeKeys = 字典键列表(边表)
        设 j = 0
        设 elen = 表长(edgeKeys)
        循环 (j < elen) {
            设 边键 = 取(edgeKeys, j)
            设 权重 = 取键(边表, 边键)
            // 解析"源->目标"
            设 pos = 查找(边键, "->")
            若 (pos < 0) { 设 j = j + 1; 继续 }
            设 源 = 子串(边键, 0, pos)
            设 目标 = 子串(边键, pos + 2, 取长(边键) - pos - 2)
            // 取源节点激活值
            若 (含键(节点表, 源) 且 含键(节点表, 目标)) {
                设 源节点 = 取键(节点表, 源)
                设 目标节点 = 取键(节点表, 目标)
                设 源激活 = 取键(源节点, "激活值")
                若 (源激活 > 0) {
                    设 传播值 = 源激活 * 权重 * 传播衰减 / (激活上限 * 激活上限)
                    设 新值 = 取键(目标节点, "激活值") + 传播值
                    若 (新值 > 激活上限) { 设 新值 = 激活上限 }
                    置键(目标节点, "激活值", 新值)
                }
            }
            设 j = j + 1
        }
        设 跳数 = 跳数 + 1
    }
}

// === 联想输出 ===
定义 取活跃概念 () {
    设 结果 = 列表()
    设 keys = 字典键列表(节点表)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(节点表, k)
        若 (取键(节点, "激活值") >= 激活阈值) {
            设 结果 = 列表合(结果, 列表(字典(
                "概念", k,
                "激活值", 取键(节点, "激活值")
            )))
        }
        设 i = i + 1
    }
    // 按激活值降序排序
    设 j = 0
    设 rlen = 表长(结果)
    循环 (j < rlen) {
        设 k2 = j + 1
        循环 (k2 < rlen) {
            设 a = 取(结果, j)
            设 b = 取(结果, k2)
            若 (取键(a, "激活值") < 取键(b, "激活值")) {
                设 tmp = 取(结果, j)
                置元素(结果, j, b)
                置元素(结果, k2, tmp)
            }
            设 k2 = k2 + 1
        }
        设 j = j + 1
    }
    返回(结果)
}

// === 持久化 ===
定义 保存关联图 () {
    设 data = 字典("节点表", 节点表, "边表", 边表)
    写文件("ternary_agent/runtime_v2/association.json", 转JSON(data))
}

定义 加载关联图 () {
    尝试 {
        设 raw = 读文件("ternary_agent/runtime_v2/association.json")
        若 (取长(raw) > 0) {
            设 data = 解析JSON(raw)
            若 (是字典(data)) {
                若 (含键(data, "节点表")) { 设 节点表 = 取键(data, "节点表") }
                若 (含键(data, "边表")) { 设 边表 = 取键(data, "边表") }
            }
        }
    } 捕获 (e) { }
}

导出 添加节点 添加关联 激活传播 取活跃概念 保存关联图 加载关联图
