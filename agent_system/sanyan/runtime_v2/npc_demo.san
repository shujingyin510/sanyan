// 三言 Agent Runtime v2 — NPC 30天行为演示
// 全部功能内联，可直接运行

// ============================================================
// 时间记忆系统
// ============================================================
设 衰减率 = 5
设 遗忘阈值 = 5
设 访问增强值 = 5
设 强度上限 = 100

设 记忆表 = 字典()

定义 创建记忆 (id, 内容, 状态, 来源) {
    置键(记忆表, id, 字典(
        "id", id, "内容", 内容, "状态", 状态,
        "创建时间", 时间戳(), "最后访问", 时间戳(),
        "访问次数", 0, "强度", 80, "来源", 来源
    ))
}

定义 回忆 (id) {
    若 (不(含键(记忆表, id))) { 返回(字典("内容","无","强度",0)) }
    设 节点 = 取键(记忆表, id)
    设 已过秒 = 时间戳() - 取键(节点, "最后访问")
    设 衰减量 = 已过秒 * 衰减率 / 86400
    设 新强度 = 取键(节点, "强度") - 衰减量
    若 (新强度 < 0) { 设 新强度 = 0 }
    置键(节点, "强度", 新强度)
    设 次数 = 取键(节点, "访问次数") + 1
    置键(节点, "访问次数", 次数)
    设 新强度 = 取键(节点, "强度") + 访问增强值
    若 (新强度 > 强度上限) { 设 新强度 = 强度上限 }
    置键(节点, "强度", 新强度)
    置键(节点, "最后访问", 时间戳())
    返回(节点)
}

定义 推进时间 (天数) {
    设 秒数 = 天数 * 86400
    设 keys = 字典键列表(记忆表)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(记忆表, k)
        设 已过秒 = 秒数
        设 衰减量 = 已过秒 * 衰减率 / 86400
        设 新强度 = 取键(节点, "强度") - 衰减量
        若 (新强度 < 0) { 设 新强度 = 0 }
        置键(节点, "强度", 新强度)
        若 (新强度 < 遗忘阈值) { 删除键(记忆表, k) }
        设 i = i + 1
    }
}

// ============================================================
// 关联激活系统
// ============================================================
设 节点表 = 字典()
设 边表 = 字典()

定义 添加节点 (概念名) {
    若 (不(含键(节点表, 概念名))) {
        置键(节点表, 概念名, 字典("名称", 概念名, "激活值", 0))
    }
}

定义 添加关联 (源, 目标, 权重) {
    添加节点(源)
    添加节点(目标)
    设 边键 = 连接(源, "->", 目标)
    置键(边表, 边键, 权重)
}

定义 激活传播 (起始概念) {
    设 nodeKeys = 字典键列表(节点表)
    设 i = 0
    设 nlen = 表长(nodeKeys)
    循环 (i < nlen) {
        设 n = 取键(节点表, 取(nodeKeys, i))
        置键(n, "激活值", 0)
        设 i = i + 1
    }
    若 (含键(节点表, 起始概念)) {
        设 start = 取键(节点表, 起始概念)
        置键(start, "激活值", 100)
    }
    设 跳数 = 0
    循环 (跳数 < 3) {
        设 edgeKeys = 字典键列表(边表)
        设 j = 0
        设 elen = 表长(edgeKeys)
        循环 (j < elen) {
            设 边键 = 取(edgeKeys, j)
            设 权重 = 取键(边表, 边键)
            设 pos = 查找(边键, "->")
            若 (pos < 0) { 设 j = j + 1; 继续 }
            设 源 = 子串(边键, 0, pos)
            设 目标 = 子串(边键, pos + 2, 取长(边键) - pos - 2)
            若 (含键(节点表, 源) 且 含键(节点表, 目标)) {
                设 源节点 = 取键(节点表, 源)
                设 目标节点 = 取键(节点表, 目标)
                设 源激活 = 取键(源节点, "激活值")
                若 (源激活 > 0) {
                    设 传播值 = 源激活 * 权重 * 70 / 10000
                    设 新值 = 取键(目标节点, "激活值") + 传播值
                    若 (新值 > 100) { 设 新值 = 100 }
                    置键(目标节点, "激活值", 新值)
                }
            }
            设 j = j + 1
        }
        设 跳数 = 跳数 + 1
    }
}

定义 取活跃概念 () {
    设 结果 = 列表()
    设 keys = 字典键列表(节点表)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(节点表, k)
        若 (取键(节点, "激活值") >= 30) {
            设 结果 = 列表合(结果, 列表(字典("概念",k,"激活值",取键(节点,"激活值"))))
        }
        设 i = i + 1
    }
    返回(结果)
}

// ============================================================
// NPC 系统
// ============================================================
设 NPC好感 = 50

定义 初始化NPC () {
    // 初始化关联图
    添加关联("苹果", "水果", 80)
    添加关联("水果", "健康", 50)
    添加关联("苹果", "红色", 60)
    添加关联("健康", "运动", 40)
    添加关联("借钱", "信任", 30)
    添加关联("借钱", "担忧", 50)

    输出("=== NPC 老王 初始化 ===")
    输出(连接("好感度: ", 转字符串(NPC好感)))
    输出("关联图: 苹果→水果→健康→运动")
    输出("")
}

定义 显示记忆状态 () {
    设 keys = 字典键列表(记忆表)
    设 i = 0
    设 len = 表长(keys)
    输出("--- 当前记忆 ---")
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(记忆表, k)
        输出(连接(
            取键(节点, "内容"), " 强度:",
            转字符串(取键(节点, "强度")),
            " 访问:", 转字符串(取键(节点, "访问次数"))
        ))
        设 i = i + 1
    }
    输出(连接("好感度: ", 转字符串(NPC好感)))
}

定义 联想检查 (概念) {
    激活传播(概念)
    设 活跃 = 取活跃概念()
    若 (表长(活跃) > 0) {
        设 out = 连接("  联想「", 概念, "」→ ")
        设 i = 0
        设 len = 表长(活跃)
        循环 (i < len) {
            设 c = 取(活跃, i)
            若 (不(字符串相等(取键(c, "概念"), 概念))) {
                设 out = 连接(out, 取键(c, "概念"), "(", 转字符串(取键(c, "激活值")), ") ")
            }
            设 i = i + 1
        }
        输出(out)
    }
}

// ============================================================
// 30天模拟
// ============================================================
定义 演示 () {
    初始化NPC()

    输出("══════ Day 1: 玩家送苹果 ══════")
    创建记忆("ev1", "玩家送了苹果", 1, "玩家")
    设 NPC好感 = NPC好感 + 10
    回忆("ev1")
    显示记忆状态()
    联想检查("苹果")
    输出("")

    输出("══════ Day 3: 玩家借钱 ══════")
    推进时间(2)
    回忆("ev1")  // 回忆苹果
    创建记忆("ev2", "玩家想借钱", -1, "玩家")
    设 NPC好感 = NPC好感 - 5
    显示记忆状态()
    联想检查("借钱")
    输出("")

    输出("══════ Day 7: 玩家送水果 ══════")
    推进时间(4)
    回忆("ev1")  // 激活苹果记忆
    创建记忆("ev3", "玩家送了水果", 1, "玩家")
    设 NPC好感 = NPC好感 + 5
    显示记忆状态()
    联想检查("苹果")
    输出("")

    输出("══════ Day 15: 无互动 ══════")
    推进时间(8)
    显示记忆状态()
    联想检查("苹果")
    输出("")

    输出("══════ Day 30: 长期无互动 ══════")
    推进时间(15)
    显示记忆状态()
    联想检查("苹果")
    输出("")

    输出("=== 演示完成 ===")
    输出(连接("最终好感度: ", 转字符串(NPC好感)))
}

演示()
