// 三言 Agent Runtime v2 — 时间记忆系统
// 带强度衰减、访问增强、遗忘清理的持久化记忆
// 所有浮点数 x100 用整数表示（范围 0-100）

// === 配置 ===
设 衰减率 = 5         // 每天衰减5分（每86400秒）
设 遗忘阈值 = 5       // 强度低于此值自动遗忘
设 访问增强值 = 5     // 每次访问强度+5
设 强度上限 = 100     // 强度最大值
设 记忆文件 = "ternary_agent/runtime_v2/memory_v2.json"

// === 记忆表 ===
设 记忆表 = 字典()

// === 核心操作 ===

// 创建记忆节点
定义 创建记忆 (id, 内容, 状态, TTL, 来源) {
    置键(记忆表, id, 字典(
        "id", id,
        "内容", 内容,
        "状态", 状态,
        "创建时间", 时间戳(),
        "最后访问", 时间戳(),
        "访问次数", 0,
        "强度", 80,    // 初始强度80
        "TTL", TTL,
        "来源", 来源
    ))
}

// 时间衰减：强度随未访问时长线性衰减
定义 计算衰减 (节点) {
    设 已过秒 = 时间戳() - 取键(节点, "最后访问")
    设 衰减量 = 已过秒 * 衰减率 / 86400
    设 新强度 = 取键(节点, "强度") - 衰减量
    若 (新强度 < 0) { 设 新强度 = 0 }
    返回(新强度)
}

// 应用衰减到节点
定义 应用衰减 (节点) {
    设 新强度 = 计算衰减(节点)
    置键(节点, "强度", 新强度)
}

// 访问增强：访问频率越高强度越高
定义 访问增强 (节点) {
    设 次数 = 取键(节点, "访问次数") + 1
    置键(节点, "访问次数", 次数)
    设 新强度 = 取键(节点, "强度") + 访问增强值
    若 (新强度 > 强度上限) { 设 新强度 = 强度上限 }
    置键(节点, "强度", 新强度)
    置键(节点, "最后访问", 时间戳())
}

// 回忆记忆：衰减后返回
定义 回忆 (id) {
    若 (不(含键(记忆表, id))) { 返回(字典("内容", "无记忆", "强度", 0)) }
    设 节点 = 取键(记忆表, id)
    应用衰减(节点)
    访问增强(节点)
    返回(节点)
}

// 遗忘清理：删除强度低于阈值的记忆
定义 清理遗忘 () {
    设 keys = 字典键列表(记忆表)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(记忆表, k)
        应用衰减(节点)
        若 (取键(节点, "强度") < 遗忘阈值) {
            删除键(记忆表, k)
        }
        设 i = i + 1
    }
}

// 取最强N条记忆
定义 取强记忆 (N) {
    清理遗忘()
    设 结果 = 列表()
    设 keys = 字典键列表(记忆表)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(记忆表, k)
        设 结果 = 列表合(结果, 列表(节点))
        设 i = i + 1
    }
    // 冒泡排序按强度降序
    设 j = 0
    设 rlen = 表长(结果)
    循环 (j < rlen) {
        设 k2 = j + 1
        循环 (k2 < rlen) {
            设 a = 取(结果, j)
            设 b = 取(结果, k2)
            若 (取键(a, "强度") < 取键(b, "强度")) {
                设 tmp = 取(结果, j)
                置元素(结果, j, b)
                置元素(结果, k2, tmp)
            }
            设 k2 = k2 + 1
        }
        设 j = j + 1
    }
    // 取前N条
    若 (rlen <= N) { 返回(结果) }
    返回(切片(结果, 0, N))
}

// 取与关键词相关的记忆（按内容匹配）
定义 取相关记忆 (关键词, N) {
    清理遗忘()
    设 结果 = 列表()
    设 keys = 字典键列表(记忆表)
    设 i = 0
    设 len = 表长(keys)
    循环 (i < len) {
        设 k = 取(keys, i)
        设 节点 = 取键(记忆表, k)
        设 内容 = 取键(节点, "内容")
        若 (查找(内容, 关键词) >= 0) {
            设 结果 = 列表合(结果, 列表(节点))
        }
        设 i = i + 1
    }
    返回(结果)
}

// === 持久化 ===
定义 保存记忆 () {
    写文件(记忆文件, 转JSON(记忆表))
}

定义 加载记忆 () {
    尝试 {
        设 raw = 读文件(记忆文件)
        若 (取长(raw) > 0) {
            设 loaded = 解析JSON(raw)
            若 (是字典(loaded)) {
                设 keys = 字典键列表(loaded)
                设 i = 0
                设 len = 表长(keys)
                循环 (i < len) {
                    设 k = 取(keys, i)
                    置键(记忆表, k, 取键(loaded, k))
                    设 i = i + 1
                }
            }
        }
    } 捕获 (e) { }
}

导出 创建记忆 回忆 清理遗忘 取强记忆 取相关记忆 保存记忆 加载记忆 计算衰减 访问增强
