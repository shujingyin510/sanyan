// 三言 Agent 运行时 — 本语言实现
// 核心决策循环：规则匹配 → LLM 调用 → 工具执行 → 学习记录
//
// 运行: python -X utf8 sanyanc.py agent_system/sanyan/agent_runtime.san --run
//
// 设计原则:
//   1. 规则优先：匹配规则直接执行，不调 LLM
//   2. LLM 兜底：无规则时调 LLM 选工具
//   3. 学习记录：SQLite 存储执行历史
//   4. 防死循环：最大轮次 + 超时保护

#include "agent_system/sanyan/agent_policy.san"
#include "agent_system/sanyan/decision.san"
#include "agent_system/sanyan/llm_iface.san"

// === 配置 ===
设 最大轮次 = 10
设 超时秒数 = 300
设 规则文件 = "agent_rules.md"
设 经验数据库 = "agent_system/agent_experience.db"

// === 初始化数据库 ===
定义 初始化数据库 ()
{
    尝试 {
        sqlite_open 经验数据库
        sqlite_exec 经验数据库 "CREATE TABLE IF NOT EXISTS task_history (id INTEGER PRIMARY KEY AUTOINCREMENT, task TEXT, tool TEXT, success INTEGER, duration REAL, created_at REAL)"
        sqlite_exec 经验数据库 "CREATE TABLE IF NOT EXISTS tool_stats (tool TEXT PRIMARY KEY, success INTEGER DEFAULT 0, fail INTEGER DEFAULT 0)"
        输出("[数据库] 初始化完成")
    } 捕获 (e) {
        输出(连接("[数据库] 初始化失败: ", 转字符串(e)))
    }
}

// === 规则匹配 ===
定义 匹配规则 (任务, 规则内容)
{
    // 简单关键词匹配（从规则文件中找匹配的规则块）
    设 规则块 = 分割(规则内容, "## 规则：")
    设 最佳匹配 = ""
    设 最佳分数 = 0
    
    设 i = 1
    循环 (i < 长度(规则块)) {
        设 块 = 取(规则块, i)
        设 名称行 = 分割(块, "\n")
        设 名称 = 取(名称行, 0)
        
        // 提取匹配模式
        设 模式 = ""
        设 j = 0
        循环 (j < 长度(名称行)) {
            设 行 = 取(名称行, j)
            若 (包含(行, "匹配：") 或 包含(行, "匹配:")) {
                设 模式 = 替换(行, "匹配：", "")
                设 模式 = 替换(模式, "匹配:", "")
                设 j = 长度(名称行)  // 退出循环
            }
            设 j = j + 1
        }
        
        // 简单关键词匹配
        设 分数 = 0
        设 模式词 = 分割(模式, "|")
        设 k = 0
        循环 (k < 长度(模式词)) {
            设 词 = 取(模式词, k)
            若 (包含(任务, 词)) {
                设 分数 = 分数 + 1
            }
            设 k = k + 1
        }
        
        若 (分数 > 最佳分数) {
            设 最佳分数 = 分数
            设 最佳匹配 = 块
        }
        设 i = i + 1
    }
    
    若 (最佳分数 > 0) {
        返回(字典("found", 真, "name", 名称, "content", 最佳匹配))
    }
    返回(字典("found", 假))
}

// === 工具执行 ===
定义 执行工具 (工具名, 参数)
{
    // 文件操作
    若 (字符串相等(工具名, "read_file")) {
        返回(读文件(参数))
    }
    若 (字符串相等(工具名, "write_file")) {
        设 部分 = 分割(参数, "|")
        设 路径 = 取(部分, 0)
        设 内容 = 取(部分, 1)
        写文件(路径, 内容)
        返回(连接("已写入 ", 路径))
    }
    若 (字符串相等(工具名, "list_files")) {
        返回(列出目录(参数))
    }
    
    // 搜索
    若 (字符串相等(工具名, "search_code")) {
        // 简单实现：返回提示
        返回(连接("搜索: ", 参数))
    }
    
    // 测试
    若 (字符串相等(工具名, "run_test")) {
        设 cmd = 连接("python -X utf8 -m pytest ", 连接(参数, " -x -q"))
        返回(执行(cmd))
    }
    若 (字符串相等(工具名, "run_shell")) {
        返回(执行(参数))
    }
    
    // 分析
    若 (字符串相等(工具名, "analyze")) {
        返回(连接("分析: ", 参数))
    }
    
    // 完成
    若 (字符串相等(工具名, "done")) {
        返回(参数)
    }
    
    返回(连接("未知工具: ", 工具名))
}

// === 学习记录 ===
定义 记录学习 (任务, 工具, 结果, 成功)
{
    设 时间 = 时间戳()
    设 成功值 = 若 (成功) { 1 } { 0 }
    
    // 记录到 SQLite
    尝试 {
        设 sql = 连接("INSERT INTO task_history (task, tool, success, duration, created_at) VALUES ('", 
            连接(任务[:50]', 连接("', '", 
            连接(工具, 连接("', ", 
            连接(转字符串(成功值), 连接(", 0, ", 
            连接(转字符串(时间), ")"))))))))
        sqlite_exec 经验数据库 sql
        
        // 更新工具统计
        设 工具存在 = sqlite_query 经验数据库 (连接("SELECT * FROM tool_stats WHERE tool='", 连接(工具, "'")))
        若 (长度(工具存在) > 0) {
            若 (成功) {
                sqlite_exec 经验数据库 (连接("UPDATE tool_stats SET success=success+1 WHERE tool='", 连接(工具, "'")))
            } {
                sqlite_exec 经验数据库 (连接("UPDATE tool_stats SET fail=fail+1 WHERE tool='", 连接(工具, "'")))
            }
        } {
            sqlite_exec 经验数据库 (连接("INSERT INTO tool_stats (tool, success, fail) VALUES ('", 
                连接(工具, 连接("', ", 连接(转字符串(成功值), 连接(", ", 
                连接(转字符串(若 (成功) { 0 } { 1 }), ")")))))))
        }
    } 捕获 (e) {
        输出(连接("[学习] 记录失败: ", 转字符串(e)))
    }
}

// === 主运行循环 ===
定义 运行任务 (任务)
{
    输出(连接("任务: ", 任务))
    输出("")
    
    // 加载规则文件
    设 规则内容 = ""
    尝试 {
        设 规则内容 = 读文件(规则文件)
    } 捕获 (e) {
        输出("⚠ 无法加载规则文件")
    }
    
    // 主循环
    设 轮次 = 0
    设 开始时间 = 时间戳()
    设 已修改 = 列表()
    设 完成 = 假
    
    循环 (轮次 < 最大轮次 且 不(完成)) {
        // 超时检查
        设 已用时间 = 时间戳() - 开始时间
        若 (已用时间 > 超时秒数) {
            输出("[超时] 执行时间超过限制")
            跳出
        }
        
        设 轮次 = 轮次 + 1
        输出(连接("[轮次 ", 连接(转字符串(轮次), "]")))
        
        // 1. 尝试规则匹配
        设 匹配 = 匹配规则(任务, 规则内容)
        若 (取键(匹配, "found")) {
            输出(连接("  [规则] 匹配: ", 取键(匹配, "name")))
            // 简化执行：直接用 LLM 生成代码
            设 回复 = 调用LLM(
                "你是编程助手。根据任务生成代码。",
                连接("任务: ", 连接(任务, "\n规则: ", 取键(匹配, "content")[:200]))
            )
            输出(连接("  [LLM] ", 回复[:100]))
            设 完成 = 真
        } {
            // 2. 无规则：调 LLM
            输出("  [LLM] 无匹配规则，调用LLM...")
            设 系统提示 = "你是三言编程助手。输出JSON格式: {\"tool\":\"工具名\",\"args\":{\"参数\":\"值\"}}"
            设 回复 = 调用LLM(系统提示, 任务)
            
            // 3. 解析工具调用
            设 解析 = 解析响应(回复)
            设 工具 = 取键(解析, "tool")
            设 参数 = 取键(解析, "params")
            
            若 (字符串相等(工具, "done") 或 字符串相等(工具, "")) {
                输出(连接("  [完成] ", 取键(解析, "answer")))
                设 完成 = 真
            } {
                // 4. 执行工具
                输出(连接("  [工具] ", 连接(工具, ": ", 参数[:50])))
                设 结果 = 执行工具(工具, 参数)
                输出(连接("  [结果] ", 结果[:100]))
                
                // 5. 记录学习
                记录学习(任务, 工具, 结果, 真)
                
                // 6. 检查是否修改了文件
                若 (字符串相等(工具, "write_file") 或 字符串相等(工具, "replace_in_file")) {
                    设 文件路径 = 分割(参数, "|")
                    设 已修改 = 列表合(已修改, 列表(取(文件路径, 0)))
                }
            }
        }
    }
    
    输出("")
    输出(连接("执行完成: ", 连接(转字符串(轮次), " 轮")))
    输出(连接("修改文件: ", 转字符串(长度(已修改))))
    返回(字典("rounds", 轮次, "modified", 已修改))
}

// === 入口 ===
定义 主 ()
{
    输出("=== 三言 Agent 运行时 (本语言版) ===")
    输出("")
    
    // 初始化数据库
    初始化数据库()
    
    // 从命令行获取任务
    设 任务 = 输入("请输入任务: ")
    若 (字符串相等(任务, "")) {
        设 任务 = "你好"
    }
    
    设 结果 = 运行任务(任务)
    
    // 查询执行统计
    尝试 {
        设 总任务 = sqlite_query 经验数据库 "SELECT COUNT(*) FROM task_history"
        设 成功任务 = sqlite_query 经验数据库 "SELECT COUNT(*) FROM task_history WHERE success=1"
        输出("")
        输出(连接("历史统计: 总计 ", 连接(转字符串(取(取(总任务, 0), 0)), 
            连接(" 次, 成功 ", 
            连接(转字符串(取(取(成功任务, 0), 0)), " 次"))))
    } 捕获 (e) { }
    
    // 关闭数据库
    sqlite_close 经验数据库
    
    输出("")
    输出("=== 完成 ===")
}

// 运行
主()
