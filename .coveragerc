[run]
omit =
    # 构建脚本（非运行时代码）
    build_combined.py
    build_exe.py
    compile_llvmgen.py
    setup.py
    sanyancc.py
    # 演示/启动器（需 LLM 网络调用，无法单测）
    run_agent.py
    run_v2.py
    run_v2_demo.py
    run_village_demo.py
    # GUI/服务器（需图形/网络环境）
    gui.py
    dap_server.py
    lsp_server.py
    main.py
    lsp/*
    # 工具脚本
    doc_sync.py
    sanfmt.py
    debug_eval.py
    utils/*
    benchmark/*
    scripts/*
    examples/*
    csrc/*
    # 网络依赖（需外网访问）
    ops/package_ops.py
    ops/net_ops.py
    # LLVM 辅助（需 llvmlite 依赖，CI 环境差异）
    llvmgen/helpers.py
    llvmgen/build.py
    llvmgen/ir_fixes.py
    llvmgen/compiler.py

[report]
fail_under = 75
